/bin/zsh -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
import json, subprocess
class Page(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.scripts=[]; self.inscript=False
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a' and a.get('href','').startswith('#'): self.links.append(a['href'][1:])
        if tag=='script': self.inscript=True
    def handle_endtag(self, tag):
        if tag=='script': self.inscript=False
    def handle_data(self, data):
        if self.inscript:self.scripts.append(data)
p=Page(); p.feed(Path('index.html').read_text())
assert len(p.ids)==len(set(p.ids)), '标识重复'
assert set(p.links)<=set(p.ids), '页面存在失效锚点'
script='\\n'.join(p.scripts)
r=subprocess.run(['node','--check'],input=script,text=True,capture_output=True)
assert r.returncode==0,r.stderr
harness=r'''
const vm=require('vm');
const assert=require('assert');
const elements={};
for(const id of ['signup','route','nickname','draft','signup-text','status','experience','copy']) {
  elements[id]={value:'',hidden:true,textContent:'',listeners:{},addEventListener(type,fn){this.listeners[type]=fn},setCustomValidity(v){this.validity=v},reportValidity(){},focus(){this.focused=true},select(){this.selected=true}};
}
const links=[{dataset:{route:'城市漫游线（探索级）'},addEventListener(type,fn){this.click=fn}}];
const context={document:{getElementById:id=>elements[id],querySelectorAll:()=>links},navigator:{clipboard:{writeText:async text=>{context.copied=text}}}};
vm.runInNewContext(SOURCE,context);
(async()=>{
links[0].click(); assert.equal(elements.route.value,'城市漫游线（探索级）');
elements.nickname.value='   '; elements.signup.listeners.submit({preventDefault(){}}); assert.ok(elements.nickname.validity);
elements.nickname.value='小骑友'; elements.signup.listeners.input(); elements.experience.value='偶尔骑行'; elements.signup.listeners.submit({preventDefault(){}});
assert.equal(elements.draft.hidden,false); assert.ok(elements['signup-text'].value.includes('小骑友')); assert.ok(elements['signup-text'].value.includes('城市漫游线'));
await elements.copy.listeners.click(); assert.equal(context.copied,elements['signup-text'].value);
context.navigator.clipboard=undefined; await elements.copy.listeners.click(); assert.ok(elements['signup-text'].selected);
elements.signup.listeners.input(); assert.equal(elements.draft.hidden,true);
console.log('报名交互检查通过：选路线、空白昵称校验、生成文本、复制、复制降级、修改后清除旧结果。');
})().catch(e=>{console.error(e);process.exitCode=1});
'''.replace('SOURCE',json.dumps(script))
r=subprocess.run(['node','-e',harness],capture_output=True,text=True)
assert r.returncode==0,r.stderr
print('静态检查通过：锚点有效、标识唯一、脚本语法正确。')
print(r.stdout)
