from pathlib import Path
from html.parser import HTMLParser
import re
p = Path('index.html')
s = p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()
        self.links = []
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if 'id' in a: self.ids.add(a['id'])
        if tag == 'a': self.links.append(a.get('href', ''))
c = Check()
c.feed(s)
assert all(h[1:] in c.ids for h in c.links if h.startswith('#'))
body = s.split('<div class=\"article-body\">', 1)[1].split('<div class=\"tags\"', 1)[0]
body = re.sub(r'<["'^>]+>'"', '', body)
print('index.html 已生成；正文汉字数：', len(re.findall(r'[\\u4e00-\\u9fff]', body)))
print('页内导航目标全部有效；CSS 已内嵌，无外部资源依赖。')
