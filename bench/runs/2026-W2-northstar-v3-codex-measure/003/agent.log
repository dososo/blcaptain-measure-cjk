diff --git a/index.html b/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..ef8e94c2e5f6946e393237df03bcb81e4a3e4212
--- /dev/null
+++ b/index.html
@@ -0,0 +1,114 @@
+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="转个弯城市骑行俱乐部：周三夜骑、周末探索、每月长线。从第一公里开始，一起发现城市的另一面。">
+  <meta name="theme-color" content="#f05b32">
+  <title>转个弯｜城市骑行俱乐部招新</title>
+  <link rel="stylesheet" href="measure.css">
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <header class="header wrap">
+    <a class="brand" href="#" aria-label="转个弯，回到首页"><span class="brand-symbol" aria-hidden="true">↗</span><span>转个弯<span class="brand-en" lang="en">TAKE A TURN · CYCLING CLUB</span></span></a>
+    <nav aria-label="主导航"><a href="#rides">骑行日历</a><a href="#routes">路线难度</a><a class="nav-join" href="#join">加入骑行 <span aria-hidden="true">↗</span></a></nav>
+  </header>
+  <main>
+    <section class="hero wrap" aria-labelledby="hero-title">
+      <div class="hero-copy">
+        <div class="eyebrow"><span class="status-dot"></span> 城市骑行俱乐部 · 新伙伴招募中</div>
+        <h1 id="hero-title">生活有点绕，<br>一起<span class="orange">转个弯。</span></h1>
+        <p class="hero-intro measure-prose">把熟悉的街道，骑成新的风景。<br>从下班后的一阵晚风，到周末的一段远路，<br>找几个同频的人，一起出发。</p>
+        <div class="hero-actions"><a class="button" href="#join">我的第一骑 <span aria-hidden="true">↗</span></a><a class="text-link" href="#routes">先看看路线 <span aria-hidden="true">↓</span></a></div>
+        <div class="hero-note"><span class="tiny-wheels" aria-hidden="true">◎◎</span> 不比速度，不卷装备。新手也有自己的节奏。</div>
+      </div>
+      <div class="hero-art">
+        <div class="art-topline"><span lang="en">LESS SCROLLING. MORE ROLLING.</span><span>01 / 出发</span></div>
+        <svg class="cycling-art" viewBox="0 0 600 530" role="img" aria-labelledby="art-title">
+          <title id="art-title">橙色夕阳下，一位骑行者穿过城市街道</title>
+          <defs><pattern id="grid" width="38" height="38" patternUnits="userSpaceOnUse"><path d="M38 0H0V38" fill="none" stroke="#242a25" stroke-opacity=".07"/></pattern></defs>
+          <path fill="url(#grid)" d="M0 0h600v530H0z"/>
+          <circle cx="385" cy="155" r="109" fill="#f05b32"/>
+          <g fill="#d9d6c7"><path d="M0 281h58V177h55v104h24V114h61v167h36V205h49v76h36v-54h54v54h51v-87h60v87h30V155h50v126h36v74H0z"/><path d="M155 114V90h25v24M530 155v-27h17v27"/></g>
+          <g stroke="#f4f1e7" stroke-width="5"><path d="M78 201v48m78-108v106m22-106v106m77-22v30m188-47v49m99-78v88"/></g>
+          <path d="M-25 433 625 287M-10 494 611 353" fill="none" stroke="#b9bfaa" stroke-width="2"/>
+          <path d="m25 470 104-24m276-63 104-24" stroke="#faf7ee" stroke-width="7"/>
+          <ellipse cx="296" cy="443" rx="231" ry="18" fill="#283a30" opacity=".12"/>
+          <g fill="none" stroke="#233b30" stroke-width="11"><circle cx="146" cy="359" r="85"/><circle cx="450" cy="359" r="85"/></g>
+          <g fill="none" stroke="#233b30" stroke-width="2" opacity=".42"><path d="m146 274 0 170m-85-85h170m-145-60 120 120m-120 0 120-120m224-25v170m-85-85h170m-145-60 120 120m-120 0 120-120"/></g>
+          <g fill="none" stroke="#f05b32" stroke-width="10" stroke-linejoin="round"><path d="m146 359 76-128 79 128H146l50-98h218l-113 98m113-98 36 98"/><path d="m414 261-17-61h35"/></g>
+          <path d="M204 229h43m174-29h22q19 0 19 17t-18 17" fill="none" stroke="#233b30" stroke-width="10" stroke-linecap="round"/>
+          <circle cx="301" cy="359" r="18" fill="#233b30"/><path d="m301 359 29 18h20" fill="none" stroke="#233b30" stroke-width="7"/>
+          <path d="m283 214-41 69 65 61" fill="none" stroke="#dca780" stroke-width="30" stroke-linecap="round" stroke-linejoin="round"/>
+          <path d="m287 224 57 44-26 91" fill="none" stroke="#edbd95" stroke-width="31" stroke-linecap="round" stroke-linejoin="round"/>
+          <path d="m309 348 27 16 5 17-42-4-6-14m-1-31 24 12 2 18-39-9-3-14" fill="#233b30"/>
+          <path d="m293 181-31 31-22 45 39 18 27-37 29 23 25-32-39-35z" fill="#233b30"/>
+          <path d="M294 105q-32 11-48 52l-10 48 77 21 49-68-17-40z" fill="#f05b32"/>
+          <path d="m257 158 70 19m-77-1 65 18" stroke="#f4f1e7" stroke-width="8"/>
+          <path d="m347 141 32 55 58 14" fill="none" stroke="#edbd95" stroke-width="23" stroke-linecap="round" stroke-linejoin="round"/>
+          <path d="m332 112 27 8 17 37-37 18-21-40z" fill="#e14c28"/>
+          <path d="m326 100 17 17 21-12-7-30" fill="#edbd95"/>
+          <path d="M323 55q32-20 50 8l-5 25-10 16-28-12-11-20" fill="#edbd95"/>
+          <path d="M313 64q-3-34 29-34 32-1 40 32l-65 10z" fill="#233b30"/>
+          <path d="m327 40 7 24m9-28 6 26m9-21 7 19" stroke="#f4f1e7" stroke-width="4"/>
+          <path d="m350 74 24-4" stroke="#233b30" stroke-width="7" stroke-linecap="round"/>
+          <g fill="none" stroke="#233b30" stroke-width="3"><path d="m45 123 57-12m-41 30 27-6m410-33 20-5m-8-7 5 20"/></g>
+        </svg>
+        <div class="art-sticker"><span lang="en">LET’S</span><strong lang="en">RIDE!</strong><span>好风景，路上见。</span></div>
+        <div class="art-bottomline"><span>城市是我们的游乐场</span><span aria-hidden="true">↗</span></div>
+      </div>
+    </section>
+    <div class="belief-bar"><div class="wrap"><span>骑慢一点，发现多一点。</span><span>有人领骑</span><span>有人收队</span><span>一起到达</span><span class="bar-arrow" aria-hidden="true">↗</span></div></div>
+    <section id="rides" class="section wrap">
+      <div class="section-heading"><div><div class="eyebrow" lang="en">01 / MAKE TIME TO RIDE</div><h2>每周，给自己一点出走时间。</h2></div><p>工作日追晚风，周末追风景。<br>选一个适合你的节奏。</p></div>
+      <div class="schedule-grid">
+        <article class="schedule"><div class="schedule-top"><span class="pill">每周三</span><span aria-hidden="true">☾</span></div><h3>下班，去吹风</h3><p>城市夜骑 · 19:30—21:00</p><div class="schedule-description">沿着城市绿道慢慢骑，用一段晚风，<br>把工作日切换到自己的时间。</div><div class="schedule-bottom"><span>约 15—20 公里</span><span>轻松级 ↗</span></div></article>
+        <article class="schedule"><div class="schedule-top"><span class="pill">每周六</span><span aria-hidden="true">☼</span></div><h3>把周末骑长一点</h3><p>周末探索 · 08:00—11:30</p><div class="schedule-description">从街角咖啡到近郊绿意，留出休息，<br>也留出停下来拍照的时间。</div><div class="schedule-bottom"><span>约 30—45 公里</span><span>进阶级 ↗</span></div></article>
+        <article class="schedule"><div class="schedule-top"><span class="pill">每月一次</span><span aria-hidden="true">↗</span></div><h3>往城市之外骑</h3><p>长线骑游 · 周日 07:30—14:00</p><div class="schedule-description">去更远一点的地方，看山、看水，<br>和队友一起完成新的里程。</div><div class="schedule-bottom"><span>约 60—80 公里</span><span>挑战级 ↗</span></div></article>
+      </div>
+      <p class="section-note">周三活动周一发布，周六活动周四发布；月度长线提前一周公布日期。遇雨或不适宜骑行的天气会调整，集合点与最终路线以当期通知为准。</p>
+    </section>
+    <section id="routes" class="routes-section"><div class="wrap section">
+      <div class="section-heading"><div><div class="eyebrow" lang="en">02 / FIND YOUR PACE</div><h2>不用很厉害，也能开始。</h2></div><p>距离只是参考，舒服才是标准。<br>第一次来，建议从轻松级出发。</p></div>
+      <div class="route-list">
+        <article class="route"><div class="route-name"><span class="level level-one" aria-hidden="true">▮▯▯</span><div><h3>轻松级 <span class="beginner">新手友好</span></h3><p>城市绿道环线</p></div></div><div class="route-stat"><strong>15—20 <small>公里</small></strong><span>平路为主 · 爬升少于 100 米</span></div><div class="route-detail"><p>参考均速 12—16 公里／小时</p><span>能熟练刹车、转弯即可，每约 30 分钟休息。</span></div><a href="#join" data-route="轻松级" aria-label="选择轻松级路线报名">↗</a></article>
+        <article class="route"><div class="route-name"><span class="level level-two" aria-hidden="true">▮▮▯</span><div><h3>进阶级</h3><p>近郊风景环线</p></div></div><div class="route-stat"><strong>30—45 <small>公里</small></strong><span>少量缓坡 · 爬升约 100—300 米</span></div><div class="route-detail"><p>参考均速 16—20 公里／小时</p><span>适合能连续骑行 1 小时、有基础体力的你。</span></div><a href="#join" data-route="进阶级" aria-label="选择进阶级路线报名">↗</a></article>
+        <article class="route"><div class="route-name"><span class="level level-three" aria-hidden="true">▮▮▮</span><div><h3>挑战级</h3><p>山野长线骑游</p></div></div><div class="route-stat"><strong>60—80 <small>公里</small></strong><span>连续起伏 · 爬升约 500—800 米</span></div><div class="route-detail"><p>参考均速 20—24 公里／小时</p><span>建议有 50 公里以上骑行经历，出发前确认体能。</span></div><a href="#join" data-route="挑战级" aria-label="选择挑战级路线报名">↗</a></article>
+      </div>
+      <div class="route-footnote"><span aria-hidden="true">↳</span><p>所有活动都有领骑与收队，不要求跟快。参考均速不含休息时间；跟队有压力时，及时告诉领骑。</p></div>
+    </div></section>
+    <section id="join" class="join section wrap">
+      <div class="join-copy"><div class="eyebrow" lang="en">03 / SEE YOU OUT THERE</div><h2>下一段路，<br>给你留个位置。</h2><p class="measure-prose">带上自行车、头盔和一点好奇心。<br>剩下的路，我们一起认识。</p><ol class="steps"><li><span>01</span><div><strong>选好你的第一条路线</strong><p>填写昵称和骑行经验，生成报名信息。</p></div></li><li><span>02</span><div><strong>发送给活动组织者</strong><p>通过招募帖或邀请你的骑友联系组织者。</p></div></li><li><span>03</span><div><strong>收到确认，再一起出发</strong><p>确认名额、集合点及费用后，按时到场。</p></div></li></ol></div>
+      <form id="signup" class="signup"><div class="form-heading"><h3>从一次骑行开始</h3><span aria-hidden="true">↗</span></div><p class="form-intro">先选意向，具体场次与组织者确认。</p><label for="nickname">怎么称呼你</label><input id="nickname" name="nickname" placeholder="你的骑行昵称" required maxlength="24" autocomplete="nickname"><label for="route">想参加哪种骑行</label><select id="route" name="route"><option>轻松级</option><option>进阶级</option><option>挑战级</option></select><label for="experience">你的骑行经验</label><select id="experience" name="experience"><option>刚开始骑，想找人一起</option><option>偶尔骑行，骑过 20—50 公里</option><option>经常骑行，有长距离经验</option></select><button class="button" type="submit">生成报名信息 <span aria-hidden="true">↗</span></button><p class="form-note">信息仅在本页生成，不会自动上传或完成报名。复制后发送给组织者，以对方确认为准。</p><div id="signup-result" hidden aria-live="polite"><label for="signup-message">你的报名信息</label><textarea id="signup-message" rows="5" readonly></textarea><button id="copy-button" type="button" class="copy-button">复制报名信息</button><p id="copy-status" role="status"></p></div></form>
+    </section>
+    <section class="before-ride wrap"><div class="eyebrow">出发前，你可能想知道</div><div class="faq-grid"><details><summary>没有公路车，也能参加吗？</summary><p>可以。轻松级适合车况良好的城市车、山地车和公路车。请自备自行车和头盔，夜骑需配备前后车灯，出发前检查刹车与胎压。</p></details><details><summary>参加活动需要费用吗？</summary><p>常规骑行不收组织费，餐饮、租车和补给自行承担。涉及交通或住宿的长线活动，会在报名确认前说明费用，自愿参加。</p></details><details><summary>一个人来，会不会跟不上？</summary><p>欢迎一个人来。第一次建议选择轻松级，出发前会说明队形与路口规则，途中有固定休息点，也有人收队。有不适请及时告诉领骑。</p></details></div></section>
+  </main>
+  <footer class="footer wrap"><a class="brand" href="#"><span class="brand-symbol" aria-hidden="true">↗</span>转个弯</a><span>好风景，路上见。</span><small>招新示例页面 · 活动安排以组织者发布为准</small><a href="#" aria-label="返回顶部">回到顶部 ↑</a></footer>
+  <script>
+    const form = document.getElementById('signup');
+    const result = document.getElementById('signup-result');
+    const message = document.getElementById('signup-message');
+    const status = document.getElementById('copy-status');
+    document.querySelectorAll('[data-route]').forEach(link => link.addEventListener('click', () => {
+      document.getElementById('route').value = link.dataset.route;
+      result.hidden = true;
+    }));
+    form.addEventListener('input', event => { if (event.target !== message) result.hidden = true; });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const nickname = document.getElementById('nickname');
+      if (!nickname.value.trim()) { nickname.setCustomValidity('请填写你的骑行昵称'); nickname.reportValidity(); return; }
+      message.value = `你好，我想报名转个弯的骑行活动。\n昵称：${nickname.value.trim()}\n意向路线：${document.getElementById('route').value}\n骑行经验：${document.getElementById('experience').value}\n请告知最近场次、集合地点、名额及费用，谢谢！`;
+      status.textContent = '';
+      result.hidden = false;
+      message.focus();
+    });
+    document.getElementById('nickname').addEventListener('input', event => event.target.setCustomValidity(''));
+    document.getElementById('copy-button').addEventListener('click', async () => {
+      try { await navigator.clipboard.writeText(message.value); status.textContent = '已复制，请发送给活动组织者。'; }
+      catch { message.focus(); message.select(); status.textContent = '已选中报名信息，请长按或使用系统复制快捷键复制。'; }
+    });
+  </script>
+</body>
+</html>
diff --git a/style.css b/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..4144dc810a07eb2fc23bcd9ae14359cc5e81dc2c
--- /dev/null
+++ b/style.css
@@ -0,0 +1,7 @@
+@layer measure;
