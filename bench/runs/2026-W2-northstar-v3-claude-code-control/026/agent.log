    background: var(--ink);\n    color: var(--card);\n    padding: .4em 1em;\n    border-radius: 999px;\n    letter-spacing: .05em;\n  }\n  h1 {\n    font-size: 9.6cqw;\n    line-height: 1.15;\n    margin-top: 3.5cqw;\n    font-weight: 900;\n  }\n  h1 .hl {\n    color: var(--accent);\n    background: linear-gradient(transparent 62%, var(--yellow) 62%);\n  }\n  .sub {\n    font-size: 3.4cqw;\n    color: var(--muted);\n    margin-top: 2cqw;\n  }\n  .list {\n    list-style: none;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 3cqw;\n    margin-top: 5cqw;\n    flex: 1;\n    position: relative;\n  }\n  .item {\n    border-radius: 20px;\n    padding: 4cqw 3.6cqw;\n    display: flex;\n    flex-direction: column;\n    gap: 1.6cqw;\n    min-width: 0;\n  }\n  .item:nth-child(1) { background: var(--c1); }\n  .item:nth-child(2) { background: var(--c2); }\n  .item:nth-child(3) { background: var(--c3); }\n  .item:nth-child(4) { background: var(--c4); }\n  .top { display: flex; align-items: center; justify-content: space-between; }\n  .emoji { font-size: 9cqw; line-height: 1; }\n  .time {\n    font-size: 2.7cqw;\n    background: rgba(255,255,255,.75);\n    padding: .3em .7em;\n    border-radius: 999px;\n    font-weight: 700;\n  }\n  .item h2 { font-size: 4.4cqw; font-weight: 800; }\n  .steps {\n    font-size: 2.9cqw;\n    line-height: 1.6;\n    color: #5a4a40;\n    padding-left: 1.2em;\n  }\n  footer {\n    margin-top: 4cqw;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 3cqw;\n    color: var(--muted);\n    position: relative;\n  }\n  footer b { color: var(--accent); }\n</style>\n</head>\n<body>\n  <article class=\"card\">\n    <header>\n      <span class=\"tag\">🍳 打工人早餐合集</span>\n      <h1>上班族<br><span class=\"hl\">10 分钟</span>早餐</h1>\n      <p class=\"sub\">再也不用空腹挤地铁了｜收藏起来每天换着做</p>\n    </header>\n\n    <ol class=\"list\">\n      <li class=\"item\">\n        <div class=\"top\"><span class=\"emoji\">🥪</span><span class=\"time\">⏱ 8 min</span></div>\n        <h2>01 鸡蛋火腿三明治</h2>\n        <ol class=\"steps\">\n          <li>吐司烤 2 分钟</li>\n          <li>煎蛋 + 火腿片</li>\n          <li>加生菜芝士夹好对切</li>\n        </ol>\n      </li>\n      <li class=\"item\">\n        <div class=\"top\"><span class=\"emoji\">🥣</span><span class=\"time\">⏱ 5 min</span></div>\n        <h2>02 酸奶燕麦杯</h2>\n        <ol class=\"steps\">\n          <li>杯底铺即食燕麦</li>\n          <li>倒入希腊酸奶</li>\n          <li>放香蕉蓝莓坚果</li>\n        </ol>\n      </li>\n      <li class=\"item\">\n        <div class=\"top\"><span class=\"emoji\">🍜</span><span class=\"time\">⏱ 10 min</span></div>\n        <h2>03 番茄鸡蛋挂面</h2>\n        <ol class=\"steps\">\n          <li>番茄炒出汁加水</li>\n          <li>水开下挂面 4 分钟</li>\n          <li>淋蛋液撒葱花</li>\n        </ol>\n      </li>\n      <li class=\"item\">\n        <div class=\"top\"><span class=\"emoji\">🥑</span><span class=\"time\">⏱ 6 min</span></div>\n        <h2>04 牛油果鸡蛋吐司</h2>\n        <ol class=\"steps\">\n          <li>牛油果压泥加盐</li>\n          <li>抹在烤好的吐司上</li>\n          <li>放水波蛋撒黑胡椒</li>\n        </ol>\n      </li>\n    </ol>\n\n    <footer>\n      <span>💡 前一晚备好食材更省时</span>\n      <span><b>♥</b> 点赞收藏不迷路</span>\n    </footer>\n  </article>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01WsAauSFgFKbmDx2sNXpcaX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
