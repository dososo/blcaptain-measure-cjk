+      try { localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(boxes.map(item => [item.dataset.task, item.checked])))); canSave = true; document.getElementById('save-status').textContent = '进度已保存到当前浏览器'; } catch { canSave = false; }
+      updateProgress();
+    }));
+    function selectDay(tab) {
