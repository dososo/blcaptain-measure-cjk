+    <section id="help" aria-labelledby="help-title"><div class="section-head"><div><div class="section-title"><span class="number">03 /</span><h2 id="help-title">有问题，找到对的人</h2></div><p>联系人及联系方式待公司补充；入职前可通过录用通知中的渠道联系 HR。</p></div></div><div class="help-grid"><div class="contact"><span class="contact-avatar"><svg class="icon"><use href="#i-user"/></svg></span><div><h3>人力资源 · HR</h3><p>入职材料、考勤制度、福利咨询</p><small>联系人 / 联系方式：待补充</small></div></div><div class="contact"><span class="contact-avatar"><svg class="icon"><use href="#i-grid"/></svg></span><div><h3>IT 支持</h3><p>设备配置、账号开通、访问权限</p><small>联系人 / 联系方式：待补充</small></div></div><div class="contact"><span class="contact-avatar"><svg class="icon"><use href="#i-chat"/></svg></span><div><h3>直属主管 / 入职伙伴</h3><p>团队协作、岗位目标、日常答疑</p><small>联系人 / 联系方式：待补充</small></div></div></div></section>
+    <footer><span>这是一份通用入职指南，具体流程请以公司安排为准。</span><span>一步一步，开启新篇章 ↗</span></footer>
+  </main>
+  <script>
+    const days = [
+      {label:'欢迎加入',title:'先安顿下来，认识新环境',description:'完成报到与基础设置，让新开始井然有序。',tasks:[['办理入职手续','按 HR 通知提交材料，确认劳动合同及入职信息。','HR'],['领取办公设备与工位','确认电脑、配件、门禁及办公网络，检查设备可正常使用。','行政 / IT'],['激活基础工作账号','开通企业邮箱与即时通讯，修改初始密码并设置多因素验证。','IT 支持'],['认识你的团队与入职伙伴','和直属主管打个招呼，了解团队成员与日常沟通方式。','直属主管']]},
+      {label:'熟悉环境',title:'找到工具，也找到协作方式',description:'了解日常规则，搭建自己的工作空间。',tasks:[['阅读员工手册','了解作息、请假、考勤与报销流程，记录需要确认的问题。','HR'],['加入工作群与团队日历','确认团队公告渠道、例会时间及会议室预约方式。','入职伙伴'],['配置工作工具与权限','安装公司批准的工具，确认文档、项目与网络访问权限。','IT 支持'],['完成信息安全学习','了解数据分级、密码管理、可疑邮件识别与问题反馈渠道。','IT 支持']]},
+      {label:'了解业务',title:'把自己的角色放进团队全景',description:'从产品、业务到岗位，建立初步理解。',tasks:[['了解公司产品与业务','阅读业务介绍，了解主要客户、核心产品与服务流程。','入职伙伴'],['与直属主管进行首次沟通','对齐岗位职责、试用期目标、交付预期与反馈方式。','直属主管'],['熟悉团队工作流程','了解任务分配、评审、交付与跨团队协作方式。','团队成员']]},
+      {label:'开始实践',title:'从一件小事，开启真实协作',description:'在伙伴的支持下，完成一次轻量实践。',tasks:[['领取第一项入门任务','与主管确认任务范围、完成标准、时间安排及支持人。','直属主管'],['参与一次团队协作','参加例会或评审，了解讨论方式并主动分享观察。','团队成员'],['动手实践并记录问题','尝试完成任务，记录遇到的阻碍，及时向入职伙伴求助。','入职伙伴']]},
+      {label:'回顾展望',title:'给第一周一个小小的收尾',description:'回顾收获，带着清晰的方向进入下一周。',tasks:[['回顾本周的学习与收获','整理认识的人、熟悉的流程、完成的任务与待解决问题。','自己'],['与主管进行第一周复盘','分享感受与困难，获取反馈，确认需要补充的支持。','直属主管'],['制定下一周工作计划','对齐优先事项、时间节点与协作对象，明确下一步行动。','直属主管'],['检查账号与权限是否齐全','确认常用系统可用，将未解决的权限问题提交给 IT。','IT 支持']]}
+    ];
+    const accounts = [
+      {name:'企业邮箱',sub:'工作通知 · 对外沟通',owner:'IT 支持',icon:'mail',color:'#668cba',bg:'#eef3fb',detail:'账号：待分配；登录入口：待补充。请向 IT 领取企业邮箱地址，首次登录后修改密码，并按公司规范设置邮件签名。'},
+      {name:'即时通讯',sub:'团队消息 · 在线会议',owner:'IT 支持',icon:'chat',color:'#668a7a',bg:'#edf4f0',detail:'账号：待分配；登录入口：待补充。根据公司使用的平台接受组织邀请，完善姓名、部门等资料，并加入团队工作群。'},
+      {name:'人事 / OA 系统',sub:'考勤请假 · 审批报销',owner:'HR / 行政',icon:'user',color:'#b99360',bg:'#faf3e8',detail:'账号：待分配；登录入口：待补充。向 HR 确认工号与登录方式，核对个人信息，并了解请假、考勤和报销审批流程。'},
+      {name:'知识库',sub:'员工手册 · 业务文档',owner:'入职伙伴',icon:'book',color:'#9080b2',bg:'#f2eff8',detail:'账号：待分配；登录入口：待补充。向入职伙伴申请团队文档空间权限，从员工手册、团队介绍和岗位学习资料开始阅读。'},
+      {name:'项目协作',sub:'任务管理 · 进度跟踪',owner:'直属主管',icon:'folder',color:'#7394aa',bg:'#edf3f7',detail:'账号：待分配；登录入口：待补充。请主管邀请你加入相关项目，确认任务看板、负责人、截止日期和团队协作规则。'},
+      {name:'VPN / 内网',sub:'安全连接 · 内部资源',owner:'IT 支持',icon:'shield',color:'#b58c79',bg:'#f8f0eb',detail:'账号：按需申请；登录入口：待补充。根据岗位需要向 IT 申请内网访问权限，使用公司批准的客户端及配置，不共享访问凭据。'}
+    ];
+    const storageKey='onboarding-guide-progress-v1';
+    const validIds=new Set(days.flatMap((d,di)=>d.tasks.map((_,ti)=>`${di}-${ti}`)));
+    let completed=new Set(),storageAvailable=true,selectedDay=0;
+    try{const saved=JSON.parse(localStorage.getItem(storageKey)||'[]');if(Array.isArray(saved))completed=new Set(saved.filter(id=>validIds.has(id)));}catch{storageAvailable=false;}
+    const icon=name=>`<svg class="icon" aria-hidden="true"><use href="#i-${name}"/></svg>`;
+    const tabs=document.querySelector('.day-tabs');
+    tabs.innerHTML=days.map((day,i)=>`<button class="day-tab" role="tab" id="tab-${i}" aria-controls="day-content" aria-selected="${i===0}" tabindex="${i===0?0:-1}" data-day="${i}"><span class="day-number">0${i+1}</span><span><small>DAY ${i+1}</small><b>${day.label}</b></span></button>`).join('');
+    function renderDay(){
+      const day=days[selectedDay];
+      tabs.querySelectorAll('button').forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===selectedDay));tab.tabIndex=i===selectedDay?0:-1;});
+      const panel=document.getElementById('day-content');panel.setAttribute('aria-labelledby',`tab-${selectedDay}`);
+      panel.innerHTML=`<div class="day-heading"><div><h3>${day.title}</h3><p>${day.description}</p></div><span class="pill" id="day-count"></span></div>`+day.tasks.map((t,i)=>`<label class="task"><input type="checkbox" data-task="${selectedDay}-${i}" ${completed.has(`${selectedDay}-${i}`)?'checked':''}><span class="task-text"><span class="task-title">${t[0]}</span><span class="task-detail">${t[1]}</span></span><span class="task-tag">${t[2]}</span></label>`).join('');
+      updateProgress();
+    }
+    function updateProgress(){
+      const total=validIds.size,percent=Math.round(completed.size/total*100);
+      document.getElementById('progress-number').textContent=`${percent}%`;
+      document.getElementById('progress').value=percent;
+      document.getElementById('progress-caption').textContent=`已完成 ${completed.size} / ${total} 项任务 · ${percent===100?'第一周准备就绪！':'每一步都算数'}`;
+      document.getElementById('day-count').textContent=`${days[selectedDay].tasks.filter((_,i)=>completed.has(`${selectedDay}-${i}`)).length} / ${days[selectedDay].tasks.length} 已完成`;
+      if(!storageAvailable)document.getElementById('save-note').textContent='浏览器存储不可用，进度仅保留至本次页面关闭';
+    }
+    function save(){try{localStorage.setItem(storageKey,JSON.stringify([...completed]));storageAvailable=true;}catch{storageAvailable=false;}updateProgress();}
+    tabs.addEventListener('click',event=>{const tab=event.target.closest('[data-day]');if(tab){selectedDay=Number(tab.dataset.day);renderDay();}});
+    tabs.addEventListener('keydown',event=>{let next=selectedDay;if(event.key==='ArrowRight')next=(next+1)%days.length;else if(event.key==='ArrowLeft')next=(next+days.length-1)%days.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=days.length-1;else return;event.preventDefault();selectedDay=next;renderDay();document.getElementById(`tab-${next}`).focus();});
+    document.getElementById('day-content').addEventListener('change',event=>{const id=event.target.dataset.task;if(!id)return;event.target.checked?completed.add(id):completed.delete(id);save();});
+    document.getElementById('reset').addEventListener('click',()=>{if(completed.size&&confirm('确定清除所有已完成标记吗？')){completed.clear();save();renderDay();}});
+    function renderAccounts(query=''){
+      const filtered=accounts.filter(a=>`${a.name} ${a.sub} ${a.owner} ${a.detail}`.toLowerCase().includes(query.trim().toLowerCase()));
+      document.getElementById('account-grid').innerHTML=filtered.length?filtered.map(a=>`<article class="account-card"><div class="account-top"><span class="app-icon" style="--app-color:${a.color};--app-bg:${a.bg}">${icon(a.icon)}</span><div><h3>${a.name}</h3><p>${a.sub}</p></div><span class="account-state">待配置</span></div><div class="account-meta"><span>账号：${a.name==='VPN / 内网'?'按需申请':'待分配'}</span><strong>负责人：${a.owner}</strong></div><details><summary>查看开通指引</summary><p>${a.detail}</p></details></article>`).join(''):'<p class="empty">没有找到相关系统，试试“邮箱”或“协作”。</p>';
+      document.getElementById('search-status').textContent=`找到 ${filtered.length} 个系统`;
+    }
+    document.getElementById('account-search').addEventListener('input',event=>renderAccounts(event.target.value));
+    const navLinks=document.querySelectorAll('.nav-link');
+    function setActiveNav(){const hash=location.hash||'#overview';navLinks.forEach(link=>{const active=link.getAttribute('href')===hash;link.classList.toggle('active',active);if(active)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});}
+    addEventListener('hashchange',setActiveNav);setActiveNav();renderDay();renderAccounts();
+  </script>
+</body>
+</html>

