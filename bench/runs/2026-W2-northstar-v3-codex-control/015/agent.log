+    const dialog=document.getElementById('info-dialog');
+    function showDialog(title,body){document.getElementById('dialog-title').textContent=title;document.getElementById('dialog-body').innerHTML=body;dialog.showModal()}
+    document.querySelectorAll('[data-start]').forEach(button=>button.addEventListener('click',()=>{const name=button.dataset.start;showDialog('从 '+name+' 开始','<p>这是 Flux API 的定价演示页。正式接入时，你将在控制台创建账户并获取 API Key。</p><div class="demo-code">Authorization: Bearer YOUR_API_KEY</div><p>你可以先使用页面中的费用计算器评估用量。本示例不会创建账户或产生任何费用。</p>')}));
+    document.getElementById('sales').addEventListener('click',e=>{e.preventDefault();showDialog('为规模化业务量身定制','<p>企业方案可根据月调用量、峰值并发和支持需求，提供专属报价。建议准备以下信息：</p><p>· 需要使用的 API 服务<br>· 预计月调用量和峰值 QPS<br>· 数据处理与技术支持需求</p><p>当前为展示页面，尚未配置销售联系方式或提交渠道。</p>')});
+    document.querySelector('.dialog-close').addEventListener('click',()=>dialog.close());document.getElementById('dialog-done').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
+    update();
+  </script>
+</body>
+</html>

