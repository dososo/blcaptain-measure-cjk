{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "measure-cjk font license table",
  "type": "object",
  "required": ["schema_version", "disclaimer", "fonts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "field_semantics": { "type": "object" },
    "fonts": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "names", "foundry", "license", "tier", "webfont_self_host", "commercial_image", "modify_subset", "attribution_required", "reserved_font_names", "revocable", "source_url", "verified_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "name_prefixes": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "filename_prefixes": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "foundry": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["embeddable", "image-only", "system-only", "commercial", "unknown"] },
          "webfont_self_host": { "$ref": "#/$defs/triBool" },
          "commercial_image": { "$ref": "#/$defs/triBool" },
          "modify_subset": { "$ref": "#/$defs/triBool" },
          "attribution_required": { "$ref": "#/$defs/triBool" },
          "reserved_font_names": { "type": "array", "items": { "type": "string" } },
          "revocable": { "$ref": "#/$defs/triBool" },
          "source_url": { "type": "string", "pattern": "^https://" },
          "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "triBool": { "anyOf": [{ "type": "boolean" }, { "const": "unknown" }] }
  }
}
