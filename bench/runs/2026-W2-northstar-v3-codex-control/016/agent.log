+  <dialog id="search-dialog"><div class="dialog-top"><label for="search-input">搜索文档</label><button id="close-search" aria-label="关闭搜索">Esc</button></div><input id="search-input" type="search" placeholder="搜索安装、配置、命令…" autocomplete="off"><div class="results" id="search-results"></div></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script>
+    const installs={macos:{command:'brew install git',help:'需要先安装 <a href="https://brew.sh/zh-cn/">Homebrew</a>；也可以使用 <a href="https://git-scm.com/downloads">其他安装方式</a>。'},linux:{command:'sudo apt update\nsudo apt install git',help:'适用于 Debian / Ubuntu。其他发行版请参考 <a href="https://git-scm.com/downloads/linux">Linux 安装说明</a>。'},windows:{command:'winget install --id Git.Git -e --source winget',help:'在 PowerShell 中运行，需要已安装 winget；也可下载 <a href="https://git-scm.com/downloads/win">Windows 安装程序</a>。安装后重新打开终端。'}};
+    const tabs=[...document.querySelectorAll('.tab')];
+    function selectOS(tab){tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1});const info=installs[tab.dataset.os];document.getElementById('install-code').textContent=info.command;document.getElementById('install-help').innerHTML='<span class="tiny-arrow">↳</span><span>'+info.help+'</span>';document.getElementById('install-panel').setAttribute('aria-labelledby',tab.id)}
+    tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectOS(tab));tab.addEventListener('keydown',e=>{let next;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectOS(tabs[next]);tabs[next].focus()})});
