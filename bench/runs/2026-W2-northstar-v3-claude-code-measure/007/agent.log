st-header {\n  border-bottom: 1px solid var(--line);\n  padding-bottom: 28px;\n  margin-bottom: 36px;\n}\n\n.crumb {\n  font-size: 14px;\n  color: var(--muted);\n  margin: 0 0 16px;\n}\n\n.crumb a { color: var(--accent); text-decoration: none; }\n\nh1 {\n  font-size: 34px;\n  font-weight: 700;\n  letter-spacing: 0.01em;\n  margin: 0 0 16px;\n}\n\n.meta {\n  font-size: 14px;\n  color: var(--muted);\n  margin: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 16px;\n}\n\n.lead {\n  font-size: 18px;\n  color: var(--fg);\n}\n\n/* 目录 */\n.toc {\n  border-left: 3px solid var(--accent);\n  padding: 4px 0 4px 18px;\n  margin: 32px 0 44px;\n}\n\n.toc-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--muted);\n  margin: 0 0 8px;\n}\n\n.toc ol { margin: 0; padding-left: 1.4em; }\n.toc li { margin: 2px 0; }\n.toc a { color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--line); }\n.toc a:hover { color: var(--accent); border-color: var(--accent); }\n\n/* 正文 */\nh2 {\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: 0.01em;\n  margin: 56px 0 16px;\n  scroll-margin-top: 24px;\n}\n\nh2 .num {\n  color: var(--accent);\n  font-variant-numeric: tabular-nums;\n  margin-right: 0.4em;\n}\n\nh3 {\n  font-size: 18px;\n  font-weight: 600;\n  margin: 28px 0 8px;\n}\n\np, li { margin: 0 0 1em; }\n\na { color: var(--accent); }\n\nstrong { font-weight: 600; }\n\nem {\n  font-style: normal;\n  text-emphasis: dot;\n  -webkit-text-emphasis: dot;\n}\n\ncode {\n  font-family: \"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, \"PingFang SC\", \"Noto Sans SC\", \"Microsoft YaHei\", monospace;\n  font-size: 0.88em;\n  background: var(--code-bg);\n  padding: 0.1em 0.35em;\n  border-radius: 3px;\n}\n\n.code {\n  margin: 16px 0 24px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: var(--code-bg);\n  overflow: hidden;\n}\n\n.code-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 13px;\n  color: var(--muted);\n  padding: 8px 14px;\n  border-bottom: 1px solid var(--line);\n}\n\n.copy {\n  font: inherit;\n  font-size: 13px;\n  color: var(--muted);\n  background: none;\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  padding: 2px 10px;\n  cursor: pointer;\n}\n\n.copy:hover { color: var(--accent); border-color: var(--accent); }\n\npre {\n  margin: 0;\n  padding: 14px 16px;\n  overflow-x: auto;\n  line-height: 1.6;\n}\n\npre code {\n  background: none;\n  padding: 0;\n  font-size: 14px;\n  color: var(--code-fg);\n}\n\n.k { color: var(--c-keyword); }\n.s { color: var(--c-string); }\n.c { color: var(--c-comment); }\n.f { color: var(--c-func); }\n.n { color: var(--c-num); }\n\n.note {\n  background: var(--note-bg);\n  border-radius: 6px;\n  padding: 14px 18px;\n  margin: 20px 0;\n  font-size: 16px;\n}\n\n.note p:last-child { margin-bottom: 0; }\n\n.note-label {\n  font-weight: 600;\n  color: var(--accent);\n  margin-right: 0.3em;\n}\n\n/* 表格 */\n.table-wrap { overflow-x: auto; margin: 16px 0 24px; }\n\ntable {\n  border-collapse: collapse;\n  width: 100%;\n  font-size: 15px;\n}\n\nth, td {\n  text-align: left;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n}\n\nth { font-weight: 600; color: var(--muted); }\n\n/* 尾部 */\n.post-footer {\n  margin-top: 64px;\n  padding-top: 24px;\n  border-top: 1px solid var(--line);\n  font-size: 15px;\n  color: var(--muted);\n}\n\n.tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; padding: 0; list-style: none; }\n.tags li {\n  margin: 0;\n  font-size: 13px;\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  padding: 2px 10px;\n}\n\n@media (max-width: 520px) {\n  body { font-size: 16px; }\n  h1 { font-size: 28px; }\n  h2 { font-size: 21px; }\n  .wrap { padding-block: 36px 56px; padding-inline: 16px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01JpQYy6hjwk5R8o1K22Sw9S","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
