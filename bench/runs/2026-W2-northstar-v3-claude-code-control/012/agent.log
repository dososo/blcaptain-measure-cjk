 flex-wrap: wrap; }\n.price .currency { font-size: 1.2rem; font-weight: 600; }\n.price .amount { font-size: 2.6rem; font-weight: 700; line-height: 1; letter-spacing: -0.02em; }\n.price .unit { color: var(--muted); font-size: 0.95rem; }\n.per {\n  font-size: 0.85rem;\n  color: var(--accent-strong);\n  margin: 0.5rem 0 0;\n  min-height: 1.4em;\n}\n.per s { color: var(--muted); margin-left: 0.35rem; }\n\n.features { list-style: none; padding: 0; margin: 1.5rem 0; flex: 1; }\n.features li {\n  position: relative;\n  padding-left: 1.6rem;\n  margin-bottom: 0.65rem;\n  font-size: 0.95rem;\n}\n.features li::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0.35em;\n  width: 1rem;\n  height: 1rem;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  box-shadow: inset 0 0 0 0.3rem var(--accent);\n}\n.features li.off { color: var(--muted); text-decoration: line-through; }\n.features li.off::before { background: var(--line); box-shadow: none; }\n\n.btn {\n  display: block;\n  text-align: center;\n  padding: 0.8rem 1rem;\n  border-radius: 0.75rem;\n  font-weight: 600;\n  text-decoration: none;\n  border: 1.5px solid var(--accent);\n  color: var(--accent-strong);\n  background: transparent;\n  cursor: pointer;\n  font: inherit;\n  width: 100%;\n  transition: background 0.2s ease, color 0.2s ease;\n}\n.btn:hover { background: var(--accent-soft); }\n.btn.primary { background: var(--accent); color: var(--on-accent); }\n.btn.primary:hover { background: var(--accent-strong); }\n\n/* Section titles */\n.section { padding-block: 3rem; border-top: 1px solid var(--line); }\n.section h2.title { text-align: center; font-size: 1.6rem; margin: 0 0 0.5rem; }\n.section .sub { text-align: center; color: var(--muted); margin: 0 0 2rem; }\n\n/* Comparison table */\n.table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); }\ntable { width: 100%; border-collapse: collapse; min-width: 40rem; }\nth, td { padding: 0.9rem 1rem; text-align: center; border-bottom: 1px solid var(--line); font-size: 0.95rem; }\nth:first-child, td:first-child { text-align: left; color: var(--muted); }\nthead th { background: var(--accent-soft); color: var(--fg); font-weight: 600; }\ntbody tr:last-child td { border-bottom: none; }\ntd.yes { color: var(--accent-strong); font-weight: 600; }\ntd.no { color: var(--muted); }\n.col-featured { background: color-mix(in srgb, var(--accent-soft) 45%, transparent); }\n\n/* Notes */\n.notes {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));\n  gap: 1rem;\n}\n.note {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 1rem;\n  padding: 1.25rem;\n  min-width: 0;\n}\n.note .icon { font-size: 1.5rem; }\n.note h3 { margin: 0.5rem 0 0.25rem; font-size: 1.05rem; }\n.note p { margin: 0; color: var(--muted); font-size: 0.9rem; }\n\n/* FAQ */\n.faq { max-width: 48rem; margin: 0 auto; }\n.faq details {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 0.85rem;\n  padding: 1rem 1.25rem;\n  margin-bottom: 0.75rem;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  list-style: none;\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n}\n.faq summary::-webkit-details-marker { display: none; }\n.faq summary::after { content: \"+\"; color: var(--accent-strong); font-size: 1.25rem; line-height: 1; }\n.faq details[open] summary::after { content: \"−\"; }\n.faq details p { margin: 0.75rem 0 0; color: var(--muted); }\n\n/* CTA + footer */\n.cta {\n  text-align: center;\n  background: var(--accent-soft);\n  border-radius: 1.5rem;\n  padding: 2.5rem 1.5rem;\n  margin-block: 1rem 3rem;\n}\n.cta h2 { margin: 0 0 0.5rem; }\n.cta p { color: var(--muted); margin: 0 0 1.25rem; }\n.cta .btn { display: inline-block; width: auto; padding-inline: 2rem; }\n\n.site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }\n.site-footer .wrap {\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  flex-wrap: wrap;\n  padding-block: 1.5rem;\n}\n\n/* Toast */\n.toast {\n  position: fixed;\n  left: 50%;\n  bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));\n  transform: translateX(-50%);\n  background: var(--fg);\n  color: var(--bg);\n  padding: 0.75rem 1.25rem;\n  border-radius: 0.75rem;\n  font-size: 0.9rem;\n  max-width: calc(100% - 2rem);\n  box-shadow: var(--shadow);\n}\n\n@media (max-width: 600px) {\n  .hero { padding-block: 2.5rem 1.5rem; }\n  .site-header nav { gap: 0.9rem; }\n  .plan .desc { min-height: 0; }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2296,"cache_read_input_tokens":31725,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2296},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"170359a3-3bcd-4be3-89e9-52c828bd8a93","uuid":"d824c85d-82aa-4b16-9ed1-5ef980530a46","timestamp":"2026-10-26T03:27:23.631Z","request_id":"req_011CgQ8soAHMjF6fWo7AVxBx","wire_tool_inputs":{"toolu_01FRL2h9xtubogQzDFYdhDbk":{"file_path":"<tmp>/measure-baseline-claude-code-012-oWrFuJ/styles.css","content":":root {\n  --bg: #faf7f2;\n  --surface: #ffffff;\n  --fg: #2f2a25;\n  --muted: #7a7068;\n  --line: #e8e1d7;\n  --accent: #6b8f71;\n  --accent-strong: #557a5b;\n  --accent-soft: #e7efe7;\n  --badge: #c9845b;\n  --on-accent: #ffffff;\n  --shadow: 0 10px 30px rgba(60, 45, 30, 0.08);\n}\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) {\n    --bg: #1b1a18;\n    --surface: #252320;\n    --fg: #f0ebe4;\n    --muted: #a99f94;\n    --line: #3a3631;\n    --accent: #8fb895;\n    --accent-strong: #a6c9ab;\n    --accent-soft: #2d3a2f;\n    --badge: #d9976e;\n    --on-accent: #15201a;\n