from pathlib import Path
from html.parser import HTMLParser
import subprocess
p = Path('index.html')
s = p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.links=[]; self.plans=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a:
            assert a['id'] not in self.ids, 'Duplicate id'
            self.ids.add(a['id'])
        if a.get('href','').startswith('#') and len(a['href'])>1: self.links.append(a['href'][1:])
        if 'data-plan' in a: self.plans.append(a['data-plan'])
c=Check(); c.feed(s)
assert all(x in c.ids for x in c.links), 'Missing anchor'
assert len(set(c.plans)) == 4
js=s.split('<script>')[1].split('</script>')[0]
r=subprocess.run(['node','--check'],input=js,text=True,capture_output=True)
assert r.returncode == 0, r.stderr
print('Verified: HTML anchors, four plan controls, and JavaScript syntax.')
print(f'Created: {p.resolve()} ({p.stat().st_size:,} bytes)')
