+  <div id="toast" class="toast" role="status" aria-live="polite"></div>
+  <script>
+    const samples = {
+      report: { original: '这周做了新版首页，跟设计对了两次，周四上线了。还处理了 3 个用户反馈。下周看看数据，再改改注册流程。', tone: '清晰 · 有重点', sections: [['本周工作进展', ['完成新版首页，经过两轮设计沟通，于周四上线。', '处理 3 个用户反馈，推进使用体验优化。']], ['下周工作计划', ['跟进新版首页上线后的数据表现。', '继续优化注册流程。']]] },
+      email: { original: '你好，上周说好的方案怎么还没发？我们这边一直在等，后面的工作都没法做了。今天能不能给一下？', tone: '礼貌 · 有分寸', sections: [['主题：确认方案进展与交付时间', ['你好，想跟进一下上周沟通的方案进展。我们需要根据方案安排后续工作，想请你协助确认一下。']], ['烦请协助确认', ['方便今天发来方案吗？如时间上有困难，也请告知预计交付时间，便于我们调整安排。谢谢！']]] }
+    };
+    const tabs = [...document.querySelectorAll('[data-mode]')];
+    function selectMode(mode) {
+      const sample = samples[mode];
+      tabs.forEach(tab => { const active = tab.dataset.mode === mode; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
+      document.getElementById('sample-panel').setAttribute('aria-labelledby', 'tab-' + mode);
+      document.getElementById('original-text').textContent = sample.original;
+      document.getElementById('tone-label').textContent = sample.tone;
