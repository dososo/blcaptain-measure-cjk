+          <div class="actions"><span class="privacy"><svg><use href="#shield"/></svg>你的反馈与个人信息将受到保护</span><button class="submit" type="submit">提交反馈<svg><use href="#arrow"/></svg></button></div>
+          <p class="error" id="form-error" role="alert"></p>
+        </form>
+        <aside aria-label="反馈指南"><div class="aside-card"><div class="aside-label">BETTER, TOGETHER</div><h2>好的产品，<br>从倾听开始。</h2><p>你的每一次反馈，都是我们向前迈进的一小步。</p><div class="orbit" aria-hidden="true"></div><svg class="orbit-star" aria-hidden="true"><use href="#spark"/></svg></div><div class="guide"><h3><svg><use href="#bulb"/></svg>让反馈更有效的小提示</h3><div class="guide-row"><span class="number">1</span><div><h4>描述具体一点</h4><p>告诉我们发生问题的页面和操作步骤，帮助我们快速定位。</p></div></div><div class="guide-row"><span class="number">2</span><div><h4>一张截图，胜过千言</h4><p>附上相关截图，让问题更直观。记得遮盖图片中的敏感信息。</p></div></div><div class="guide-row"><span class="number">3</span><div><h4>分享你的期待</h4><p>你希望它如何改进？你的使用场景和想法，对我们很有帮助。</p></div></div><div class="thanks"><svg><use href="#heart"/></svg>感谢你花时间，和我们一起打磨产品。</div></div></aside>
+      </div>
+      <footer class="page-footer"><span>© 2026 unto. 为每一个更好的体验。</span><span>预览演示 · 提交内容不会发送<svg><use href="#spark"/></svg></span></footer>
+    </main>
+  </div>
+  <dialog id="success-dialog" aria-labelledby="success-title"><div class="success-icon"><svg><use href="#check"/></svg></div><h2 id="success-title">感谢你的声音</h2><p>本次反馈已完成演示提交。<br>这是一个预览表单，内容不会发送至服务器。</p><button class="submit" id="close-dialog" type="button">返回表单<svg><use href="#arrow"/></svg></button></dialog>
+  <script>
+    const form = document.getElementById('feedback-form');
+    const description = document.getElementById('description');
+    const fileInput = document.getElementById('screenshots');
+    const dropzone = document.getElementById('dropzone');
+    const uploadError = document.getElementById('upload-error');
+    const formError = document.getElementById('form-error');
+    const previews = document.getElementById('previews');
+    const dialog = document.getElementById('success-dialog');
+    let attachments = [];
+    let processing = 0;
+    function showError(element, message) { element.textContent = message; element.classList.toggle('visible', !!message); }
+    description.addEventListener('input', () => { document.getElementById('count').textContent = description.value.length; description.setCustomValidity(''); showError(formError, ''); });
+    function renderImages() {
+      previews.replaceChildren();
+      document.getElementById('image-count').textContent = attachments.length;
+      attachments.forEach(item => {
+        const wrap = document.createElement('div'); wrap.className = 'preview';
+        const img = document.createElement('img'); img.src = item.url; img.alt = item.file.name;
+        const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'remove'; remove.setAttribute('aria-label', '移除 ' + item.file.name);
+        remove.innerHTML = '<svg aria-hidden="true"><use href="#close"/></svg>';
+        remove.addEventListener('click', () => { URL.revokeObjectURL(item.url); attachments = attachments.filter(image => image !== item); renderImages(); fileInput.focus(); });
+        wrap.append(img, remove); previews.append(wrap);
+      });
+    }
+    async function addFiles(files) {
+      const messages = [];
+      processing++;
+      for (const file of files) {
+        if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) { messages.push('请选择 PNG、JPG 或 WebP 格式的图片。'); continue; }
+        if (file.size > 10 * 1024 * 1024) { messages.push('图片不能超过 10 MB，请压缩后重试。'); continue; }
+        if (attachments.some(item => item.file.name === file.name && item.file.size === file.size && item.file.lastModified === file.lastModified)) { messages.push('这张图片已经添加过了。'); continue; }
+        const url = URL.createObjectURL(file);
+        const valid = await new Promise(resolve => { const image = new Image(); image.onload = () => resolve(true); image.onerror = () => resolve(false); image.src = url; });
+        if (!valid) { URL.revokeObjectURL(url); messages.push('有图片无法读取，请选择有效的图片文件。'); continue; }
+        if (attachments.length >= 3) { URL.revokeObjectURL(url); messages.push('最多添加 3 张截图，请移除已有截图后再试。'); continue; }
+        attachments.push({file, url}); renderImages();
+      }
+      processing--;
+      showError(uploadError, [...new Set(messages)].join(' '));
+    }
+    fileInput.addEventListener('change', () => { const files = Array.from(fileInput.files); fileInput.value = ''; addFiles(files); });
+    let dragDepth = 0;
+    dropzone.addEventListener('dragenter', event => { event.preventDefault(); dragDepth++; dropzone.classList.add('dragging'); });
+    dropzone.addEventListener('dragover', event => { event.preventDefault(); event.dataTransfer.dropEffect = 'copy'; });
+    dropzone.addEventListener('dragleave', () => { dragDepth--; if (dragDepth <= 0) dropzone.classList.remove('dragging'); });
+    dropzone.addEventListener('drop', event => { event.preventDefault(); dragDepth = 0; dropzone.classList.remove('dragging'); addFiles(Array.from(event.dataTransfer.files)); });
+    window.addEventListener('dragover', event => { if (event.dataTransfer.types.includes('Files')) event.preventDefault(); });
+    window.addEventListener('drop', event => { if (event.dataTransfer.types.includes('Files')) event.preventDefault(); });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      if (!description.value.trim()) { description.setCustomValidity('请填写具体的问题描述或建议。'); description.reportValidity(); return; }
+      if (processing) { showError(formError, '图片正在处理中，请稍后再提交。'); return; }
+      showError(formError, ''); dialog.showModal();
+    });
+    document.getElementById('close-dialog').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('click', event => { if (event.target === dialog) { const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); } });
+    window.addEventListener('pagehide', () => attachments.forEach(item => URL.revokeObjectURL(item.url)));
+  </script>
+</body>
+</html>

