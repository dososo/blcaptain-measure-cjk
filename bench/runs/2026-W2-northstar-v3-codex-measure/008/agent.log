+@media(max-width:480px){.site-header{padding:18px 20px}main,.site-footer{margin-left:20px;margin-right:20px}.brand{font-size:16px}.article-header{margin-top:32px}.eyebrow{font-size:12px;gap:10px;letter-spacing:1px}.eyebrow-line{width:20px}.category{padding:4px 8px;letter-spacing:1px}h1{font-size:39px;letter-spacing:1px;margin-top:24px}.dek{font-size:15px;line-height:1.9}.duration{display:none}.byline{font-size:12px;row-gap:9px;margin-top:23px}.byline>span+span:before{margin:0 9px}.byline .fiction-note{width:100%;margin-left:0}.hero{margin-left:-20px;margin-right:-20px}.hero svg{aspect-ratio:1.6}.hero figcaption{padding:12px 20px}.contents nav{font-size:12px;column-gap:12px;padding-left:12px}.contents nav a span{margin-right:7px}.prose{font-size:16px}.section-heading{gap:12px;margin-top:37px}h2{font-size:23px;letter-spacing:0}.prose blockquote{padding:20px;font-size:19px}.quote-break{display:none}.closing-strip{align-items:flex-start}.closing-strip p{max-width:13em;font-size:15px}.closing-strip a{padding-top:3px}.site-footer{font-size:12px;gap:12px}}
+@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
+@media print{body{background:white}.site-header,.contents,.header-link,.closing-strip,.skip-link{display:none}.article-header{margin-top:0}.reading-layout{display:block}.prose{max-width:36em;margin:auto}.hero svg{max-height:260px}.section-heading{break-after:avoid}.site-footer{padding-bottom:0}}

