+    let guests = 2;
+    const weekdays = ['周日','周一','周二','周三','周四','周五','周六'];
+    const times = ['17:30','18:00','18:30','19:00','19:30','20:00','20:30','21:00'];
+    function readableDate(value){ if(!value) return '请选择日期'; const d = new Date(value+'T00:00:00'); return `${d.getMonth()+1}月${d.getDate()}日 ${weekdays[d.getDay()]}`; }
