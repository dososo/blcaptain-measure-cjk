s a:hover, .nav-links .active { color: var(--fg); }\n@media (max-width: 640px) { .nav-links { display: none; } .nav-inner { justify-content: space-between; } }\n\n/* Hero */\n.hero { text-align: center; padding-block: 72px 40px; }\n.eyebrow { display: inline-block; padding: 4px 12px; border-radius: 99px; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 600; }\n.hero h1 { font-size: clamp(28px, 5vw, 44px); line-height: 1.2; margin: 16px 0 12px; letter-spacing: -.02em; }\n.sub { color: var(--muted); max-width: 560px; margin: 0 auto; }\n\n.billing { display: inline-flex; margin-top: 32px; padding: 4px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); }\n.billing-opt { border: 0; background: none; color: var(--muted); font: inherit; font-weight: 600; padding: 8px 18px; border-radius: 99px; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: .2s; }\n.billing-opt.is-active { background: var(--fg); color: var(--bg); }\n.save { font-size: 11px; padding: 2px 6px; border-radius: 6px; background: var(--accent-2); color: #fff; }\n\n/* Plans */\n.plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; padding-bottom: 80px; }\n@media (max-width: 900px) { .plans { grid-template-columns: 1fr; max-width: 460px; } }\n.plan { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px 28px; box-shadow: var(--shadow); display: flex; flex-direction: column; min-width: 0; }\n.plan-featured { border: 2px solid var(--accent); transform: translateY(-8px); }\n@media (max-width: 900px) { .plan-featured { transform: none; } }\n.badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 12px; font-weight: 700; padding: 4px 14px; border-radius: 99px; white-space: nowrap; }\n.plan h2 { margin: 0; 