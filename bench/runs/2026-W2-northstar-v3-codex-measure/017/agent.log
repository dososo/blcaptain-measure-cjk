/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import re
p=Path('style.css')
s=p.read_text()
s=re.sub(r'font-size:(?:[7-9]|10|11)px', 'font-size:12px', s)
s=s.replace('font-family:ui-monospace,monospace', 'font-family:ui-monospace,\"PingFang SC\",\"Microsoft YaHei\",monospace')
