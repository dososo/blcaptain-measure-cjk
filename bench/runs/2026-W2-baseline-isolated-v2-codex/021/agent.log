+</div>
+<script>
+const form = document.getElementById('signup-form');
+const city = document.getElementById('city');
+const otherCity = document.getElementById('other-city');
+const confirmation = document.getElementById('confirmation');
+const error = document.getElementById('form-error');
+city.addEventListener('change', () => {
+  const isOther = city.value === 'other';
+  document.getElementById('other-city-field').hidden = !isOther;
+  otherCity.disabled = !isOther;
+  otherCity.required = isOther;
+  if (isOther) otherCity.focus();
+});
+form.addEventListener('input', () => { error.textContent = ''; });
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  const name = document.getElementById('name').value.trim();
+  const selectedCity = city.value === 'other' ? otherCity.value.trim() : city.value;
+  if (!name || !selectedCity) {
+    error.textContent = !name ? '请输入有效姓名，不能仅填写空格。' : '请输入有效的城市名称。';
+    (!name ? document.getElementById('name') : otherCity).focus();
+    return;
+  }
+  const data = new FormData(form);
+  const summary = document.getElementById('summary');
+  summary.replaceChildren();
+  [['姓名', name], ['手机号', data.get('phone')], ['所在城市', selectedCity], ['参加场次', data.get('session')]].forEach(([label, value]) => {
+    const row = document.createElement('div');
+    const term = document.createElement('dt');
+    const detail = document.createElement('dd');
+    term.textContent = label;
+    detail.textContent = value;
+    row.append(term, detail);
+    summary.append(row);
+  });
+  form.hidden = true;
+  confirmation.hidden = false;
+  confirmation.focus();
+});
+document.getElementById('edit-button').addEventListener('click', () => {
+  confirmation.hidden = true;
+  form.hidden = false;
+  document.getElementById('name').focus();
+});
+window.addEventListener('pageshow', () => {
+  form.reset();
+  otherCity.disabled = true;
+  otherCity.required = false;
+  document.getElementById('other-city-field').hidden = true;
+  document.getElementById('summary').replaceChildren();
+  confirmation.hidden = true;
+  form.hidden = false;
+  error.textContent = '';
+});
+</script>
+</body>
+</html>

