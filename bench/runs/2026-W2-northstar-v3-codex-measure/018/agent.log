from pathlib import Path
class PageCheck(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.styles=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a': self.links.append(a.get('href',''))
        if tag=='link' and a.get('rel')=='stylesheet': self.styles.append(a['href'])
p=PageCheck(); p.feed(Path('index.html').read_text())
assert len(p.ids)==len(set(p.ids)), 'Duplicate IDs'
assert all(x[1:] in p.ids for x in p.links if x.startswith('#')), 'Broken anchor'
assert all(Path(x).is_file() for x in p.styles), 'Missing CSS'
