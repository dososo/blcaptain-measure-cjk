%, transparent 61%),\n      radial-gradient(70cqw 22cqw at 85% 100%, #ebf0e6 60%, transparent 61%);\n    z-index: 0;\n  }\n  .card > * { position: relative; z-index: 1; }\n\n  .top {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 2.6cqw;\n    color: var(--muted);\n    letter-spacing: .1em;\n  }\n  .tag {\n    background: var(--green);\n    color: #fff;\n    padding: .6cqw 2cqw;\n    border-radius: 99px;\n    letter-spacing: .05em;\n  }\n\n  h1 {\n    margin-top: 4cqw;\n    font-size: 8.6cqw;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: .02em;\n  }\n  h1 em {\n    font-style: normal;\n    color: var(--green);\n    background: linear-gradient(transparent 62%, var(--orange-soft) 62%);\n  }\n  .sub {\n    margin-top: 2cqw;\n    font-size: 3.1cqw;\n    color: var(--muted);\n  }\n\n  .days {\n    margin-top: 3.6cqw;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 3cqw;\n    flex: 1;\n    min-height: 0;\n  }\n  .day {\n    background: #fff;\n    border: .3cqw solid var(--line);\n    border-radius: 2.4cqw;\n    padding: 3.2cqw 3cqw;\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n  }\n  .day-head {\n    display: flex;\n    align-items: baseline;\n    gap: 1.5cqw;\n    padding-bottom: 2cqw;\n    border-bottom: .3cqw dashed var(--line);\n  }\n  .day-num {\n    font-size: 5.4cqw;\n    font-weight: 800;\n    color: var(--green);\n  }\n  .day:nth-child(2) .day-num { color: var(--orange); }\n  .day-theme { font-size: 2.8cqw; color: var(--muted); }\n\n  .stops { list-style: none; margin-top: 2.2cqw; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }\n  .stop {\n    position: relative;\n    padding-left: 3.6cqw;\n  }\n  .stop::before {\n    content: \"\";\n    position: absolute;\n    left: 0; top: 1.3cqw;\n    width: 1.6cqw; height: 1.6cqw;\n    border-radius: 50%;\n    background: var(--green);\n  }\n  .stop::after {\n    content: \"\";\n    position: absolute;\n    left: .65cqw; top: 3.4cqw; bottom: -2.4cqw;\n    border-left: .3cqw dotted #b9c7b6;\n  }\n  .stop:last-child::after { display: none; }\n  .day:nth-child(2) .stop::before { background: var(--orange); }\n  .day:nth-child(2) .stop::after { border-color: #e8bfa9; }\n\n  .time { font-size: 2.3cqw; color: var(--muted); letter-spacing: .05em; }\n  .place { font-size: 3.1cqw; font-weight: 700; line-height: 1.35; }\n  .note { font-size: 2.4cqw; color: #5d5950; line-height: 1.45; margin-top: .3cqw; }\n\n  .tips {\n    margin-top: 3.2cqw;\n    background: var(--green-soft);\n    border-radius: 2.4cqw;\n    padding: 2.8cqw 3.4cqw;\n    font-size: 2.55cqw;\n    line-height: 1.6;\n  }\n  .tips b { color: var(--green); }\n  .tips ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: .4cqw 3cqw; margin-top: .8cqw; }\n  .tips li::before { content: \"· \"; color: var(--green); font-weight: 700; }\n\n  .foot {\n    margin-top: 2.8cqw;\n    display: flex;\n    justify-content: space-between;\n    font-size: 2.4cqw;\n    color: var(--muted);\n  }\n  .foot span:last-child { color: var(--orange); font-weight: 600; }\n</style>\n</head>\n<body>\n  <article class=\"card\">\n    <div class=\"top\">\n      <span>WEEKEND · HANGZHOU</span>\n      <span class=\"tag\">收藏备用</span>\n    </div>\n\n    <h1>周末去<em>杭州</em><br>两天一夜这样走</h1>\n    <p class=\"sub\">不赶路 · 不踩坑 · 人均约 ¥800（不含往返交通）</p>\n\n    <section class=\"days\">\n      <div class=\"day\">\n        <div class=\"day-head\">\n          <span class=\"day-num\">DAY 1</span>\n          <span class=\"day-theme\">湖光与古寺</span>\n        </div>\n        <ul class=\"stops\">\n          <li class=\"stop\">\n            <div class=\"time\">08:30</div>\n            <div class=\"place\">断桥 → 白堤 → 孤山</div>\n            <div class=\"note\">早去人少，沿湖慢走</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">12:00</div>\n            <div class=\"place\">湖滨午饭</div>\n            <div class=\"note\">西湖醋鱼、东坡肉、片儿川</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">14:00</div>\n            <div class=\"place\">灵隐寺 · 飞来峰</div>\n            <div class=\"note\">看石窟造像，留足 3 小时</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">18:30</div>\n            <div class=\"place\">南宋御街 · 湖滨夜景</div>\n            <div class=\"note\">住湖滨一带，步行可达</div>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"day\">\n        <div class=\"day-head\">\n          <span class=\"day-num\">DAY 2</span>\n          <span class=\"day-theme\">茶山与老街</span>\n        </div>\n        <ul class=\"stops\">\n          <li class=\"stop\">\n            <div class=\"time\">08:30</div>\n            <div class=\"place\">九溪十八涧</div>\n            <div class=\"note\">溪水山径，徒步约 1.5 小时</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">11:30</div>\n            <div class=\"place\">龙井村喝茶吃饭</div>\n            <div class=\"note\">龙井虾仁 + 一杯现泡龙井</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">14:00</div>\n            <div class=\"place\">苏堤南段 · 花港观鱼</div>\n            <div class=\"note\">骑共享单车穿过苏堤</div>\n          </li>\n          <li class=\"stop\">\n            <div class=\"time\">16:30</div>\n            <div class=\"place\">小河直街 · 拱宸桥</div>\n            <div class=\"note\">运河边老街，逛完去东站返程</div>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <div class=\"tips\">\n      <b>📌 小贴士</b>\n      <ul>\n        <li>西湖周边周末限行，地铁最方便</li>\n        <li>穿好走的鞋，日均 2 万步+</li>\n        <li>灵隐、飞来峰门票分开购买</li>\n        <li>龙井茶认准正规茶庄再买</li>\n      </ul>\n    </div>\n\n    <div class=\"foot\">\n      <span>#杭州旅行 #周末去哪儿 #西湖</span>\n      <span>❤️ 点赞收藏不迷路</span>\n    </div>\n  </article>\n</body>\n</html>\n","structuredPatch":[{"oldStart":201,"oldLines":7,"newStart":201,"newLines":7,"lines":["           <li class=\"stop\">","             <div class