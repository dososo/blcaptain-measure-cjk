入有效的邮箱或手机号</p>\n    </div>\n\n    <button type=\"submit\" class=\"submit\" id=\"submitBtn\">提交反馈</button>\n  </form>\n\n  <section class=\"card done\" id=\"done\" hidden>\n    <div class=\"check\">✓</div>\n    <h2>提交成功，感谢你的反馈！</h2>\n    <p>我们会在 1–3 个工作日内处理，如有需要会通过你留下的联系方式与你沟通。</p>\n    <button type=\"button\" class=\"ghost\" id=\"again\">再提交一条</button>\n  </section>\n</main>\n\n<script>\n(function () {\n  const MAX_FILES = 5, MAX_SIZE = 5 * 1024 * 1024;\n  const form = document.getElementById('feedback');\n  const desc = document.getElementById('desc');\n  const descCount = document.getElementById('descCount');\n  const fileInput = document.getElementById('file');\n  const drop = document.getElementById('drop');\n  const thumbs = document.getElementById('thumbs');\n  const fileError = document.getElementById('fileError');\n  const contact = document.getElementById('contact');\n  const submitBtn = document.getElementById('submitBtn');\n  const done = document.getElementById('done');\n  let files = []; // { file, url }\n\n  desc.addEventListener('input', () => {\n    descCount.textContent = desc.value.length;\n    if (desc.value.trim().length >= 10) toggle('descError', false, desc);\n  });\n  form.addEventListener('change', e => {\n    if (e.target.name === 'type') toggle('typeError', false);\n  });\n\n  function toggle(id, show, input) {\n    document.getElementById(id).hidden = !show;\n    if (input) input.classList.toggle('invalid', show);\n  }\n\n  function addFiles(list) {\n    const msgs = [];\n    for (const f of list) {\n      if (!f.type.startsWith('image/')) { msgs.push(`「${f.name}」不是图片`); continue; }\n      if (f.size > MAX_SIZE) { msgs.push(`「${f.name}」超过 5MB`); continue; }\n      if (files.length >= MAX_FILES) { msgs.push(`最多上传 ${MAX_FILES} 张`); break; }\n      files.push({ file: f, url: URL.createObjectURL(f) });\n    }\n    fileError.textContent = msgs.join('；');\n    fileError.hidden = !msgs.length;\n    render();\n  }\n\n  function render() {\n    thumbs.innerHTML = '';\n    files.forEach((item, i) => {\n      const li = document.createElement('li');\n      li.className = 'thumb';\n      const img = document.createElement('img');\n      img.src = item.url; img.alt = item.file.name;\n      const btn = document.createElement('button');\n      btn.type = 'button'; btn.className = 'remove'; btn.setAttribute('aria-label', '删除图片'); btn.textContent = '×';\n      btn.onclick = () => { URL.revokeObjectURL(item.url); files.splice(i, 1); fileError.hidden = true; render(); };\n      li.append(img, btn);\n      thumbs.appendChild(li);\n    });\n    drop.hidden = files.length >= MAX_FILES;\n  }\n\n  fileInput.addEventListener('change', () => { addFiles(fileInput.files); fileInput.value = ''; });\n  drop.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });\n  ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));\n  ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));\n  drop.addEventListener('drop', e => addFiles(e.dataTransfer.files));\n  document.addEventListener('paste', e => {\n    const imgs = [...(e.clipboardData?.files || [])].filter(f => f.type.startsWith('image/'));\n    if (imgs.length) { e.preventDefault(); addFiles(imgs); }\n  });\n\n  form.addEventListener('submit', async e => {\n    e.preventDefault();\n    const type = form.querySelector('input[name=\"type\"]:checked');\n    const c = contact.value.trim();\n    const contactOk = !c || /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(c) || /^1\\d{10}$/.test(c);\n    const descOk = desc.value.trim().length >= 10;\n\n    toggle('typeError', !type);\n    toggle('descError', !descOk, desc);\n    toggle('contactError', !contactOk, contact);\n    if (!type || !descOk || !contactOk) {\n      form.querySelector('.error:not([hidden])')?.closest('.field')?.scrollIntoView({ behavior: 'smooth', block: 'center' });\n      return;\n    }\n\n    const data = new FormData();\n    data.append('type', type.value);\n    data.append('description', desc.value.trim());\n    data.append('contact', c);\n    files.forEach(f => data.append('screenshots', f.file));\n\n    submitBtn.disabled = true;\n    submitBtn.textContent = '提交中…';\n    // TODO: 替换为真实接口，例如 await fetch('/api/feedback', { method: 'POST', body: data })\n    await new Promise(r => setTimeout(r, 800));\n    submitBtn.disabled = false;\n    submitBtn.textContent = '提交反馈';\n    form.hidden = true;\n    done.hidden = false;\n  });\n\n  document.getElementById('again').addEventListener('click', () => {\n    form.reset();\n    files.forEach(f => URL.revokeObjectURL(f.url));\n    files = []; render();\n    descCount.textContent = '0';\n    done.hidden = true;\n    form.hidden = false;\n  });\n})();\n</script>\n</body>\n</html>\n"}}}
