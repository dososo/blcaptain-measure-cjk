/bin/zsh -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.stack=[]
    def handle_starttag(self,tag,attrs):
        attrs=dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if tag=='a': self.links.append(attrs.get('href',''))
        if tag not in {'meta','br','path','circle','ellipse','rect','line','polyline','polygon','stop','input','img','link','hr'}: self.stack.append(tag)
    def handle_endtag(self,tag):
        if tag in {'path','circle','ellipse','rect','line','polyline','polygon','stop'}: return
        assert self.stack and self.stack.pop()==tag, f'标签不匹配：{tag}'
p=Path('index.html'); source=p.read_text(); c=Check(); c.feed(source)
assert not c.stack, c.stack
assert len(c.ids)==len(set(c.ids)), '重复标识'
assert all(h[1:] in c.ids for h in c.links if h.startswith('#')), '锚点缺失'
assert 'tel:01000000000' in c.links
assert '科室' in source and '医生团队' in source and '预约' in source
