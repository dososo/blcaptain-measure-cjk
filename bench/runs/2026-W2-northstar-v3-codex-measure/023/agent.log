+    const fields = ['frequency', 'duration', 'transport', 'distance', 'departure', 'satisfaction'];
+    const titles = ['每周通勤频率', '单程通勤时间', '交通方式', '单程通勤距离', '通常出发时间', '通勤满意度'];
+    const transport = [...form.querySelectorAll('[name="transport"]')];
+    let answers = [];
+    function updateProgress() {
+      const data = new FormData(form);
+      const count = fields.filter(key => data.getAll(key).some(Boolean)).length;
+      document.querySelector('#progress').value = count;
+      document.querySelector('#progress-text').textContent = `已完成 ${count} / 6`;
+      transport[0].setCustomValidity(data.getAll('transport').length ? '' : '请至少选择一种交通方式，或选择“不适用”。');
+    }
+    form.addEventListener('change', event => {
+      if (event.target.name === 'transport' && event.target.checked) {
+        transport.forEach(input => {
+          if (input !== event.target && (event.target.value === '不适用' || input.value === '不适用')) input.checked = false;
+        });
+      }
+      updateProgress();
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      updateProgress();
+      if (!form.reportValidity()) return;
+      const data = new FormData(form);
+      answers = fields.map((key, index) => ({question: titles[index], answer: data.getAll(key).join('、')}));
+      const list = document.querySelector('#result-list');
+      list.replaceChildren();
+      answers.forEach(({question, answer}) => {
+        const row = document.createElement('div');
+        const label = document.createElement('dt');
+        const value = document.createElement('dd');
+        label.textContent = question;
+        value.textContent = answer;
+        row.append(label, value);
+        list.append(row);
+      });
+      form.hidden = true;
+      document.querySelector('#result').hidden = false;
+      document.querySelector('#result-title').focus();
+    });
+    document.querySelector('#edit').addEventListener('click', () => {
+      document.querySelector('#result').hidden = true;
+      form.hidden = false;
+      form.querySelector('input').focus();
+    });
+    document.querySelector('#download').addEventListener('click', () => {
+      const text = '通勤之间 · 我的通勤记录\n\n' + answers.map(({question, answer}, index) => `${index + 1}. ${question}\n${answer}`).join('\n\n');
+      const url = URL.createObjectURL(new Blob(['\ufeff' + text], {type: 'text/plain;charset=utf-8'}));
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = '我的通勤记录.txt';
+      document.body.append(link);
+      link.click();
+      link.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+    });
+    updateProgress();
+  </script>
+</body>
+</html>
