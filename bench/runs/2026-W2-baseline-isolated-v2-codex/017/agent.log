from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.targets=[]; self.stack=[]; self.errors=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if a.get('href','').startswith('#'): self.targets.append(a['href'][1:])
        if 'data-copy' in a: self.targets.append(a['data-copy'])
        if tag not in {'meta','link','br','hr','img','input','source','area','base','embed','param','track','wbr'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        if not self.stack or self.stack[-1]"'!=tag: self.errors.append(tag)
        else: self.stack.pop()
p=Path('"'index.html'); content=p.read_text(); c=Check(); c.feed(content)
assert len(c.ids)==len(set(c.ids)), 'Duplicate ids'
assert all(t in c.ids for t in c.targets), 'Missing anchor target'
assert not c.errors and not c.stack, (c.errors,c.stack)
