--accent);\n  color: var(--accent-ink);\n  display: grid;\n  place-items: center;\n  font-size: 0.9rem;\n}\n.nav { display: flex; align-items: center; gap: 1.5rem; }\n.nav a { text-decoration: none; color: var(--muted); font-size: 0.95rem; }\n.nav a:hover { color: var(--fg); }\n\n.btn {\n  display: inline-block;\n  border: 0;\n  border-radius: 8px;\n  padding: 0.7rem 1.25rem;\n  font: inherit;\n  font-weight: 600;\n  text-decoration: none;\n  cursor: pointer;\n}\n.btn-primary { background: var(--accent); color: var(--accent-ink); }\n.btn-primary:hover { filter: brightness(1.08); }\n.btn-ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); }\n.btn-small { padding: 0.45rem 0.95rem; font-size: 0.95rem; }\n\n/* 首屏 */\n.hero { padding-block: 4.5rem 3.5rem; }\n.hero-grid {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 3rem;\n  align-items: center;\n}\n.hero-grid > * { min-width: 0; }\n.hero h1 {\n  font-size: clamp(2rem, 4.6vw, 3rem);\n  letter-spacing: 0.02em;\n  margin: 0 0 1.25rem;\n}\n.hero .lead {\n  font-size: 1.125rem;\n  color: var(--muted);\n  max-width: 30em;\n  margin: 0 0 2rem;\n}\n.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }\n.hero-note { color: var(--muted); font-size: 0.875rem; margin: 1rem 0 0; }\n\n/* 首屏右侧：账目示意 */\n.ledger {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  padding: 1.25rem;\n  font-size: 0.95rem;\n}\n.ledger-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin-bottom: 1rem;\n}\n.ledger-head strong { font-size: 1rem; }\n.ledger-head span { color: var(--muted); font-size: 0.875rem; }\n.ledger table { width: 100%; border-collapse: collapse; }\n.ledger td {\n  padding: 0.6rem 0;\n  border-top: 1px solid var(--line);\n  vertical-align: top;\n}\n.ledger td:last-child { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.ledger .who { color: var(--m