+      if(language==='javascript') return `const response = await fetch('${url}', {\n  method: '${e.method}',\n  headers: {\n    Authorization: 'Bearer YOUR_API_TOKEN',\n    Accept: 'application/json'${e.body?",\n    'Content-Type': 'application/json'":''}\n  }${e.body?',\n  body: JSON.stringify('+JSON.stringify(e.body)+')':''}\n});\nconst data = await response.json();\nif (!response.ok) throw new Error(data.error.message);\nconsole.log(data);`;
+      return `curl --request ${e.method} \\\n  '${url}' \\\n  --header 'Authorization: Bearer YOUR_API_TOKEN' \\\n  --header 'Accept: application/json'${e.body?" \\\n  --header 'Content-Type: application/json' \\\n  --data '"+JSON.stringify(e.body)+"'":''}`;
+    }
+    document.querySelector('#endpoint-details').innerHTML=endpoints.map((e,i)=>`<section class="doc-section endpoint-detail observed" id="${e.id}"><div class="endpoint-kicker">USERS <span>/</span> 0${i+1}</div><div class="section-heading"><h2>${e.title}</h2><a class="anchor-link" href="#${e.id}" aria-label="链接到${e.title}">#</a></div><p class="measure-prose">${e.desc}</p><div class="route-line"><span class="method ${e.method.toLowerCase()}">${e.method}</span><code>${e.path}</code><span class="scope">权限：<code>${e.scope}</code></span></div><div class="two-column"><div>${e.method==='PATCH'?'<h3>路径参数</h3><div class="path-description"><code>user_id</code><span class="required">必填</span><p>用户的唯一标识，类型为 string。</p></div>':''}<h3>${e.paramTitle}</h3><div class="parameters">${e.params.map(p=>`<div class="parameter"><div><code>${p[0]}</code><span class="param-type">${p[1]}</span><span class="${p[2]==='必填'?'required':'optional'}">${p[2]}</span></div><p>${p[3]}</p></div>`).join('')}</div>${e.method==='PATCH'?'<p class="small-description">至少提交一个字段；不接受 null 值及未知字段。</p>':e.method==='POST'?'<p class="small-description">不接受 null 值及未知字段。</p>':''}<h3 class="response-title">响应说明 <span class="success-status">${e.status}</span></h3><p class="measure-prose">${e.responseNote}</p><div class="schema-note"><strong>用户对象</strong><p><code>id</code> 为唯一标识，<code>name</code> 为名称，<code>email</code> 为邮箱；以上字段均为字符串。<code>created_at</code> 与 <code>updated_at</code> 为 UTC 时间字符串。</p></div><p class="small-description">可能的错误：<a href="#errors">${e.errors}</a>。</p></div><div class="examples"><div class="code-panel"><div class="code-toolbar"><div class="code-tabs" role="group" aria-label="${e.title}示例语言"><button class="code-tab selected" aria-pressed="true" data-id="${e.id}" data-language="curl">cURL</button><button class="code-tab" aria-pressed="false" data-id="${e.id}" data-language="javascript">JavaScript</button></div><button class="copy code-copy" data-target="request-${e.id}">复制 <span aria-hidden="true">⧉</span></button></div><pre id="request-${e.id}"><code>${escapeHTML(requestCode(e,'curl'))}</code></pre></div><div class="code-panel response-panel"><div class="code-toolbar"><span>响应示例</span><span class="success-status"><span class="status-dot"></span>${e.status}</span><button class="copy code-copy" data-target="response-${e.id}" aria-label="复制${e.title}响应">⧉</button></div><pre id="response-${e.id}"><code>${highlight(e.response)}</code></pre></div></div></div></section>`).join('');
+    let toastTimer;
+    function notify(message){const toast=document.querySelector('#toast');toast.textContent=message;toast.classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('visible'),2400);}
+    async function copyText(value){try{if(navigator.clipboard && window.isSecureContext){await navigator.clipboard.writeText(value);}else{const field=document.createElement('textarea');field.value=value;field.style.position='fixed';field.style.opacity='0';document.body.append(field);field.select();const ok=document.execCommand('copy');field.remove();if(!ok)throw Error('copy');}notify('已复制到剪贴板');}catch{notify('复制失败，请选中代码后手动复制');}}
