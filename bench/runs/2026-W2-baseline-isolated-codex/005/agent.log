from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.links=[]; self.images=0
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.add(a['id'])
        if tag=='a' and a.get('href','').startswith('#') and len(a['href'])>1: self.links.append(a['href'][1:])
        if tag=='img':
            assert a.get('alt'), 'Missing image alt text'
            self.images+=1
p=Check(); p.feed(Path('index.html').read_text())
assert all(link in p.ids for link in p.links), 'Broken internal link'
css=Path('style.css').read_text()
assert css.count('{')==css.count('}'), 'Unbalanced CSS'
print(f'Checked index.html and style.css: internal links valid, {p.images} images have alt text, CSS braces balanced.')
