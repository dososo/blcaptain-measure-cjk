+.care-strip>div:last-child { border: 0; }
+.strip-symbol { color: #6e825e; font-size: 30px; font-weight: 400; }
+.care-strip strong { display: block; font-size: 15px; font-weight: 600; }
+.care-strip small { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
+.section { padding-top: 78px; padding-bottom: 78px; }
