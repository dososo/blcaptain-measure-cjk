from pathlib import Path
from html.parser import HTMLParser
import ast
p=Path('index.html')
s=p.read_text()
s=s.replace(\"+'\\\\n\\\\nprint(f\\\"报表已生成：{workspace / chr(26376)}\\\")\\\\n';const finalCode=code.replace('print(f\\\"报表已生成：{workspace / chr(26376)}\\\")','print(\\\"报表已生成：\\\", workspace / \\\"月度销售报表.xlsx\\\")');\", \"+'\\\\n\\\\nprint(\\\"报表已生成：\\\", workspace / \\\"月度销售报表.xlsx\\\")\\\\n';\")
s=s.replace('new Blob([finalCode]', 'new Blob([code]')
p.write_text(s)
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.targets=[]; self.codes=[]; self.in_pre=False; self.in_script=False; self.js=''
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a' and a.get('href','').startswith('#'): self.targets.append(a['href'][1:])
        if tag=='pre': self.in_pre=True; self.codes.append('')
        if tag=='script': self.in_script=True
    def handle_endtag(self, tag):
        if tag=='pre': self.in_pre=False
        if tag=='script': self.in_script=False
    def handle_data(self,data):
        if self.in_pre: self.codes[-1]+=data
        if self.in_script: self.js+=data
c=Check();c.feed(s)
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert all(t in c.ids for t in c.targets), 'Missing anchor target'
assert len(c.codes)==5
ast.parse('\\n\\n'.join(c.codes))
Path('/tmp/stack-notes-check.js').write_text(c.js)
