lg\">免费开始使用</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">© 2026 妙笔 AI 写作助手 · 让每一次表达都恰到好处</div>\n  </footer>\n\n  <script>\n    const samples = {\n      report: {\n        before: `这周干的事：\n- 弄了下登录页面\n- 开了好几个会\n- 修了一些bug\n- 跟设计对了下需求\n- 下周继续做支付那块`,\n        after: `<strong>【本周进展】</strong>\n1. 完成登录页改版上线，页面加载时间由 2.1s 降至 1.2s\n2. 修复线上缺陷 8 个，其中 P1 级 2 个，崩溃率下降 15%\n3. 与设计团队完成支付模块需求评审，确认交互方案\n\n<strong>【风险与问题】</strong>\n支付接口文档尚未确定，可能影响联调排期\n\n<strong>【下周计划】</strong>\n推进支付模块开发，预计周四进入联调`,\n        chips: [\"结构化整理\", \"成果量化\", \"突出亮点\", \"补充风险\"]\n      },\n      email: {\n        before: `王总，那个方案我们做完了，你看下，有问题跟我说。另外上次说的预算的事情还没回复，麻烦快点，我们这边等着用。`,\n        after: `<strong>主题：</strong>Q4 推广方案已完成，烦请审阅及确认预算\n\n王总，您好：\n\nQ4 推广方案已完成，详见附件，烦请您在方便时审阅，如有修改意见我们会第一时间调整。\n\n另外，关于上次沟通的预算事宜，因涉及下周的物料采购排期，想请您在本周五前给予确认，以便我们按计划推进。\n\n感谢您的支持！\n\n祝好\n李明`,\n        chips: [\"对上级语气\", \"补全主题行\", \"说明原因\", \"明确截止时间\"]\n      },\n      decline: {\n        before: `这个需求我们这周做不了，人手不够，你们找别人吧。`,\n        after: `你好，感谢你们对我们团队的信任！\n\n本周我们正在全力保障版本上线，人力已经排满，如果现在接手，恐怕难以保证交付质量。\n\n建议两种方式供参考：\n1. 若时间允许，我们可在下周三后开始排期；\n2. 若比较紧急，可以先联系 B 组同事评估，我们可以协助提供相关背景资料。\n\n有任何需要随时找我～`,\n        chips: [\"委婉拒绝\", \"给出理由\", \"提供替代方案\", \"维护关系\"]\n      }\n    };\n\n    const beforeEl = document.getElementById(\"before\");\n    const afterEl = document.getElementById(\"after\");\n    const chipsEl = document.getElementById(\"chips\");\n    const tabs = document.querySelectorAll(\".tab\");\n\n    function show(key) {\n      const s = samples[key];\n      beforeEl.textContent = s.before;\n      afterEl.innerHTML = s.after;\n      chipsEl.innerHTML = s.chips.map(c => `<span class=\"chip\">${c}</span>`).join(\"\");\n      tabs.forEach(t => t.setAttribute(\"aria-selected\", t.dataset.key === key));\n    }\n\n    tabs.forEach(t => t.addEventListener(\"click\", () => show(t.dataset.key)));\n    show(\"report\");\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,