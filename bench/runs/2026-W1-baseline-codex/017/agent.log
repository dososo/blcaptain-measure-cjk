from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.stack=[]
    def handle_starttag(self,t,a):
        d=dict(a)
        if 'id' in d: self.ids.append(d['id'])
        if t=='a': self.links.append(d.get('href',''))
        if t not in {'meta','input','br','hr','img','link','wbr','source','area','base','embed','param','track','col'}: self.stack.append(t)
    def handle_endtag(self,t):
        assert self.stack and self.stack.pop()==t, f'标签不匹配: {t}'
p=Path('index.html'); s=p.read_text(); c=Check(); c.feed(s)
assert not c.stack
assert len(c.ids)==len(set(c.ids))
assert all(x[1:] in c.ids for x in c.links if x.startswith('#'))
assert 'https://' not in s and 'http://' not in s
assert all(x in s for x in ['分支命名','提交信息','代码评审流程','合并前'])
print(f'检查通过：HTML 标签闭合、{len(c.ids)} 个章节锚点、目录链接、核心内容和零外部依赖。文件大小：{p.stat().st_size} 字节。')
