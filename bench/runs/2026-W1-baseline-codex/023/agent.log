from html.parser import HTMLParser
from pathlib import Path
import re
class Check(HTMLParser):
 def __init__(self):
  super().__init__(); self.questions=0; self.groups=set(); self.required=set()
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if tag=='fieldset':self.questions+=1
  if tag=='input':
   self.groups.add(a['name'])
   if 'required' in a:self.required.add(a['name'])
p=Path('index.html');s=p.read_text();c=Check();c.feed(s)
assert c.questions==6 and len(c.groups)==6 and c.groups==c.required
assert not re.search(r'<(?:script|link)["'^>]+(?:src|href)=["'"\\']https?://',s)
Path('/tmp/commute-page-check.js').write_text(re.search(r'<script>(.*?)</script>',s,re.S).group(1))
print('已验证：6 道题、6 个必填分组，无外部脚本或样式依赖。')
