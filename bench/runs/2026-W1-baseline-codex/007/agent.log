from html.parser import HTMLParser
from pathlib import Path
import ast, json, subprocess
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.codes=[]; self.code=None; self.script=False; self.js=[]; self.sections=0
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a:self.ids.append(a['id'])
        if tag=='a':self.links.append(a.get('href',''))
        if tag=='code':self.code=''
        if tag=='script':self.script=True
        if tag=='section' and a.get('class')=='section':self.sections+=1
    def handle_endtag(self,tag):
        if tag=='code':self.codes.append(self.code);self.code=None
        if tag=='script':self.script=False
    def handle_data(self,data):
        if self.code is not None:self.code+=data
        if self.script:self.js.append(data)
p=Path('index.html'); c=Check(); c.feed(p.read_text())
assert len(c.ids)==len(set(c.ids)), '存在重复标识'
assert all(a[1:] in c.ids for a in c.links if a.startswith('#')), '目录链接缺少目标'
assert c.sections==5
snippets=[code for code in c.codes if '\\n' in code]
for code in snippets:ast.parse(code)
result=subprocess.run(['node','--check'],input=''.join(c.js),text=True,capture_output=True)
assert result.returncode==0,result.stderr
print(json.dumps({'文件':'index.html','文件大小':p.stat().st_size,'技巧数量':c.sections,'Python语法通过':len(snippets),'页面脚本语法':'通过','内部链接':'全部有效','外部资源依赖':'无'},ensure_ascii=False,indent=2))
