class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.questions=0
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if 'data-name' in attrs: self.questions+=1
parser=Check(); parser.feed(html)
assert parser.questions == 6
