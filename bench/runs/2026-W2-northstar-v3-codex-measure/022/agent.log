+      document.querySelector('#count').textContent = description.value.length;
+      validateDescription();
+      document.querySelector('#description-error').textContent = '';
+      description.removeAttribute('aria-invalid');
+    });
+    description.addEventListener('invalid', () => {
+      document.querySelector('#description-error').textContent = '请至少填写 10 个字，帮助我们了解你的反馈。';
+      description.setAttribute('aria-invalid', 'true');
+    });
+    function renderPreviews() {
+      previews.replaceChildren();
+      screenshots.forEach((item) => {
+        const wrapper = document.createElement('div');
+        wrapper.className = 'preview';
+        const img = document.createElement('img');
+        img.src = item.data;
