<script>
const platforms={macos:{command:'brew install ripgrep',note:'使用 <a href=\"https://brew.sh/\">Homebrew</a> 安装，需先安装 Homebrew。'},linux:{command:'sudo apt install ripgrep',note:'适用于 Debian / Ubuntu，使用系统的 APT 包管理器。'},windows:{command:'winget install BurntSushi.ripgrep.MSVC',note:'在 PowerShell 中使用 WinGet 安装，完成后重新打开终端。'},cargo:{command:'cargo install ripgrep',note:'跨平台安装，需要先准备好 Rust 工具链与 Cargo。'}};
const tabs=[...document.querySelectorAll('.tab')];function selectTab(tab){tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1});const p=platforms[tab.dataset.platform];document.querySelector('#install-command').textContent=p.command;document.querySelector('#platform-note').innerHTML=p.note;document.querySelector('#install-panel').setAttribute('aria-labelledby',tab.id)}tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(tab));tab.addEventListener('keydown',e=>{let n;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();selectTab(tabs[n]);tabs[n].focus()})});
let toastTimer;function notify(message){const t=document.querySelector('#toast');t.textContent=message;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2400)}
async function copyText(value){try{if("'!navigator.clipboard)throw new Error('"'fallback');await navigator.clipboard.writeText(value);return true}catch{const area=document.createElement('textarea');area.value=value;area.style.cssText='position:fixed;left:-9999px;top:0';document.body.appendChild(area);area.select();let ok=false;try{ok=document.execCommand('copy')}catch{}area.remove();return ok}}
document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const value=document.getElementById(button.dataset.copy).textContent;const ok=await copyText(value);notify(ok?'已复制到剪贴板':'复制未成功，请选择命令文本手动复制');button.focus()}));
const entries=[{title:'安装 ripgrep',description:'macOS、Linux、Windows 与 Cargo 安装方式',id:'install'},{title:'基础配置',description:'配置文件、行号、智能大小写与环境变量',id:'configuration'},{title:'搜索文本',description:'rg -n · 在项目中查找 TODO',id:'search-text'},{title:'筛选日志',description:'rg -n -i · 匹配 error 或 warn',id:'search-logs'},{title:'查找文件',description:'rg --files · TypeScript 与目录过滤',id:'search-files'}];const dialog=document.querySelector('#search-dialog');const input=document.querySelector('#search-input');function renderSearch(){const term=input.value.trim().toLowerCase();const matches=entries.filter(x=>(x.title+x.description).toLowerCase().includes(term));const results=document.querySelector('#search-results');results.replaceChildren();if("'!matches.length){const p=document.createElement('"'p');p.className='empty';p.textContent='没有找到相关内容，试试“安装”或“搜索”。';results.append(p)}matches.forEach(x=>{const a=document.createElement('a');a.href='#'+x.id;const title=document.createElement('strong');title.textContent=x.title;const desc=document.createElement('small');desc.textContent=x.description;a.append(title,desc);a.addEventListener('click',()=>dialog.close());results.append(a)})}function openSearch(){input.value='';renderSearch();dialog.showModal();input.focus()}document.querySelector('#open-search').addEventListener('click',openSearch);document.querySelector('#close-search').addEventListener('click',()=>dialog.close());input.addEventListener('input',renderSearch);input.addEventListener('keydown',e=>{if(e.key==='Enter'){document.querySelector('#search-results a')?.click()}});document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();if(dialog.open)dialog.close();else openSearch()}});dialog.addEventListener('click',e=>{const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()});
const tocLinks=[...document.querySelectorAll('.toc>a')];const targets=tocLinks.map(a=>document.querySelector(a.getAttribute('href')));let ticking=false;function updateToc(){let current=0;targets.forEach((target,i)=>{if(target.getBoundingClientRect().top<=160)current=i});tocLinks.forEach((a,i)=>{a.classList.toggle('current',i===current);if(i===current)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')});ticking=false}addEventListener('scroll',()=>{if("'!ticking){requestAnimationFrame(updateToc);ticking=true}},{passive:true});updateToc();
</script>
