from html.parser import HTMLParser
from pathlib import Path
import re, shutil, subprocess, tempfile
p = Path('index.html')
s = p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.targets=[]; self.stack=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if a.get('href','').startswith('#') and len(a['href'])>1: self.targets.append(a['href'][1:])
        if tag not in {'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr','path','circle','ellipse'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in {'path','circle','ellipse'}: return
        assert self.stack and self.stack[-1]==tag, (tag,self.stack[-3:])
        self.stack.pop()
c=Check(); c.feed(s)
assert not c.stack, c.stack
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert set(c.targets)<=set(c.ids), 'Broken section links'
assert '<html lang=\"zh-CN\">' in s
assert 'https://' not in s and 'http://' not in s, 'External dependency'
print('HTML structure, unique IDs, section links, and standalone assets: OK')
node=shutil.which('node')
if node:
    with tempfile.NamedTemporaryFile(suffix='.js',mode='w') as f:
        f.write(re.search(r'<script>(.*?)</script>',s,re.S).group(1)); f.flush()
        subprocess.run([node,'--check',f.name],check=True)
    print('JavaScript syntax: OK')
else: print('Node unavailable; JavaScript syntax check skipped')
print(f'Generated: index.html ({p.stat().st_size:,} bytes)')
