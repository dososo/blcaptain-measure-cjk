+const localDate=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
+const today=new Date();today.setHours(0,0,0,0);
+const maximum=new Date(today);maximum.setDate(maximum.getDate()+30);
+const tomorrow=new Date(today);tomorrow.setDate(tomorrow.getDate()+1);
+const date=$('date');date.min=localDate(today);date.max=localDate(maximum);date.value=localDate(tomorrow);
+$('year').textContent=new Date().getFullYear();
+let guests=2,period='dinner',chosen='18:00';
+const times={lunch:['11:30','12:00','12:30','13:00'],dinner:['17:30','18:00','18:30','19:00','19:30','20:00','20:30']};
+const prettyDate=()=>{if(!date.value)return '请选择日期';const d=new Date(`${date.value}T12:00:00`);return `${d.getMonth()+1}月${d.getDate()}日 周${'日一二三四五六'[d.getDay()]}`};
+function update(){
+  $('summary').textContent=`${prettyDate()} · ${chosen||'请选择时间'} · ${guests} 位`;
+  $('guest-display').textContent=`${guests} 位`;$('guests').value=guests;$('time').value=chosen;
+  $('minus').disabled=guests<=1;$('plus').disabled=guests>=8;
+}
+function renderTimes(){
+  const now=new Date();const available=times[period].filter(t=>date.value&&new Date(`${date.value}T${t}:00`)>now);
+  if(!available.includes(chosen))chosen=available[0]||'';
+  $('time-grid').replaceChildren();
+  times[period].forEach(t=>{const b=document.createElement('button');b.type='button';b.className='time-slot'+(t===chosen?' selected':'');b.textContent=t;b.disabled=!available.includes(t);b.setAttribute('aria-pressed',String(t===chosen));if(b.disabled)b.setAttribute('aria-label',`${t} 已过可预约时间`);b.addEventListener('click',()=>{chosen=t;renderTimes()});$('time-grid').appendChild(b)});
+  $('time-hint').textContent=available.length?'从容入席，慢慢享用':'本时段无可选时间，请选择其他日期或时段';update();
+}
+date.addEventListener('change',renderTimes);
+$('tomorrow').addEventListener('click',()=>{date.value=localDate(tomorrow);renderTimes()});
+$('weekend').addEventListener('click',()=>{const next=new Date(today);next.setDate(next.getDate()+((6-next.getDay()+7)%7));date.value=localDate(next);renderTimes()});
+document.querySelectorAll('.period').forEach(b=>b.addEventListener('click',()=>{period=b.dataset.period;document.querySelectorAll('.period').forEach(p=>{p.classList.toggle('selected',p===b);p.setAttribute('aria-pressed',String(p===b))});renderTimes()}));
+$('minus').addEventListener('click',()=>{guests=Math.max(1,guests-1);update()});$('plus').addEventListener('click',()=>{guests=Math.min(8,guests+1);update()});
+$('notes').addEventListener('input',()=>{$('char-count').textContent=$('notes').value.length});
+$('reservation-form').addEventListener('submit',e=>{e.preventDefault();if(!date.reportValidity())return;const previous=chosen;renderTimes();if(!chosen||chosen!==previous){$('time-hint').textContent='请重新选择一个可预约的到店时间';$('time-grid').querySelector('button:not(:disabled)')?.focus();return;}const notes=$('notes').value.trim();$('confirmation-details').textContent=`禾间 · 自然料理\n${prettyDate()}  ${chosen}\n用餐人数：${guests} 位${notes?'\n特别备注：'+notes:''}`;$('confirmation').showModal()});
+$('close-dialog').addEventListener('click',()=>$('confirmation').close());
+$('confirmation').addEventListener('click',e=>{if(e.target===$('confirmation')){const r=$('confirmation').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)$('confirmation').close()}});
+renderTimes();
+})();
+</script>
+</body>
+</html>

