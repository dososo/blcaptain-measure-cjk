from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.buttons=0
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a:self.ids.append(a['id'])
        if tag=='a' and a.get('href','').startswith('#') and a['href']"'!='"'#':self.links.append(a['href'][1:])
        if tag=='button' and 'data-signup' in a:self.buttons+=1
p=Path('index.html'); s=p.read_text(); c=Check(); c.feed(s)
assert len(c.ids)==len(set(c.ids)), '存在重复标识'
assert all(link in c.ids for link in c.links), '存在失效锚点'
assert c.buttons==3
assert 'prefers-reduced-motion' in s and '@media(max-width:720px)' in s
assert '<script src=' not in s and '<link ' not in s
print(f'检查通过：{p.name}，{p.stat().st_size} 字节；锚点完整，3 个注册入口，无外部依赖。')
