e\"] .wd,\n.date-btn[aria-pressed=\"true\"] .m { color: var(--accent-fg); }\n.date-btn:disabled { color: var(--disabled); cursor: not-allowed; }\n.date-btn:disabled .wd, .date-btn:disabled .m { color: var(--disabled); }\n\n/* 时间 */\n.slot-group + .slot-group { margin-top: 14px; }\n.slot-group h3 { font-size: 14px; font-weight: 500; color: var(--muted); margin: 0 0 8px; }\n.slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }\n.slot {\n  padding: 10px 0;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--fg);\n  font: inherit;\n  font-size: 15px;\n  cursor: pointer;\n}\n.slot[aria-pressed=\"true\"] { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }\n.slot:disabled { color: var(--disabled); cursor: not-allowed; text-decoration: line-through; }\n\n/* 人数 */\n.party { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }\n.stepper { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 6px; }\n.stepper button {\n  width: 44px; height: 44px;\n  border: 0; background: transparent; color: var(--fg);\n  font: inherit; font-size: 20px; cursor: pointer;\n}\n.stepper button:disabled { color: var(--disabled); cursor: not-allowed; }\n.stepper output { min-width: 56px; text-align: center; font-size: 18px; font-weight: 600; }\n.party-note { font-size: 14px; color: var(--muted); line-height: 1.75; margin: 0; }\n\n/* 文本输入 */\n.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.field { display: flex; flex-direction: column; min-width: 0; }\n.field label { font-size: 15px; margin-bottom: 6px; }\ninput[type=\"text\"], input[type=\"tel\"], textarea {\n  width: 100%;\n  padding: 10px 12px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: var(--bg);\n  color: var(--fg);\n  font: inherit;\n  line-height: 1.6;\n}\ntextarea { resize: vertical; min-height: 100px; }\ninput:focus, textarea:focus, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n.counter { font-size: 13px; color: var(--muted); text-align: right; margin-top: 4px; }\n.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }\n.tag {\n  padding: 4px 12px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: transparent;\n  color: var(--muted);\n  font: inherit;\n  font-size: 14px;\n  cursor: pointer;\n}\n.tag:hover { color: var(--fg); border-color: var(--muted); }\n\n.error { color: var(--error); font-size: 14px; margin: 8px 0 0; min-height: 0; }\n\n/* 汇总与提交 */\n.summary {\n  border-top: 1px solid var(--line);\n  padding-top: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n.summary p { margin: 0; line-height: 1.75; min-width: 0; }\n.summary strong { font-weight: 600; }\n.submit {\n  padding: 12px 28px;\n  border: 0;\n  border-radius: 6px;\n  background: var(--accent);\n  color: var(--accent-fg);\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n/* 确认 */\n.confirm h2 { font-size: 22px; margin: 0 0 12px; }\n.confirm dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 20px; margin: 0 0 20px; }\n.confirm dt { color: var(--muted); }\n.confirm dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }\n.confirm p { line-height: 1.75; color: var(--muted); margin: 0 0 20px; }\n.ghost {\n  padding: 10px 20px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--fg);\n  font: inherit;\n  cursor: pointer;\n}\n\nfooter { margin-top: 28px; color: var(--muted); font-size: 14px; line-height: 1.75; }\nfooter p { margin: 0; }\n\n@media (max-width: 520px) {\n  header h1 { font-size: 26px; }\n  .fields { grid-template-columns: 1fr; }\n  .summary { flex-direction: column; align-items: stretch; }\n  .submit { width: 100%; }\n}\n"}}}
