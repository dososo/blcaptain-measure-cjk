\n  counter-reset: step;\n}\n.step {\n  position: relative;\n  padding: 28px 24px 24px;\n  border-radius: var(--radius);\n  background: var(--surface);\n  border: 1px solid var(--border);\n}\n.step::before {\n  counter-increment: step;\n  content: counter(step);\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  margin-bottom: 14px;\n  font-weight: 700;\n  color: #fff;\n  background: linear-gradient(135deg, var(--accent), var(--accent-2));\n}\n.step h4 { margin: 0 0 6px; }\n.step p { margin: 0; color: var(--muted); font-size: 0.93rem; }\n\n/* Stats */\n.stats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n  text-align: center;\n}\n.stat b {\n  display: block;\n  font-size: clamp(2rem, 5vw, 2.8rem);\n  line-height: 1.2;\n}\n.stat span { color: var(--muted); font-size: 0.93rem; }\n\n/* Testimonials */\n.quotes {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n.quote {\n  padding: 24px;\n  border-radius: var(--radius);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.quote p { margin: 0; }\n.who { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.88rem; }\n.avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  font-weight: 700;\n  color: var(--accent);\n  background: var(--accent-soft);\n}\n\n/* CTA */\n.cta-box {\n  text-align: center;\n  padding: 56px 24px;\n  border-radius: 28px;\n  color: #fff;\n  background: linear-gradient(135deg, #5b4bff, #8a5cff 60%, #b06bff);\n}\n.cta-box h2 { margin: 0 0 12px; font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.3; }\n.cta-box p { margin: 0 0 28px; opacity: 0.9; }\n.cta-box .btn { background: #fff; color: #4a3be0; }\n\nfooter {\n  padding-block: 32px 48px;\n  color: var(--muted);\n  font-size: 0.88rem;\n  text-align: center;\n}\n\n/* Responsive */\n@media (max-width: 900px) {\n  .features, .quotes, .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 760px) {\n  .nav-links { display: none; }\n  .cases { grid-template-columns: 1fr; }\n  .compare { grid-template-columns: 1fr; }\n  .arrow { transform: rotate(90deg); }\n  .case { padding: 24px; }\n}\n@media (max-width: 560px) {\n  .features, .quotes, .steps, .stats { grid-template-columns: 1fr; }\n  section { padding-block: 52px; }\n  .hero { padding-block: 60px 40px; }\n  .demo { padding: 14px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01TjHgFmoDqFXoePUPMGLGqs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgQ8VXkDbJyPMbWvibpT8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K4FAWt7XAU5N26LpMJxYvx","name":"Write","input":{"file_path":"<tmp>/measure-baseline-claude-code-004-cPWAPT/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>妙笔 AI 写作助手</title>\n  <meta name=\"description\" content=\"妙笔 AI 写作助手：一键润色周报与邮件，让你的每一次汇报和沟通都清晰、专业、得体。\" />\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n\n  <header class=\"nav\">\n    <div class=\"wrap\">\n      <a href=\"#\" class=\"logo\"><span class=\"logo-mark\">✎</span>妙笔</a>\n      <nav class=\"nav-links\">\n        <a href=\"#demo\">效果演示</a>\n        <a href=\"#cases\">周报 &amp; 邮件</a>\n        <a href=\"#features\">功能</a>\n        <a href=\"#how\">使用方法</a>\n      </nav>\n      <a href=\"#start\" class=\"btn btn-primary\">免费试用</a>\n    </div>\n  </header>\n\n  <main>\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"wrap\">\n        <span class=\"badge\">✨ 专为职场写作打造的 AI 助手</span>\n        <h1>周报不再流水账，<br /><span class=\"grad\">邮件不再反复改</span></h1>\n        <p class=\"lead\">把零散的工作记录、写得太直白的邮件丢给妙笔，几秒钟就能得到结构清晰、重点突出、语气得体的成稿。少花时间斟酌措辞，多花时间做真正重要的事。</p>\n        <div class=\"hero-cta\">\n          <a href=\"#start\" class=\"btn btn-primary btn-lg\">立即免费体验</a>\n          <a href=\"#demo\" class=\"btn btn-ghost btn-lg\">看看改写效果 →</a>\n        </div>\n        <p class=\"hero-note\">无需信用卡 · 每天 20 次免费改写 · 支持网页、浏览器插件与办公软件</p>\n      </div>\n    </section>\n\n    <!-- Demo -->\n    <section id=\"demo\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">BEFORE / AFTER</div>\n          <h2>同样的内容，换一种写法</h2>\n          <p>切换下面的示例，看看妙笔是如何把草稿变成拿得出手的成稿的。</p>\n        </div>\n\n        <div class=\"demo\">\n          <div class=\"tabs\" role=\"tablist\">\n            <button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-key=\"report\">📊 改周报</button>\n            <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-key=\"email\">✉️ 改邮件</button>\n            <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-key=\"decline\">🙅 委婉拒绝</button>\n          </div>\n\n          <div class=\"compare\">\n            <div class=\"pane before\">\n              <span class=\"pane-label\">原稿</span>\n              <div class=\"pane-body\" id=\"before\"></div>\n            </div>\n            <div class=\"arrow\" aria-hidden=\"true\">→</div>\n            <div class=\"pane after\">\n              <span class=\"pane-label\">妙笔改写</span>\n              <div class=\"pane-body\" id=\"after\"></div>\n            </div>\n          </div>\n\n          <div class=\"demo-foot\" id=\"chips\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Use cases -->\n    <section id=\"cases\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">核心场景</div>\n          <h2>职场里最耗神的两件写作小事，交给妙笔</h2>\n          <p>我们把最常见、最高频的周报和邮件场景打磨到极致。</p>\n        </div>\n\n        <div class=\"cases\">\n          <article class=\"case\">\n            <div class=\"case-icon\">📊</div>\n            <h3>周报改写</h3>\n            <p>把\"做了什么\"变成\"带来了什么\"，让领导一眼看到你的价值。</p>\n            <ul class=\"checks\">\n              <li>自动归纳为「本周进展 / 关键成果 / 风险问题 / 下周计划」结构</li>\n              <li>把模糊描述转换为可量化的结果与数据</li>\n              <li>提炼亮点放在前面，弱化琐碎事务</li>\n              <li>支持日报、周报、月报、季度述职多种模板</li>\n              <li>可导入任务清单、会议纪要，一键生成初稿</li>\n            </ul>\n          </article>\n\n          <article class=\"case\">\n            <div class=\"case-icon\">✉️</div>\n            <h3>邮件润色</h3>\n            <p>措辞得体、意图清楚，不再为一封邮件纠结半小时。</p>\n            <ul class=\"checks\">\n              <li>根据收件人（上级 / 客户 / 同事）自动调整语气</li>\n              <li>一键切换：更正式、更简洁、更委婉、更有说服力</li>\n              <li>自动补全称呼、主题行与结尾落款</li>\n              <li>催进度、拒绝请求、道歉说明等敏感场景都有妥帖表达</li>\n              <li>中英双语互译润色，海外沟通同样地道</li>\n            </ul>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features -->\n    <section id=\"features\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">更多能力</div>\n          <h2>不只是改字，更懂你的工作语境</h2>\n        </div>\n        <div class=\"features\">\n          <div class=\"feature\">\n            <div class=\"ico\">🎯</div>\n            <h4>语气精准调节</h4>\n            <p>正式、亲切、简洁、坚定……滑动即可切换，满足不同对象的沟通需要。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🧠</div>\n            <h4>记住你的风格</h4>\n            <p>学习你过往的写作习惯和团队术语，改出来的内容依然\"像你写的\"。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🔍</div>\n            <h4>逐句修改说明</h4>\n            <p>每处改动都标注原因，可单句接受或撤销，你始终掌握最终决定权。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🧩</div>\n            <h4>无缝嵌入工作流</h4>\n            <p>支持浏览器插件、邮箱客户端、飞书、钉钉、企业微信与 Office，选中即改。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">📚</div>\n            <h4>团队模板库</h4>\n            <p>统一团队周报格式和对外邮件规范，新人也能写出标准化文档。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🔒</div>\n            <h4>数据安全</h4>\n            <p>传输全程加密，内容不用于模型训练，企业版支持私有化部署。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- How -->\n    <section id=\"how\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">三步上手</div>\n          <h2>30 秒，完成一份周报或一封邮件</h2>\n        </div>\n        <div class=\"steps\">\n          <div class=\"step\">\n            <h4>粘贴草稿</h4>\n            <p>贴入零散的工作记录、要点清单，或者写到一半的邮件。</p>\n          </div>\n          <div class=\"step\">\n            <h4>选择场景</h4>\n            <p>选择\"周报\"或\"邮件\"，并告诉妙笔收件人是谁、想达到什么目的。</p>\n          </div>\n          <div class=\"step\">\n            <h4>一键生成</h4>\n            <p>获得润色后的成稿，按需微调后直接复制发送。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Stats -->\n    <section>\n      <div class=\"wrap\">\n        <div class=\"stats\">\n          <div class=\"stat\"><b class=\"grad\">70%</b><span>写周报平均节省的时间</span></div>\n          <div class=\"stat\"><b class=\"grad\">3 秒</b><span>一封邮件的平均润色耗时</span></div>\n          <div class=\"stat\"><b class=\"grad\">20+</b><span>覆盖的职场写作场景</span></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Testimonials -->\n    <section>\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">用户反馈</div>\n          <h2>他们已经告别了周五晚上的周报焦虑</h2>\n        </div>\n        <div class=\"quotes\">\n          <div class=\"quote\">\n            <p>\"以前写周报要憋一个小时，现在把这周的任务列表贴进去，5 分钟就能交，而且领导说我的周报越来越有条理了。\"</p>\n            <div class=\"who\"><span class=\"avatar\">产</span>产品经理 · 互联网公司</div>\n          </div>\n          <div class=\"quote\">\n            <p>\"给客户写催款邮件最头疼，妙笔的'坚定但礼貌'模式简直救命，既把话说清楚，又不伤合作关系。\"</p>\n            <div class=\"who\"><span class=\"avatar\">商</span>商务负责人 · 外贸企业</div>\n          </div>\n          <div class=\"quote\">\n            <p>\"作为程序员，我最怕写文字。现在技术周报能自动把我的提交记录整理成成果描述，太省心了。\"</p>\n            <div class=\"who\"><span class=\"avatar\">研</span>后端工程师 · 科技公司</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- CTA -->\n    <section id=\"start\">\n      <div class=\"wrap\">\n        <div class=\"cta-box\">\n          <h2>这周的周报，就让妙笔来帮你写</h2>\n          <p>注册即送 7 天专业版，所有周报与邮件功能不限次数使用。</p>\n          <a href=\"#\" class=\"btn btn-lg\">免费开始使用</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">© 2026 妙笔 AI 写作助手 · 让每一次表达都恰到好处</div>\n  </footer>\n\n  <script>\n    const samples = {\n      report: {\n        before: `这周干的事：\n- 弄了下登录页面\n- 开了好几个会\n- 修了一些bug\n- 跟设计对了下需求\n- 下周继续做支付那块`,\n        after: `<strong>【本周进展】</strong>\n1. 完成登录页改版上线，页面加载时间由 2.1s 降至 1.2s\n2. 修复线上缺陷 8 个，其中 P1 级 2 个，崩溃率下降 15%\n3. 与设计团队完成支付模块需求评审，确认交互方案\n\n<strong>【风险与问题】</strong>\n支付接口文档尚未确定，可能影响联调排期\n\n<strong>【下周计划】</strong>\n推进支付模块开发，预计周四进入联调`,\n        chips: [\"结构化整理\", \"成果量化\", \"突出亮点\", \"补充风险\"]\n      },\n      email: {\n        before: `王总，那个方案我们做完了，你看下，有问题跟我说。另外上次说的预算的事情还没回复，麻烦快点，我们这边等着用。`,\n        after: `<strong>主题：</strong>Q4 推广方案已完成，烦请审阅及确认预算\n\n王总，您好：\n\nQ4 推广方案已完成，详见附件，烦请您在方便时审阅，如有修改意见我们会第一时间调整。\n\n另外，关于上次沟通的预算事宜，因涉及下周的物料采购排期，想请您在本周五前给予确认，以便我们按计划推进。\n\n感谢您的支持！\n\n祝好\n李明`,\n        chips: [\"对上级语气\", \"补全主题行\", \"说明原因\", \"明确截止时间\"]\n      },\n      decline: {\n        before: `这个需求我们这周做不了，人手不够，你们找别人吧。`,\n        after: `你好，感谢你们对我们团队的信任！\n\n本周我们正在全力保障版本上线，人力已经排满，如果现在接手，恐怕难以保证交付质量。\n\n建议两种方式供参考：\n1. 若时间允许，我们可在下周三后开始排期；\n2. 若比较紧急，可以先联系 B 组同事评估，我们可以协助提供相关背景资料。\n\n有任何需要随时找我～`,\n        chips: [\"委婉拒绝\", \"给出理由\", \"提供替代方案\", \"维护关系\"]\n      }\n    };\n\n    const beforeEl = document.getElementById(\"before\");\n    const afterEl = document.getElementById(\"after\");\n    const chipsEl = document.getElementById(\"chips\");\n    const tabs = document.querySelectorAll(\".tab\");\n\n    function show(key) {\n      const s = samples[key];\n      beforeEl.textContent = s.before;\n      afterEl.innerHTML = s.after;\n      chipsEl.innerHTML = s.chips.map(c => `<span class=\"chip\">${c}</span>`).join(\"\");\n      tabs.forEach(t => t.setAttribute(\"aria-selected\", t.dataset.key === key));\n    }\n\n    tabs.forEach(t => t.addEventListener(\"click\", () => show(t.dataset.key)));\n    show(\"report\");\n  </script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2295,"cache_read_input_tokens":31725,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2295},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2e23c09c-b1eb-455b-8a51-d65bbefb4b75","uuid":"6f973d1a-bdeb-43fc-afd0-1c71af06d882","timestamp":"2026-10-26T03:23:10.396Z","request_id":"req_011CgQ8VWN7wdBnmTUKqvLDS","wire_tool_inputs":{"toolu_01K4FAWt7XAU5N26LpMJxYvx":{"file_path":"<tmp>/measure-baseline-claude-code-004-cPWAPT/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>妙笔 AI 写作助手</title>\n  <meta name=\"description\" content=\"妙笔 AI 写作助手：一键润色周报与邮件，让你的每一次汇报和沟通都清晰、专业、得体。\" />\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n\n  <header class=\"nav\">\n    <div class=\"wrap\">\n      <a href=\"#\" class=\"logo\"><span class=\"logo-mark\">✎</span>妙笔</a>\n      <nav class=\"nav-links\">\n        <a href=\"#demo\">效果演示</a>\n        <a href=\"#cases\">周报 &amp; 邮件</a>\n        <a href=\"#features\">功能</a>\n        <a href=\"#how\">使用方法</a>\n      </nav>\n      <a href=\"#start\" class=\"btn btn-primary\">免费试用</a>\n    </div>\n  </header>\n\n  <main>\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"wrap\">\n        <span class=\"badge\">✨ 专为职场写作打造的 AI 助手</span>\n        <h1>周报不再流水账，<br /><span class=\"grad\">邮件不再反复改</span></h1>\n        <p class=\"lead\">把零散的工作记录、写得太直白的邮件丢给妙笔，几秒钟就能得到结构清晰、重点突出、语气得体的成稿。少花时间斟酌措辞，多花时间做真正重要的事。</p>\n        <div class=\"hero-cta\">\n          <a href=\"#start\" class=\"btn btn-primary btn-lg\">立即免费体验</a>\n          <a href=\"#demo\" class=\"btn btn-ghost btn-lg\">看看改写效果 →</a>\n        </div>\n        <p class=\"hero-note\">无需信用卡 · 每天 20 次免费改写 · 支持网页、浏览器插件与办公软件</p>\n      </div>\n    </section>\n\n    <!-- Demo -->\n    <section id=\"demo\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">BEFORE / AFTER</div>\n          <h2>同样的内容，换一种写法</h2>\n          <p>切换下面的示例，看看妙笔是如何把草稿变成拿得出手的成稿的。</p>\n        </div>\n\n        <div class=\"demo\">\n          <div class=\"tabs\" role=\"tablist\">\n            <button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-key=\"report\">📊 改周报</button>\n            <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-key=\"email\">✉️ 改邮件</button>\n            <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-key=\"decline\">🙅 委婉拒绝</button>\n          </div>\n\n          <div class=\"compare\">\n            <div class=\"pane before\">\n              <span class=\"pane-label\">原稿</span>\n              <div class=\"pane-body\" id=\"before\"></div>\n            </div>\n            <div class=\"arrow\" aria-hidden=\"true\">→</div>\n            <div class=\"pane after\">\n              <span class=\"pane-label\">妙笔改写</span>\n              <div class=\"pane-body\" id=\"after\"></div>\n            </div>\n          </div>\n\n          <div class=\"demo-foot\" id=\"chips\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Use cases -->\n    <section id=\"cases\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">核心场景</div>\n          <h2>职场里最耗神的两件写作小事，交给妙笔</h2>\n          <p>我们把最常见、最高频的周报和邮件场景打磨到极致。</p>\n        </div>\n\n        <div class=\"cases\">\n          <article class=\"case\">\n            <div class=\"case-icon\">📊</div>\n            <h3>周报改写</h3>\n            <p>把\"做了什么\"变成\"带来了什么\"，让领导一眼看到你的价值。</p>\n            <ul class=\"checks\">\n              <li>自动归纳为「本周进展 / 关键成果 / 风险问题 / 下周计划」结构</li>\n              <li>把模糊描述转换为可量化的结果与数据</li>\n              <li>提炼亮点放在前面，弱化琐碎事务</li>\n              <li>支持日报、周报、月报、季度述职多种模板</li>\n              <li>可导入任务清单、会议纪要，一键生成初稿</li>\n            </ul>\n          </article>\n\n          <article class=\"case\">\n            <div class=\"case-icon\">✉️</div>\n            <h3>邮件润色</h3>\n            <p>措辞得体、意图清楚，不再为一封邮件纠结半小时。</p>\n            <ul class=\"checks\">\n              <li>根据收件人（上级 / 客户 / 同事）自动调整语气</li>\n              <li>一键切换：更正式、更简洁、更委婉、更有说服力</li>\n              <li>自动补全称呼、主题行与结尾落款</li>\n              <li>催进度、拒绝请求、道歉说明等敏感场景都有妥帖表达</li>\n              <li>中英双语互译润色，海外沟通同样地道</li>\n            </ul>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features -->\n    <section id=\"features\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">更多能力</div>\n          <h2>不只是改字，更懂你的工作语境</h2>\n        </div>\n        <div class=\"features\">\n          <div class=\"feature\">\n            <div class=\"ico\">🎯</div>\n            <h4>语气精准调节</h4>\n            <p>正式、亲切、简洁、坚定……滑动即可切换，满足不同对象的沟通需要。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🧠</div>\n            <h4>记住你的风格</h4>\n            <p>学习你过往的写作习惯和团队术语，改出来的内容依然\"像你写的\"。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🔍</div>\n            <h4>逐句修改说明</h4>\n            <p>每处改动都标注原因，可单句接受或撤销，你始终掌握最终决定权。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🧩</div>\n            <h4>无缝嵌入工作流</h4>\n            <p>支持浏览器插件、邮箱客户端、飞书、钉钉、企业微信与 Office，选中即改。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">📚</div>\n            <h4>团队模板库</h4>\n            <p>统一团队周报格式和对外邮件规范，新人也能写出标准化文档。</p>\n          </div>\n          <div class=\"feature\">\n            <div class=\"ico\">🔒</div>\n            <h4>数据安全</h4>\n            <p>传输全程加密，内容不用于模型训练，企业版支持私有化部署。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- How -->\n    <section id=\"how\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">三步上手</div>\n          <h2>30 秒，完成一份周报或一封邮件</h2>\n        </div>\n        <div class=\"steps\">\n          <div class=\"step\">\n            <h4>粘贴草稿</h4>\n            <p>贴入零散的工作记录、要点清单，或者写到一半的邮件。</p>\n          </div>\n          <div class=\"step\">\n            <h4>选择场景</h4>\n            <p>选择\"周报\"或\"邮件\"，并告诉妙笔收件人是谁、想达到什么目的。</p>\n          </div>\n          <div class=\"step\">\n            <h4>一键生成</h4>\n            <p>获得润色后的成稿，按需微调后直接复制发送。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Stats -->\n    <section>\n      <div class=\"wrap\">\n        <div class=\"stats\">\n          <div class=\"stat\"><b class=\"grad\">70%</b><span>写周报平均节省的时间</span></div>\n          <div class=\"stat\"><b class=\"grad\">3 秒</b><span>一封邮件的平均润色耗时</span></div>\n          <div class=\"stat\"><b class=\"grad\">20+</b><span>覆盖的职场写作场景</span></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Testimonials -->\n    <section>\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">用户反馈</div>\n          <h2>他们已经告别了周五晚上的周报焦虑</h2>\n        </div>\n        <div class=\"quotes\">\n          <div class=\"quote\">\n            <p>\"以前写周报要憋一个小时，现在把这周的任务列表贴进去，5 分钟就能交，而且领导说我的周报越来越有条理了。\"</p>\n            <div class=\"who\"><span class=\"avatar\">产</span>产品经理 · 互联网公司</div>\n          </div>\n          <div class=\"quote\">\n            <p>\"给客户写催款邮件最头疼，妙笔的'坚定但礼貌'模式简直救命，既把话说清楚，又不伤合作关系。\"</p>\n            <div class=\"who\"><span class=\"avatar\">商</span>商务负责人 · 外贸企业</div>\n          </div>\n          <div class=\"quote\">\n            <p>\"作为程序员，我最怕写文字。现在技术周报能自动把我的提交记录整理成成果描述，太省心了。\"</p>\n            <div class=\"who\"><span class=\"avatar\">研</span>后端工程师 · 科技公司</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- CTA -->\n    <section id=\"start\">\n      <div class=\"wrap\">\n        <div class=\"cta-box\">\n          <h2>这周的周报，就让妙笔来帮你写</h2>\n          <p>注册即送 7 天专业版，所有周报与邮件功能不限次数使用。</p>\n          <a href=\"#\" class=\"btn btn-lg\">免费开始使用</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">© 2026 妙笔 AI 写作助手 · 让每一次表达都恰到好处</div>\n  </footer>\n\n  <script>\n    const samples = {\n      report: {\n        before: `这周干的事：\n- 弄了下登录页面\n- 开了好几个会\n- 修了一些bug\n- 跟设计对了下需求\n- 下周继续做支付那块`,\n        after: `<strong>【本周进展】</strong>\n1. 完成登录页改版上线，页面加载时间由 2.1s 降至 1.2s\n2. 修复线上缺陷 8 个，其中 P1 级 2 个，崩溃率下降 15%\n3. 与设计团队完成支付模块需求评审，确认交互方案\n\n<strong>【风险与问题】</strong>\n支付接口文档尚未确定，可能影响联调排期\n\n<strong>【下周计划】</strong>\n推进支付模块开发，预计周四进入联调`,\n        chips: [\"结构化整理\", \"成果量化\", \"突出亮点\", \"补充风险\"]\n      },\n      email: {\n        before: `王总，那个方案我们做完了，你看下，有问题跟我说。另外上次说的预算的事情还没回复，麻烦快点，我们这边等着用。`,\n        after: `<strong>主题：</strong>Q4 推广方案已完成，烦请审阅及确认预算\n\n王总，您好：\n\nQ4 推广方案已完成，详见附件，烦请您在方便时审阅，如有修改意见我们会第一时间调整。\n\n另外，关于上次沟通的预算事宜，因涉及下周的物料采购排期，想请您在本周五前给予确认，以便我们按计划推进。\n\n感谢您的支持！\n\n祝好\n李明`,\n        chips: [\"对上级语气\", \"补全主题行\", \"说明原因\", \"明确截止时间\"]\n      },\n      decline: {\n        before: `这个需求我们这周做不了，人手不够，你们找别人吧。`,\n        after: `你好，感谢你们对我们团队的信任！\n\n本周我们正在全力保障版本上线，人力已经排满，如果现在接手，恐怕难以保证交付质量。\n\n建议两种方式供参考：\n1. 若时间允许，我们可在下周三后开始排期；\n2. 若比较紧急，可以先联系 B 组同事评估，我们可以协助提供相关背景资料。\n\n有任何需要随时找我～`,\n        chips: [\"委婉拒绝\", \"给出理由\", \"提供替代方案\", \"维护关系\"]\n      }\n    };\n\n    const beforeEl = document.getElementById(\"before\");\n    const afterEl = document.getElementById(\"after\");\n    const chipsEl = document.getElementById(\"chips\");\n    const tabs = document.querySelectorAll(\".tab\");\n\n    function show(key) {\n      const s = samples[key];\n      beforeEl.textContent = s.before;\n      afterEl.innerHTML = s.after;\n      chipsEl.innerHTML = s.chips.map(c => `<span class=\"chip\">${c}</span>`).join(\"\");\n      tabs.forEach(t => t.setAttribute(\"aria-selected\", t.dataset.key === key));\n    }\n\n    tabs.forEach(t => t.addEventListener(\"click\", () => show(t.dataset.key)));\n    show(\"report\");\n  </script>\n</body>\n</html>\n"}}}
