ro .badge {\n  display: inline-block;\n  font-size: 0.85rem;\n  color: var(--accent);\n  background: var(--accent-soft);\n  padding: 4px 12px;\n  border-radius: 999px;\n}\n\nheader.hero h1 {\n  font-size: clamp(1.7rem, 5vw, 2.4rem);\n  margin: 12px 0 8px;\n}\n\nheader.hero p {\n  color: var(--muted);\n  margin: 0;\n}\n\nnav.toc {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: center;\n  margin: 24px 0 32px;\n}\n\nnav.toc a {\n  text-decoration: none;\n  color: var(--fg);\n  background: var(--card);\n  border: 1px solid var(--border);\n  padding: 8px 16px;\n  border-radius: 999px;\n  transition: border-color .15s, color .15s;\n}\n\nnav.toc a:hover { border-color: var(--accent); color: var(--accent); }\n\nsection.card {\n  background: var(--card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px clamp(16px, 4vw, 32px);\n  margin-bottom: 24px;\n  scroll-margin-top: 16px;\n}\n\nsection.card h2 {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin: 0 0 8px;\n  font-size: 1.4rem;\n}\n\nsection.card h2 .num {\n  flex: none;\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background: var(--accent);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  font-size: 1rem;\n}\n\nsection.card h3 {\n  font-size: 1.05rem;\n  margin: 24px 0 8px;\n}\n\n.lead { color: var(--muted); margin-top: 0; }\n\nol.steps {\n  list-style: none;\n  counter-reset: step;\n  padding: 0;\n  margin: 0;\n}\n\nol.steps > li {\n  counter-increment: step;\n  position: relative;\n  padding: 0 0 18px 48px;\n}\n\nol.steps > li::before {\n  content: counter(step);\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: 2px solid var(--accent);\n  color: var(--accent);\n  display: grid;\n  place-items: center;\n  font-weight: 600;\n  font-size: 0.9rem;\n}\n\nol.steps > li:not(:last-child)::after {\n  content: \"\";\n  position: absolute;\n  left: 15px;\n  top: 34px;\n  bottom: 4px;\n  width: 2px;\n  background: var(--border);\n}\n\nol.steps strong { display: block; }\n\nkbd {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 0.85em;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-bottom-width: 2px;\n  border-radius: 6px;\n  padding: 1px 6px;\n}\n\n.note {\n  border-radius: 10px;\n  padding: 12px 16px;\n  margin: 16px 0 0;\n  border-left: 4px solid;\n}\n\n.note.tip { background: var(--accent-soft); border-color: var(--accent); }\n.note.warn { background: var(--warn-soft); border-color: var(--warn); }\n.note.danger { background: var(--danger-soft); border-color: var(--danger); }\n.note b { display: block; margin-bottom: 4px; }\n.note ul { margin: 0; padding-left: 20px; }\n\n.table-wrap { overflow-x: auto; margin-top: 12px; }\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  min-width: 420px;\n}\n\nth, td {\n  text-align: left;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n  vertical-align: top;\n}\n\nth { color: var(--muted); font-weight: 600; font-size: 0.9rem; }\n\n.grid2 {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 16px;\n}\n\n.grid2 > div {\n  min-width: 0;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 4px 16px 12px;\n}\n\ndetails {\n  border-bottom: 1px solid var(--border);\n  padding: 12px 0;\n}\n\ndetails summary { cursor: pointer; font-weight: 600; }\ndetails p { margin: 8px 0 0; color: var(--muted); }\n\nfooter {\n  text-align: center;\n  color: var(--muted);\n  font-size: 0.85rem;\n  margin-top: 32px;\n}\n\na { color: var(--accent); }\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KDvPxrFikpGnUWr5Lw7kPx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
