+      currentCycle = button.dataset.cycle;
+      const annual = currentCycle === 'yearly';
+      cycleButtons.forEach(item => { const selected = item === button; item.classList.toggle('selected', selected); item.setAttribute('aria-pressed', String(selected)); });
