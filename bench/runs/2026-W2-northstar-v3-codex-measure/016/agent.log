+  <script>
+    const platforms = {
+      mac: { command: 'brew install just', manager: 'Homebrew', hint: '需要先安装 Homebrew。' },
+      linux: { command: 'sudo apt install just', manager: 'APT', hint: '适用于 Debian 13、Ubuntu 24.04 及其衍生发行版。' },
+      windows: { command: 'winget install --id Casey.Just --exact', manager: 'WinGet', hint: '示例任务使用默认的 sh，请安装 Git for Windows 并确保 sh 在 PATH 中。' }
+    };
+    const tabs = [...document.querySelectorAll('[role="tab"]')];
+    function selectPlatform(tab) {
+      const value = platforms[tab.dataset.platform];
+      tabs.forEach(item => { item.setAttribute('aria-selected', String(item === tab)); item.tabIndex = item === tab ? 0 : -1; });
+      document.getElementById('install-command').textContent = value.command;
+      document.getElementById('package-manager').textContent = value.manager;
+      document.getElementById('install-panel').setAttribute('aria-labelledby', tab.id);
+      const hint = document.getElementById('platform-hint');
+      hint.replaceChildren(document.createTextNode(value.hint + '其他安装方式见'));
