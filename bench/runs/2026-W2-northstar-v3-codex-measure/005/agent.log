th d="M216 300q55 25 113 0" fill="none" stroke="#55765c" stroke-width="12"/><circle cx="274" cy="316" r="12" fill="#f6d583"/><path d="M370 423c-25-6-29-27-18-55" stroke="#f8f5e9" stroke-width="20" fill="none" stroke-linecap="round"/><path d="M365 423c-9-35-1-70 16-88h48c23 27 32 54 18 88Z" fill="#faf7ec"/><path d="m371 302-5-58 36 23 24-1 29-23-1 61c-1 49-83 49-83-2Z" fill="#faf7ec"/><path d="m375 279-2-22 17 15m43-1 15-14-1 24" fill="#dda895"/><path d="M422 266c1 20 9 33 30 38l2-61Z" fill="#b2bbaa"/><path d="m386 301 9 2m32 0 9-2" stroke="#334438" stroke-width="3" stroke-linecap="round"/><path d="m407 312 5 5 5-5" fill="#d5917c"/><path d="M412 317v6m-7-1q7 6 14 0m-35-7-18-3m18 10-18 3m70-10 18-3m-18 10 18 3" stroke="#53634f" stroke-width="2" stroke-linecap="round" fill="none"/><path d="m391 390-2 34m38-34 2 34" stroke="#d7d9cb" stroke-width="2"/><path d="M384 345q27 10 52-1" stroke="#d7804e" stroke-width="7" fill="none"/><path d="M119 153c-19-20-38 2 0 25 38-23 19-45 0-25Z" fill="#d78a60"/><path d="m487 218 0 22m-11-11h22" stroke="#f8f5e9" stroke-width="5" stroke-linecap="round"/><path d="m172 111 0 16m-8-8h16" stroke="#55765c" stroke-width="3" stroke-linecap="round"/></svg>
