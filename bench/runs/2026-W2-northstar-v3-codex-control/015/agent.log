+  <script>
+    const plans={data:{price:2,free:10000},smart:{price:5,free:5000},vision:{price:12,free:1000}};
+    let currency='CNY';
+    const service=document.getElementById('service'),volume=document.getElementById('volume'),range=document.getElementById('volume-range');
+    const symbols={CNY:'¥',USD:'$'};
+    const rate=()=>currency==='CNY'?1:1/7;
+    function update(){
+      const count=Math.max(0,Math.min(1000000,Math.floor(Number(volume.value)||0)));
+      const plan=plans[service.value],billable=Math.max(0,count-plan.free),price=plan.price*rate();
+      document.getElementById('total').textContent=(billable*price/1000).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+      document.getElementById('free-count').textContent=Math.min(count,plan.free).toLocaleString('en-US');
+      document.querySelector('.currency-sign').textContent=symbols[currency];
+      document.getElementById('formula').textContent=currency==='CNY'?`${billable.toLocaleString('en-US')} 次 × ¥${plan.price/1000} / 次`:'参考汇率：$1 = ¥7，以人民币结算';
+      range.value=count;
+    }
+    volume.addEventListener('input',update);
+    volume.addEventListener('change',()=>{volume.value=Math.max(0,Math.min(1000000,Math.floor(Number(volume.value)||0)));update()});
+    range.addEventListener('input',()=>{volume.value=range.value;update()});
+    service.addEventListener('change',update);
+    document.querySelectorAll('[data-currency]').forEach(button=>button.addEventListener('click',()=>{currency=button.dataset.currency;document.querySelectorAll('[data-currency]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll('[data-price]').forEach(p=>p.textContent=(Number(p.dataset.price)*rate()).toFixed(2));document.querySelectorAll('.symbol').forEach(p=>p.textContent=symbols[currency]);document.querySelectorAll('.billing-note').forEach(p=>p.textContent=currency==='CNY'?'按实际成功调用次数计费':'美元仅供参考 · $1 = ¥7 · 人民币结算');update()}));
+    const dialog=document.getElementById('info-dialog');
