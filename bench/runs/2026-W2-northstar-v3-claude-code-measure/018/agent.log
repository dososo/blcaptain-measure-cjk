\n  flex-wrap: wrap;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.toc a {\n  display: inline-block;\n  padding: 6px 14px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: var(--surface);\n  color: var(--fg);\n  font-size: 15px;\n  text-decoration: none;\n}\n.toc a:hover { border-color: var(--accent); color: var(--accent); }\n.toc .num { color: var(--muted); margin-right: 6px; font-variant-numeric: tabular-nums; }\n\n/* 章节 */\nsection {\n  padding-block: 36px 8px;\n  border-bottom: 1px solid var(--line);\n  scroll-margin-top: 16px;\n}\nsection:last-of-type { border-bottom: 0; }\n\nsection h2 {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  margin: 0 0 12px;\n  font-size: 24px;\n  letter-spacing: 0.02em;\n}\nsection h2 .num {\n  color: var(--accent);\n  font-size: 18px;\n  font-variant-numeric: tabular-nums;\n}\nsection h3 {\n  margin: 28px 0 8px;\n  font-size: 17px;\n}\n\n.meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 20px;\n  margin: 0 0 20px;\n  padding: 0;\n  list-style: none;\n  color: var(--muted);\n  font-size: 14px;\n}\n.meta b { color: var(--fg); font-weight: 600; }\n\n/* 步骤 */\nol.steps {\n  counter-reset: step;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\nol.steps > li {\n  counter-increment: step;\n  position: relative;\n  padding: 0 0 18px 44px;\n}\nol.steps > li::before {\n  content: counter(step);\n  position: absolute;\n  left: 0;\n  top: 0.15em;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 28px;\n  text-align: center;\n}\nol.steps > li:not(:last-child)::after {\n  content: \"\";\n  position: absolute;\n  left: 13.5px;\n  top: calc(0.15em + 32px);\n  bottom: 4px;\n  width: 1px;\n  background: var(--line);\n}\nol.steps p { margin: 0; }\nol.steps .hint {\n  margin-top: 4px;\n  color: var(--muted);\n  font-size: 15px;\n}\n\n/* 按键、语音提示 */\nkbd {\n  display: inline-block;\n  padding: 0 6px;\n  border: 1px solid var(--line);\n  border-bottom-width: 2px;\n  border-radius: 4px;\n  background: var(--code-bg);\n  font-family: inherit;\n  font-size: 0.92em;\n  line-height: 1.5;\n}\n.voice {\n  color: var(--accent);\n  font-weight: 600;\n}\n\n/* 提示框 */\n.note {\n  margin: 8px 0 20px;\n  padding: 14px 16px;\n  border-left: 3px solid var(--accent);\n  border-radius: 0 6px 6px 0;\n  background: var(--accent-soft);\n}\n.note.warn {\n  border-left-color: var(--warn);\n  background: var(--warn-soft);\n}\n.note .label {\n  display: block;\n  margin-bottom: 2px;\n  font-weight: 700;\n}\n.note.warn .label { color: var(--warn); }\n.note p { margin: 0; }\n.note ul { margin: 4px 0 0; padding-left: 1.2em; }\n\nul.plain { margin: 0 0 16px; padding-left: 1.2em; }\n\n/* 表格 */\n.table-wrap {\n  overflow-x: auto;\n  margin: 8px 0 20px;\n}\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 15px;\n}\nth, td {\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--line);\n  text-align: left;\n  vertical-align: top;\n  line-height: 1.6;\n}\nth {\n  color: var(--muted);\n  font-weight: 600;\n  white-space: nowrap;\n}\n\nfooter {\n  margin-top: 40px;\n  color: var(--muted);\n  font-size: 14px;\n}\nfooter p { margin: 0 0 6px; }\n\n@media (max-width: 480px) {\n  .masthead { padding-block: 32px 20px; }\n  ol.steps > li { padding-left: 40px; }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":200,"cache_read_input_tokens":44717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":200},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ff340f97-0966-4437-aa48-d4bdd08410c7","uuid":"f6c64b9b-a550-4813-b2ed-17ec695e0c6c","timestamp":"2026-10-26T