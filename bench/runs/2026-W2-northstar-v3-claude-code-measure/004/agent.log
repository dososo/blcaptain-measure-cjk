h1 {\n  font-size: clamp(2rem, 5vw, 3.25rem);\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  margin: 0 0 1.25rem;\n  max-width: 16em;\n}\n.hero p {\n  max-width: 32em;\n  font-size: 1.125rem;\n  color: var(--muted);\n  margin: 0 0 2rem;\n}\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  align-items: center;\n}\n.btn {\n  display: inline-block;\n  padding: 0.75rem 1.5rem;\n  border-radius: 6px;\n  font-size: 16px;\n  font-weight: 600;\n  text-decoration: none;\n  border: 1px solid var(--accent);\n}\n.btn-primary { background: var(--accent); color: var(--bg); }\n.btn-ghost { color: var(--accent); }\n.note {\n  font-size: 14px;\n  color: var(--muted);\n}\n\n/* 改写演示 */\n.demo {\n  padding-block: 3rem;\n  border-top: 1px solid var(--line);\n}\n.demo-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);\n  gap: 2rem;\n  align-items: start;\n  margin-bottom: 2rem;\n}\n.demo-head h2 {\n  font-size: 1.75rem;\n  margin: 0;\n  letter-spacing: 0.02em;\n}\n.demo-head .tag {\n  display: block;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--accent);\n  margin-bottom: 0.5rem;\n}\n.demo-head p {\n  margin: 0;\n  color: var(--muted);\n}\n.compare {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 1rem;\n}\n.pane {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 1.5rem;\n  min-width: 0;\n}\n.pane-label {\n  display: inline-block;\n  font-size: 13px;\n  font-weight: 600;\n  padding: 0.125rem 0.625rem;\n  border-radius: 4px;\n  margin-bottom: 1rem;\n}\n.before .pane-label { background: var(--strike-soft); color: var(--strike); }\n.after .pane-label { background: var(--accent-soft); color: var(--accent); }\n.after { border-color: var(--accent); }\n.pane p, .pane li { font-size: 15px; margin: 0 0 0.5rem; }\n.pane ul { margin: 0; padding-left: 1.25rem; }\n.pane .meta {\n  font-size: 14px;\n  color: var(--muted);\n  border-bottom: 1px dashed var(--line);\n  padding-bottom: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n.changes {\n  margin: 1.25rem 0 0;\n  padding: 0;\n  list-style: none;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem 1.5rem;\n  font-size: 14px;\n  color: var(--muted);\n}\n.changes li::before {\n  content: \"\";\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--accent);\n  margin-right: 0.5rem;\n  vertical-align: middle;\n}\n\n/* 使用步骤 */\n.steps {\n  padding-block: 3.5rem;\n  border-top: 1px solid var(--line);\n}\n.steps h2, .faq h2 {\n  font-size: 1.75rem;\n  margin: 0 0 2rem;\n  letter-spacing: 0.02em;\n}\n.steps ol {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  counter-reset: step;\n  max-width: 40em;\n}\n.steps li {\n  counter-increment: step;\n  display: grid;\n  grid-template-columns: 3rem minmax(0, 1fr);\n  padding-block: 1.25rem;\n  border-bottom: 1px solid var(--line);\n}\n.steps li::before {\n  content: counter(step);\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: var(--accent);\n  line-height: 1.3;\n}\n.steps h3 { margin: 0 0 0.25rem; font-size: 1.125rem; }\n.steps p { margin: 0; color: var(--muted); }\n\n/* 常见问题 */\n.faq {\n  padding-block: 3.5rem;\n  border-top: 1px solid var(--line);\n}\n.faq dl { margin: 0; max-width: 40em; }\n.faq dt { font-weight: 600; font-size: 1.0625rem; margin-top: 1.5rem; }\n.faq dt:first-child { margin-top: 0; }\n.faq dd { margin: 0.375rem 0 0; color: var(--muted); line-height: 1.75; }\n\n/* 结尾 */\n.cta {\n  padding-block: 3.5rem;\n  border-top: 1px solid var(--line);\n}\n.cta h2 { font-size: 1.75rem; margin: 0 0 0.75rem; letter-spacing: 0.02em; }\n.cta p { color: var(--muted); margin: 0 0 1.5rem; }\n\nfooter {\n  border-top: 1px solid var(--line);\n  padding-block: 1.5rem;\n  font-size: 14px;\n  color: var(--muted);\n}\n\n@media (max-width: 760px) {\n  .nav-links { display: none; }\n  .hero { padding-block: 3rem 2.5rem; }\n  .demo-head, .compare { grid-template-columns: minmax(0, 1f