<form id="application">
<section class="form-section" id="basic"><div class="section-top"><div class="section-title"><span class="section-icon"><svg><use href="#i-user"/></svg></span><h2>基本信息</h2></div><span class="section-note"><span class="required">*</span> 为必填项</span></div><div class="grid"><div class="field"><label for="name">姓名<span class="required">*</span></label><input id="name" name="name" placeholder="请输入你的姓名" autocomplete="name" maxlength="50" required></div><div class="field"><label for="phone">手机号码<span class="required">*</span></label><div class="phone-wrap"><span class="prefix">+86</span><input id="phone" name="phone" type="tel" placeholder="请输入手机号码" autocomplete="tel-national" pattern="1[0-9]{10}" title="请输入 11 位中国大陆手机号码" required></div></div><div class="field"><label for="email">电子邮箱<span class="required">*</span></label><input id="email" name="email" type="email" placeholder="用于接收面试通知" autocomplete="email" required></div><div class="field"><label for="city">现居城市<span class="required">*</span></label><input id="city" name="city" placeholder="如：上海" autocomplete="address-level2" maxlength="50" required></div><div class="field"><label for="education">最高学历<span class="required">*</span></label><select id="education" name="education" required><option value="" disabled selected>请选择最高学历</option><option>博士</option><option>硕士</option><option>本科</option><option>大专</option><option>高中及以下</option></select></div><div class="field"><label for="years">工作年限<span class="required">*</span></label><select id="years" name="years" required><option value="" disabled selected>请选择工作年限</option><option>应届毕业生</option><option>1 年以内</option><option>1–3 年</option><option>3–5 年</option><option>5–10 年</option><option>10 年以上</option></select></div></div><div class="upload-label">附件简历 <span class="optional">（选填）</span></div><label class="upload" id="drop-zone" for="resume"><span class="upload-icon"><svg><use href="#i-doc"/></svg></span><span><strong id="file-label">点击上传，或将简历拖拽至此</strong><p id="file-hint">支持 PDF、DOC、DOCX 格式，文件不超过 10 MB</p></span><svg class="upload-right"><use href="#i-upload"/></svg><input type="file" id="resume" class="visually-hidden" accept=".pdf,.doc,.docx"></label><div class="error" id="file-error" role="alert" hidden></div></section>
<section class="form-section" id="work"><div class="section-top"><div class="section-title"><span class="section-icon"><svg><use href="#i-bag"/></svg></span><h2>工作经历</h2></div><button class="add-button" id="add-experience" type="button"><svg><use href="#i-plus"/></svg>添加经历</button></div><div id="experiences"></div></section>
<section class="form-section salary-section" id="salary"><div class="section-top"><div><div class="section-title"><span class="section-icon"><svg><use href="#i-wallet"/></svg></span><h2>期望薪资</h2></div><p class="section-subtitle">好的开始，是彼此期待的契合。</p></div><label class="checkbox"><input type="checkbox" name="negotiable" id="negotiable">薪资可面议</label></div><div class="grid"><div class="field"><label for="salary-min">期望月薪<span class="required">*</span></label><div class="salary-range"><div class="unit-input"><input id="salary-min" name="salaryMin" type="number" min="0" max="999" step="0.5" placeholder="最低" required aria-label="最低期望月薪，千元"><span class="unit">K</span></div><span>—</span><div class="unit-input"><input id="salary-max" name="salaryMax" type="number" min="0" max="999" step="0.5" placeholder="最高" required aria-label="最高期望月薪，千元"><span class="unit">K</span></div></div></div><div class="field"><label for="availability">预计到岗时间<span class="required">*</span></label><select id="availability" name="availability" required><option value="" disabled selected>请选择到岗时间</option><option>随时到岗</option><option>1 周以内</option><option>2 周以内</option><option>1 个月以内</option><option>1 个月以上</option></select></div></div><p class="salary-hint">税前月薪，以人民币计算，1 K = 1,000 元</p></section>
<div class="form-footer"><label class="consent"><input type="checkbox" name="consent" required><span>我已阅读并同意<button type="button" class="text-button" id="privacy-open">《个人信息保护声明》</button>，确认以上信息真实、准确。</span></label><div class="actions"><span class="local-note"><svg><use href="#i-shield"/></svg>你的信息仅用于本次招聘</span><div class="buttons"><button class="btn" type="button" id="save-draft">保存草稿</button><button class="btn btn-primary" type="submit">提交简历<svg><use href="#i-arrow"/></svg></button></div></div></div>
</form></div></main>
<footer><span class="footer-brand">© 2026 有序 · 让工作与热爱同行</span><span>每一种可能，都值得一次开始。</span></footer><div class="toast" id="toast" role="status" hidden></div>
<dialog id="privacy-dialog"><h2>个人信息保护声明</h2><p>本页面为本地演示，不会向服务器发送你的信息或简历文件。所选附件仅用于展示文件名。</p><p>点击“保存草稿”后，填写的信息将存储在当前浏览器中，不包含附件内容。请避免在公共设备上保存个人信息。</p><p>你可以清除本地草稿。完成填写后，可预览并下载信息副本；实际投递需通过招聘方的正式渠道完成。</p><div class="dialog-actions"><button class="btn" type="button" id="clear-draft">清除本地草稿</button><button class="btn btn-primary" type="button" data-close="privacy-dialog">我知道了</button></div></dialog>
<dialog id="review-dialog"><h2>简历已准备就绪</h2><p>请核对你的申请信息。当前为本地演示，尚未投递至招聘方；你可以下载填写内容留存。</p><div id="review-content" class="review-list"></div><div class="dialog-actions"><button class="btn" type="button" data-close="review-dialog">继续编辑</button><button class="btn btn-primary" type="button" id="download">下载填写内容</button></div></dialog>
<template id="experience-template"><div class="experience"><div class="experience-title"><span class="experience-heading"><span class="tiny-dot"></span><span class="experience-number"></span></span><button class="remove" type="button">删除</button></div><div class="grid"><div class="field"><label data-for="company">公司名称<span class="required">*</span></label><input data-key="company" placeholder="请输入公司名称" maxlength="100" required></div><div class="field"><label data-for="position">职位名称<span class="required">*</span></label><input data-key="position" placeholder="请输入你的职位" maxlength="100" required></div><div class="field full"><div class="label-row"><label class="field-label" data-for="start">在职时间<span class="required">*</span></label><label class="checkbox"><input data-key="current" type="checkbox">目前在职</label></div><div class="date-row"><input data-key="start" type="month" required aria-label="入职年月"><span>—</span><input data-key="end" type="month" required aria-label="离职年月"></div></div><div class="field full"><label data-for="description">工作内容与成就 <span class="optional">（选填）</span></label><div class="textarea-wrap"><textarea data-key="description" maxlength="1000" placeholder="介绍你的主要职责、参与的项目或取得的成果，让我们看到你的独特价值。"></textarea><span class="count">0 / 1000</span></div></div></div></div></template>
<script>
const form=document.getElementById('"'application'),experiences=document.getElementById('experiences'),draftKey='youxu-application-draft-v1';let seq=0,toastTimer;
function toast(message){const el=document.getElementById('toast');el.textContent=message;el.hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.hidden=true,4200)}
function renumber(){[...experiences.children].forEach((el,i)=>el.querySelector('.experience-number').textContent='工作经历 '+String(i+1).padStart(2,'0'))}
function addExperience(data={}){const fragment=document.getElementById('experience-template').content.cloneNode(true),block=fragment.querySelector('.experience'),id=++seq;block.querySelectorAll('[data-key]').forEach(input=>{const key=input.dataset.key;input.id='work-'+id+'-'+key;input.name='work-'+id+'-'+key;if(input.type==='checkbox')input.checked="'!!data[key];else input.value=data[key]||'"'';const label=block.querySelector('[data-for=\"'+key+'\"]');if(label)label.htmlFor=input.id});block.querySelector('.remove').addEventListener('click',()=>{block.remove();renumber();updateProgress()});block.querySelector('[data-key=\"current\"]').addEventListener('change',()=>syncExperience(block));block.addEventListener('input',()=>syncExperience(block));experiences.append(fragment);syncExperience(block);renumber();updateProgress();return block}
function syncExperience(block){const start=block.querySelector('[data-key=\"start\"]'),end=block.querySelector('[data-key=\"end\"]'),current=block.querySelector('[data-key=\"current\"]');end.disabled=current.checked;end.required="'!current.checked;end.min=start.value;end.setCustomValidity(!current.checked&&end.value&&start.value&&end.value<start.value?'"'离职时间不能早于入职时间':'');const now=new Date(),month=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');start.max=month;end.max=month;block.querySelector('.count').textContent=block.querySelector('textarea').value.length+' / 1000'}
function syncSalary(){const negotiable=document.getElementById('negotiable').checked,min=document.getElementById('salary-min'),max=document.getElementById('salary-max');[min,max].forEach(el=>{el.disabled=negotiable;el.required="'!negotiable});max.setCustomValidity(!negotiable&&min.value!=='"''&&max.value"'!=='"''&&Number(max.value)<Number(min.value)?'最高期望月薪不能低于最低期望月薪':'');updateProgress()}
function updateProgress(){const fields=[...form.querySelectorAll('[required]')].filter(el=>"'!el.disabled&&el.type!=='"'checkbox');const complete=fields.filter(el=>el.value.trim()&&el.validity.valid).length;const percent=fields.length?Math.round(complete/fields.length*100):0;document.getElementById('progress-text').textContent=percent+'%';document.getElementById('progress-fill').style.width=percent+'%';document.querySelector('[role=\"progressbar\"]').setAttribute('aria-valuenow',percent)}
function getData(){const fields={};form.querySelectorAll('[name]').forEach(el=>{if("'!el.name.startsWith('"'work-'))fields[el.name]=el.type==='checkbox'?el.checked:el.value});return{fields,experiences:[...experiences.children].map(block=>Object.fromEntries([...block.querySelectorAll('[data-key]')].map(el=>[el.dataset.key,el.type==='checkbox'?el.checked:el.value])))} }
addExperience();
try{const draft=JSON.parse(localStorage.getItem(draftKey)||'null');if(draft&&draft.fields&&Array.isArray(draft.experiences)){Object.entries(draft.fields).forEach(([key,value])=>{const input=form.elements.namedItem(key);if(input){if(input.type==='checkbox')input.checked="'!!value;else input.value=value}});experiences.replaceChildren();draft.experiences.forEach(addExperience);syncSalary();toast('"'已恢复本地草稿，附件需重新选择')}}catch(error){}
form.addEventListener('input',()=>{syncSalary();updateProgress()});form.addEventListener('change',updateProgress);
document.getElementById('add-experience').addEventListener('click',()=>{const block=addExperience();block.querySelector('input').focus()});
document.getElementById('save-draft').addEventListener('click',()=>{try{localStorage.setItem(draftKey,JSON.stringify(getData()));toast('草稿已保存至此浏览器，附件不会保存')}catch(error){toast('浏览器无法保存草稿，请检查存储设置')}});
document.getElementById('clear-draft').addEventListener('click',()=>{try{localStorage.removeItem(draftKey);toast('本地草稿已清除，当前填写内容仍保留')}catch(error){toast('无法访问本地存储')}});
const resume=document.getElementById('resume'),drop=document.getElementById('drop-zone');let selectedFile=null;
function selectFile(file){const error=document.getElementById('file-error');error.hidden=true;if("'!file)return;if(!/'"\\.(pdf|doc|docx)"'$/i.test(file.name)||file.size>10*1024*1024){resume.value='"'';selectedFile=null;document.getElementById('file-label').textContent='点击上传，或将简历拖拽至此';document.getElementById('file-hint').textContent='支持 PDF、DOC、DOCX 格式，文件不超过 10 MB';error.textContent='请选择不超过 10 MB 的 PDF、DOC 或 DOCX 文件。';error.hidden=false;return}selectedFile=file;document.getElementById('file-label').textContent=file.name;document.getElementById('file-hint').textContent=(file.size/1024/1024).toFixed(2)+' MB · 已选择，点击可更换'}
resume.addEventListener('change',()=>selectFile(resume.files[0]));['dragenter','dragover'].forEach(event=>drop.addEventListener(event,e=>{e.preventDefault();drop.classList.add('dragging')}));['dragleave','drop'].forEach(event=>drop.addEventListener(event,e=>{e.preventDefault();drop.classList.remove('dragging')}));drop.addEventListener('drop',e=>selectFile(e.dataTransfer.files[0]));
document.getElementById('privacy-open').addEventListener('click',()=>document.getElementById('privacy-dialog').showModal());document.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.close).close()));
form.addEventListener('submit',event=>{event.preventDefault();syncSalary();experiences.querySelectorAll('.experience').forEach(syncExperience);if("'!form.reportValidity())return;const data=getData(),fields=data.fields;const entries=[['"'申请职位','产品设计师'],['姓名',fields.name],['手机号码','+86 '+fields.phone],['电子邮箱',fields.email],['现居城市',fields.city],['最高学历',fields.education],['工作年限',fields.years],['期望月薪',fields.negotiable?'面议':fields.salaryMin+'–'+fields.salaryMax+' K'],['到岗时间',fields.availability],['附件简历',selectedFile?selectedFile.name+'（仅本地选择）':'未选择']];data.experiences.forEach((work,i)=>entries.push(['工作经历 '+(i+1),work.company+' · '+work.position+'，'+work.start+' 至 '+(work.current?'至今':work.end)+(work.description?'。'+work.description:'')]));const content=document.getElementById('review-content');content.replaceChildren();entries.forEach(([label,value])=>{const row=document.createElement('div'),key=document.createElement('span'),val=document.createElement('div');key.textContent=label;val.textContent=value;row.append(key,val);content.append(row)});document.getElementById('review-dialog').showModal()});
document.getElementById('download').addEventListener('click',()=>{const data=getData();const blob=new Blob([JSON.stringify({职位:'产品设计师',...data,附件:selectedFile?selectedFile.name:null,说明:'本地填写内容副本，不包含附件文件，尚未投递。'},null,2)],{type:'application/json;charset=utf-8'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='有序-简历填写内容.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('填写内容已导出，请另行保留简历附件')});
if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting);if(visible.length){const id=visible[0].target.id;document.querySelectorAll('.steps li').forEach(li=>li.classList.toggle('active',li.querySelector('a').hash==='#'+id))}},{rootMargin:'-5% 0px -60% 0px',threshold:0});document.querySelectorAll('.form-section').forEach(section=>observer.observe(section))}
updateProgress();
</script>
</body>
</html>
