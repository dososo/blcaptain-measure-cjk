+.account { border: 1px solid var(--line); background: white; border-radius: 8px; padding: 20px 18px 13px; }
+.account summary { list-style: none; display: flex; align-items: center; gap: 12px; }
+.account summary::-webkit-details-marker { display: none; }
+.app-icon { display: grid; place-items: center; height: 38px; width: 38px; border-radius: 10px; flex-shrink: 0; font-size: 24px; }
+.mail { color: #8b79bd; background: #f0eafa; }
+.chat { color: #6f97b4; background: #eaf2f9; }
+.people { color: #b69c60; background: #f7f0e2; }
+.docs { color: #749585; background: #eaf3ee; }
+.project { color: #868ac0; background: #eceefa; }
+.finance { color: #bc8c79; background: #fbede6; }
+.account strong { font-size: 14px; font-weight: 550; }
+.account summary small { display: block; margin-top: 2px; font-size: 11px; color: #a097a9; }
+.expand { margin-left: auto; color: #b7adbf; font-size: 17px; }
+.account[open] .expand { transform: rotate(45deg); }
+.account-meta { border-top: 1px solid #f1eef5; padding-top: 10px; margin-top: 17px; display: flex; justify-content: space-between; font-size: 10px; color: #978d9f; gap: 8px; }
+.account-details { font-size: 12px; color: #7b7089; }
+dl { margin: 16px 0; }
+dt { font-weight: 600; margin-top: 10px; }
+dd { margin: 3px 0 0; line-height: 1.75; }
+.security-note { display: flex; gap: 8px; align-items: center; color: #918799; margin-top: 15px; }
+.security-note p { font-size: 12px; }
+.help-section { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 20px; align-items: center; padding: 27px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: 36px; }
+.help-section h2 { font-size: 18px; }
+.help-section p { font-size: 11px; color: #94899e; margin-top: 6px; }
+.help-item > span { display: block; color: #b3a1c6; font-size: 12px; margin-bottom: 5px; }
+.help-item strong { font-size: 13px; font-weight: 500; }
+footer { display: flex; gap: 20px; padding: 22px 0; color: #a39ba9; font-size: 10px; }
+footer a { margin-left: auto; white-space: nowrap; }
