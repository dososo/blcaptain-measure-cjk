from pathlib import Path
from html.parser import HTMLParser
import re
p = Path('index.html')
s = p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.links=[]; self.in_article=False; self.words=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.add(a['id'])
        if tag=='a': self.links.append(a.get('href',''))
        if tag=='article': self.in_article=True
    def handle_endtag(self,tag):
        if tag=='article': self.in_article=False
    def handle_data(self,data):
        if self.in_article: self.words.append(data)
c=Check(); c.feed(s)
assert all(link[1:] in c.ids for link in c.links if link.startswith('#'))
assert '<html lang=\"zh-CN\">' in s and 'name=\"viewport\"' in s
print('已验证：HTML 可解析，页内链接有效，包含中文语言与移动端设置。')
print('文章区域中文字数：',len(re.findall(r'[\\u4e00-\\u9fff]', ''.join(c.words))))
print('文件：',p.resolve())
