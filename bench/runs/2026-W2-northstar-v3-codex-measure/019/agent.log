+    ];
+    const escapeHTML = value => String(value).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+    const highlight = value => escapeHTML(JSON.stringify(value,null,2)).replace(/(&quot;.*?&quot;)(\s*:)?/g,(all,str,colon)=>`<span class="${colon?'syntax-blue':'syntax-green'}">${str}</span>${colon||''}`);
+    function requestCode(e,language){
