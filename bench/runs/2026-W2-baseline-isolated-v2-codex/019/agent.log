+          <a class="endpoint-row" href="#list-users"><span class="method">GET</span><code>/v1/users</code><span class="row-desc">获取用户列表</span><svg><use href="#i-arrow"/></svg></a>
+          <a class="endpoint-row" href="#get-user"><span class="method">GET</span><code>/v1/users/{id}</code><span class="row-desc">获取用户详情</span><svg><use href="#i-arrow"/></svg></a>
