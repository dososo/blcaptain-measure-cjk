umeric: oldstyle-nums;\n}\n\np { margin: 0 0 1em; }\n\nstrong { font-weight: 700; }\n\n.dot {\n  text-emphasis: dot var(--accent);\n  -webkit-text-emphasis: dot var(--accent);\n}\n\nblockquote {\n  margin: 24px 0;\n  padding: 16px 20px;\n  background: var(--quote-bg);\n  border-left: 3px solid var(--accent);\n  color: var(--muted);\n}\n\nblockquote p { margin: 0; }\n\nfooter {\n  padding-top: 24px;\n  border-top: 1px solid var(--rule);\n  color: var(--muted);\n  font-size: 15px;\n}\n\nfooter p { margin: 0; }\n\n@media (max-width: 480px) {\n  main { padding-block: 44px 64px; }\n  h1 { font-size: 32px; }\n  h2 { font-size: 21px; }\n  body { font-size: 16px; }\n}\n","structuredPatch":[{"oldStart":46,"oldLines":7,"newStart":46,"newLines":7,"lines":[" .kicker {","   margin: 0 0 12px;","   color: var(--muted);","-  font-size: 15px;","+  font-size: 16px;","   letter-spacing: 0.05em;"," }"," "]},{"oldStart":60,"oldLines":7,"newStart":60,"newLines":7,"lines":[" .meta {","   margin: 0;","   color: var(--muted);","-  font-size: 15px;","+  font-size: 16px;"," }"," "," .intro { margin: 0 0 48px; }"]},{"oldStart":106,"oldLines":7,"newStart":106,"newLines":7,"lines":["   padding-top: 24px;","   border-top: 1px solid var(--rule);","   color: var(--muted);","-  font-size: 15px;","+  font-size: 16px;"," }"," "," footer p { margin: 0; }"]}],"userModified":false,"replaceAll":true},"tool_result_meta":[{"id":"toolu_01H7cFxF4eAvnF5jdrSiA63N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
