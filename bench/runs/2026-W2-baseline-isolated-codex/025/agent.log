+      current.addEventListener('change',sync);start.addEventListener('input',sync);end.addEventListener('input',sync);sync();
+      entry.querySelector('.remove-work').addEventListener('click',()=>{entry.remove();renumber();document.querySelector('#add-experience').focus()});list.append(entry);renumber();return entry;
+    }
+    function renumber(){list.querySelectorAll('.work-title').forEach((el,i)=>el.textContent='工作经历 '+String(i+1).padStart(2,'0'))}
+    function collect(){const values=Object.fromEntries(new FormData(form));values.experiences=[...list.children].map(entry=>Object.fromEntries([...entry.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.type==='checkbox'?input.checked:input.value]))).filter(item=>item.company||item.role||item.start||item.end||item.description);return values}
+    document.querySelector('#add-experience').addEventListener('click',()=>{const entry=addExperience();entry.querySelector('input').focus()});
