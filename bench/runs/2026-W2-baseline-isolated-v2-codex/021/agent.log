+<body>
+<div class="page">
+<header><div class="brand"><span class="brand-icon" aria-hidden="true">✳</span>同频 TONGPIN</div><div class="header-note">让相遇，发生</div></header>
+<main>
+<section class="intro" aria-labelledby="event-title">
+<div class="eyebrow">THE CITY INSPIRATION PROJECT</div>
+<h1 id="event-title">走进城市，<br>遇见<em>同频的你。</em></h1>
+<p class="lead">给日常留一点新鲜感。与有趣的人相聚，<br>交换想法、发现灵感，一起打开城市的另一面。</p>
+<div class="details"><div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 11h16"/></svg>2026.11.14 · 周六</div><div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>线下灵感交流会</div></div>
+<div class="art" aria-hidden="true"><span class="art-label">CONNECT. CREATE. INSPIRE.</span><div class="sun"></div><div class="arch"></div><div class="orbital"></div><div class="orbital second"></div><div class="star">✳</div><span class="art-bottom">BETTER TOGETHER ↗</span></div>
+<div class="intro-bottom">每一次相遇，都是新故事的开始。</div>
+</section>
+<section class="form-card" aria-labelledby="form-title">
+<div class="card-top"><div><h2 id="form-title">预留你的位置</h2><p class="card-subtitle">花一分钟填写，让我们更好地认识你。</p></div><span class="step">JOIN US ↗</span></div><div class="divider"></div>
+<form id="signup-form">
+<div class="field"><label for="name">姓名<span class="required" aria-hidden="true">*</span></label><input id="name" name="name" type="text" placeholder="怎么称呼你？" autocomplete="name" maxlength="40" required></div>
+<div class="field"><label for="phone">手机号<span class="required" aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" placeholder="请输入 11 位中国大陆手机号" autocomplete="tel-national" inputmode="tel" pattern="1[3-9][0-9]{9}" maxlength="11" title="请输入有效的 11 位中国大陆手机号" required></div>
+<div class="field"><label for="city">所在城市<span class="required" aria-hidden="true">*</span></label><div class="select-wrap"><select id="city" name="city" autocomplete="address-level2" required><option value="" disabled selected>选择你所在的城市</option><option>北京</option><option>上海</option><option>广州</option><option>深圳</option><option>杭州</option><option>成都</option><option>南京</option><option>武汉</option><option>西安</option><option>重庆</option><option value="other">其他城市</option></select></div></div>
+<div class="field" id="other-city-field" hidden><label for="other-city">城市名称<span class="required" aria-hidden="true">*</span></label><input id="other-city" name="otherCity" type="text" placeholder="请输入你所在的城市" maxlength="40" disabled></div>
+<fieldset><legend class="field-title">参加场次<span class="required" aria-hidden="true">*</span><span class="session-hint">选择一个适合你的时间</span></legend><div class="sessions">
+<label class="session"><input type="radio" name="session" value="上午场 · 10:00–12:00" required><span class="session-content"><span class="session-name">上午场</span><span class="session-time">10:00 – 12:00</span></span></label>
+<label class="session"><input type="radio" name="session" value="下午场 · 14:00–16:00" required><span class="session-content"><span class="session-name">下午场</span><span class="session-time">14:00 – 16:00</span></span></label>
+</div></fieldset>
+<label class="agreement"><input type="checkbox" name="consent" required><span>我已知悉：这是报名演示页面，填写的信息仅用于本页预览，不会发送或保存。</span></label>
+<p id="form-error" class="error" role="alert"></p>
+<button class="submit" type="submit">确认报名信息 <span aria-hidden="true">→</span></button>
+<p class="privacy"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5 7V5a3 3 0 0 1 6 0v2M8 10v2"/></svg>信息仅在当前页面展示，刷新后清空</p>
+</form>
+<div id="confirmation" class="confirmation" hidden tabindex="-1" aria-labelledby="confirmation-title"><div class="success-icon" aria-hidden="true">✓</div><h3 id="confirmation-title">报名信息已准备好</h3><p>感谢你的参与！请核对以下信息。<br>当前为演示页面，尚未向主办方提交报名。</p><dl id="summary" class="summary"></dl><button class="reset" id="edit-button" type="button">返回修改信息</button></div>
+</section>
+</main>
+<footer><span>© 2026 同频 TONGPIN · 城市灵感计划</span><span class="footer-tag">保持好奇，保持连接。</span></footer>
+</div>
+<script>
+const form = document.getElementById('signup-form');
+const city = document.getElementById('city');
+const otherCity = document.getElementById('other-city');
+const confirmation = document.getElementById('confirmation');
+const error = document.getElementById('form-error');
+city.addEventListener('change', () => {
+  const isOther = city.value === 'other';
+  document.getElementById('other-city-field').hidden = !isOther;
+  otherCity.disabled = !isOther;
+  otherCity.required = isOther;
+  if (isOther) otherCity.focus();
+});
+form.addEventListener('input', () => { error.textContent = ''; });
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  const name = document.getElementById('name').value.trim();
+  const selectedCity = city.value === 'other' ? otherCity.value.trim() : city.value;
+  if (!name || !selectedCity) {
+    error.textContent = !name ? '请输入有效姓名，不能仅填写空格。' : '请输入有效的城市名称。';
+    (!name ? document.getElementById('name') : otherCity).focus();
+    return;
+  }
+  const data = new FormData(form);
+  const summary = document.getElementById('summary');
+  summary.replaceChildren();
+  [['姓名', name], ['手机号', data.get('phone')], ['所在城市', selectedCity], ['参加场次', data.get('session')]].forEach(([label, value]) => {
+    const row = document.createElement('div');
+    const term = document.createElement('dt');
+    const detail = document.createElement('dd');
+    term.textContent = label;
+    detail.textContent = value;
+    row.append(term, detail);
+    summary.append(row);
+  });
+  form.hidden = true;
+  confirmation.hidden = false;
+  confirmation.focus();
+});
+document.getElementById('edit-button').addEventListener('click', () => {
+  confirmation.hidden = true;
+  form.hidden = false;
+  document.getElementById('name').focus();
+});
+window.addEventListener('pageshow', () => {
+  form.reset();
+  otherCity.disabled = true;
+  otherCity.required = false;
+  document.getElementById('other-city-field').hidden = true;
+  document.getElementById('summary').replaceChildren();
+  confirmation.hidden = true;
+  form.hidden = false;
+  error.textContent = '';
+});
+</script>
+</body>
+</html>

