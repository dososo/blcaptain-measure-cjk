sition: relative; cursor: pointer; }\n.type input { position: absolute; opacity: 0; pointer-events: none; }\n.type span {\n  display: flex; flex-direction: column; height: 100%;\n  padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 10px;\n  transition: border-color .15s, background .15s;\n}\n.type b { font-weight: 600; }\n.type small { color: var(--muted); font-size: .8rem; }\n.type:hover span { border-color: var(--accent); }\n.type input:checked + span { border-color: var(--accent); background: var(--accent-soft); }\n.type input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n/* 输入框 */\ntextarea, input[type=\"text\"] {\n  width: 100%; padding: 12px 14px; font: inherit; color: inherit;\n  background: var(--card); border: 1.5px solid var(--line); border-radius: 10px;\n  transition: border-color .15s;\n}\ntextarea { resize: vertical; min-height: 140px; }\ntextarea:focus, input[type=\"text\"]:focus { outline: none; border-color: var(--accent); }\n.invalid { border-color: var(--danger) !important; }\n.meta { display: flex; justify-content: space-between; gap: 12px; margin-top: 6px; }\n.count { margin-left: auto; color: var(--muted); font-size: .8rem; }\n.error { margin: 6px 0 0; color: var(--danger); font-size: .85rem; }\n.meta .error { margin: 0; }\n\n/* 上传 */\n.uploader { display: flex; flex-wrap: wrap; gap: 10px; }\n.thumbs { display: contents; list-style: none; margin: 0; padding: 0; }\n.thumb, .drop { width: 104px; height: 104px; border-radius: 10px; }\n.thumb { position: relative; overflow: hidden; border: 1px solid var(--line); }\n.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.remove {\n  position: absolute; top: 4px; right: 4px; width: 22px; height: 22px;\n  border: 0; border-radius: 50%; cursor: pointer; line-height: 22px; padding: 0;\n  background: rgb(0 0 0 / .6); color: #fff; font-size: 15px;\n}\n.drop {\n  display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;\n  width: auto; min-width: 104px; flex: 1 1 200px; padding: 8px 12px;\n  border: 1.5px dashed var(--line); color: var(--muted); cursor: pointer; font-size: .85rem;\n  transition: border-color .15s, background .15s, color .15s;\n}\n.drop small { font-size: .75rem; }\n.drop input { display: none; }\n.drop:hover, .drop:focus-visible, .drop.over { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); outline: none; }\n\n/* 按钮 */\n.submit, .ghost {\n  font: inherit; font-weight: 600; border-radius: 10px; cursor: pointer; padding: 12px 20px;\n}\n.submit { width: 100%; border: 0; background: var(--accent); color: #fff; transition: opacity .15s; }\n.submit:hover { opacity: .9; }\n.submit:disabled { opacity: .6; cursor: wait; }\n.ghost { background: transparent; border: 1.5px solid var(--line); color: var(--fg); }\n.ghost:hover { border-color: var(--accent); color: var(--accent); }\n\n/* 成功 */\n.done { text-align: center; padding: 48px 28px; }\n.check {\n  width: 60px; height: 60px; margin: 0 auto 16px; border-radius: 50%;\n  display: grid; place-items: center; font-size: 30px; color: #fff; background: var(--ok);\n}\n.done h2 { margin: 0 0 8px; font-size: 1.3rem; }\n.done p { margin: 0 0 24px; color: var(--muted); }\n\n@media (max-width: 480px) {\n  .wrap { padding-top: 24px; }\n  .card { padding: 20px 16px; }\n  .types { grid-template-columns: 1fr 1fr; }\n  .thumb { width: calc(33.333% - 7px); height: auto; aspect-ratio: 1; }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2282,"cache_read_input_tokens":31725,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2282},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0a6