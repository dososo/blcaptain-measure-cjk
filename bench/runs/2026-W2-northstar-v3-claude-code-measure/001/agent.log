one;\n}\n.brand small {\n  margin-left: 10px;\n  font-size: 13px;\n  font-weight: 400;\n  color: var(--ink-soft);\n  letter-spacing: 0.02em;\n}\n.site-nav {\n  display: flex;\n  gap: 24px;\n  font-size: 15px;\n}\n.site-nav a {\n  text-decoration: none;\n  color: var(--ink-soft);\n}\n.site-nav a:hover { color: var(--accent); }\n\n/* 首屏 */\n.hero .wrap {\n  display: grid;\n  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);\n  gap: 56px;\n  align-items: end;\n  padding-block: 88px 72px;\n}\n.hero h1 {\n  margin: 0 0 28px;\n  font-size: 52px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  line-height: 1.3;\n}\n.hero h1 span { color: var(--accent); }\n.hero-lead {\n  margin: 0 0 32px;\n  max-width: 26em;\n  color: var(--ink-soft);\n  font-size: 18px;\n}\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n}\n.btn {\n  display: inline-block;\n  padding: 11px 22px;\n  border: 1px solid var(--ink);\n  border-radius: 2px;\n  font-size: 15px;\n  text-decoration: none;\n  letter-spacing: 0.04em;\n}\n.btn-solid {\n  background: var(--ink);\n  color: var(--paper);\n}\n.btn-solid:hover { background: var(--accent); border-color: var(--accent); }\n.btn:not(.btn-solid):hover { color: var(--accent); border-color: var(--accent); }\n\n.roast-log {\n  margin: 0;\n  padding: 24px 26px;\n  background: var(--paper-deep);\n  border-left: 3px solid var(--accent);\n  font-size: 15px;\n}\n.roast-log h2 {\n  margin: 0 0 14px;\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n}\n.roast-log dl {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 8px 18px;\n  margin: 0;\n  line-height: 1.6;\n}\n.roast-log dt { color: var(--ink-soft); }\n.roast-log dd { margin: 0; }\n\n/* 通用分区 */\n.section {\n  border-top: 1px solid var(--line);\n  padding-block: 80px;\n}\n.section-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 8px 24px;\n  margin-bottom: 40px;\n}\n.section-head h2 {\n  margin: 0;\n  font-size: 34px;\n  font-weight: 700;\n  letter-spacing: 0.03em;\n}\n.section-head p {\n  margin: 0;\n  color: var(--ink-soft);\n  font-size: 15px;\n}\n\n/* 豆单 */\n.bean-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  border-top: 2px solid var(--ink);\n}\n.bean {\n  display: grid;\n  grid-template-columns: minmax(0, 2.2fr) minmax(0, 2fr) minmax(0, 1fr) auto;\n  gap: 8px 32px;\n  align-items: baseline;\n  padding-block: 26px;\n  border-bottom: 1px solid var(--line);\n}\n.bean-name h3 {\n  margin: 0 0 4px;\n  font-size: 21px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n.bean-origin {\n  margin: 0;\n  color: var(--ink-soft);\n  font-size: 14px;\n  line-height: 1.6;\n}\n.bean-notes {\n  margin: 0;\n  font-size: 16px;\n}\n.bean-roast {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n.bean-roast::before {\n  content: \"\";\n  flex: none;\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--dot, var(--mid-roast));\n}\n.bean-roast[data-level=\"light\"] { --dot: var(--light-roast); }\n.bean-roast[data-level=\"mid\"] { --dot: var(--mid-roast); }\n.bean-roast[data-level=\"dark\"] { --dot: var(--dark-roast); }\n.bean-price {\n  font-size: 17px;\n  white-space: nowrap;\n  text-align: right;\n}\n.bean-price small {\n  color: var(--ink-soft);\n  font-size: 13px;\n}\n.bean-featured .bean-name h3::after {\n  content: \"本周新烘\";\n  margin-left: 10px;\n  padding: 1px 7px;\n  border: 1px solid var(--accent);\n  color: var(--accent);\n  font-size: 12px;\n  font-weight: 400;\n  vertical-align: 3px;\n}\n.bean-footnote {\n  margin: 24px 0 0;\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n/* 烘焙理念 */\n.philosophy .wrap {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);\n  gap: 56px;\n}\n.philosophy .section-head {\n  display: block;\n  margin: 0;\n}\n.philosophy .section-head p { margin-top: 12px; }\n.principles {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  counter-reset: p;\n}\n.principles li {\n  counter-increment: p;\n  position: relative;\n  padding-left: 52px;\n  margin-bottom: 36px;\n}\n.principles li::before {\n  content: counter(p, decimal-leading-zero);\n  position: absolute;\n  left: 0;\n  top: 2px;\n  font-size: 15px;\n  color: var(--accent);\n  letter-spacing: 0.04em;\n}\n.principles h3 {\n  margin: 0 0 8px;\n  font-size: 21px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n.principles p {\n  margin: 0;\n  color: var(--ink-soft);\n}\n.quote {\n  margin: 8px 0 0;\n  padding: 28px 0 0;\n  border-top: 1px solid var(--line);\n  font-size: 19px;\n}\n.quote p { margin: 0 0 8px; }\n.quote footer {\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n/* 到店 */\n.visit .wrap {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 56px;\n}\n.visit .section-head { grid-column: 1 / -1; margin-bottom: 0; }\n.visit address {\n  font-style: normal;\n}\n.visit-block { margin-bottom: 32px; }\n.visit-block h3 {\n  margin: 0 0 8px;\n  font-size: 15px;\n  font-weight: 700;\n  color: var(--ink-soft);\n  letter-spacing: 0.04em;\n}\n.visit-block p { margin: 0; }\n.visit-address {\n  font-size: 22px;\n}\n.hours {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.hours li {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding-block: 6px;\n  border-bottom: 1px dashed var(--line);\n}\n.hours li span:last-child { white-space: nowrap; }\n.route {\n  margin: 0;\n  padding-left: 1.2em;\n}\n.route li { margin-bottom: 6px; }\n.visit-note {\n  margin: 0;\n  padding: 22px 24px;\n  background: var(--paper-deep);\n  font-size: 16px;\n}\n.visit-note h3 {\n  margin: 0 0 10px;\n  font-size: 17px;\n  font-weight: 700;\n}\n.visit-note p { margin: 0 0 10px; }\n.visit-note p:last-child { margin-bottom: 0; }\n\n/* 页脚 */\n.site-footer {\n  border-top: 1px solid var(--line);\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n.site-footer .wrap {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 8px 24px;\n  padding-block: 28px;\n}\n.site-footer p { margin: 0; }\n\n/* 窄屏 */\n@media (max-width: 860px) {\n  .hero .wrap,\n  .philosophy .wrap,\n  .visit .wrap {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 40px;\n  }\n  .hero .wrap { padding-block: 56px 48px; }\n  .hero h1 { font-size: 38px; }\n  .section { padding-block: 56px; }\n  .section-head h2 { font-size: 28px; }\n  .bean {\n    grid-template-columns: minmax(0, 1fr) auto;\n  }\n  .bean-name { grid-column: 1 / -1; }\n  .bean-notes { grid-column: 1 / -1; }\n}\n\n@media (max-width: 480px) {\n  .wrap { padding-inline: 18px; }\n  .hero h1 { font-size: 32px; }\n  .site-nav { gap: 18px; }\n}\n","structuredPatch":[{"oldStart":358,"oldLines":6,"newStart":358,"newLines":15,"lines":[" .visit-note p { margin: 0 0 10px; }"," .visit-note p:last-child { margin-bottom: 0; }"," ","+/* 正文行长上限：网格列里的段落也保证每行不超过约 36 字 */","+.bean-notes,","+.bean-footnote,","+.section-head p,","+.route li,","+.visit-note p {","+  max-width: 36em;","+}","+"," /* 页脚 */"," .site-footer {","   border-top: 1px solid var(--line);"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_014SEnoLPWSurigUCqXyJ2bT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
