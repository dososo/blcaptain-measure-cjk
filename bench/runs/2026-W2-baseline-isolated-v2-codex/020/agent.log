+  <script>
+    const days = [
+      {label:'欢迎加入',title:'先安顿下来，认识新环境',description:'完成报到与基础设置，让新开始井然有序。',tasks:[['办理入职手续','按 HR 通知提交材料，确认劳动合同及入职信息。','HR'],['领取办公设备与工位','确认电脑、配件、门禁及办公网络，检查设备可正常使用。','行政 / IT'],['激活基础工作账号','开通企业邮箱与即时通讯，修改初始密码并设置多因素验证。','IT 支持'],['认识你的团队与入职伙伴','和直属主管打个招呼，了解团队成员与日常沟通方式。','直属主管']]},
+      {label:'熟悉环境',title:'找到工具，也找到协作方式',description:'了解日常规则，搭建自己的工作空间。',tasks:[['阅读员工手册','了解作息、请假、考勤与报销流程，记录需要确认的问题。','HR'],['加入工作群与团队日历','确认团队公告渠道、例会时间及会议室预约方式。','入职伙伴'],['配置工作工具与权限','安装公司批准的工具，确认文档、项目与网络访问权限。','IT 支持'],['完成信息安全学习','了解数据分级、密码管理、可疑邮件识别与问题反馈渠道。','IT 支持']]},
+      {label:'了解业务',title:'把自己的角色放进团队全景',description:'从产品、业务到岗位，建立初步理解。',tasks:[['了解公司产品与业务','阅读业务介绍，了解主要客户、核心产品与服务流程。','入职伙伴'],['与直属主管进行首次沟通','对齐岗位职责、试用期目标、交付预期与反馈方式。','直属主管'],['熟悉团队工作流程','了解任务分配、评审、交付与跨团队协作方式。','团队成员']]},
+      {label:'开始实践',title:'从一件小事，开启真实协作',description:'在伙伴的支持下，完成一次轻量实践。',tasks:[['领取第一项入门任务','与主管确认任务范围、完成标准、时间安排及支持人。','直属主管'],['参与一次团队协作','参加例会或评审，了解讨论方式并主动分享观察。','团队成员'],['动手实践并记录问题','尝试完成任务，记录遇到的阻碍，及时向入职伙伴求助。','入职伙伴']]},
+      {label:'回顾展望',title:'给第一周一个小小的收尾',description:'回顾收获，带着清晰的方向进入下一周。',tasks:[['回顾本周的学习与收获','整理认识的人、熟悉的流程、完成的任务与待解决问题。','自己'],['与主管进行第一周复盘','分享感受与困难，获取反馈，确认需要补充的支持。','直属主管'],['制定下一周工作计划','对齐优先事项、时间节点与协作对象，明确下一步行动。','直属主管'],['检查账号与权限是否齐全','确认常用系统可用，将未解决的权限问题提交给 IT。','IT 支持']]}
+    ];
+    const accounts = [
+      {name:'企业邮箱',sub:'工作通知 · 对外沟通',owner:'IT 支持',icon:'mail',color:'#668cba',bg:'#eef3fb',detail:'账号：待分配；登录入口：待补充。请向 IT 领取企业邮箱地址，首次登录后修改密码，并按公司规范设置邮件签名。'},
+      {name:'即时通讯',sub:'团队消息 · 在线会议',owner:'IT 支持',icon:'chat',color:'#668a7a',bg:'#edf4f0',detail:'账号：待分配；登录入口：待补充。根据公司使用的平台接受组织邀请，完善姓名、部门等资料，并加入团队工作群。'},
+      {name:'人事 / OA 系统',sub:'考勤请假 · 审批报销',owner:'HR / 行政',icon:'user',color:'#b99360',bg:'#faf3e8',detail:'账号：待分配；登录入口：待补充。向 HR 确认工号与登录方式，核对个人信息，并了解请假、考勤和报销审批流程。'},
+      {name:'知识库',sub:'员工手册 · 业务文档',owner:'入职伙伴',icon:'book',color:'#9080b2',bg:'#f2eff8',detail:'账号：待分配；登录入口：待补充。向入职伙伴申请团队文档空间权限，从员工手册、团队介绍和岗位学习资料开始阅读。'},
