+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <svg class="svg-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
+    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
+    <symbol id="spark" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/></symbol>
+    <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
+    <symbol id="doc" viewBox="0 0 24 24"><path d="M14 3H5v18h14V8Zm0 0v5h5M8 12h8m-8 4h6"/></symbol>
+    <symbol id="mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></symbol>
+  </defs></svg>
+  <header class="site-header wrap">
+    <a class="brand" href="#" aria-label="落笔首页"><span class="brand-mark" aria-hidden="true">↳</span><span>落笔<span class="brand-ai">AI</span></span></a>
+    <nav aria-label="主导航"><a href="#scenarios">写作场景</a><a href="#how-it-works">使用方式</a><a href="#questions">常见问题</a></nav>
+    <a class="button button-small" href="#demo">体验改写 <svg><use href="#arrow"/></svg></a>
+  </header>
+  <main>
+    <section class="hero wrap" aria-labelledby="hero-title">
+      <div class="hero-copy">
+        <div class="eyebrow"><span class="status-dot"></span> 你的日常工作写作搭档</div>
+        <h1 id="hero-title">工作已经够忙，<br>表达交给<span class="handline">落笔。</span></h1>
