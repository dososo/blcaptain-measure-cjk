  "demos": [
    {
      "rule": "T02",
      "title": "中英文、中文与数字之间要有间距",
      "why": "汉字和字母、数字挤在一起，读的时候要自己找边界。measure.css 打开 text-autospace，浏览器自动留出约四分之一个字的空隙，文案里不用手打空格。",
      "width": 600,
      "off": "shots/demo-t02-off.png",
      "on": "shots/demo-t02-on.png"
    },
    {
      "rule": "T03",
      "title": "中文语境用全角标点",
      "why": "半角逗号、句号、问号又小又靠下，夹在汉字中间像没打完。中文句子用全角标点，字距才均匀。",
      "width": 600,
      "off": "shots/demo-t03-off.png",
      "on": "shots/demo-t03-on.png"
    },
    {
      "rule": "T05",
      "title": "正文行长 28–40 字",
      "why": "一行太长，眼睛从行尾回到下一行行首时容易串行。中文正文每行 28–40 个字最舒服，宽屏上要给正文限宽。",
      "width": 1040,
      "off": "shots/demo-t05-off.png",
      "on": "shots/demo-t05-on.png"
    },
    {
      "rule": "T06",
      "title": "正文行高不低于 1.5",
      "why": "汉字是方块字，字面撑满整个字身，行与行之间比西文更需要留白。行高 1.35 时上下两行已经显得挤，正文建议 1.6–1.9。",
      "width": 600,
      "off": "shots/demo-t06-off.png",
      "on": "shots/demo-t06-on.png"
    },
    {
      "rule": "T07",
      "title": "中文字距不能为负",
      "why": "西文大标题常用负字距收紧，搬到中文上，笔画会碰在一起。中文标题保持默认字距，靠字重和留白拉开层次。",
      "width": 600,
      "off": "shots/demo-t07-off.png",
      "on": "shots/demo-t07-on.png"
    },
    {
      "rule": "T08",
      "title": "中文不用斜体",
      "why": "中文字体没有真正的斜体，浏览器只能把字形硬生生歪过去。强调中文，用加粗、颜色或着重号。",
      "width": 600,
      "off": "shots/demo-t08-off.png",
      "on": "shots/demo-t08-on.png"
    },
    {
      "rule": "T11",
      "title": "最小字号：正文 ≥ 14px，任何中文 ≥ 12px",
      "why": "西文 10px 还能辨认，汉字笔画多，10px 时笔画会糊成一团。价格说明、标签这类小字，中文也不要小于 12px。",
      "width": 600,
      "off": "shots/demo-t11-off.png",
      "on": "shots/demo-t11-on.png"
    }
  ],
