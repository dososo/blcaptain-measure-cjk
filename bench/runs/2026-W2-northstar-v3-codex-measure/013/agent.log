+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <svg class="svg-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
+    <symbol id="cloud" viewBox="0 0 32 32"><path d="M8 24a7 7 0 0 1-1-13.9A9 9 0 0 1 24.5 12 6 6 0 0 1 24 24Z"/></symbol>
+    <symbol id="check" viewBox="0 0 20 20"><path d="m5 10 3 3 7-7"/></symbol>
