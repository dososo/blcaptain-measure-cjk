+    .endmark{display:block;width:7px;height:7px;background:var(--accent);margin:33px 0 0}
+    footer{border-top:1px solid var(--line);padding:25px 0 32px;display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;letter-spacing:1px;gap:20px}
+    footer a{color:var(--ink);padding:8px 0}
+    footer a:hover{color:var(--accent)}
+    @media(max-width:760px){.wrap{padding:0 25px}.masthead{height:78px}.tagline{font-size:10px;letter-spacing:1px}.hero{grid-template-columns:1fr;padding:42px 0 35px;gap:20px}h1{font-size:36px}.illustration{height:270px;max-width:340px;width:100%;margin:0 auto}.notebook{transform:rotate(-8deg) scale(.9)}.halo{width:235px;height:235px}.pen{height:200px;top:42px}.caption{bottom:-1px}.reading{grid-template-columns:1fr;gap:0;padding:33px 0 44px}.margin-note{display:none}.article-body{font-size:17px}blockquote{font-size:21px}footer{font-size:10px}}
