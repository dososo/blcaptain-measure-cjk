 h3 { margin: 0 0 6px; font-size: 1.15rem; }\n.card .when { color: var(--accent); font-weight: 700; margin: 0 0 10px; }\n.card p { margin: 0 0 8px; color: var(--muted); }\n.card ul { margin: 8px 0 0; padding-left: 1.1em; color: var(--muted); }\n\n/* 日历条 */\n.week {\n  display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;\n  margin-top: 28px; text-align: center; font-size: .85rem;\n}\n.week div { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 4px; color: var(--muted); }\n.week div.on { border-color: var(--accent); color: var(--fg); }\n.week div b { display: block; font-size: .95rem; color: var(--fg); }\n.week div small { display: block; margin-top: 4px; color: var(--accent); font-weight: 700; }\n\n/* 难度 */\n.levels { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }\n.level { border-top: 5px solid var(--c); }\n.level .tag {\n  display: inline-block; font-size: .8rem; font-weight: 700; padding: 2px 10px;\n  border-radius: 999px; color: var(--c); border: 1.5px solid var(--c); margin-bottom: 10px;\n}\n.level dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; margin: 14px 0; font-size: .95rem; }\n.level dt { color: var(--muted); }\n.level dd { margin: 0; font-weight: 600; }\n.lv1 { --c: var(--green); }\n.lv2 { --c: var(--amber); }\n.lv3 { --c: var(--red); }\n.note { margin-top: 20px; font-size: .92rem; color: var(--muted); }\n\n/* 报名步骤 */\n.steps { counter-reset: s; list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }\n.steps li { counter-increment: s; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 18px 18px 64px; position: relative; min-width: 0; }\n.steps li::before {\n  content: counter(s); position: absolute; left: 18px; top: 18px;\n  width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--accent-ink);\n  display: grid; place-items: center; font-weight: 800;\n}\n.steps b { display: block; margin-bottom: 4px; }\n.steps span { color: var(--muted); font-size: .95rem; }\n\n.signup { display: grid; gap: 24px; grid-template-columns: 1.4fr 1fr; align-items: start; }\n@media (max-width: 820px) { .signup { grid-template-columns: 1fr; } }\n\nform .row { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }\n@media (max-width: 520px) { form .row { grid-template-columns: 1fr; } }\nlabel { display: block; font-weight: 600; font-size: .92rem; margin-bottom: 14px; }\ninput, select, textarea {\n  display: block; width: 100%; margin-top: 6px; padding: 10px 12px;\n  font: inherit; color: var(--fg); background: var(--bg);\n  border: 1px solid var(--line); border-radius: 10px;\n}\ninput:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }\n.check { display: flex; gap: 8px; align-items: flex-start; font-weight: 400; color: var(--muted); }\n.check input { width: auto; margin-top: 5px; }\n.ok { background: color-mix(in srgb, var(--green) 14%, var(--surface)); border: 1px solid var(--green); border-radius: 10px; padding: 14px; margin-top: 14px; }\n\n.contact p { margin: 0 0 12px; }\n.contact code { background: var(--bg); padding: 2px 8px; border-radius: 6px; border: 1px solid var(--line); font-size: .95rem; word-break: break-all; }\n\n/* FAQ */\ndetails { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 10px; }\nsummary { cursor: pointer; font-weight: 700; }\ndetails p { margin: 10px 0 0; color: var(--muted); }\n\nfooter { border-top: 1px solid var(--line); padding-block: 28px; color: var(--muted); font-size: .9rem; text-align: center; }\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2299,"cache_read_input_tokens":31725,"cache_creation