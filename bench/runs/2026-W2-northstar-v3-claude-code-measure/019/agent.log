  --code-muted: #808a95;\n  --get: #7fd39a;\n  --get-bg: #1f3326;\n  --post: #8db8ee;\n  --post-bg: #1d2a3b;\n  --patch: #e7bf6a;\n  --patch-bg: #362c17;\n  --delete: #f09a92;\n  --delete-bg: #3b2120;\n  color-scheme: dark;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--sans);\n  font-size: 16px;\n}\n\na { color: var(--accent); text-underline-offset: 0.2em; }\n\n.layout {\n  display: grid;\n  grid-template-columns: 15rem minmax(0, 1fr);\n  max-width: 76rem;\n  margin: 0 auto;\n  padding-inline: 1.5rem;\n  gap: 3rem;\n}\n\n/* 侧栏导航 */\n.sidebar {\n  position: sticky;\n  top: 0;\n  align-self: start;\n  max-height: 100vh;\n  overflow-y: auto;\n  padding-block: 2.5rem;\n}\n\n.brand {\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.4;\n  margin: 0 0 0.25rem;\n}\n\n.version {\n  color: var(--muted);\n  font-size: 0.875rem;\n  line-height: 1.5;\n  margin: 0 0 2rem;\n}\n\n.nav-group {\n  color: var(--muted);\n  font-size: 0.8125rem;\n  font-weight: 600;\n  line-height: 1.5;\n  margin: 1.5rem 0 0.5rem;\n}\n\n.nav { list-style: none; margin: 0; padding: 0; }\n.nav li { line-height: 1.6; }\n\n.nav a {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.3rem 0.5rem;\n  margin-inline: -0.5rem;\n  border-radius: 4px;\n  color: var(--fg);\n  font-size: 0.9375rem;\n  text-decoration: none;\n}\n\n.nav a:hover { background: var(--sunken); }\n\n/* 正文 */\nmain { padding-block: 2.5rem 6rem; min-width: 0; }\n\nh1 {\n  font-size: 2rem;\n  font-weight: 600;\n  letter-spacing: 0;\n  margin: 0 0 1rem;\n}\n\nh2 {\n  font-size: 1.5rem;\n  font-weight: 600;\n  margin: 0 0 1rem;\n  padding-top: 1rem;\n}\n\nh3 {\n  font-size: 1.0625rem;\n  font-weight: 600;\n  margin: 2rem 0 0.75rem;\n}\n\np { margin: 0 0 1rem; }\n\n.lead { font-size: 1.0625rem; color: var(--muted); }\n\nsection {\n  padding-block: 2.5rem;\n  border-top: 1px solid var(--line);\n  scroll-margin-top: 0.5rem;\n}\n\nsection:first-of-type { border-top: 0; padding-top: 0; }\n\nul.plain, ol.plain { margin: 0 0 1rem; padding-left: 1.25rem; }\nul.plain li, ol.plain li { margin-bottom: 0.375rem; }\n\n/* 接口行：方法 + 路径 */\n.endpoint {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.75rem 1rem;\n  margin: 0 0 1.25rem;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  font-family: var(--mono);\n  font-size: 0.9375rem;\n  line-height: 1.5;\n  overflow-x: auto;\n}\n\n.method {\n  display: inline-block;\n  min-width: 4.25em;\n  padding: 0.125rem 0.5rem;\n  border-radius: 4px;\n  font-family: var(--mono);\n  font-size: 0.75rem;\n  font-weight: 600;\n  line-height: 1.6;\n  text-align: center;\n}\n\n.method.get { color: var(--get); background: var(--get-bg); }\n.method.post { color: var(--post); background: var(--post-bg); }\n.method.patch { color: var(--patch); background: var(--patch-bg); }\n.method.delete { color: var(--delete); background: var(--delete-bg); }\n\n.scope {\n  margin-left: auto;\n  color: var(--muted);\n  font-size: 0.8125rem;\n}\n\n/* 行内代码 */\ncode {\n  font-family: var(--mono);\n  font-size: 0.875em;\n  background: var(--sunken);\n  padding: 0.1em 0.35em;\n  border-radius: 3px;\n}\n\n/* 代码块 */\n.code {\n  position: relative;\n  margin: 0 0 1.25rem;\n  background: var(--code-bg);\n  border-radius: 6px;\n}\n\n.code-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.5rem 0.75rem 0.5rem 1rem;\n  border-bottom: 1px solid rgba(128, 128, 128, 0.25);\n  color: var(--code-muted);\n  font-size: 0.8125rem;\n  line-height: 1.5;\n}\n\n.copy {\n  font: inherit;\n  color: var(--code-muted);\n  background: transparent;\n  border: 1px solid rgba(128, 128, 128, 0.35);\n  border-radius: 4px;\n  padding: 0.125rem 0.625rem;\n  cursor: pointer;\n}\n\n.copy:hover { color: var(--code-fg); }\n\npre {\n  margin: 0;\n  padding: 1rem;\n  overflow-x: auto;\n  color: var(--code-fg);\n  font-family: var(--mono);\n  font-size: 0.875rem;\n  line-height: 1.65;\n}\n\npre code { background: none; padding: 0; font-size: inherit; color: inherit; }\n\n.c { color: var(--code-muted); }\n\n/* 参数表 */\n.table-wrap {\n  overflow-x: auto;\n  margin: 0 0 1.25rem;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: var(--surface);\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.9375rem;\n  line-height: 1.65;\n}\n\nth, td {\n  text-align: left;\n  vertical-align: top;\n  padding: 0.625rem 0.875rem;\n  border-bottom: 1px solid var(--line);\n}\n\ntr:last-child td { border-bottom: 0; }\n\nth {\n  color: var(--muted);\n  font-size: 0.8125rem;\n  font-weight: 600;\n  background: var(--sunken);\n  white-space: nowrap;\n}\n\ntd:first-child { white-space: nowrap; }\ntd code { white-space: nowrap; }\n\n.req { color: var(--delete); font-size: 0.8125rem; white-space: nowrap; }\n.opt { color: var(--muted); font-size: 0.8125rem; white-space: nowrap; }\n\n/* 提示框 */\n.note {\n  margin: 0 0 1.25rem;\n  padding: 0.875rem 1rem;\n  border-left: 3px solid var(--accent);\n  background: var(--surface);\n  border-radius: 0 6px 6px 0;\n}\n\n.note p { margin: 0; }\n\n.emph { text-emphasis: dot; }\n\n@media (max-width: 52rem) {\n  .layout {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0;\n    padding-inline: 1rem;\n  }\n\n  .sidebar {\n    position: static;\n    max-height: none;\n    padding-block: 1.5rem 0;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .version { margin-bottom: 1rem; }\n\n  main { padding-top: 1.5rem; }\n\n  h1 { font-size: 1.625rem; }\n\n  .scope { margin-left: 0; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01CoBznZRAfRcpU9aGgNuiAS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
