+    const dateString = date => `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
+    const lastDate = new Date(today); lastDate.setDate(today.getDate()+29);
+    dateInput.min = dateString(today); dateInput.max = dateString(lastDate); dateInput.value = dateString(today);
