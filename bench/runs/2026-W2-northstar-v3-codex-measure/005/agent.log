+.section-kicker { color: var(--orange); font-size: 11px; letter-spacing: 2px; }
+h2 { font-size: 30px; font-weight: 650; margin: 12px 0 0; }
+.section-heading>p { color: var(--muted); font-size: 14px; margin: 0 0 3px; }
+.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
+.service-card { position: relative; background: #fffdf7; border: 1px solid #e5e3d8; border-radius: 10px; padding: 27px 24px 24px; }
+.service-icon { width: 34px; height: 34px; fill: none; stroke: #627c58; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+.card-number { position: absolute; right: 23px; top: 30px; font-size: 12px; color: #9b9e8e; }
+h3 { font-size: 19px; font-weight: 650; margin: 23px 0 12px; }
+.service-card p { font-size: 14px; color: var(--muted); margin: 0; max-width: 36em; }
+.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
+.tags span { padding: 5px 8px; font-size: 12px; background: #f0f1e8; color: #65745b; border-radius: 4px; }
+.doctors-section { background: #eeefe5; }
+.doctor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
+.doctor-card { display: flex; align-items: center; gap: 16px; padding: 22px 0; border-top: 1px solid #d6dacb; }
+.portrait { flex-shrink: 0; width: 90px; height: 108px; overflow: hidden; background: #d4ddca; border-radius: 45px 45px 8px 8px; }
+.portrait svg { height: 112px; width: 112px; margin-left: -11px; }
+.portrait-two { background: #e4cfb6; }
+.portrait-three { background: #d6dcd8; }
+.doctor-card h3 { margin: 0 0 10px; font-size: 18px; }
+.doctor-card h3 span { display: inline-block; font-size: 12px; font-weight: 400; color: var(--muted); margin-left: 6px; }
+.doctor-card p { font-size: 13px; color: var(--muted); margin: 0; }
+blockquote { font-size: 12px; margin: 12px 0 0; color: #5d7059; line-height: 1.7; }
+.sample-note { color: #767e6c; font-size: 12px; margin: 12px 0 0; }
+.visit-card { display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; padding: 48px 56px; background: var(--green); color: #f6f3e8; border-radius: 12px; }
+.visit-card .eyebrow { color: #c2cdb5; font-size: 11px; letter-spacing: 2px; }
+.visit-card h2 { font-size: 31px; line-height: 1.5; margin-top: 18px; }
+.visit-copy>p { color: #c7d0c3; font-size: 14px; margin: 17px 0 22px; }
+.phone-number { font-size: clamp(25px, 3vw, 36px); font-weight: 600; display: inline-flex; gap: 25px; align-items: center; }
+.phone-number span { font-size: 25px; color: #e4b689; }
+.phone-note { display: block; color: #bac7b5; font-size: 12px; margin-top: 8px; }
+.visit-info { border-left: 1px solid #5b6c59; padding-left: 42px; display: flex; flex-direction: column; justify-content: center; gap: 25px; }
+.info-label { display: block; font-size: 12px; color: #b8c7ac; margin-bottom: 8px; }
+.visit-info strong { font-size: 16px; font-weight: 500; }
+.visit-info p { font-size: 12px; color: #c1cbb9; margin: 6px 0 0; }
+.visit-tip { display: flex; align-items: center; gap: 14px; padding-top: 18px; border-top: 1px solid #5b6c59; }
+.visit-tip .icon { color: #d7be91; stroke: none; width: 25px; height: 25px; }
+.visit-tip p { margin: 0; line-height: 1.8; }
+footer { display: flex; align-items: center; gap: 22px; padding: 0 0 32px; }
+.footer-brand { font-size: 15px; gap: 9px; }
+.footer-brand .brand-mark { width: 30px; height: 30px; }
+.footer-brand .brand-mark svg { width: 18px; height: 18px; }
+footer p, footer>span { color: var(--muted); font-size: 12px; }
+footer>span { margin-left: auto; }
+@media(min-width: 1450px) { .hero { min-height: 660px; } }
