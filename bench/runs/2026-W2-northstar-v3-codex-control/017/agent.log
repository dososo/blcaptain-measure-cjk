+<body id="top">
+  <aside class="sidebar" aria-label="文档导航">
+    <a class="brand" href="#top" aria-label="Dev Handbook 首页"><span class="brand-mark">/.</span><span>Dev Handbook<small>BUILD BETTER, TOGETHER.</small></span></a>
+    <div class="sidebar-label">ENGINEERING / 工程实践</div>
+    <nav class="nav">
+      <a href="#overview" class="active" aria-current="location"><span class="nav-num">00</span>规范概览</a>
