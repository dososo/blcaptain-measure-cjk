class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.refs=[]; self.external=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        for k in ('href','src'):
            v=a.get(k,'')
            if v.startswith('#') and len(v)>1:self.refs.append(v[1:])
            if v.startswith(('http:','https:')):self.external.append(v)
