from pathlib import Path
p=Path('style.css')
s=p.read_text()
s=s.replace('.art-sticker>span:last-child{font-size:10px;', '.art-sticker>span:last-child{font-size:12px;')
s=s.replace('.beginner{font-size:10px;', '.beginner{font-size:12px;')
s=s.replace('.section-note{max-width:76em;', '.section-note{max-width:36em;')
s=s.replace('.section-note{max-width:36em;margin-top:27px;color:var(--muted);font-size:12px;}', '.section-note{max-width:36em;margin-top:27px;color:var(--muted);font-size:14px;}')
s=s.replace('.route-footnote p{font-size:12px;max-width:70em;}', '.route-footnote p{font-size:14px;max-width:36em;}')
s=s.replace('.route-name p{font-size:12px;', '.route-name p{font-size:14px;')
s=s.replace('.route-name p{font-size:13px;}', '.route-name p{font-size:14px;}')
s=s.replace('.steps p{font-size:12px;', '.steps p{font-size:14px;')
s=s.replace('.form-intro{font-size:12px;', '.form-intro{font-size:14px;')
s=s.replace('.form-note{font-size:12px;', '.form-note{font-size:14px;')
s += '\\n.art-topline>span:last-child{font-size:12px}.signup #copy-status{font-size:14px}\\n'
p.write_text(s)
PY
