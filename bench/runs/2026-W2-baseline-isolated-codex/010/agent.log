from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.links = []
        self.faq = 0
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if tag == 'a' and attrs.get('href', '').startswith('#'): self.links.append(attrs['href'][1:])
        if tag == 'details': self.faq += 1
p = Path('index.html')
s = p.read_text()
c = Check()
c.feed(s)
assert len(c.ids) == len(set(c.ids)), 'Duplicate IDs'
assert set(c.links) <= set(c.ids), 'Broken anchor links'
