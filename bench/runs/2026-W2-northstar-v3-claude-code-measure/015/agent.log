lEl.textContent = billable === 0\n        ? \"全部在免费额度（\" + fmt(a.free) + \" 次）以内。\"\n        : \"扣除免费额度 \" + fmt(a.free) + \" 次后，计费 \" + fmt(billable) + \" 次。\";\n    }\n\n    apiSel.addEventListener(\"change\", update);\n    callsIn.addEventListener(\"input\", update);\n    document.getElementById(\"calc\").addEventListener(\"submit\", function (e) { e.preventDefault(); });\n    update();\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":18,"oldLines":15,"newStart":18,"newLines":15,"lines":["     <section aria-labelledby=\"free-title\">","       <h2 id=\"free-title\">每月免费额度</h2>","       <div class=\"free\">","-        <div class=\"free-card\">","+        <div class=\"free-card measure-prose\">","           <p class=\"num\">18 万次</p>","           <p>所有接口合计的免费调用次数，每月 1 日自动重置。</p>","         </div>","-        <div class=\"free-card\">","+        <div class=\"free-card measure-prose\">","           <p class=\"num\">¥0</p>","           <p>免费额度内不收费，注册即可使用，无需绑定银行卡。</p>","         </div>","-        <div class=\"free-card\">","+        <div class=\"free-card measure-prose\">","           <p class=\"num\">按接口独立</p>","           <p>各接口额度互不占用，某个接口用完不影响其他接口。</p>","         </div>"]}],"userModified":false,"replaceAll":true},"tool_result_meta":[{"id":"toolu_01ER5jqxRHxjCt3sR3zZL8Bt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
