from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.links=[]; self.headings=0
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if 'id' in attrs: self.ids.add(attrs['id'])
        if tag=='a': self.links.append(attrs.get('href',''))
        if tag=='h2': self.headings+=1
p=Path('index.html')
c=Check(); c.feed(p.read_text()); c.close()
assert all(link[1:] in c.ids for link in c.links if link.startswith('#'))
assert c.headings==5
assert '<meta name=\"viewport\"' in p.read_text()
print(f'检查通过：{p.name}，{p.stat().st_size} 字节，5 个游记小标题，页内链接均有效。')
