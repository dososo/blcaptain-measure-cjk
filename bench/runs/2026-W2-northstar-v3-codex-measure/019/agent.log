+    function renderSearch(){const q=searchInput.value.trim().toLowerCase();const found=searchable.filter(item=>(item.title+' '+item.text).toLowerCase().includes(q));document.querySelector('#search-results').innerHTML=found.length?found.map(item=>`<a href="#${item.id}"><strong>${item.title}</strong><span>${escapeHTML(item.text)}</span><b>↗</b></a>`).join(''):'<p class="empty-search">没有找到相关内容，请尝试“用户”或“Token”。</p>';}
