from html.parser import HTMLParser
from pathlib import Path
import subprocess
import re
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.anchors=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a' and a.get('href','').startswith('#') and len(a['href'])>1: self.anchors.append(a['href'][1:])
p=Path('index.html'); s=p.read_text(); c=Check(); c.feed(s)
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert set(c.anchors)<=set(c.ids), 'Broken internal anchors'
assert not re.search(r'(?:src|href)=[\\\"\\']https?://',s), 'External resource'
js=re.search(r'<script>(.*?)</script>',s,re.S).group(1)
r=subprocess.run(['node','--check'],input=js,text=True,capture_output=True)
assert r.returncode==0,r.stderr
print('PASS: HTML parsed, internal anchors valid, JavaScript syntax valid, no external resources.')
print(f'Created index.html ({p.stat().st_size:,} bytes).')
