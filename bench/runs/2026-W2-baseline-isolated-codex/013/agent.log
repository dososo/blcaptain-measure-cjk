+    <footer><a class="footer-brand" href="#">云屿 / CLOUD ISLE</a><span class="copyright">© 2026 云屿 Cloud Isle · 让珍贵，始终在身边</span><div class="footer-links"><button data-info="privacy">隐私政策</button><button data-info="terms">服务条款</button><a href="#faq">帮助中心 ↗</a></div></footer>
+  </div>
+  <dialog id="info-dialog" aria-labelledby="dialog-title"><button class="close" aria-label="关闭对话框">×</button><div class="dialog-tag">CLOUD ISLE</div><h2 id="dialog-title"></h2><p id="dialog-content"></p><button class="dialog-action">知道了</button></dialog>
+  <script>
+    const cycleButtons = document.querySelectorAll('[data-cycle]');
+    let cycle = 'annual';
+    cycleButtons.forEach(button => button.addEventListener('click', () => {
+      cycle = button.dataset.cycle;
+      cycleButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+      document.querySelectorAll('.plan').forEach(plan => {
+        const amount = plan.querySelector('.amount');
+        amount.textContent = amount.dataset[cycle];
+        plan.querySelector('.billed').textContent = cycle === 'annual' ? `按年支付 ¥${Number(plan.querySelector('.billed').dataset.total).toLocaleString('zh-CN')}，每年结算` : `按月支付 ¥${amount.dataset.monthly}，每月结算`;
+      });
+    }));
+    const dialog = document.querySelector('#info-dialog');
+    function showInfo(title, content) {
+      document.querySelector('#dialog-title').textContent = title;
+      document.querySelector('#dialog-content').textContent = content;
+      dialog.showModal();
+    }
+    document.querySelectorAll('.choose').forEach(button => button.addEventListener('click', () => {
+      const amount = button.closest('.plan').querySelector('.amount').dataset[cycle];
+      const total = cycle === 'annual' ? Number(amount) * 12 : Number(amount);
+      showInfo(`${button.dataset.plan} · ${button.dataset.capacity}`, `你选择了${cycle === 'annual' ? '年付' : '月付'}方案，每${cycle === 'annual' ? '年' : '月'} ¥${total.toLocaleString('zh-CN')}。这是云屿的定价演示页面，暂未开放账户注册与付款，不会产生任何费用。`);
+    }));
+    document.querySelector('#contact-sales').addEventListener('click', () => showInfo('为团队定制更大空间', '企业方案可按团队人数、所需容量和协作需求定制。当前为产品演示，销售咨询尚未开放；你可以先查看个人套餐，了解基础容量与功能。'));
+    document.querySelector('[data-info="privacy"]').addEventListener('click', () => showInfo('隐私说明', '此演示页面不会收集个人信息，不使用 Cookie 或分析追踪，也不会上传你的数据。页面中的套餐选择仅在当前页面内展示。正式服务上线后，将提供完整隐私政策。'));
+    document.querySelector('[data-info="terms"]').addEventListener('click', () => showInfo('服务条款说明', '此页面为云存储产品定价演示，所示套餐、价格及服务规则用于展示，不构成实际服务承诺。当前不提供购买、存储或续费服务。'));
+    dialog.querySelectorAll('.close, .dialog-action').forEach(button => button.addEventListener('click', () => dialog.close()));
+    dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+  </script>
+</body>
+</html>

