; }\n:not(pre) > code { background: var(--code-bg); padding: 0.1em 0.4em; border-radius: 4px; }\n\n.layout {\n  display: grid;\n  grid-template-columns: 15rem minmax(0, 1fr);\n  max-width: 72rem;\n  margin: 0 auto;\n  padding-inline: 1.5rem;\n  gap: 2.5rem;\n}\nnav {\n  position: sticky;\n  top: env(safe-area-inset-top, 0px);\n  align-self: start;\n  padding-block: 2rem;\n  max-height: 100vh;\n  overflow-y: auto;\n}\nnav .brand { font-weight: 700; font-size: 1.1rem; margin-bottom: 1.25rem; }\nnav h4 { margin: 1.25rem 0 0.4rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }\nnav ul { list-style: none; margin: 0; padding: 0; }\nnav li a { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.5rem; border-radius: 6px; color: var(--fg); font-size: 0.9rem; }\nnav li a:hover { background: var(--surface); text-decoration: none; }\n\nmain { padding-block: 2rem 4rem; min-width: 0; }\nh1 { font-size: 2rem; margin: 0 0 0.5rem; }\nh2 { font-size: 1.4rem; margin: 3rem 0 1rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }\nh3 { font-size: 1.05rem; margin: 1.5rem 0 0.5rem; }\n.lead { color: var(--muted); margin-top: 0; }\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 1.25rem 1.5rem;\n  margin: 1rem 0;\n}\n.endpoint {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;\n  font-family: \"SF Mono\", Menlo, Consolas, monospace;\n  font-size: 1rem;\n  background: var(--code-bg);\n  border-radius: 8px;\n  padding: 0.6rem 0.9rem;\n  overflow-wrap: anywhere;\n}\n.method {\n  display: inline-block;\n  min-width: 3.6rem;\n  text-align: center;\n  font-size: 0.72rem;\n  font-weight: 700;\n  padding: 0.15rem 0.45rem;\n  border-radius: 4px;\n  color: var(--surface);\n  font-family: \"SF Mono\", Menlo, Consolas, monospace;\n}\n.get { background: var(--get); }\n.post { background: var(--post); }\n.patch { background: var(--patch); }\n.delete { background: var(--delete); }\n\n.table-wrap { overflow-x: auto; margin: 0.5rem 0 1rem; }\ntable { width: 100%; border-collapse: collapse; font-size: 0.9rem; }\nth, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }\nth { color: var(--muted); font-weight: 600; font-size: 0.8rem; }\ntd code { white-space: nowrap; }\n.req { color: var(--delete); font-size: 0.75rem; font-weight: 600; }\n.opt { color: var(--muted); font-size: 0.75rem; }\n\npre {\n  background: var(--code-bg);\n  color: var(--code-fg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 0.9rem 1rem;\n  overflow-x: auto;\n  margin: 0.5rem 0 1rem;\n  line-height: 1.5;\n}\n.examples { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }\n.examples > div { min-width: 0; }\n.label { font-size: 0.8rem; color: var(--muted); font-weight: 600; }\n\n.note {\n  background: var(--note-bg);\n  border-left: 4px solid var(--note-border);\n  border-radius: 6px;\n  padding: 0.75rem 1rem;\n  margin: 1rem 0;\n  font-size: 0.92rem;\n}\n.status { font-weight: 600; font-family: \"SF Mono\", Menlo, Consolas, monospace; }\n\n@media (max-width: 52rem) {\n  .layout { grid-template-columns: minmax(0, 1fr); gap: 0; padding-inline: 1rem; }\n  nav { position: static; max-height: none; padding-block: 1.5rem 0; border-bottom: 1px solid var(--border); }\n  nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem; }\n  h1 { font-size: 1.6rem; }\n  .card { padding: 1rem; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01G9zkJhq4APXFYVPfPbs17J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
