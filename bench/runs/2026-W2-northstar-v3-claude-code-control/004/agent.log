lock;\n  padding: 4px 14px;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 0.85rem;\n  font-weight: 600;\n  margin-bottom: 20px;\n}\n.hero h1 {\n  font-size: clamp(2rem, 5.5vw, 3.6rem);\n  line-height: 1.2;\n  margin: 0 0 20px;\n  letter-spacing: -0.02em;\n}\n.grad {\n  background: linear-gradient(135deg, var(--accent), var(--accent-2));\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n}\n.hero p.lead {\n  max-width: 640px;\n  margin: 0 auto 32px;\n  color: var(--muted);\n  font-size: 1.1rem;\n}\n.hero-cta {\n  display: flex;\n  gap: 12px;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n.hero-note {\n  margin-top: 16px;\n  color: var(--muted);\n  font-size: 0.85rem;\n}\n\n/* Section */\nsection { padding-block: 72px; }\n.section-head {\n  text-align: center;\n  max-width: 640px;\n  margin: 0 auto 44px;\n}\n.section-head h2 {\n  font-size: clamp(1.6rem, 3.5vw, 2.3rem);\n  margin: 0 0 12px;\n  line-height: 1.3;\n}\n.section-head p { color: var(--muted); margin: 0; }\n.eyebrow {\n  color: var(--accent);\n  font-weight: 700;\n  font-size: 0.85rem;\n  letter-spacing: 0.08em;\n  margin-bottom: 8px;\n}\n\n/* Demo */\n.demo {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 22px;\n  box-shadow: var(--shadow);\n  padding: 20px;\n}\n.tabs {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin-bottom: 18px;\n}\n.tab {\n  padding: 8px 18px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--surface-2);\n  color: var(--muted);\n  font: inherit;\n  font-size: 0.95rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n.tab[aria-selected=\"true\"] {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\n.compare {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: 16px;\n  align-items: stretch;\n}\n.pane {\n  min-width: 0;\n  border-radius: var(--radius);\n  padding: 20px;\n  border: 1px solid var(--border);\n  background: var(--surface-2);\n}\n.pane-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.8rem;\n  font-weight: 700;\n  padding: 3px 10px;\n  border-radius: 999px;\n  margin-bottom: 12px;\n}\n.pane.before .pane-label { background: var(--bad-soft); color: var(--bad); }\n.pane.after .pane-label { background: var(--good-soft); color: var(--good); }\n.pane.after { border-color: color-mix(in srgb, var(--good) 40%, var(--border)); }\n.pane-body {\n  white-space: pre-wrap;\n  font-size: 0.93rem;\n  line-height: 1.8;\n  overflow-wrap: anywhere;\n}\n.pane-body strong { color: var(--fg); }\n.arrow {\n  display: grid;\n  place-items: center;\n  color: var(--accent);\n  font-size: 1.6rem;\n}\n.demo-foot {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n.chip {\n  font-size: 0.82rem;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-weight: 600;\n}\n\n/* Use cases */\n.cases {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 24px;\n}\n.case {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  padding: 32px;\n  box-shadow: var(--shadow);\n}\n.case-icon {\n  width: 52px;\n  height: 52px;\n  border-radius: 14px;\n  display: grid;\n  place-items: center;\n  font-size: 1.6rem;\n  background: var(--accent-soft);\n  margin-bottom: 18px;\n}\n.case h3 { margin: 0 0 8px; font-size: 1.35rem; }\n.case > p { color: var(--muted); margin: 0 0 18px; }\n.checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }\n.checks li { display: flex; gap: 10px; }\n.checks li::before {\n  content: \"✓\";\n  flex: none;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  font-size: 0.75rem;\n  font-weight: 700;\n  margin-top: 3px;\n  background: var(--good-soft);\n  color: var(--good);\n}\n\n/* Features */\n.features {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n.feature {\n  padding: 24px;\n  border-radius: var(--radius);\n  background: var(--surface);\n  border: 1px solid var(--border);\n}\n.feature .ico { font-size: 1.5rem; margin-bottom: 10px; }\n.feature h4 { margin: 0 0 6px; font-size: 1.05rem; }\n.feature p { margin: 0; color: var(--muted); font-size: 0.93rem; }\n\n/* Steps */\n.steps {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n  counter-reset: step;\n}\n.step {\n  position: relative;\n  padding: 28px 24px 24px;\n  border-radius: var(--radius);\n  background: var(--surface);\n  border: 1px solid var(--border);\n}\n.step::before {\n  counter-increment: step;\n  content: counter(step);\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  margin-bottom: 14px;\n  font-weight: 700;\n  color: #fff;\n  background: linear-gradient(135deg, var(--accent), var(--accent-2));\n}\n.step h4 { margin: 0 0 6px; }\n.step p { margin: 0; color: var(--muted); font-size: 0.93rem; }\n\n/* Stats */\n.stats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n  text-align: center;\n}\n.stat b {\n  display: block;\n  font-size: clamp(2rem, 5vw, 2.8rem);\n  line-height: 1.2;\n}\n.stat span { color: var(--muted); font-size: 0.93rem; }\n\n/* Testimonials */\n.quotes {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n.quote {\n  padding: 24px;\n  border-radius: var(--radius);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.quote p { margin: 0; }\n.who { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.88rem; }\n.avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  font-weight: 700;\n  color: var(--accent);\n  background: var(--accent-soft);\n}\n\n/* CTA */\n.cta-box {\n  text-align: center;\n  padding: 56px 24px;\n  border-radius: 28px;\n  color: #fff;\n  background: linear-gradient(135deg, #5b4bff, #8a5cff 60%, #b06bff);\n}\n.cta-box h2 { margin: 0 0 12px; font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.3; }\n.cta-box p { margin: 0 0 28px; opacity: 0.9; }\n.cta-box .btn { background: #fff; color: #4a3be0; }\n\nfooter {\n  padding-block: 32px 48px;\n  color: var(--muted);\n  font-size: 0.88rem;\n  text-align: center;\n}\n\n/* Responsive */\n@media (max-width: 900px) {\n  .features, .quotes, .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 760px) {\n  .nav-links { display: none; }\n  .cases { grid-template-columns: 1fr; }\n  .compare { grid-template-columns: 1fr; }\n  .arrow { transform: rotate(90deg); }\n  .case { padding: 24px; }\n}\n@media (max-width: 560px) {\n  .features, .quotes, .steps, .stats { grid-template-columns: 1fr; }\n  section { padding-block: 52px; }\n  .hero { padding-block: 60px 40px; }\n  .demo { padding: 14px; }\n}\n"}}}
