+@layer measure;
+:root{--paper:#f6f3e9;--green:#263e33;--muted:#6e7567;--line:#d6d9c9;--rust:#aa5135;--serif:ui-serif,"Noto Serif SC",serif;--sans:ui-sans-serif,"Noto Sans SC",sans-serif;color-scheme:light}
