n-bottom: 0.75rem;\n}\n\n.muted { color: var(--muted); }\n\n/* Header */\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  background: color-mix(in srgb, var(--bg) 88%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--line);\n}\n\n.header-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 64px;\n}\n\n.logo {\n  font-family: var(--serif);\n  font-weight: 700;\n  font-size: 1.25rem;\n  text-decoration: none;\n  letter-spacing: 0.05em;\n}\n\n.logo span { color: var(--accent); }\n\n.nav { display: flex; gap: 28px; }\n\n.nav a {\n  text-decoration: none;\n  font-size: 0.95rem;\n  color: var(--muted);\n  transition: color 0.2s;\n}\n\n.nav a:hover { color: var(--fg); }\n\n/* Hero */\n.hero {\n  padding-block: clamp(80px, 14vw, 160px);\n  background:\n    radial-gradient(circle at 85% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 45%),\n    radial-gradient(circle at 10% 90%, color-mix(in srgb, var(--bean-medium) 14%, transparent), transparent 40%);\n}\n\n.hero-inner { max-width: 820px; margin-left: max(0px, calc((100% - 1120px) / 2)); }\n\n.hero h1 {\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  margin-bottom: 1.5rem;\n}\n\n.lead {\n  font-size: clamp(1.05rem, 2vw, 1.2rem);\n  color: var(--muted);\n  max-width: 34em;\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 2.5rem;\n}\n\n.btn {\n  display: inline-block;\n  padding: 0.8em 1.6em;\n  border-radius: 999px;\n  text-decoration: none;\n  font-size: 0.95rem;\n  transition: transform 0.2s, background 0.2s, color 0.2s;\n}\n\n.btn:hover { transform: translateY(-2px); }\n\n.btn-primary { background: var(--accent); color: var(--accent-fg); }\n\n.btn-ghost { border: 1px solid var(--line); background: var(--surface); }\n\n/* Sections */\n.section { padding-block: clamp(64px, 10vw, 120px); }\n\n.section-alt { background: var(--bg-alt); }\n\n.section-head { max-width: 640px; margin-bottom: 3rem; }\n\n.section h2 {\n  font-size: clamp(1.8rem, 4vw, 2.5rem);\n  margin-bottom: 1rem;\n}\n\n.section-intro { color: var(--muted); }\n\n/* Beans */\n.bean-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 24px;\n}\n\n.bean-card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  transition: transform 0.25s, box-shadow 0.25s;\n}\n\n.bean-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 16px 40px -20px rgba(60, 30, 10, 0.35);\n}\n\n.bean-swatch {\n  height: 140px;\n  background-size: 28px 28px;\n}\n\n.swatch-light {\n  background-color: var(--bean-light);\n  background-image: radial-gradient(ellipse 6px 9px at 50% 50%, rgba(0,0,0,.18) 60%, transparent 62%);\n}\n.swatch-medium {\n  background-color: var(--bean-medium);\n  background-image: radial-gradient(ellipse 6px 9px at 50% 50%, rgba(0,0,0,.22) 60%, transparent 62%);\n}\n.swatch-dark {\n  background-color: var(--bean-dark);\n  background-image: radial-gradient(ellipse 6px 9px at 50% 50%, rgba(255,255,255,.08) 60%, transparent 62%);\n}\n\n.bean-body {\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n}\n\n.bean-meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px;\n  font-size: 0.85rem;\n  color: var(--muted);\n  margin-bottom: 0.75rem;\n}\n\n.tag {\n  padding: 2px 10px;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--accent) 14%, transparent);\n  color: var(--accent);\n  font-size: 0.78rem;\n}\n\n.bean-body h3 { font-size: 1.35rem; margin-bottom: 0.4rem; }\n\n.notes { color: var(--accent); font-size: 0.95rem; margin-bottom: 1.25rem; }\n\n.specs {\n  margin: 0 0 1.5rem;\n  display: grid;\n  gap: 6px;\n  font-size: 0.9rem;\n}\n\n.specs div {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  bo