from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.headings=0; self.external=[]; self.stack=[]
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if tag=='h2': self.headings+=1
        if tag=='a': self.links.append(attrs.get('href',''))
        for name in ('src','href'):
            if name in attrs and not attrs[name].startswith('#'): self.external.append(attrs[name])
        if tag not in {'meta','br','hr','img','input','link','source','wbr','area','base','embed','param','track','col'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        assert self.stack and self.stack.pop()==tag, f'标签未正确配对：{tag}'
p=Path('index.html'); text=p.read_text(); c=Check(); c.feed(text)
assert not c.stack, c.stack
assert len(c.ids)==len(set(c.ids))
assert c.headings==5
assert all(link[1:] in c.ids for link in c.links)
assert not c.external
assert 'name=\"viewport\"' in text
print(f'检查通过：index.html，{p.stat().st_size} 字节；5 个小标题，目录锚点全部有效，标签配对正确，无外部依赖。')
