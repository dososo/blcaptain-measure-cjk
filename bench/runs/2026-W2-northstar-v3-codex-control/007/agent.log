from pathlib import Path
from html.parser import HTMLParser
import ast

css = Path('style.css')
css.write_text(css.read_text().replace('@import none;\\n', '', 1))
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.links = []
        self.codes = []
        self.in_pre = False
        self.current = ''
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if tag == 'a': self.links.append(attrs.get('href', ''))
        if tag == 'pre': self.in_pre = True; self.current = ''
    def handle_endtag(self, tag):
        if tag == 'pre': self.codes.append(self.current); self.in_pre = False
    def handle_data(self, data):
        if self.in_pre: self.current += data
p = Check()
p.feed(Path('index.html').read_text())
