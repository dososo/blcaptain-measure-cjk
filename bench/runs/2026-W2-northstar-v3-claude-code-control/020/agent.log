: auto; color: var(--muted); font-size: .85rem; font-weight: 400; }\n.day ul { list-style: none; padding: 0; margin: 12px 0 0; }\n.day li { border-top: 1px dashed var(--border); }\n.day label { display: flex; gap: 10px; padding: 8px 0; cursor: pointer; align-items: flex-start; }\n.day input { margin-top: 6px; accent-color: var(--done); flex-shrink: 0; }\n.day li.checked .t { text-decoration: line-through; color: var(--muted); }\n.t small { display: block; color: var(--muted); font-size: .85rem; }\n\n/* 账号表 */\n.table-scroll { overflow-x: auto; }\ntable { width: 100%; border-collapse: collapse; min-width: 640px; }\nth, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }\nth { color: var(--muted); font-weight: 600; font-size: .85rem; }\ntd code {\n  background: var(--accent-soft); color: var(--accent); padding: 1px 6px; border-radius: 4px; font-size: .85rem;\n}\n\n.note {\n  background: var(--warn-bg); color: var(--warn-fg); border-radius: 10px; padding: 12px 16px; margin-top: 16px; font-size: .92rem;\n}\n\ndl.faq dt { font-weight: 600; margin-top: 12px; }\ndl.faq dt:first-child { margin-top: 0; }\ndl.faq dd { margin: 2px 0 0; color: var(--muted); }\n\nfooter { color: var(--muted); font-size: .85rem; text-align: center; padding-block: 24px; border-top: 1px solid var(--border); }\n\n@media (max-width: 480px) {\n  .hero h1 { font-size: 1.6rem; }\n  .card { padding: 16px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011HsMdLWrCZWocGBB4cAGYB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
