+    for(let i=0;i<6;i++){
+      const d = new Date(today); d.setDate(today.getDate()+i);
+      const button = document.createElement('button'); button.type='button'; button.className='date-option'; button.dataset.date=dateString(d);
+      button.innerHTML=`<small>${i===0?'今天':i===1?'明天':weekdays[d.getDay()]}</small><strong>${String(d.getDate()).padStart(2,'0')}</strong>`;
