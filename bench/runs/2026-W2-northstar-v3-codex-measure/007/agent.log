from html.parser import HTMLParser
from pathlib import Path
import ast, subprocess
class PageParser(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.codes=[]; self.inside=False; self.script=False; self.js=''
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a': self.links.append(a.get('href',''))
        if tag=='pre': self.inside=True; self.codes.append('')
        if tag=='script': self.script=True
        if tag=='link': assert Path(a['href']).is_file()
    def handle_endtag(self,tag):
        if tag=='pre': self.inside=False
        if tag=='script': self.script=False
    def handle_data(self,data):
        if self.inside: self.codes[-1]+=data
        if self.script: self.js+=data
p=PageParser(); p.feed(Path('index.html').read_text())
assert len(p.ids)==len(set(p.ids))
assert all(link[1:] in p.ids for link in p.links if link.startswith('#'))
assert len(p.codes)==5
for code in p.codes: ast.parse(code)
subprocess.run(['node','--check'],input=p.js,text=True,check=True)
print('Passed: 5 Python snippets, JavaScript syntax, local stylesheets, unique IDs, and all anchor targets.')
print('Files: '+', '.join(sorted(x.name for x in Path('.').iterdir())))
