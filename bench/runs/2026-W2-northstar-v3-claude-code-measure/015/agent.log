 {\n  width: 100%;\n  border-collapse: collapse;\n  min-width: 40rem;\n}\nth, td {\n  text-align: left;\n  padding: 0.875rem 1rem;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n  vertical-align: top;\n}\nthead th {\n  font-size: 14px;\n  color: var(--muted);\n  font-weight: 600;\n  background: var(--bg);\n}\ntbody tr:last-child td { border-bottom: 0; }\ntd.price, th.price {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\ntd.price strong { font-size: 1.0625rem; }\n.api-name { font-weight: 600; display: block; }\n.api-desc { color: var(--muted); font-size: 14px; }\ncode {\n  font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n  font-size: 0.875em;\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  padding: 0 0.3em;\n}\n\n/* 阶梯折扣 */\n.tiers {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  gap: 1rem;\n}\n.tier {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 1.25rem;\n  min-width: 0;\n}\n.tier h3 {\n  font-size: 1rem;\n  margin: 0 0 0.5rem;\n  line-height: 1.5;\n}\n.tier .off {\n  font-size: 1.5rem;\n  font-weight: 700;\n  margin: 0;\n  color: var(--accent);\n}\n.tier p { margin: 0; line-height: 1.7; }\n\n/* 计算器 */\n.calc {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 1.25rem;\n  display: grid;\n  gap: 1rem;\n  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));\n  align-items: end;\n}\n.calc label {\n  display: block;\n  font-size: 14px;\n  color: var(--muted);\n  margin-bottom: 0.375rem;\n}\n.calc select, .calc input {\n  width: 100%;\n  font: inherit;\n  color: var(--fg);\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 0.5rem 0.75rem;\n}\n.result {\n  grid-column: 1 / -1;\n  background: var(--highlight);\n  border-radius: 8px;\n  padding: 1rem 1.25rem;\n}\n.result .total {\n  font-size: 1.75rem;\n  font-weight: 700;\n  margin: 0;\n  font-variant-numeric: tabular-nums;\n}\n.result p { margin: 0; line-height: 1.7; }\n.result .detail { color: var(--muted); font-size: 14px; }\n\n/* 常见问题 */\n.faq { max-width: 36em; }\n.faq details {\n  border-bottom: 1px solid var(--line);\n  padding-block: 0.875rem;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  line-height: 1.6;\n}\n.faq details p {\n  margin: 0.5rem 0 0;\n  color: var(--muted);\n}\n\nfooter {\n  padding-block: 2rem 3rem;\n  color: var(--muted);\n  font-size: 14px;\n}\n"}}}
