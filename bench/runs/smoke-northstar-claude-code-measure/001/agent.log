.75rem 2.5rem;\n  padding-block: 1.75rem;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n}\n.bean h3 {\n  margin: 0 0 0.35rem;\n  font-size: 1.25rem;\n  font-weight: 700;\n}\n.bean .origin {\n  margin: 0;\n  font-size: 0.9rem;\n  color: var(--muted);\n  line-height: 1.6;\n}\n.bean .notes { margin: 0; min-width: 0; }\n.bean .notes p { margin: 0 0 0.5rem; }\n.bean .tags {\n  margin: 0;\n  font-size: 0.9rem;\n  color: var(--muted);\n  line-height: 1.6;\n}\n.bean .side {\n  text-align: right;\n  font-size: 0.95rem;\n  line-height: 1.6;\n}\n.bean .price {\n  display: block;\n  font-family: var(--mono);\n  font-size: 1.05rem;\n}\n.bean .price + span { color: var(--muted); font-size: 0.85rem; }\n\n/* 烘焙度：五格刻度，不用图标 */\n.roast {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-top: 0.6rem;\n  font-size: 0.85rem;\n  color: var(--muted);\n}\n.roast .bar {\n  display: inline-flex;\n  gap: 3px;\n}\n.roast .bar::before {\n  content: \"\";\n  width: calc(var(--lv) * 14px + (var(--lv) - 1) * 3px);\n  height: 8px;\n  background: var(--bean);\n  border-radius: 1px;\n}\n.roast i::after {\n  content: \"\";\n  width: calc((5 - var(--lv)) * 14px + (4 - var(--lv)) * 3px);\n  height: 8px;\n  background: var(--bean-off);\n  border-radius: 1px;\n}\n\n.beans-foot {\n  margin: 1.5rem 0 0;\n  font-size: 0.95rem;\n  color: var(--muted);\n}\n\n/* 理念 */\n.philo {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);\n  gap: 3rem;\n  align-items: start;\n}\n.philo .measure-prose { min-width: 0; }\n.philo .measure-prose p { margin: 0 0 1.25em; }\n.philo .measure-prose h3 {\n  margin: 2em 0 0.6em;\n  font-size: 1.2rem;\n}\n.philo .measure-prose h3:first-child { margin-top: 0; }\n.philo strong { font-weight: 700; }\n.philo .dot { text-emphasis: dot; }\n\n.log {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  padding: 1.5rem;\n}\n.log h3 {\n  margin: 0 0 1rem;\n  font-size: 1rem;\n}\n.log dl {\n  margin: 0;\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 0.6rem 1rem;\n  font-size: 0.95rem;\n  line-height: 1.6;\n}\n.log dt { color: var(--muted); }\n.log dd { margin: 0; font-family: var(--mono); }\n.log p {\n  margin: 1.25rem 0 0;\n  font-size: 0.9rem;\n  color: var(--muted);\n}\n\n/* 到店 */\n.visit {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 3rem;\n}\n.visit address {\n  font-style: normal;\n  font-size: 1.3rem;\n  line-height: 1.6;\n  margin-bottom: 1.5rem;\n}\n.visit address span {\n  display: block;\n  font-size: 0.95rem;\n  color: var(--muted);\n  margin-top: 0.35rem;\n}\n.visit .measure-prose p { margin: 0 0 1em; }\n.hours {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.95rem;\n}\n.hours th,\n.hours td {\n  text-align: left;\n  padding: 0.7rem 0;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n  font-weight: 400;\n}\n.hours td { text-align: right; font-family: var(--mono); }\n.hours tr.off td { color: var(--muted); font-family: var(--serif); }\n.visit h3 {\n  margin: 0 0 0.75rem;\n  font-size: 1.05rem;\n}\n.visit ul {\n  margin: 0;\n  padding-left: 1.2em;\n}\n.visit ul li { margin-bottom: 0.35rem; }\n.copy {\n  margin-top: 0.75rem;\n  font: inherit;\n  font-size: 0.9rem;\n  padding: 0.45rem 1rem;\n  background: transparent;\n  color: var(--fg);\n  border: 1px solid var(--fg);\n  border-radius: 3px;\n  cursor: pointer;\n}\n.copy:hover { background: var(--fg); color: var(--bg); }\n\n/* 页脚 */\n.site-foot {\n  padding-block: 2.5rem 3rem;\n  font-size: 0.9rem;\n  color: var(--muted);\n}\n.site-foot .wrap {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 0.75rem 2rem;\n}\n.site-foot p { margin: 0; line-height: 1.6; }\n\n@media (max-width: 760px) {\n  .bean { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }\n  .bean .side { text-align: left; }\n  .philo,\n  .visit { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }\n}\n","structuredPatch":[{"oldStart":212,"oldLines":7,"newStart":212,"newLines":7,"lines":["   background: var(--bean);","   border-radius: 1px;"," }","-.roast i::after {","+.roast .bar::after {","   content: \"\";","   width: calc((5 - var(--lv)) * 14px + (4 - var(--lv)) * 3px);","   height: 8px;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01WHPyAWyXHw69gqVXnVDdA6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
