l;\n  color: #e8541e;\n  font-size: 1.25em;\n  background: linear-gradient(transparent 62%, #ffd48a 62%);\n  padding: 0 .1em;\n}\n.sub { font-size: 3.4cqw; color: #8a7559; margin-top: 1.2cqw; }\n\n.item {\n  display: flex;\n  gap: 3cqw;\n  background: #fff;\n  border-radius: 2.4cqw;\n  padding: 3cqw 3.4cqw;\n  box-shadow: 0 .5cqw 1.6cqw rgba(120, 80, 30, .07);\n  flex: 1;\n  min-height: 0;\n}\n.num {\n  font-size: 7cqw;\n  font-weight: 900;\n  color: #e8541e;\n  line-height: 1;\n  font-family: \"DIN Alternate\", \"Helvetica Neue\", Arial, sans-serif;\n}\n.body { flex: 1; min-width: 0; }\n.body h2 { font-size: 4.6cqw; font-weight: 800; }\n.body h2 span {\n  font-size: 2.9cqw;\n  font-weight: 500;\n  color: #fff;\n  background: #e8541e;\n  padding: .3cqw 1.6cqw;\n  border-radius: 1cqw;\n  margin-left: 1cqw;\n  vertical-align: middle;\n}\n.body p { font-size: 3.2cqw; color: #5b4a35; margin-top: 1cqw; line-height: 1.5; }\n\n.eg {\n  margin-top: 1.6cqw;\n  background: #fff6e6;\n  border-left: .8cqw solid #ffb648;\n  border-radius: 1cqw;\n  padding: 1.6cqw 2.2cqw;\n  font-size: 3cqw;\n  line-height: 1.6;\n}\n.eg strong { color: #e8541e; font-size: 1.25em; }\n.eg small { font-size: 2.6cqw; color: #8a7559; }\n\n.bar {\n  position: relative;\n  height: 3.6cqw;\n  margin-top: 1cqw;\n  background: #f1e6d4;\n  border-radius: 99px;\n}\n.bar i {\n  display: block;\n  height: 100%;\n  border-radius: 99px;\n  background: #c9b79c;\n}\n.bar.hot i { background: linear-gradient(90deg, #ffb648, #e8541e); }\n.bar label {\n  position: absolute;\n  left: calc(100% - 30cqw);\n  top: 50%;\n  transform: translateY(-50%);\n  font-size: 2.6cqw;\n  color: #5b4a35;\n  white-space: nowrap;\n}\n.bar.hot label { color: #e8541e; font-weight: 700; }\n\n.scale {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 1cqw;\n  font-size: 2.8cqw;\n}\n.scale span:not(.arrow) {\n  background: #fff;\n  border: 1px solid #ffd48a;\n  border-radius: 1cqw;\n  padding: .2cqw 1.4cqw;\n}\n.scale .arrow { color: #e8541e; font-weight: 700; }\n\n.foot {\n  text-align: center;\n  font-size: 3.3cqw;\n}\n.foot b { color: #e8541e; }\n.foot span { display: block; font-size: 2.6cqw; color: #a8957a; margin-top: 1cqw; }\n","structuredPatch":[{"oldStart":121,"oldLines":7,"newStart":121,"newLines":7,"lines":[" .bar.hot i { background: linear-gradient(90deg, #ffb648, #e8541e); }"," .bar label {","   position: absolute;","-  left: calc(100% - 30cqw);","+  right: 1.6cqw;","   top: 50%;","   transform: translateY(-50%);","   font-size: 2.6cqw;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01GA52ofjkSM2VY61sbeCC8B","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
