+    document.querySelector('#download').addEventListener('click',()=>{if(!submitted)return;const labels={name:'姓名',phone:'手机号码',email:'电子邮箱',city:'现居城市',position:'意向岗位',education:'最高学历',salaryMin:'期望月薪下限（元）',salaryMax:'期望月薪上限（元）',availability:'到岗时间',desiredCity:'期望工作城市',message:'补充说明'};let text='原野 · 求职申请资料\n\n';for(const [key,label]of Object.entries(labels))text+=`${label}：${submitted[key]||'未填写'}\n`;text+='\n工作经历\n';submitted.experiences.forEach((item,i)=>{text+=`\n${i+1}. ${item.company||'未填写公司'} · ${item.role||'未填写职位'}\n${item.start||'未填写'} 至 ${item.current?'至今':item.end||'未填写'}\n${item.description||'暂无描述'}\n`});if(!submitted.experiences.length)text+='暂无\n';const url=URL.createObjectURL(new Blob(['\uFEFF'+text],{type:'text/plain;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='求职申请资料.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('申请资料已生成，请查看浏览器下载')});
+    const sectionObserver=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting)document.querySelectorAll('.step').forEach(step=>{const active=step.hash==='#'+entry.target.id;step.classList.toggle('active',active);if(active)step.setAttribute('aria-current','step');else step.removeAttribute('aria-current')})})},{rootMargin:'-5% 0px -60% 0px',threshold:0});document.querySelectorAll('form>section').forEach(section=>sectionObserver.observe(section));
+  </script>
+</body>
+</html>

