from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.items=0; self.titles=0; self.stack=[]
    def handle_starttag(self, tag, attrs):
        if tag == 'li': self.items+=1
        if tag == 'h2': self.titles+=1
        if tag not in ('meta','path','circle','br'): self.stack.append(tag)
    def handle_endtag(self, tag):
        assert self.stack and self.stack.pop()==tag, f'标签不匹配: {tag}'
