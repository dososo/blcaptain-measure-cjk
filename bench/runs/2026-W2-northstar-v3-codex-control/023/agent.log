+    document.querySelector('#download').addEventListener('click',()=>{
+      const values=answers();const record={问卷:'在路上 · 城市通勤小调查',填写时间:new Date().toISOString(),答案:Object.fromEntries(questions.map(q=>[q.label,q.multiple?values[q.name]:values[q.name][0]]))};
