+  <script>
+    const platforms = {
+      mac: { command: 'brew install just', manager: 'Homebrew', hint: '需要先安装 Homebrew。' },
+      linux: { command: 'sudo apt install just', manager: 'APT', hint: '适用于 Debian 13、Ubuntu 24.04 及其衍生发行版。' },
+      windows: { command: 'winget install --id Casey.Just --exact', manager: 'WinGet', hint: '示例任务使用默认的 sh，请安装 Git for Windows 并确保 sh 在 PATH 中。' }
+    };
+    const tabs = [...document.querySelectorAll('[role="tab"]')];
+    function selectPlatform(tab) {
+      const value = platforms[tab.dataset.platform];
+      tabs.forEach(item => { item.setAttribute('aria-selected', String(item === tab)); item.tabIndex = item === tab ? 0 : -1; });
+      document.getElementById('install-command').textContent = value.command;
+      document.getElementById('package-manager').textContent = value.manager;
+      document.getElementById('install-panel').setAttribute('aria-labelledby', tab.id);
+      const hint = document.getElementById('platform-hint');
+      hint.replaceChildren(document.createTextNode(value.hint + '其他安装方式见'));
+      const link = document.createElement('a'); link.href = 'https://just.systems/man/en/packages.html'; link.textContent = '官方安装指南 ↗'; link.target = '_blank'; link.rel = 'noopener noreferrer'; hint.append(link, '。');
+    }
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => selectPlatform(tab));
+      tab.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+        if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = tabs.length - 1;
+        if (next !== undefined) { event.preventDefault(); selectPlatform(tabs[next]); tabs[next].focus(); }
+      });
+    });
+    let toastTimer;
+    document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
+      const value = document.getElementById(button.dataset.copy).textContent;
+      let copied = false;
+      try { await navigator.clipboard.writeText(value); copied = true; } catch {
+        const area = document.createElement('textarea'); area.value = value; area.style.cssText = 'position:fixed;left:-9999px;top:0'; document.body.append(area); area.select();
+        try { copied = document.execCommand('copy'); } catch {} finally { area.remove(); button.focus(); }
+      }
+      const toast = document.getElementById('toast'); toast.textContent = copied ? '已复制到剪贴板' : '复制未成功，请选中代码手动复制'; toast.classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('visible'), 2600);
+    }));
+    const dialog = document.getElementById('search-dialog');
+    const input = document.getElementById('search-input');
+    const pages = [{ id: 'install', title: '安装 just', description: 'macOS · Linux · Windows · 版本验证', keywords: 'brew apt winget install' }, { id: 'configure', title: '配置你的项目', description: '创建 justfile，定义 dev 和 test 任务', keywords: '配置 缩进 npm Node.js' }, { id: 'commands', title: '三个常用命令', description: 'just --list · just dev · just test', keywords: '查看 任务 开发 测试' }];
+    function renderResults() {
+      const results = document.getElementById('search-results'); results.replaceChildren();
+      const query = input.value.trim().toLowerCase();
+      pages.filter(page => (page.title + page.description + page.keywords).toLowerCase().includes(query)).forEach(page => {
+        const link = document.createElement('a'); link.href = '#' + page.id; const title = document.createElement('strong'); title.textContent = page.title; const detail = document.createElement('span'); detail.textContent = page.description; link.append(title, detail); link.addEventListener('click', () => { dialog.close(); const section = document.getElementById(page.id); section.tabIndex = -1; section.focus(); }); results.append(link);
+      });
+      if (!results.children.length) { const empty = document.createElement('p'); empty.textContent = '没有找到相关内容，试试“安装”或“命令”。'; results.append(empty); }
+    }
+    function openSearch() { input.value = ''; renderResults(); dialog.showModal(); input.focus(); }
+    document.getElementById('open-search').addEventListener('click', openSearch);
+    document.getElementById('close-search').addEventListener('click', () => dialog.close());
+    input.addEventListener('input', renderResults);
+    document.addEventListener('keydown', event => { if (event.key === '/' && !dialog.open && !event.ctrlKey && !event.metaKey && !event.altKey && !event.target.matches('input, textarea, [contenteditable="true"]')) { event.preventDefault(); openSearch(); } });
+    dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+    if ('IntersectionObserver' in window) {
+      const observer = new IntersectionObserver(entries => { entries.forEach(entry => { if (entry.isIntersecting) document.querySelectorAll('.toc nav a').forEach(link => link.classList.toggle('active', link.hash === '#' + entry.target.id)); }); }, { rootMargin: '-15% 0px -60% 0px' });
+      document.querySelectorAll('.doc-section').forEach(section => observer.observe(section));
+    }
+  </script>
+</body>
+</html>
