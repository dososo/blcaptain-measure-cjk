/bin/zsh -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
import re, shutil, subprocess
p=Path('index.html')
s=p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.stack=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if a.get('href','').startswith('#') and a['href']"'!='"'#': self.links.append(a['href'][1:])
        if tag not in {'meta','link','input','br','hr','img','use','path','rect','circle'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in {'use','path','rect','circle'}: return
        assert self.stack and self.stack.pop()==tag, f'Mismatched tag: {tag}'
c=Check(); c.feed(s)
assert not c.stack, c.stack
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert set(c.links)<=set(c.ids), 'Missing anchor targets'
assert '<html lang=\"zh-CN\">' in s
print('HTML structure, unique IDs and anchor targets: passed')
node=shutil.which('node')
if node:
    script=re.search(r'<script>(.*?)</script>',s,re.S).group(1)
    result=subprocess.run([node,'--check','-'],input=script,text=True,capture_output=True)
    assert result.returncode==0,result.stderr
    print('JavaScript syntax: passed')
print(f'Generated index.html: {p.stat().st_size:,} bytes')
