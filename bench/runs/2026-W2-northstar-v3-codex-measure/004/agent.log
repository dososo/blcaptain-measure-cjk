+      try { await navigator.clipboard.writeText(content); copied = true; } catch {
+        const field = document.createElement('textarea'); field.value = content; field.style.cssText = 'position:fixed;opacity:0;pointer-events:none'; document.body.append(field); field.select(); try { copied = document.execCommand('copy'); } catch {} field.remove(); document.getElementById('copy-button').focus();
+      }
+      const toast = document.getElementById('toast'); toast.textContent = copied ? '已复制，可以粘贴使用。' : '暂时无法复制，请选中示例文字手动复制。'; toast.classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('visible'), 3200);
+    });
+  </script>
+</body>
+</html>
