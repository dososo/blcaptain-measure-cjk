@@ -0,0 +1,29 @@
+@layer measure;
+:root{color-scheme:light;--paper:#fafbf7;--ink:#25372d;--muted:#687365;--line:#e0e5da;--green:#3e563a;--pale:#edf1e5}
+*{box-sizing:border-box}
+html{scroll-behavior:smooth;scroll-padding-top:104px}
+body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,"PingFang SC","Noto Sans SC",sans-serif;font-size:16px;-webkit-font-smoothing:antialiased}
+a{color:inherit;text-decoration:none}
+button{font:inherit}
+button,a,summary{-webkit-tap-highlight-color:transparent}
+a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #78915e;outline-offset:5px}
+p,h1,h2,h3{margin:0}
+.skip{position:fixed;top:-70px;left:16px;z-index:10;padding:12px;background:white}.skip:focus{top:12px}
+.header{height:84px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 5.2%;background:#fafbf7f5;position:sticky;top:0;z-index:5;backdrop-filter:blur(12px)}
+.brand{display:flex;align-items:center;gap:12px;font-size:23px;font-weight:650}.brand-icon{display:grid;place-items:center;background:var(--green);width:34px;height:38px;border-radius:10px;color:#f5f8ee}.brand-icon svg{width:21px;fill:none;stroke:currentColor;stroke-width:1.6}.brand-divider{height:20px;width:1px;background:#d0d8c9;margin:0 8px}.brand-sub{font-size:14px;font-weight:400;color:var(--muted)}
+.print-button{display:flex;align-items:center;gap:9px;background:transparent;border:1px solid #d8dfd0;border-radius:7px;padding:9px 15px;color:#475441;font-size:13px;cursor:pointer}.print-button svg{width:17px;fill:none;stroke:currentColor;stroke-width:1.5}.print-button:hover{background:var(--pale)}
+.layout{max-width:1360px;padding:0 5.2%;margin:auto;display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px}
+.sidebar{border-right:1px solid var(--line);padding-right:28px}.sidebar-inner{position:sticky;top:126px;padding-bottom:30px}.eyebrow{font-size:12px;color:#737f6e;margin-bottom:17px}.eyebrow span{font-size:11px;letter-spacing:1px;margin-left:5px}.sidebar-title{font-size:24px;font-weight:650}.sidebar-description{font-size:13px;color:var(--muted);margin-top:6px}.sidebar nav{display:grid;gap:7px;margin:30px 0 42px}.nav-item{display:flex;align-items:center;gap:13px;padding:12px;border-radius:6px;font-size:14px;color:#616d5a}.nav-item:hover{background:#f0f3e9}.nav-item.active{background:#e8eedc;color:#334b2d;font-weight:600}.nav-number{font-size:12px;width:20px;color:#76856c;font-variant-numeric:tabular-nums}.nav-arrow{margin-left:auto;font-weight:400}.side-note{font-size:12px;color:#53644b;border-top:1px solid var(--line);padding-top:24px}.status-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#75935b;vertical-align:middle;margin-right:8px}.side-note p{margin-top:10px;color:#788170;font-size:12px}.back-top{display:inline-block;margin-top:30px;font-size:12px;color:#788170}
+main{min-width:0;padding-top:40px}.hero{position:relative;display:grid;grid-template-columns:1.15fr 1fr;align-items:center;min-height:420px;background:#eef2e5;border:1px solid #e3e9d9;border-radius:12px;overflow:hidden;padding:34px 30px 30px 36px}.hero-tag{font-size:12px;color:#5e704f;margin-bottom:23px}.hero h1{font-size:clamp(34px,3.5vw,48px);font-weight:650;line-height:1.3;letter-spacing:1px}.hero-intro{font-size:14px;color:#65715c;margin-top:20px;line-height:1.85}.primary-link{display:inline-flex;gap:33px;align-items:center;padding:11px 19px;margin-top:26px;background:#3e563a;color:white;border-radius:6px;font-size:14px}.primary-link:hover{background:#2c4228}.hero-caption{font-size:12px;color:#778269;margin-top:14px}.hero-art{align-self:center;margin-left:-12px}.lock-illustration{display:block;width:100%;height:auto;overflow:visible}.illustration-caption{text-align:center;font-size:12px;color:#7c876e;margin-top:-5px}
+.preflight{display:flex;gap:13px;padding:24px 3px 28px;border-bottom:1px solid var(--line)}.info-symbol{margin-top:3px;flex-shrink:0;border:1px solid #809276;border-radius:50%;width:19px;height:19px;font-size:12px;text-align:center;line-height:17px;color:#718464}.preflight strong{font-size:14px;font-weight:600}.preflight p{font-size:13px;color:var(--muted);margin-top:5px;max-width:52em}
+.guide-section{padding:40px 0 36px;border-bottom:1px solid var(--line);scroll-margin-top:10px}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.heading-main{display:flex;gap:18px;align-items:center}.section-number{font-size:38px;font-weight:350;color:#889c76;font-variant-numeric:tabular-nums;line-height:1.2}.section-kicker{font-size:12px;color:#7a8571;margin-bottom:5px}h2{font-size:26px;font-weight:650}.section-badge{font-size:12px;color:#617452;background:#edf1e6;border:1px solid #e3e9d8;padding:5px 10px;border-radius:5px;white-space:nowrap}.section-intro{font-size:15px;color:var(--muted);margin-top:22px;line-height:1.8}
+.steps{list-style:none;padding:0;margin:27px 0 24px;display:grid;gap:0}.steps li{display:flex;gap:16px;position:relative;padding-bottom:24px}.steps li:last-child{padding-bottom:0}.steps li:not(:last-child)::before{content:"";position:absolute;left:14px;top:31px;bottom:3px;border-left:1px solid #e0e5d9}.step-number{display:grid;place-items:center;flex-shrink:0;width:29px;height:29px;border:1px solid #d8e1cb;border-radius:50%;background:#f1f5e9;font-size:13px;font-weight:600;color:#5d744a}.steps h3{font-size:16px;font-weight:600;margin:3px 0 6px}.steps p{font-size:14px;max-width:36em;color:#687262;line-height:1.85}.tip{display:flex;gap:12px;background:#f0f3ea;border-radius:7px;padding:16px 19px}.tip>span{font-size:18px;color:#7d9467}.tip p{font-size:13px;line-height:1.8;color:#657358;max-width:48em}.tip strong{font-weight:600;color:#465c3c}
+.battery-types{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:23px}.battery-types>div{border:1px solid var(--line);padding:20px;border-radius:8px;background:#fffefa}.small-label{font-size:12px;color:#7f8c70}.battery-types h3{font-size:15px;font-weight:600;margin:9px 0}.battery-types p{font-size:13px;color:var(--muted);line-height:1.8}.warning-badge{background:#f7eee1;color:#8b6638;border-color:#ebdcc5}.warning{display:flex;gap:14px;background:#faf1e4;border:1px solid #ecdfc9;padding:19px 20px;border-radius:8px;margin:25px 0}.warning-icon{flex-shrink:0;color:#986a2e;border:1px solid #b99357;border-radius:50%;width:22px;height:22px;text-align:center;font-size:14px}.warning h3{font-size:15px;color:#7c5b2e;margin-bottom:7px;font-weight:600}.warning p{max-width:40em;font-size:14px;color:#8a714e;line-height:1.8}
+.faq{padding:37px 0 34px}.faq-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.faq h2{font-size:22px}.faq-heading>span{font-size:12px;color:#839078}.faq details{border-bottom:1px solid var(--line)}.faq summary{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:19px 0;cursor:pointer;font-size:14px;list-style:none}.faq summary::-webkit-details-marker{display:none}.faq summary span{font-size:20px;font-weight:300;color:#6b7d5b;transition:transform .2s}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{font-size:14px;line-height:1.85;color:var(--muted);padding:0 20px 20px 0;max-width:38em}
+footer{padding:25px 0 32px;border-top:1px solid var(--line);display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:#7b8571;font-size:12px}.footer-mark{font-weight:600;color:#5a6c4d}footer p{font-size:12px}footer a{margin-left:auto;white-space:nowrap}
+@media(min-width:1400px){.layout{padding:0 60px}.header{padding:0 max(60px,calc((100vw - 1240px)/2))}}
+@media(max-width:1100px){.layout{gap:30px;grid-template-columns:190px minmax(0,1fr);padding:0 4%}.sidebar{padding-right:18px}.hero{padding:27px;min-height:390px}.hero h1{font-size:37px}.desktop-break{display:none}.hero-art{margin-left:-20px}.hero-intro{max-width:19em}.section-badge{font-size:12px}}
+@media(max-width:800px){.header{height:70px;padding:0 5%}.layout{display:block;padding:0 5%}.sidebar{border-right:0;padding:20px 0 0}.sidebar-inner{position:static;padding:0}.eyebrow,.sidebar-title,.sidebar-description,.side-note,.back-top{display:none}.sidebar nav{display:flex;gap:5px;overflow:auto;margin:0;padding-bottom:7px}.nav-item{white-space:nowrap;gap:7px;padding:9px 11px;font-size:13px}.nav-arrow{display:none}.nav-number{width:auto}.brand-sub{font-size:12px}.brand-divider{margin:0 2px}.brand{font-size:21px;gap:9px}main{padding-top:17px}.hero{min-height:370px;padding:30px}.hero-art{max-width:300px;justify-self:center;width:100%}.hero h1{font-size:38px}html{scroll-padding-top:90px}.section-heading{gap:10px}.section-number{font-size:34px}.heading-main{gap:14px}}
+@media(max-width:520px){.header{padding:0 20px}.print-button{padding:8px 10px;font-size:12px}.print-button svg{display:none}.brand-sub{font-size:12px}.brand-divider{display:none}.brand-icon{width:29px;height:33px}.layout{padding:0 20px}.hero{grid-template-columns:1fr;padding:27px 24px 20px;min-height:auto}.hero-copy{position:relative;z-index:1}.hero h1{font-size:38px}.hero-tag{margin-bottom:17px}.hero-intro{max-width:21em}.hero-art{width:215px;margin:-25px -24px -5px auto;align-self:end;justify-self:end}.hero-caption{max-width:8em;margin-top:18px}.illustration-caption{font-size:12px;margin-top:-10px}.primary-link{margin-top:22px}.hero-art .lock-illustration{margin-top:-18px}.section-heading{align-items:flex-start;flex-wrap:wrap}.section-badge{margin-left:47px;margin-top:0}.section-number{font-size:32px}h2{font-size:24px}.guide-section{padding-top:30px}.section-intro{margin-top:18px}.steps{margin-top:23px}.steps li{gap:12px}.steps h3{font-size:16px}.steps p{font-size:14px}.battery-types{grid-template-columns:1fr;gap:10px}.battery-types>div{padding:17px}.tip{padding:15px}.warning{padding:17px 15px;gap:10px}.preflight{padding:22px 0}.faq h2{font-size:21px}footer{gap:10px}footer p{order:3;width:100%}}
+@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
+@media print{body{background:white;color:#111}.header{position:static;height:65px;padding:0;background:white}.print-button,.sidebar,.primary-link,.back-top,footer a{display:none}.layout{display:block;padding:0;max-width:none}main{padding-top:20px}.hero{min-height:300px;grid-template-columns:1fr 260px;print-color-adjust:exact}.hero-art{width:250px;margin:0}.hero h1{font-size:36px}.guide-section{padding:25px 0}.section-heading,.steps li,.tip,.warning,.battery-types,details{break-inside:avoid}.section-heading{break-after:avoid}.steps p{max-width:48em}footer{padding-bottom:0}a{color:inherit}.faq details p{display:block}html{scroll-behavior:auto}}

