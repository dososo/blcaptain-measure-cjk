+    }
+    async function addFiles(files) {
+      const errors = [];
+      for (const file of files) {
+        if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) { errors.push('仅支持 JPG、PNG 和 WebP 图片。'); continue; }
+        if (file.size > 5 * 1024 * 1024) { errors.push('单张截图不能超过 5 MB。'); continue; }
+        if (screenshots.length + pending >= 3) { errors.push('最多可上传 3 张截图。'); continue; }
+        if (screenshots.some(item => item.name === file.name && item.size === file.size)) continue;
+        pending++;
+        submit.disabled = true;
+        try {
+          const data = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
+          await new Promise((resolve, reject) => { const img = new Image(); img.onload = resolve; img.onerror = reject; img.src = data; });
+          screenshots.push({name:file.name, size:file.size, type:file.type, data});
+          renderPreviews();
+        } catch { errors.push('有一张图片无法读取，请重新选择。'); }
+        finally { pending--; submit.disabled = pending > 0; }
+      }
+      uploadError.textContent = [...new Set(errors)].join(' ');
+      upload.value = '';
+    }
+    upload.addEventListener('change', () => addFiles(Array.from(upload.files)));
+    ['dragenter', 'dragover'].forEach(event => zone.addEventListener(event, e => { e.preventDefault(); zone.classList.add('dragover'); }));
+    zone.addEventListener('dragleave', e => { if (!zone.contains(e.relatedTarget)) zone.classList.remove('dragover'); });
+    zone.addEventListener('drop', e => { e.preventDefault(); zone.classList.remove('dragover'); addFiles(Array.from(e.dataTransfer.files)); });
+    window.addEventListener('dragover', e => e.preventDefault());
+    window.addEventListener('drop', e => e.preventDefault());
+    form.addEventListener('submit', e => {
+      e.preventDefault();
+      if (!validateDescription()) { description.reportValidity(); return; }
+      if (pending) return;
+      feedback = {type:new FormData(form).get('type'), description:description.value.trim(), email:document.querySelector('#email').value.trim(), screenshots:[...screenshots], createdAt:new Date().toISOString()};
+      document.querySelector('#result-summary').textContent = feedback.type + ' · ' + screenshots.length + ' 张截图';
+      dialog.showModal();
+    });
+    document.querySelector('#close-dialog').addEventListener('click', () => dialog.close());
+    document.querySelector('#download').addEventListener('click', () => {
+      if (!feedback) return;
+      const url = URL.createObjectURL(new Blob([JSON.stringify(feedback, null, 2)], {type:'application/json'}));
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = '留白反馈-' + new Date().toISOString().slice(0,10) + '.json';
+      document.body.append(link);
+      link.click();
+      link.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+    });
+  </script>
+</body>
+</html>

