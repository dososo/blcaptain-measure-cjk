f('永久') === -1) {\n            u.textContent = cycle === 'yearly' ? '/ 月，年付' : '/ 月';\n          }\n        });\n      }\n      buttons.forEach(function (b) {\n        b.addEventListener('click', function () { setCycle(b.dataset.cycle); });\n      });\n    })();\n  </script>\n</body>\n</html>\n"}}}
