from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.links = []
        self.headings = 0
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if tag == 'a': self.links.append(attrs.get('href', ''))
        if tag == 'h2': self.headings += 1
p = Path('index.html')
s = p.read_text()
c = Check()
c.feed(s)
assert len(c.ids) == len(set(c.ids)), 'Duplicate IDs'
assert all(link.startswith('#') and link[1:] in c.ids for link in c.links), 'Broken anchor'
assert c.headings == 5, 'Expected five chapters'
