+.art-sticker { position: absolute; right: 0; bottom: 70px; display: flex; align-items: center; gap: 10px; background: #faf3dc; border: 1px solid #d7c9a8; padding: 15px 18px; font-size: 13px; line-height: 1.7; transform: rotate(7deg); border-radius: 8px; }
+.art-sticker svg { width: 28px; height: 28px; color: #ba7950; }
+.art-footnote { display: block; text-align: center; font-size: 10px; letter-spacing: 3px; color: #7a8a72; margin-top: -12px; }
+.care-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 25px 0; }
