from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.refs=[]; self.plans=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a:
            assert a['id'] not in self.ids, 'Duplicate ID'
            self.ids.add(a['id'])
        if a.get('href','').startswith('#') and a['href']"'!='"'#': self.refs.append(a['href'][1:])
        if 'data-plan' in a: self.plans.append(a['data-plan'])
p=Path('index.html'); check=Check(); check.feed(p.read_text())
assert all(r in check.ids for r in check.refs), 'Missing link target'
assert len(check.plans)==4, 'Expected four plans'
print(f'Validated {p}: four pricing plans, unique IDs, all internal links resolve. {p.stat().st_size:,} bytes.')
