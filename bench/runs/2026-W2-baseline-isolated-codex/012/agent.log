from html.parser import HTMLParser
from pathlib import Path
import re
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.plans=[]
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if 'id' in attrs: self.ids.append(attrs['id'])
        if attrs.get('href','').startswith('#') and attrs['href'] "'!= '"'#': self.links.append(attrs['href'][1:])
        if 'data-plan' in attrs: self.plans.append(attrs['data-plan'])
p=Path('index.html'); content=p.read_text(); check=Check(); check.feed(content)
assert len(check.ids)==len(set(check.ids)), 'Duplicate IDs'
assert all(link in check.ids for link in check.links), 'Missing anchor'
assert check.plans == ['single','ten','month','year'], 'Missing plan'
assert '<meta name=\"viewport\"' in content
assert not re.search(r'(?:src|href)=\"https?://', content), 'External resource'
