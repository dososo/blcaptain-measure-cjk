+      {name:'satisfaction',label:'通勤满意度',options:['很不满意','不太满意','一般','比较满意','非常满意']},
+      {name:'improvement',label:'希望改善的方面',multiple:true,options:['缩短通勤时间','减少拥挤和堵车','降低出行费用','减少换乘次数','提高准点率','改善步行 / 骑行环境','其他','暂无改善需求']}
+    ];
+    const form=document.querySelector('#survey');
+    questions.forEach(q=>{
+      const container=document.getElementById(q.name+'-options');
+      q.options.forEach((value,i)=>{
+        const label=document.createElement('label');label.className='option'+(q.multiple?' checkbox':'');
+        const input=document.createElement('input');input.type=q.multiple?'checkbox':'radio';input.name=q.name;input.value=value;
+        if(!q.multiple) input.required=true;
+        const choice=document.createElement('span');choice.className='choice';
+        if(q.icons){choice.innerHTML='<svg class="icon" aria-hidden="true"><use href="#'+q.icons[i]+'"/></svg><span class="checkmark" aria-hidden="true">✓</span>';}
