+  <script>
+    const form = document.querySelector('#feedback-form');
+    const description = document.querySelector('#description');
+    const upload = document.querySelector('#screenshots');
+    const zone = document.querySelector('#dropzone');
+    const previews = document.querySelector('#previews');
+    const uploadError = document.querySelector('#upload-error');
+    const dialog = document.querySelector('#result');
+    const submit = document.querySelector('#submit');
+    let screenshots = [];
+    let feedback = null;
+    let pending = 0;
+    function validateDescription() {
+      const valid = description.value.trim().length >= 10;
+      description.setCustomValidity(valid ? '' : '请至少填写 10 个字，帮助我们了解你的反馈。');
+      return valid;
+    }
+    description.addEventListener('input', () => {
+      document.querySelector('#count').textContent = description.value.length;
+      validateDescription();
+      document.querySelector('#description-error').textContent = '';
+      description.removeAttribute('aria-invalid');
+    });
+    description.addEventListener('invalid', () => {
+      document.querySelector('#description-error').textContent = '请至少填写 10 个字，帮助我们了解你的反馈。';
+      description.setAttribute('aria-invalid', 'true');
+    });
+    function renderPreviews() {
+      previews.replaceChildren();
+      screenshots.forEach((item) => {
+        const wrapper = document.createElement('div');
+        wrapper.className = 'preview';
+        const img = document.createElement('img');
+        img.src = item.data;
+        img.alt = item.name;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-image';
+        remove.setAttribute('aria-label', '删除截图：' + item.name);
+        remove.innerHTML = '<svg aria-hidden="true"><use href="#x"/></svg>';
+        remove.addEventListener('click', () => {
+          screenshots = screenshots.filter(file => file !== item);
+          renderPreviews();
+          uploadError.textContent = '';
+          upload.focus();
+        });
+        wrapper.append(img, remove);
+        previews.append(wrapper);
+      });
+    }
+    async function addFiles(files) {
+      const errors = [];
+      for (const file of files) {
+        if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) { errors.push('仅支持 JPG、PNG 和 WebP 图片。'); continue; }
+        if (file.size > 5 * 1024 * 1024) { errors.push('单张截图不能超过 5 MB。'); continue; }
+        if (screenshots.length + pending >= 3) { errors.push('最多可上传 3 张截图。'); continue; }
+        if (screenshots.some(item => item.name === file.name && item.size === file.size)) continue;
+        pending++;
+        submit.disabled = true;
+        try {
+          const data = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
+          await new Promise((resolve, reject) => { const img = new Image(); img.onload = resolve; img.onerror = reject; img.src = data; });
+          screenshots.push({name:file.name, size:file.size, type:file.type, data});
+          renderPreviews();
+        } catch { errors.push('有一张图片无法读取，请重新选择。'); }
+        finally { pending--; submit.disabled = pending > 0; }
+      }
+      uploadError.textContent = [...new Set(errors)].join(' ');
+      upload.value = '';
+    }
+    upload.addEventListener('change', () => addFiles(Array.from(upload.files)));
+    ['dragenter', 'dragover'].forEach(event => zone.addEventListener(event, e => { e.preventDefault(); zone.classList.add('dragover'); }));
