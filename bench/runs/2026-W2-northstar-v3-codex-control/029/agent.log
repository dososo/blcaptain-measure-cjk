from pathlib import Path
from html.parser import HTMLParser
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack = []
        self.books = 0
    def handle_starttag(self, tag, attrs):
        if tag not in {'meta', 'path', 'circle', 'ellipse', 'br'}:
            self.stack.append(tag)
        if tag == 'li' and ('class', 'book') in attrs:
            self.books += 1
    def handle_endtag(self, tag):
        if tag in {'path', 'circle', 'ellipse'}:
            return
        assert self.stack and self.stack.pop() == tag, f'Mismatched closing tag: {tag}'
p = Path('index.html')
s = p.read_text()
check = Check()
check.feed(s)
assert not check.stack, check.stack
assert check.books == 5
assert 'aspect-ratio: 3 / 4' in s
assert '<script' not in s and '<link' not in s
print(f'OK: {p.name}; {check.books} books; 3:4 ratio; inline CSS and SVG; {p.stat().st_size} bytes')
