+<script>
+const registerModal=document.getElementById('register-modal');
+document.querySelectorAll('[data-register]').forEach(button=>button.addEventListener('click',()=>registerModal.showModal()));
+document.querySelectorAll('.modal').forEach(modal=>{modal.querySelector('.close-modal').addEventListener('click',()=>modal.close());modal.addEventListener('click',event=>{const rect=modal.getBoundingClientRect();if(event.target===modal&&(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom))modal.close()})});
+const menu=document.querySelector('.mobile-toggle');
+menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'收起导航':'展开导航');document.getElementById('nav-links').classList.toggle('open',open)});
+document.querySelectorAll('.nav-links a').forEach(link=>link.addEventListener('click',()=>{document.getElementById('nav-links').classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','展开导航')}));
+let toastTimer;function notify(message){const toast=document.getElementById('toast');toast.textContent=message;toast.hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>{toast.hidden=true},5000)}
+document.getElementById('register-form').addEventListener('submit',event=>{event.preventDefault();const name=document.getElementById('team-name');if(!name.value.trim()){name.setCustomValidity('请输入团队名称');name.reportValidity();return}const team=name.value.trim();document.getElementById('workspace-name').textContent=team;registerModal.close();document.getElementById('workspace').scrollIntoView({block:'center'});document.getElementById('workspace').focus({preventScroll:true});notify('欢迎来到「'+team+'」的体验账本，当前展示示例数据。');event.target.reset()});
+document.getElementById('team-name').addEventListener('input',event=>event.target.setCustomValidity(''));
+document.getElementById('demo-link').addEventListener('click',()=>{notify('这是工作台预览：查看收支概况、趋势与最近一笔记录。');document.getElementById('workspace').focus({preventScroll:true})});
+const legalCopy={privacy:['隐私说明','此页面是小账产品的静态演示。不使用跟踪工具或 Cookie，不收集或上传个人信息。体验表单中的信息仅用于当前页面展示，刷新后即清除。'],terms:['演示使用说明','本页面用于展示小账的产品设计与使用场景，不提供真实记账、云同步或账号服务。金额、经营数据、人物及评价均为示例。请勿将本演示作为真实财务记录使用。']};
+document.querySelectorAll('[data-legal]').forEach(button=>button.addEventListener('click',()=>{const [title,body]=legalCopy[button.dataset.legal];document.getElementById('legal-title').textContent=title;document.getElementById('legal-body').textContent=body;document.getElementById('legal-modal').showModal()}));
+</script>
+</body>
+</html>

