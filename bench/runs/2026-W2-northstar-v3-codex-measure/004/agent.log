+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="落笔 AI 写作助手，把零散的工作记录整理成清晰周报，让每一封邮件表达得体。">
+  <meta name="theme-color" content="#f7f8f2">
+  <title>落笔 · 把工作写清楚</title>
