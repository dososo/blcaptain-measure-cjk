from pathlib import Path
from html.parser import HTMLParser
p = Path('index.html')
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids = []; self.fields = set(); self.external = []
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag == 'input': self.fields.add(a.get('name'))
        if tag in ('script', 'link', 'img') and (a.get('src') or a.get('href')): self.external.append(a)
c = Check(); c.feed(p.read_text())
assert len(c.ids) == len(set(c.ids)), 'Duplicate IDs'
assert {'name', 'phone', 'city', 'session'} <= c.fields
assert not c.external
print('index.html 已生成；四项报名字段齐全，无外部资源依赖。')
