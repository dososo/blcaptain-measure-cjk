toast{position:fixed;bottom:28px;left:calc(50% + 122px);transform:translateX(-50%);padding:9px 18px;border-radius:6px;background:#263b2e;color:#edf3e6;font-size:12px;box-shadow:0 5px 20px #24372b20;opacity:0;pointer-events:none;transition:opacity .2s}.toast.visible{opacity:1}@media(min-width:1500px){.page{padding-top:60px}.principles{margin-bottom:45px}}@media(max-width:1100px){.sidebar{width:210px;padding:30px 18px}.shell{margin-left:210px}.topbar{padding:0 30px}.page{padding:35px 30px}.hero-decoration{display:none}.principles{gap:10px}.principle{padding:15px 10px;gap:8px}.toast{left:calc(50% + 105px)}}@media(max-width:760px){.sidebar{position:relative;inset:auto;width:auto;padding:20px 22px;border-right:0;border-bottom:1px solid var(--line)}.brand{font-size:14px}.workspace,.nav-label,.sidebar-note{display:none}.sidebar nav{display:flex;overflow-x:auto;gap:7px;margin-top:16px}.nav-link{white-space:nowrap;font-size:11px;padding:7px 9px;margin:0}.nav-link .num{font-size:10px}.nav-link.active:after{display:none}.shell{margin-left:0}.topbar{height:54px;padding:0 22px}.top-tag{font-size:10px}.page{padding:30px 22px}.hero{padding-bottom:26px}h1{font-size:34px}.lead{font-size:13px}.meta{gap:12px;flex-wrap:wrap}.principles{grid-template-columns:1fr;margin:22px 0 32px;gap:8px}.principle{padding:12px 14px;align-items:center}.principle h3{font-size:12px}.principle p{margin-top:0}.principle-icon{width:28px;height:28px}.branch-map{flex-direction:column;gap:12px;align-items:flex-start;padding:16px}.commit-grid{grid-template-columns:1fr 1fr}.flow{grid-template-columns:1fr 1fr}.step:nth-child(2):after{display:none}.review-grid{grid-template-columns:1fr;gap:12px}.quickstart{padding:19px 15px}.footer{gap:16px}.toast{left:50%}h2{font-size:20px}td,th{padding:12px 14px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}@media print{.sidebar,.topbar,.copy,.toast,.hero-decoration{display:none}.shell{margin:0}.page{max-width:none;padding:0}.forma