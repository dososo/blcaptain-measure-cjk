ted);\n  font-size: .82rem;\n  min-height: 1.4em;\n  margin: 0 0 1.25rem;\n}\n.price-note.saving { color: var(--success); }\n\n.btn {\n  display: block;\n  text-align: center;\n  padding: .7rem 1rem;\n  border-radius: .6rem;\n  font-weight: 600;\n  text-decoration: none;\n  border: 1px solid var(--accent);\n  color: var(--accent);\n  background: transparent;\n  transition: background .15s, color .15s;\n}\n.btn:hover { background: var(--accent-soft); }\n.btn.primary { background: var(--accent); color: var(--accent-fg); }\n.btn.primary:hover { filter: brightness(1.08); background: var(--accent); }\n\n.features {\n  list-style: none;\n  padding: 0;\n  margin: 1.5rem 0 0;\n  display: grid;\n  gap: .6rem;\n  font-size: .92rem;\n}\n.features li {\n  display: flex;\n  gap: .55rem;\n  align-items: flex-start;\n}\n.features li::before {\n  content: \"\";\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  margin-top: .22rem;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  -webkit-mask: none;\n  box-shadow: inset 0 0 0 .3rem var(--accent);\n  transform: scale(.75);\n}\n\n.footnote {\n  text-align: center;\n  color: var(--muted);\n  font-size: .88rem;\n  margin: .5rem 0 0;\n}\n\n/* 对比表 */\n.section {\n  padding-block: 4rem 0;\n}\n.section h2.section-title {\n  text-align: center;\n  font-size: clamp(1.5rem, 3vw, 2rem);\n  margin: 0 0 .5rem;\n}\n.section .section-sub {\n  text-align: center;\n  color: var(--muted);\n  margin: 0 0 2rem;\n}\n.table-scroll {\n  overflow-x: auto;\n  border: 1px solid var(--border);\n  border-radius: 1rem;\n  background: var(--surface);\n}\ntable {\n  width: 100%;\n  min-width: 40rem;\n  border-collapse: collapse;\n  font-size: .93rem;\n}\nth, td {\n  padding: .85rem 1rem;\n  text-align: center;\n  border-bottom: 1px solid var(--border);\n}\nth:first-child, td:first-child { text-align: left; color: var(--muted); }\nthead th { font-weight: 700; color: var(--fg); }\nthead th:first-child { color: var(--fg); }\ntbody tr:last-child td { border-bottom: 0; }\n.yes { color: var(--success); font-weight: 700; }\n.no { color: var(--muted); }\n\n/* FAQ */\n.faq {\n  max-width: 48rem;\n  margin: 0 auto;\n  display: grid;\n  gap: .75rem;\n}\n.faq details {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: .8rem;\n  padding: 0 1.25rem;\n}\n.faq summary {\n  cursor: pointer;\n  list-style: none;\n  padding-block: 1rem;\n  font-weight: 600;\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  align-items: center;\n}\n.faq summary::-webkit-details-marker { display: none; }\n.faq summary::after {\n  content: \"+\";\n  flex: none;\n  font-size: 1.3rem;\n  line-height: 1;\n  color: var(--accent);\n  transition: transform .2s;\n}\n.faq details[open] summary::after { transform: rotate(45deg); }\n.faq details p {\n  margin: 0 0 1rem;\n  color: var(--muted);\n}\n\n/* CTA */\n.cta {\n  margin-block: 4rem;\n  padding: 2.5rem 1.5rem;\n  border-radius: 1.25rem;\n  background: var(--accent-soft);\n  text-align: center;\n}\n.cta h2 { margin: 0 0 .5rem; font-size: 1.5rem; }\n.cta p { margin: 0 0 1.5rem; color: var(--muted); }\n.cta .btn { display: inline-block; padding-inline: 1.75rem; }\n\nfooter {\n  border-top: 1px solid var(--border);\n  color: var(--muted);\n  font-size: .85rem;\n  text-align: center;\n  padding-block: 1.5rem;\n}\n\n@media (max-width: 640px) {\n  .nav { display: none; }\n  .hero { padding-block: 2.5rem 1rem; }\n  .plan .tagline { min-height: 0; }\n}\n"}}}
