+    }
+    service.addEventListener('change', calculate);
+    calls.addEventListener('input', calculate);
+    calls.addEventListener('change', () => { calls.value = Math.max(0, Math.min(10000000, Math.floor(Number(calls.value) || 0))); calculate(); });
+    usage.addEventListener('input', () => { calls.value = usage.value; calculate(); });
+    document.querySelectorAll('[data-calculate]').forEach(button => button.addEventListener('click', () => { service.value = button.dataset.calculate; calculate(); document.querySelector('#calculator').scrollIntoView({ behavior: 'smooth' }); service.focus({ preventScroll: true }); }));
