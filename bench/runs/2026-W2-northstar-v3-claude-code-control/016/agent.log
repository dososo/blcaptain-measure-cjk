 1.25rem 0;\n}\n.cmd-card h3 { margin-top: 1rem; }\n\nfooter { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }\n\n@media (max-width: 760px) {\n  .layout { grid-template-columns: minmax(0, 1fr); gap: 1rem; padding-block: 1.25rem 3rem; }\n  .toc { position: static; }\n  .toc ol { display: flex; flex-wrap: wrap; border-left: 0; gap: .25rem; }\n  .toc li.sub { display: none; }\n  .toc li a { border: 1px solid var(--line); border-radius: 99px; padding: .15rem .75rem; margin: 0; }\n  .hero h1 { font-size: 1.8rem; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01XzWKfhkhzSXixx5ahqGysk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
