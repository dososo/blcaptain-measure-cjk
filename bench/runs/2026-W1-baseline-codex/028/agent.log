from pathlib import Path
from html.parser import HTMLParser
p=Path('index.html')
s=p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.headings=0
        self.external=[]
    def handle_starttag(self,tag,attrs):
        if tag=='h2': self.headings+=1
        for key,value in attrs:
            if key in ('src','href') and value.startswith(('http:','https:','//')): self.external.append(value)
c=Check();c.feed(s)
assert c.headings==3 and not c.external
assert 'aspect-ratio:3 / 4' in s
assert all(word in s for word in ('本金','收益率','风险'))
print('检查通过：三个知识点、3:4 比例、无外部依赖。')
print(f'已生成：{p.resolve()}，{p.stat().st_size} 字节')
