kground:var(--accent)}h1{font:500 38px/1.5 var(--serif);letter-spacing:3px;margin:0 0 10px}.intro-copy{margin:0;color:#858b7d;font-size:12px;letter-spacing:1px;line-height:1.8}.intro-aside{font:italic 16px/1.8 Georgia,serif;color:#8c927f;text-align:right;padding-bottom:5px}.intro-aside span{display:block;font:10px/2.4 sans-serif;letter-spacing:2px;color:#999f8f}.layout{display:grid;grid-template-columns:1fr 1.04fr;gap:28px;align-items:start}.restaurant{border-radius:6px;overflow:hidden;background:#eeeee5}.restaurant-image{height:394px;position:relative;overflow:hidden;background:#686a51}.restaurant-image img{height:100%;width:100%;object-fit:cover;object-position:center 55%;display:block;filter:brightness(.82) saturate(.7)}.restaurant-image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,#152014b8)}.image-tag{position:absolute;z-index:1;top:22px;left:23px;font-size:10px;letter-spacing:2px;color:#fff;border:1px solid #ffffff6b;padding:8px 12px;background:#26322633;backdrop-filter:blur(8px)}.image-caption{position:absolute;z-index:1;bottom:30px;left:30px;color:#fff}.overline{font-size:9px;letter-spacing:3px;opacity:.8;margin-bottom:12px}.image-caption h2{font:500 28px/1.5 var(--serif);letter-spacing:3px;margin:0 0 8px}.image-caption p{font-size:11px;letter-spacing:1px;opacity:.8;margin:0}.image-index{position:absolute;z-index:1;bottom:31px;right:25px;color:#fff9;font:11px Georgia;letter-spacing:2px}.restaurant-info{padding:25px 29px 26px}.info-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.info-top h3{font:500 18px var(--serif);letter-spacing:2px;margin:0}.cuisine{font-size:10px;color:#748068;border:1px solid #d1d7c6;padding:5px 9px;border-radius:3px}.info-line{display:flex;gap:11px;align-items:center;font-size:11px;color:#737b68;line-height:1.7;margin-top:11px}.info-line svg{width:16px;height:16px;flex-shrink:0}.split{color:#b0b4a5;padding:0 8px}.left-note{display:flex;align-items:cen