/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
p=Path('style.css');p.write_text(p.read_text()+'\\n.avoid-box .better-example,.checklist-header p,.toc-note p{font-size:14px}\\n')
from html.parser import HTMLParser
class Check(HTMLParser):
 def __init__(self):
  super().__init__(); self.ids=[]; self.refs=[]; self.files=[]
 def handle_starttag(self, tag, attrs):
  a=dict(attrs)
  if 'id' in a: self.ids.append(a['id'])
  if a.get('href','').startswith('#'): self.refs.append(a['href'][1:])
  if tag=='link': self.files.append(a['href'])
c=Check();c.feed(Path('index.html').read_text())
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert all(r in c.ids for r in c.refs), 'Missing anchor'
assert all(Path(f).is_file() for f in c.files), 'Missing stylesheet'
print('HTML anchors and local stylesheets: OK')
