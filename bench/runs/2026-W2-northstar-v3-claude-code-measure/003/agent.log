n.topbar nav { display: flex; gap: 20px; flex-wrap: wrap; }\n.topbar nav a {\n  color: var(--muted);\n  text-decoration: none;\n  font-size: 15px;\n}\n.topbar nav a:hover { color: var(--fg); }\n\n/* 首屏 */\n.hero { padding-block: 72px 56px; }\n.hero h1 {\n  font-size: clamp(32px, 6vw, 52px);\n  line-height: 1.25;\n  letter-spacing: 0.02em;\n  margin: 0 0 20px;\n  max-width: 14em;\n}\n.hero h1 span { color: var(--orange); }\n.hero .lead {\n  font-size: 18px;\n  color: var(--muted);\n  margin: 0 0 32px;\n}\n.actions { display: flex; gap: 12px; flex-wrap: wrap; }\n.btn {\n  display: inline-block;\n  padding: 12px 24px;\n  border-radius: var(--radius);\n  font-size: 16px;\n  font-weight: 600;\n  text-decoration: none;\n  border: 2px solid var(--green);\n  cursor: pointer;\n  font-family: inherit;\n}\n.btn-primary { background: var(--green); color: var(--bg); }\n.btn-primary:hover { opacity: 0.9; }\n.btn-ghost { background: transparent; color: var(--green); }\n\n.facts {\n  margin: 48px 0 0;\n  padding: 0;\n  list-style: none;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  border-top: 1px solid var(--line);\n}\n.facts li {\n  padding: 20px 16px 0 0;\n  line-height: 1.5;\n}\n.facts strong {\n  display: block;\n  font-size: 28px;\n  color: var(--fg);\n}\n.facts span { color: var(--muted); font-size: 14px; }\n\n/* 通用区块 */\nsection.block {\n  padding-block: 64px;\n  border-top: 1px solid var(--line);\n}\n.block h2 {\n  font-size: clamp(24px, 4vw, 32px);\n  letter-spacing: 0.02em;\n  margin: 0 0 12px;\n}\n.block .intro {\n  color: var(--muted);\n  margin: 0 0 36px;\n}\n\n/* 活动频率 */\n.schedule {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 0;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  overflow: hidden;\n}\n.schedule article {\n  padding: 24px;\n  border-right: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  min-width: 0;\n}\n.schedule .when {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--orange);\n  margin: 0 0 6px;\n}\n.schedule h3 { font-size: 20px; margin: 0 0 10px; }\n.schedule p { margin: 0; color: var(--muted); font-size: 15px; }\n.schedule .meta {\n  margin-top: 14px;\n  font-size: 14px;\n  color: var(--fg);\n}\n.note {\n  margin: 20px 0 0;\n  font-size: 15px;\n  color: var(--muted);\n}\n\n/* 路线难度 */\n.table-scroll { overflow-x: auto; }\ntable.levels {\n  width: 100%;\n  min-width: 720px;\n  border-collapse: collapse;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  font-size: 15px;\n}\n.levels th, .levels td {\n  text-align: left;\n  padding: 16px;\n  border-bottom: 1px solid var(--line);\n  vertical-align: top;\n  line-height: 1.6;\n}\n.levels thead th {\n  font-size: 14px;\n  color: var(--muted);\n  font-weight: 600;\n  background: var(--bg);\n}\n.levels tbody th { white-space: nowrap; }\n.tag {\n  display: inline-block;\n  padding: 2px 10px;\n  border-radius: 99px;\n  font-size: 14px;\n  font-weight: 600;\n}\n.tag-1 { background: var(--green-soft); color: var(--green); }\n.tag-2 { background: #f6ecd2; color: #7a5300; }\n.tag-3 { background: var(--orange-soft); color: var(--orange); }\n@media (prefers-color-scheme: dark) {\n  .tag-2 { background: #352c17; color: var(--yellow); }\n}\n.dots { display: inline-flex; gap: 3px; margin-left: 6px; vertical-align: middle; }\n.dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }\n.dots i.on { background: currentColor; }\n\n.rules {\n  margin: 32px 0 0;\n  padding: 20px 24px;\n  background: var(--green-soft);\n  border-radius: var(--radius);\n}\n.rules h3 { margin: 0 0 8px; font-size: 17px; }\n.rules ul { margin: 0; padding-left: 1.2em; }\n.rules li { margin: 4px 0; }\n\n/* 报名方式 */\n.signup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 48px;\n  align-items: start;\n}\n@media (max-width: 760px) {\n  .signup { grid-template-columns: minmax(0, 1fr); gap: 36px; }\n}\n.steps {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  counter-reset: step;\n}\n.steps li {\n  counter-increment: step;\n  position: relative;\n  padding: 0 0 24px 48px;\n}\n.steps li::before {\n  content: counter(step);\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--green);\n  color: var(--bg);\n  font-weight: 700;\n  display: grid;\n  place-items: center;\n  line-height: 1;\n}\n.steps h3 { margin: 2px 0 4px; font-size: 18px; }\n.steps p { margin: 0; color: var(--muted); }\n.contact {\n  margin-top: 8px;\n  padding: 16px 20px;\n  border: 1px dashed var(--line);\n  border-radius: var(--radius);\n  line-height: 1.8;\n}\n.contact code {\n  font-family: \"SF Mono\", Menlo, Consolas, monospace;\n  font-size: 15px;\n  background: var(--green-soft);\n  padding: 1px 6px;\n  border-radius: 4px;\n  user-select: all;\n}\n\nform.card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 28px;\n}\nform h3 { margin: 0 0 4px; font-size: 20px; }\nform .hint { margin: 0 0 20px; color: var(--muted); font-size: 14px; line-height: 1.6; }\n.field { margin-bottom: 16px; }\n.field label, .field legend {\n  display: block;\n  font-size: 15px;\n  font-weight: 600;\n  margin-bottom: 6px;\n  padding: 0;\n}\nfieldset.field { border: 0; padding: 0; margin: 0 0 16px; min-width: 0; }\n.field input[type=\"text\"], .field input[type=\"tel\"], .field select {\n  width: 100%;\n  padding: 10px 12px;\n  font-size: 16px;\n  font-family: inherit;\n  color: var(--fg);\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n}\n.field input:focus, .field select:focus { outline: 2px solid var(--green); outline-offset: 1px; }\n.radios { display: flex; flex-wrap: wrap; gap: 8px 20px; }\n.radios label { font-weight: 400; display: flex; gap: 6px; align-items: center; margin: 0; }\n.check { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; color: var(--muted); margin: 4px 0 20px; line-height: 1.6; }\n.check input { margin-top: 4px; }\nform .btn { width: 100%; }\n.error { color: var(--orange); font-size: 14px; margin: 10px 0 0; }\n\n.result {\n  margin-top: 20px;\n  padding: 16px;\n  background: var(--green-soft);\n  border-radius: var(--radius);\n}\n.result p { margin: 0 0 8px; font-size: 15px; }\n.result pre {\n  margin: 0 0 12px;\n  white-space: pre-wrap;\n  font-family: inherit;\n  font-size: 15px;\n  line-height: 1.7;\n  background: var(--surface);\n  padding: 12px;\n  border-radius: 4px;\n}\n.result .btn { padding: 8px 16px; font-size: 15px; width: auto; }\n\n/* 常见问题 */\n.faq details {\n  border-bottom: 1px solid var(--line);\n  padding: 16px 0;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 17px;\n}\n.faq details p { margin: 10px 0 0; color: var(--muted); }\n\nfooter {\n  border-top: 1px solid var(--line);\n  padding-block: 32px 48px;\n  color: var(--muted);\n  font-size: 14px;\n}\nfooter p { margin: 0 0 4px; line-height: 1.7; }\n\n@media (max-width: 560px) {\n  .topbar nav { display: none; }\n  .hero { padding-block: 48px 40px; }\n  section.block { padding-block: 48px; }\n  form.card { padding: 20px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013wnRFNrXZF9anze4R5GZT7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
