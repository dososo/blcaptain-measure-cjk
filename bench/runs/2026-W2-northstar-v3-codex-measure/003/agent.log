+@layer measure;
+:root{--paper:#f7f5ed;--ink:#233b30;--orange:#ef5a32;--muted:#657066;--line:#d9dcd0;--pale:#ebece2}
+*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:26px}body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,"PingFang SC","Microsoft YaHei",sans-serif;font-size:16px}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}a,button{touch-action:manipulation}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:5px}button{cursor:pointer}h1,h2,h3,p{margin:0}p{max-width:36em}svg{display:block;width:100%}.wrap{width:min(1280px,calc(100% - 104px));margin:auto}.header{height:112px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;gap:12px;align-items:center;font-size:25px;font-weight:850;line-height:1.2}.brand-symbol{width:43px;height:43px;background:var(--orange);color:var(--paper);display:grid;place-items:center;font-size:37px;border-radius:50%;font-weight:500}.brand-en{display:block;font-size:9px;letter-spacing:1.25px;margin-top:7px;font-weight:600}nav{display:flex;align-items:center;gap:34px;font-size:14px;font-weight:600}.nav-join{border:1px solid var(--ink);padding:13px 20px}.nav-join span{margin-left:24px;font-size:20px}nav a:hover,.text-link:hover{color:var(--orange)}.hero{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding-top:54px;padding-bottom:58px;align-items:center}.eyebrow{font-size:12px;font-weight:650;letter-spacing:1px;display:flex;align-items:center;gap:9px}.status-dot{height:7px;width:7px;border-radius:50%;background:var(--orange)}h1{font-size:clamp(40px,4.6vw,66px);line-height:1.24;margin:26px 0 24px;font-weight:850;letter-spacing:0}.orange{color:var(--orange)}.hero-intro{font-size:16px;color:var(--muted);line-height:1.9}.hero-actions{display:flex;gap:28px;align-items:center;margin-top:31px}.button{display:flex;align-items:center;justify-content:space-between;gap:34px;min-height:54px;background:var(--orange);color:#fff;padding:14px 23px;border:0;font-weight:650;font-size:15px;transition:background .2s,transform .2s}.button:hover{background:#cf4420;transform:translateY(-2px)}.button span{font-size:23px;line-height:1}.text-link{font-size:14px;font-weight:600}.text-link span{margin-left:16px}.hero-note{display:flex;align-items:center;gap:10px;font-size:12px;margin-top:34px;color:var(--muted)}.tiny-wheels{font-size:23px;letter-spacing:-5px;margin-right:6px;color:var(--ink)}.hero-art{position:relative;background:#e9ecdf;border:1px solid #d1d8c9;overflow:hidden}.art-topline,.art-bottomline{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;font-size:10px;font-weight:600;letter-spacing:.7px}.art-topline{border-bottom:1px solid #d1d8c9}.cycling-art{margin-top:-6px}.art-bottomline{border-top:1px solid #d1d8c9;font-size:12px}.art-bottomline span:last-child{font-size:23px}.art-sticker{position:absolute;right:24px;bottom:88px;width:116px;height:116px;display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(10deg);background:var(--paper);border:1px solid var(--ink);border-radius:50%;box-shadow:3px 3px 0 var(--ink);line-height:1.1}.art-sticker>span:first-child{font-size:12px;font-weight:750}.art-sticker strong{font-size:29px}.art-sticker>span:last-child{font-size:10px;margin-top:8px}.belief-bar{background:var(--ink);color:var(--paper)}.belief-bar .wrap{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}.belief-bar span{font-size:13px}.belief-bar span:first-child{font-size:20px;font-weight:650;margin-right:80px}.belief-bar span:not(:first-child):not(:last-child)::before{content:'✳';color:#c5d78c;margin-right:14px}.belief-bar .bar-arrow{font-size:32px;color:#c5d78c}.section{padding-top:78px;padding-bottom:70px}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:34px}.section-heading h2{font-size:30px;margin-top:16px;font-weight:750}.section-heading>p{font-size:14px;color:var(--muted)}.schedule-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.schedule{border-top:2px solid var(--ink);padding:22px 0 0}.schedule-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}.pill{font-size:12px;padding:5px 13px;border:1px solid #c9cebf;border-radius:24px}.schedule-top>span:last-child{font-size:31px;font-weight:400}.schedule h3{font-size:23px;margin-bottom:9px}.schedule>p{font-size:14px}.schedule-description{color:var(--muted);font-size:14px;line-height:1.8;margin:19px 0 27px}.schedule-bottom{display:flex;justify-content:space-between;font-size:12px;border-top:1px solid var(--line);padding-top:17px}.schedule-bottom span:last-child{color:#bd4324}.section-note{max-width:76em;margin-top:27px;color:var(--muted);font-size:12px}.routes-section{background:var(--pale)}.route{display:grid;grid-template-columns:1.15fr 1fr 1.4fr 34px;align-items:center;gap:24px;border-top:1px solid #ccd2c4;padding:27px 0}.route:last-child{border-bottom:1px solid #ccd2c4}.route-name{display:flex;align-items:center;gap:20px}.level{font-size:23px;white-space:nowrap;letter-spacing:1px}.level-one{color:#667e46}.level-two{color:#ad772c}.level-three{color:#cc5030}.route h3{font-size:19px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}.beginner{font-size:10px;font-weight:500;border:1px solid #8fa17d;padding:2px 7px;border-radius:3px}.route-name p{font-size:12px;color:var(--muted);margin-top:7px}.route-stat strong{font-size:25px;font-weight:650;display:block}.route-stat small{font-size:12px;font-weight:400}.route-stat>span,.route-detail>span{display:block;font-size:12px;color:var(--muted);margin-top:7px;line-height:1.75}.route-detail p{font-size:14px}.route>a{font-size:25px;width:40px;height:40px;border:1px solid #b3beaa;border-radius:50%;display:grid;place-items:center;transition:background .2s}.route>a:hover{background:#d3dac7}.route-footnote{display:flex;align-items:center;gap:14px;margin-top:22px;color:var(--muted)}.route-footnote>span{font-size:25px}.route-footnote p{font-size:12px;max-width:70em}.join{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-top:82px}.join h2{font-size:48px;line-height:1.3;margin:21px 0}.join-copy>p{font-size:16px;color:var(--muted)}.steps{list-style:none;padding:0;margin:31px 0 0;display:grid;gap:23px}.steps li{display:flex;gap:18px}.steps li>span{font-size:12px;width:30px;height:30px;display:grid;place-items:center;border:1px solid #c9cebf;border-radius:50%}.steps strong{font-size:14px}.steps p{font-size:12px;color:var(--muted);margin-top:3px}.signup{border:1px solid var(--line);background:#fffdf7;padding:34px 36px;align-self:start;box-shadow:6px 6px 0 #ebe9df}.form-heading{display:flex;justify-content:space-between;align-items:center}.form-heading h3{font-size:23px}.form-heading>span{font-size:32px;color:var(--orange)}.form-intro{font-size:12px;color:var(--muted);margin:7px 0 23px}.signup label{display:block;font-size:13px;font-weight:600;margin:17px 0 9px}.signup input,.signup select,.signup textarea{width:100%;min-height:47px;border:1px solid #d4d8cb;border-radius:0;background:var(--paper);padding:12px 13px;color:var(--ink);font-size:14px}.signup textarea{line-height:1.75;resize:vertical}.signup .button{width:100%;margin-top:26px}.form-note{font-size:12px;line-height:1.75;color:var(--muted);margin-top:15px}.copy-button{background:var(--ink);color:white;border:0;padding:12px 16px;font-size:14px;margin-top:10px}.signup #copy-status{font-size:12px;margin-top:8px;color:var(--muted)}.before-ride{border-top:1px solid var(--line);padding-top:30px;padding-bottom:65px}.faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:23px}details{border-bottom:1px solid var(--line);padding-bottom:16px}summary{cursor:pointer;font-size:14px;font-weight:600;line-height:1.75;padding-right:8px}details p{font-size:14px;color:var(--muted);margin-top:15px}.footer{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:108px;border-top:1px solid var(--ink)}.footer .brand{font-size:21px}.footer .brand-symbol{width:33px;height:33px;font-size:28px}.footer>span{font-size:14px}.footer small,.footer>a:last-child{font-size:12px;color:var(--muted)}[hidden]{display:none!important}
