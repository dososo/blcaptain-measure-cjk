5rem;\n  font-weight: 700;\n  font-size: 1.1rem;\n  color: var(--fg);\n  text-decoration: none;\n}\n.logo-mark {\n  width: 1.75rem;\n  height: 1.75rem;\n  border-radius: .5rem;\n  background: var(--accent);\n  display: grid;\n  place-items: center;\n  color: var(--accent-fg);\n}\n.nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }\n.nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }\n.nav a:hover, .nav a[aria-current] { color: var(--fg); }\n\n/* 头部 */\n.hero {\n  text-align: center;\n  padding-block: 4rem 2rem;\n}\n.hero h1 {\n  font-size: clamp(1.9rem, 4.5vw, 2.8rem);\n  line-height: 1.2;\n  margin: 0 0 .75rem;\n  letter-spacing: -.01em;\n}\n.hero p {\n  color: var(--muted);\n  font-size: 1.1rem;\n  margin: 0 auto;\n  max-width: 36rem;\n}\n\n/* 计费周期切换 */\n.billing-toggle {\n  display: inline-flex;\n  margin-top: 2rem;\n  padding: .25rem;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  background: var(--surface);\n}\n.billing-toggle button {\n  border: 0;\n  background: transparent;\n  color: var(--muted);\n  font: inherit;\n  font-size: .95rem;\n  padding: .45rem 1.1rem;\n  border-radius: 999px;\n  cursor: pointer;\n}\n.billing-toggle button[aria-pressed=\"true\"] {\n  background: var(--accent);\n  color: var(--accent-fg);\n  font-weight: 600;\n}\n.save-tag {\n  font-size: .75rem;\n  margin-left: .35rem;\n  padding: .05rem .4rem;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-weight: 600;\n}\n.billing-toggle button[aria-pressed=\"true\"] .save-tag {\n  background: rgba(255, 255, 255, .22);\n  color: inherit;\n}\n\n/* 价格卡片 */\n.plans {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));\n  gap: 1.25rem;\n  padding-block: 1.5rem 1rem;\n}\n.plan {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 1.75rem 1.5rem;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 1rem;\n  box-shadow: var(--shadow);\n}\n.plan.featured {\n  border: 2px solid var(--accent);\n}\n.badge {\n  position: absolute;\n  top: -.8rem;\n  left: 50%;\n  transform: translateX(-50%);\n  background: var(--accent);\n  color: var(--accent-fg);\n  font-size: .78rem;\n  font-weight: 600;\n  padding: .2rem .8rem;\n  border-radius: 999px;\n  white-space: nowrap;\n}\n.plan h2 {\n  font-size: 1.15rem;\n  margin: 0;\n}\n.plan .tagline {\n  color: var(--muted);\n  font-size: .9rem;\n  margin: .25rem 0 1.25rem;\n  min-height: 2.9em;\n}\n.capacity {\n  font-size: 2rem;\n  font-weight: 800;\n  letter-spacing: -.02em;\n  line-height: 1.1;\n}\n.capacity small {\n  font-size: 1rem;\n  font-weight: 600;\n  color: var(--muted);\n  margin-left: .2rem;\n}\n.price {\n  margin: .9rem 0 .2rem;\n  display: flex;\n  align-items: baseline;\n  gap: .25rem;\n  flex-wrap: wrap;\n}\n.price .amount {\n  font-size: 1.6rem;\n  font-weight: 700;\n}\n.price .unit { color: var(--muted); font-size: .9rem; }\n.price-note {\n  color: var(--muted);\n  font-size: .82rem;\n  min-height: 1.4em;\n  margin: 0 0 1.25rem;\n}\n.price-note.saving { color: var(--success); }\n\n.btn {\n  display: block;\n  text-align: center;\n  padding: .7rem 1rem;\n  border-radius: .6rem;\n  font-weight: 600;\n  text-decoration: none;\n  border: 1px solid var(--accent);\n  color: var(--accent);\n  background: transparent;\n  transition: background .15s, color .15s;\n}\n.btn:hover { background: var(--accent-soft); }\n.btn.primary { background: var(--accent); color: var(--accent-fg); }\n.btn.primary:hover { filter: brightness(1.08); background: var(--accent); }\n\n.features {\n  list-style: none;\n  padding: 0;\n  margin: 1.5rem 0 0;\n  display: grid;\n  gap: .6rem;\n  font-size: .92rem;\n}\n.features li {\n  display: flex;\n  gap: .55rem;\n  align-items: flex-start;\n}\n.features li::before {\n  content: \"\";\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  margin-top: .22rem;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  -webkit-mask: none;\n  box-shadow: inset 0 0 0 .3rem var(--accent);\n  transform: scale(.75);\n}\n\n.footnote {\n  text-align: center;\n  color: var(--muted);\n  font-size: .88rem;\n  margin: .5rem 0 0;\n}\n\n/* 对比表 */\n.section {\n  padding-block: 4rem 0;\n}\n.section h2.section-title {\n  text-align: center;\n  font-size: clamp(1.5rem, 3vw, 2rem);\n  margin: 0 0 .5rem;\n}\n.section .section-sub {\n  text-align: center;\n  color: var(--muted);\n  margin: 0 0 2rem;\n}\n.table-scroll {\n  overflow-x: auto;\n  border: 1px solid var(--border);\n  border-radius: 1rem;\n  background: var(--surface);\n}\ntable {\n  width: 100%;\n  min-width: 40rem;\n  border-collapse: collapse;\n  font-size: .93rem;\n}\nth, td {\n  padding: .85rem 1rem;\n  text-align: center;\n  border-bottom: 1px solid var(--border);\n}\nth:first-child, td:first-child { text-align: left; color: var(--muted); }\nthead th { font-weight: 700; color: var(--fg); }\nthead th:first-child { color: var(--fg); }\ntbody tr:last-child td { border-bottom: 0; }\n.yes { color: var(--success); font-weight: 700; }\n.no { color: var(--muted); }\n\n/* FAQ */\n.faq {\n  max-width: 48rem;\n  margin: 0 auto;\n  display: grid;\n  gap: .75rem;\n}\n.faq details {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: .8rem;\n  padding: 0 1.25rem;\n}\n.faq summary {\n  cursor: pointer;\n  list-style: none;\n  padding-block: 1rem;\n  font-weight: 600;\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  align-items: center;\n}\n.faq summary::-webkit-details-marker { display: none; }\n.faq summary::after {\n  content: \"+\";\n  flex: none;\n  font-size: 1.3rem;\n  line-height: 1;\n  color: var(--accent);\n  transition: transform .2s;\n}\n.faq details[open] summary::after { transform: rotate(45deg); }\n.faq details p {\n  margin: 0 0 1rem;\n  color: var(--muted);\n}\n\n/* CTA */\n.cta {\n  margin-block: 4rem;\n  padding: 2.5rem 1.5rem;\n  border-radius: 1.25rem;\n  background: var(--accent-soft);\n  text-align: center;\n}\n.cta h2 { margin: 0 0 .5rem; font-size: 1.5rem; }\n.cta p { margin: 0 0 1.5rem; color: var(--muted); }\n.cta .btn { display: inline-block; padding-inline: 1.75rem; }\n\nfooter {\n  border-top: 1px solid var(--border);\n  color: var(--muted);\n  font-size: .85rem;\n  text-align: center;\n  padding-block: 1.5rem;\n}\n\n@media (max-width: 640px) {\n  .nav { display: none; }\n  .hero { padding-block: 2.5rem 1rem; }\n  .plan .tagline { min-height: 0; }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2287,"cache_read_input_tokens":31725,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2287},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"56fb1670-d49e-4b63-8a97-e2e67484c433","uuid":"847ae04b-5a57-4893-b809-53e37a5476ba","timestamp":"2026-10-26T03:27:46.047Z","request_id":"req_011CgQ8uZmffWdxMfc4T8oPp","wire_tool_inputs":{"toolu_01UTrioHoXiPmukRBUskwt2J":{"file_path":"<tmp>/measure-baseline-claude-code-013-qwFZXE/styles.css","content":":root {\n  --bg: #f7f8fb;\n  --surface: #ffffff;\n  --fg: #1a1d29;\n  --muted: #5f6577;\n  --border: #e3e6ee;\n  --accent: #3a5bf0;\n  --accent-soft: #eaeefe;\n  --accent-fg: #ffffff;\n  --success: #1f9d61;\n  --shadow: 0 1px 2px rgba(20, 24, 40, .04), 0 8px 24px rgba(20, 24, 40, .06);\n}\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) {\n    --bg: #0f1117;\n    --surface: #171a23;\n    --fg: #e8eaf2;\n    --muted: #9aa0b4;\n    --border: #2a2f3d;\n    --accent: #6d86ff;\n    --accent-soft: #1e2546;\n    --accent-fg: #0f1117;\n    --success: #4cc98c;\n    --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 24px rgba(0, 0, 0, .25);\n    color-scheme: dark;\n  }\n}\n:root[data-theme=\