: center; gap: 6px; }\n.logo-mark { background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.nav-links { display: flex; gap: 24px; flex: 1; color: var(--muted); }\n.nav-links a:hover, .nav-links .active { color: var(--fg); }\n@media (max-width: 640px) { .nav-links { display: none; } .nav-inner { justify-content: space-between; } }\n\n/* Hero */\n.hero { text-align: center; padding-block: 72px 40px; }\n.eyebrow { display: inline-block; padding: 4px 12px; border-radius: 99px; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 600; }\n.hero h1 { font-size: clamp(28px, 5vw, 44px); line-height: 1.2; margin: 16px 0 12px; letter-spacing: -.02em; }\n.sub { color: var(--muted); max-width: 560px; margin: 0 auto; }\n\n.billing { display: inline-flex; margin-top: 32px; padding: 4px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); }\n.billing-opt { border: 0; background: none; color: var(--muted); font: inherit; font-weight: 600; padding: 8px 18px; border-radius: 99px; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: .2s; }\n.billing-opt.is-active { background: var(--fg); color: var(--bg); }\n.save { font-size: 11px; padding: 2px 6px; border-radius: 6px; background: var(--accent-2); color: #fff; }\n\n/* Plans */\n.plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; padding-bottom: 80px; }\n@media (max-width: 900px) { .plans { grid-template-columns: 1fr; max-width: 460px; } }\n.plan { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px 28px; box-shadow: var(--shadow); display: flex; flex-direction: column; min-width: 0; }\n.plan-featured { border: 2px solid var(--accent); transform: translateY(-8px); }\n@media (max-width: 900px) { .plan-featured { transform: none; } }\n.badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 12px; font-weight: 700; padding: 4px 14px; border-radius: 99px; white-space: nowrap; }\n.plan h2 { margin: 0; font-size: 20px; }\n.plan-desc { margin: 4px 0 0; color: var(--muted); font-size: 14px; }\n.price { margin-top: 24px; display: flex; align-items: baseline; gap: 2px; }\n.currency { font-size: 22px; font-weight: 600; }\n.amount { font-size: 48px; font-weight: 800; letter-spacing: -.03em; line-height: 1; }\n.per { color: var(--muted); margin-left: 6px; }\n.price-note { color: var(--muted); font-size: 13px; margin: 8px 0 24px; min-height: 1.6em; }\n\n.btn { display: inline-flex; justify-content: center; align-items: center; font-weight: 600; border-radius: 12px; padding: 12px 20px; transition: .2s; border: 1px solid transparent; }\n.btn-sm { padding: 6px 14px; border-radius: 10px; font-size: 14px; }\n.btn-block { width: 100%; }\n.btn-primary { background: var(--accent); color: #fff; }\n.btn-primary:hover { filter: brightness(1.08); box-shadow: 0 6px 20px color-mix(in srgb, var(--accent) 35%, transparent); }\n.btn-ghost { border-color: var(--line); }\n.btn-ghost:hover { border-color: var(--fg); }\n.btn-dark { background: var(--dark); color: var(--on-dark); }\n.btn-dark:hover { opacity: .88; }\n.btn-light { background: #fff; color: #16161d; }\n\n.features { list-style: none; padding: 24px 0 0; margin: 24px 0 0; border-top: 1px solid var(--line); display: grid; gap: 12px; font-size: 14px; }\n.features li { position: relative; padding-left: 28px; }\n.features li::before { content: \"✓\"; position: absolute; left: 0; top: 1px; width: 18px; height: 18px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 11px; font-weight: 700; display: grid; place-items: center; }\n.features li.off { color: var(--muted); text-decoration: line-through; opacity: .7; }\n.features li.off::before { content: \"–\"; background: var(--line); color: var(--muted); }\n\n/* Compare */\n.section-title { text-align: center; font-size: 28px; margin: 0 0 32px; letter-spacing: -.01em; }\n.compare { padding-bottom: 80px; }\n.table-scroll { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }\ntable { width: 100%; border-collapse: collapse; min-width: 600px; font-size: 14px; }\nth, td { padding: 14px 20px; text-align: center; border-bottom: 1px solid var(--line); }\nth:first-child, td:first-child { text-align: left; }\nthead th { font-size: 15px; padding-block: 18px; }\ntbody tr:last-child td { border-bottom: 0; }\n.group td { background: var(--bg); font-weight: 700; font-size: 13px; color: var(--muted); }\n.hl { background: var(--accent-soft); }\nth.hl { color: var(--accent); }\n.yes { color: var(--accent); font-weight: 700; }\n.no { color: var(--muted); }\n\n/* FAQ */\n.faq { max-width: 760px; padding-bottom: 80px; }\ndetails { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 0 20px; margin-bottom: 12px; }\nsummary { cursor: pointer; padding: 18px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 16px; }\nsummary::-webkit-details-marker { display: none; }\nsummary::after { content: \"+\"; color: var(--muted); font-size: 20px; line-height: 1; transition: transform .2s; }\ndetails[open] summary::after { transform: rotate(45deg); }\ndetails p { margin: 0 0 18px; color: var(--muted); }\n\n/* CTA */\n.cta { padding-bottom: 64px; }\n.cta-box { text-align: center; border-radius: 24px; padding: 56px 24px; color: #fff; background: linear-gradient(135deg, #5b4cf5, #a24cf5 55%, #ff6b9a); }\n.cta-box h2 { margin: 0 0 8px; font-size: clamp(22px, 4vw, 30px); }\n.cta-box p { margin: 0 0 24px; opacity: .9; }\n\n.footer { text-align: center; color: var(--muted); font-size: 13px; padding-block: 24px 40px; border-top: 1px solid var(--line); }\n.footer a:hover { color: var(--fg); }\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KhLtYmov5BsTFkiDYEYvsR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
