from pathlib import Path
from html.parser import HTMLParser
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids=set()
        self.links=[]
        self.faq=0
    def handle_starttag(self,tag,attrs):
        attrs=dict(attrs)
        if 'id' in attrs:
            assert attrs['id'] not in self.ids, 'Duplicate id'
            self.ids.add(attrs['id'])
        if tag=='a': self.links.append(attrs.get('href',''))
        if tag=='details': self.faq+=1
p=Path('index.html')
s=p.read_text()
c=Check()
c.feed(s)
assert all(h[1:] in c.ids for h in c.links if h.startswith('#'))
assert c.faq==6
assert '<html lang=\"zh-CN\">' in s
assert '2026 年 11 月 1 日' in s
assert 'https://' not in s and '<script' not in s
print(f'Checked index.html: {p.stat().st_size:,} bytes, 6 FAQs, valid anchor targets, no external dependencies.')
