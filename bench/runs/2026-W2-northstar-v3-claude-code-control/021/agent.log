order-color: var(--accent);\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);\n}\n.invalid input, .invalid select { border-color: var(--error); }\n\n.sessions { display: grid; gap: 0.6rem; }\n.session {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.6rem;\n  padding: 0.7rem 0.85rem;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  cursor: pointer;\n  transition: border-color .15s;\n}\n.session:hover { border-color: var(--accent); }\n.session input { margin-top: 0.3rem; accent-color: var(--accent); }\n.session strong { display: block; }\n.session span { color: var(--muted); font-size: 0.9em; }\n.invalid .session { border-color: var(--error); }\n\n.error {\n  min-height: 1.2em;\n  margin: 0.3rem 0 0;\n  font-size: 0.85rem;\n  color: var(--error);\n}\n\nbutton {\n  width: 100%;\n  padding: 0.8rem;\n  font: inherit;\n  font-weight: 600;\n  color: #fff;\n  background: var(--accent);\n  border: 0;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background .15s;\n}\nbutton:hover { background: var(--accent-hover); }\n\n.success {\n  padding: 1.25rem;\n  border-radius: 10px;\n  background: var(--success-bg);\n  color: var(--success-fg);\n}\n.success h2 { margin: 0 0 0.5rem; font-size: 1.2rem; }\n.success dl { margin: 0.75rem 0 1rem; display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; }\n.success dt { font-weight: 600; }\n.success dd { margin: 0; overflow-wrap: anywhere; }\n.success button { background: var(--success-fg); color: var(--success-bg); }\n\n[hidden] { display: none !important; }\n"}}}
