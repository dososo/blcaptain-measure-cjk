+    <symbol id="sync" viewBox="0 0 24 24"><path d="M20 9a8 8 0 0 0-14-3L3 9m0-5v5h5M4 15a8 8 0 0 0 14 3l3-3m0 5v-5h-5"/></symbol>
+    <symbol id="devices" viewBox="0 0 24 24"><rect x="3" y="4" width="13" height="11" rx="2"/><path d="M5 19h9m-5-4v4"/><rect x="16" y="10" width="6" height="11" rx="1.5"/></symbol>
+    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></symbol>
+  </defs></svg>
+  <header class="header wrap">
+    <a class="brand" href="#" aria-label="栖云首页"><span class="brand-icon"><svg><use href="#cloud"/></svg></span>栖云<span class="brand-en">qicloud</span></a>
+    <nav aria-label="主导航"><a href="#benefits">产品优势</a><a class="active" href="#pricing" aria-current="page">定价方案</a><a href="#faq">常见问题</a></nav>
+    <a href="#pricing" class="header-cta">免费开始 <span aria-hidden="true">↗</span></a>
+  </header>
+  <main>
+    <section class="hero wrap" aria-labelledby="hero-title">
+      <div class="hero-label"><span></span> 为每一种生活，留一点空间</div>
+      <h1 id="hero-title">重要的，都有<span class="accent">地方放。</span></h1>
+      <p class="hero-description">从第一张照片，到下一个大作。<br>选一份刚刚好的空间，让美好安心留下。</p>
+      <div class="hero-note"><svg><use href="#check"/></svg> 免费起步 <span>·</span> 随时升级 <span>·</span> 没有隐藏费用</div>
+      <div class="art art-left" aria-hidden="true"><div class="photo-card photo-back"></div><div class="photo-card photo-front"><div class="landscape"><span class="sun"></span><span class="mountain one"></span><span class="mountain two"></span></div><span class="photo-caption">留住每一刻</span></div><span class="art-spark">✳</span></div>
+      <div class="art art-right" aria-hidden="true"><div class="floating-cloud"><svg><use href="#cloud"/></svg></div><div class="file-tag"><span class="file-icon">↓</span>灵感，随时在线<span class="file-dot"></span></div><span class="orbit-dot"></span></div>
+    </section>
+    <section class="pricing wrap" id="pricing" aria-label="容量与定价">
+      <div class="billing-row"><div class="billing-switch" role="group" aria-label="付款周期"><button class="selected" type="button" data-cycle="monthly" aria-pressed="true">按月付费</button><button type="button" data-cycle="yearly" aria-pressed="false">按年付费 <span>省 20%</span></button></div><p class="billing-caption" id="billing-caption">灵活按月，空间随你而变</p></div>
+      <div class="plans">
+        <article class="plan">
+          <div class="plan-top"><span class="plan-symbol sprout" aria-hidden="true">✳</span><span class="plan-category">轻装起步</span></div>
+          <h2>免费版</h2><p class="plan-description">给日常的小美好，一个家。</p>
+          <div class="capacity">20 <span>GB</span></div>
+          <div class="price"><span class="currency">¥</span><strong data-month="0">0</strong><span class="period"> / 永久免费</span></div>
+          <p class="billing-detail" data-free="true">无需绑定支付方式</p>
+          <button class="plan-button" data-plan="免费版" data-space="20 GB" data-price="0">免费开始 <svg><use href="#arrow"/></svg></button>
+          <div class="features-title">小空间，也有完整体验</div>
+          <ul class="features"><li>20 GB 安全云存储</li><li>单个文件最大 2 GB</li><li>手机、电脑自动同步</li><li>7 天文件误删恢复</li></ul>
+        </article>
+        <article class="plan">
+          <div class="plan-top"><span class="plan-symbol" aria-hidden="true">◈</span><span class="plan-category">日常相伴</span></div>
+          <h2>轻享版</h2><p class="plan-description">相册和文件，都能轻松装下。</p>
+          <div class="capacity">200 <span>GB</span></div>
+          <div class="price"><span class="currency">¥</span><strong data-month="12">12</strong><span class="period"> / 月</span></div>
+          <p class="billing-detail" data-annual="115.20">每月付费，随时取消续订</p>
+          <button class="plan-button" data-plan="轻享版" data-space="200 GB" data-price="12">选择轻享版 <svg><use href="#arrow"/></svg></button>
+          <div class="features-title">包含免费版全部功能，以及</div>
+          <ul class="features"><li>200 GB 安全云存储</li><li>单个文件最大 10 GB</li><li>相册原画质自动备份</li><li>30 天文件误删恢复</li></ul>
+        </article>
+        <article class="plan featured">
+          <div class="popular"><span aria-hidden="true">✦</span> 最受欢迎</div>
+          <div class="plan-top"><span class="plan-symbol" aria-hidden="true">✦</span><span class="plan-category">灵感自由生长</span></div>
+          <h2>进阶版</h2><p class="plan-description">为热爱和创作，多留些余地。</p>
+          <div class="capacity">2 <span>TB</span></div>
+          <div class="price"><span class="currency">¥</span><strong data-month="28">28</strong><span class="period"> / 月</span></div>
+          <p class="billing-detail" data-annual="268.80">每月付费，随时取消续订</p>
+          <button class="plan-button primary" data-plan="进阶版" data-space="2 TB" data-price="28">选择进阶版 <svg><use href="#arrow"/></svg></button>
+          <div class="features-title">包含轻享版全部功能，以及</div>
+          <ul class="features"><li>2 TB 安全云存储</li><li>单个文件最大 100 GB</li><li>最多与 5 位家人共享空间</li><li>90 天文件恢复与历史版本</li></ul>
+        </article>
+        <article class="plan">
+          <div class="plan-top"><span class="plan-symbol infinity" aria-hidden="true">∞</span><span class="plan-category">装下更多可能</span></div>
+          <h2>旗舰版</h2><p class="plan-description">海量素材，尽管放手去创造。</p>
+          <div class="capacity">10 <span>TB</span></div>
+          <div class="price"><span class="currency">¥</span><strong data-month="88">88</strong><span class="period"> / 月</span></div>
+          <p class="billing-detail" data-annual="844.80">每月付费，随时取消续订</p>
+          <button class="plan-button" data-plan="旗舰版" data-space="10 TB" data-price="88">选择旗舰版 <svg><use href="#arrow"/></svg></button>
+          <div class="features-title">包含进阶版全部功能，以及</div>
+          <ul class="features"><li>10 TB 安全云存储</li><li>单个文件最大 500 GB</li><li>180 天文件恢复与历史版本</li><li>专属优先客服支持</li></ul>
+        </article>
+      </div>
+      <p class="pricing-footnote">每一档，都认真守护你的文件。所有价格均为人民币含税价。</p>
+    </section>
+    <section class="benefits wrap" id="benefits" aria-label="所有方案均包含">
+      <div class="benefit-intro"><span class="eyebrow">安心，是标配</span><h2>不止是更大的空间。</h2></div>
+      <div class="benefit"><svg><use href="#shield"/></svg><div><h3>安全加密</h3><p>传输与存储全程加密</p></div></div>
+      <div class="benefit"><svg><use href="#sync"/></svg><div><h3>自动备份</h3><p>珍贵文件，多一份安心</p></div></div>
+      <div class="benefit"><svg><use href="#devices"/></svg><div><h3>多端同步</h3><p>随时随地，接着上次继续</p></div></div>
+    </section>
+    <section class="faq wrap" id="faq" aria-labelledby="faq-title">
+      <div class="faq-intro"><span class="eyebrow">一点解答，少点疑问</span><h2 id="faq-title">你可能还想知道</h2><p>关于空间、订阅和文件，<br>答案都在这里。</p><div class="faq-doodle" aria-hidden="true">?</div></div>
+      <div class="questions">
+        <details open><summary>我应该选择多大的存储空间？<span class="toggle-icon"></span></summary><p class="measure-prose">如果主要存放文档，可以从免费的 20 GB 开始；备份日常照片适合 200 GB；经常拍视频、保存设计素材，或与家人共享，建议选择 2 TB；大量原始素材和长期归档则适合 10 TB。你可以随时升级。</p></details>
+        <details><summary>可以随时升级或降级方案吗？<span class="toggle-icon"></span></summary><p class="measure-prose">可以。升级时按当前周期剩余时间补齐差价，新空间立即生效。降级将在下个计费周期生效；请先将已用空间调整到新方案的容量以内。</p></details>
+        <details><summary>按年付费和按月付费有什么区别？<span class="toggle-icon"></span></summary><p class="measure-prose">两种付费方式享有相同功能。年付一次支付全年费用，相比连续月付节省 20%；页面显示的年付月价是全年费用除以 12 后的折算价格。免费版不受计费周期影响。</p></details>
+        <details><summary>取消订阅后，我的文件会被删除吗？<span class="toggle-icon"></span></summary><p class="measure-prose">取消续订后，已付费空间仍可使用到本周期结束。到期后账户恢复为 20 GB 免费空间；超出容量时将暂停上传和同步，并保留 30 天下载整理时间。我们会在保留期结束前提醒你。</p></details>
+        <details><summary>共享空间后，家人能看到我的文件吗？<span class="toggle-icon"></span></summary><p class="measure-prose">不能。家庭成员共享存储额度，各自的文件和相册保持独立。只有你主动分享的文件，才会向指定的人开放。</p></details>
+      </div>
+    </section>
+    <section class="closing wrap"><div><span class="eyebrow">从今天开始，轻装一点</span><h2>把空间留给文件，把时间留给生活。</h2></div><button class="primary closing-button" data-plan="免费版" data-space="20 GB" data-price="0">领取 20 GB 免费空间 <svg><use href="#arrow"/></svg></button></section>
+  </main>
+  <footer class="footer wrap"><a class="brand" href="#"><span class="brand-icon"><svg><use href="#cloud"/></svg></span>栖云</a><span>让每一份珍贵，都有所栖。</span><p>© 2026 栖云 · 概念产品展示</p></footer>
+  <dialog id="plan-dialog" aria-labelledby="dialog-title"><form method="dialog"><button class="dialog-close" aria-label="关闭弹窗">×</button></form><span class="eyebrow">你的空间选择</span><h2 id="dialog-title">进阶版</h2><p id="dialog-summary"></p><div class="dialog-notice">这是定价页面演示，尚未连接账户与支付服务。你的选择仅在当前页面展示，不会产生扣费。</div><form method="dialog"><button class="primary dialog-done">好的，继续浏览</button></form></dialog>
+  <script>
+    const cycleButtons = document.querySelectorAll('[data-cycle]');
+    let currentCycle = 'monthly';
+    function format(value) { return Number(value.toFixed(2)).toString(); }
+    cycleButtons.forEach(button => button.addEventListener('click', () => {
+      currentCycle = button.dataset.cycle;
+      const annual = currentCycle === 'yearly';
+      cycleButtons.forEach(item => { const selected = item === button; item.classList.toggle('selected', selected); item.setAttribute('aria-pressed', String(selected)); });
+      document.querySelectorAll('[data-month]').forEach(price => { price.textContent = format(Number(price.dataset.month) * (annual ? 0.8 : 1)); });
+      document.querySelectorAll('[data-annual]').forEach(detail => { detail.textContent = annual ? `每年 ¥${detail.dataset.annual}，一次付清` : '每月付费，随时取消续订'; });
+      document.getElementById('billing-caption').textContent = annual ? '一次年付，让每一份空间都更划算' : '灵活按月，空间随你而变';
+    }));
+    const dialog = document.getElementById('plan-dialog');
+    document.querySelectorAll('[data-plan]').forEach(button => button.addEventListener('click', () => {
+      const price = Number(button.dataset.price);
+      document.getElementById('dialog-title').textContent = `${button.dataset.plan} · ${button.dataset.space}`;
+      document.getElementById('dialog-summary').textContent = price === 0 ? '永久免费，无需绑定支付方式。' : currentCycle === 'yearly' ? `年付 ¥${(price * 12 * 0.8).toFixed(2)}，折合每月 ¥${format(price * 0.8)}。` : `每月 ¥${price}，随时取消续订。`;
+      dialog.showModal();
+    }));
+    dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+  </script>
+</body>
+</html>
diff --git a/style.css b/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..98bf0c1be964a403f7217ce2fa45097eeded9db8
--- /dev/null
+++ b/style.css
@@ -0,0 +1,20 @@
+@layer measure;
+:root{--paper:#f7f6f2;--ink:#282b26;--muted:#777a71;--line:#e3e4dc;--orange:#e77954;--orange-dark:#ad4d2d;--green:#57705a}
+*{box-sizing:border-box}
+html{scroll-behavior:smooth;scroll-padding-top:30px}
+body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,"PingFang SC","Noto Sans SC",sans-serif;font-size:14px;-webkit-font-smoothing:antialiased}
+button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-decoration:none}button,a,summary{touch-action:manipulation}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--orange-dark);outline-offset:5px}
+button{transition:background .2s,transform .2s}button:hover{transform:translateY(-2px)}p,h1,h2,h3{margin:0}p{max-width:36em}svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.svg-defs{position:absolute;width:0;height:0;overflow:hidden}.wrap{width:min(1200px,calc(100% - 96px));margin-inline:auto}
+.header{height:99px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:24px;white-space:nowrap}.brand-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:var(--orange);color:var(--paper)}.brand-icon svg{width:27px;height:27px;fill:currentColor;stroke:none}.brand-en{font-size:14px;font-weight:500;color:var(--muted);margin:4px 0 0 2px}.header nav{display:flex;gap:38px;height:100%;align-items:center}.header nav a{color:#777970;font-size:14px;height:100%;display:flex;align-items:center;position:relative}.header nav a.active{color:var(--ink);font-weight:600}.header nav a.active:after{content:"";height:3px;width:20px;background:var(--orange);position:absolute;bottom:22px;left:calc(50% - 10px);border-radius:2px}.header-cta{border:1px solid #cdd0c4;padding:10px 17px;border-radius:7px;font-weight:600}.header-cta span{margin-left:13px}
