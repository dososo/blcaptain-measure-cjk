+<script>
+const form = document.getElementById('signup');
+const success = document.getElementById('success');
+function validateField(id) {
+  const input = document.getElementById(id);
+  const value = input.value.trim();
+  const valid = id === 'phone' ? /^1[3-9]\d{9}$/.test(value.replace(/[\s-]/g, '')) : value.length > 0;
+  input.setAttribute('aria-invalid', String(!valid));
+  document.getElementById(id + '-error').classList.toggle('show', !valid);
+  return valid;
+}
+['name', 'phone', 'city'].forEach(id => {
+  const input = document.getElementById(id);
+  input.addEventListener('blur', () => { if(input.value || input.hasAttribute('aria-invalid')) validateField(id); });
+  input.addEventListener('input', () => { if(input.getAttribute('aria-invalid') === 'true') validateField(id); });
+});
+form.addEventListener('input', () => { success.hidden = true; });
+form.addEventListener('change', () => {
+  if(form.querySelector('input[name="session"]:checked')) {
+    document.getElementById('session-error').classList.remove('show');
+    form.querySelectorAll('input[name="session"]').forEach(input => input.setAttribute('aria-invalid', 'false'));
+  }
+});
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  success.hidden = true;
+  let firstInvalid = null;
+  ['name', 'phone', 'city'].forEach(id => { if(!validateField(id) && !firstInvalid) firstInvalid = document.getElementById(id); });
+  const session = form.querySelector('input[name="session"]:checked');
+  document.getElementById('session-error').classList.toggle('show', !session);
+  form.querySelectorAll('input[name="session"]').forEach(input => input.setAttribute('aria-invalid', String(!session)));
+  if(!session && !firstInvalid) firstInvalid = form.querySelector('input[name="session"]');
+  if(firstInvalid) { firstInvalid.focus(); return; }
+  document.getElementById('summary').textContent = document.getElementById('name').value.trim() + ' · ' + document.getElementById('city').value.trim() + ' · ' + session.value;
+  success.hidden = false;
+});
+</script>
