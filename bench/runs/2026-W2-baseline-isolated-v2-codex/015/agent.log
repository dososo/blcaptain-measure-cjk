+<dialog id="quickstart" aria-labelledby="dialog-title"><div class="dialog-top"><h2 id="dialog-title">开始构建</h2><button class="close" aria-label="关闭">×</button></div><p id="dialog-description"></p><pre><code id="sample-code"></code></pre><p class="api-note">这是产品定价演示。上述域名和密钥为示例，尚未连接实际 API 服务；无需注册或提供支付信息。</p><div class="dialog-actions"><span>先用费用计算器，估算你的第一个月。</span><button class="btn" id="estimate-selected">估算此 API 费用 <span class="arrow">↗</span></button></div></dialog>
+<script>
+const plans={data:{name:'基础数据 API',price:.2,free:10000,path:'data/search'},smart:{name:'智能处理 API',price:1.5,free:1000,path:'intelligence/analyze'},events:{name:'实时事件 API',price:.5,free:5000,path:'events'}};
+const usage=document.getElementById('usage'),type=document.getElementById('api-type');
+function calculate(){const n=Number(usage.value),p=plans[type.value];document.getElementById('volume').textContent=n.toLocaleString('zh-CN');document.getElementById('cost').textContent=(Math.max(0,n-p.free)/1000*p.price).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});document.getElementById('included').textContent=n<p.free?'当前用量完全包含在免费额度内':'已扣除 '+p.free.toLocaleString('zh-CN')+' 次免费额度';usage.style.background='linear-gradient(to right,#426e3e '+n/10000+'%,#d7dfcf '+n/10000+'%)';usage.setAttribute('aria-valuetext','每月 '+n.toLocaleString('zh-CN')+' 次');}
+usage.addEventListener('input',calculate);type.addEventListener('change',calculate);
+const dialog=document.getElementById('quickstart');let selected='data';
+document.querySelectorAll('[data-start]').forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.start;const p=plans[selected];document.getElementById('dialog-title').textContent='开始使用'+p.name;document.getElementById('dialog-description').textContent='每月 '+p.free.toLocaleString('zh-CN')+' 次免费调用，从一个简单的请求开始。';document.getElementById('sample-code').textContent='curl https://api.relay.example/v1/'+p.path+' '+String.fromCharCode(92,10)+'  -H "Authorization: Bearer YOUR_API_KEY"';dialog.showModal();}));
+document.querySelector('.close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
+document.getElementById('estimate-selected').addEventListener('click',()=>{type.value=selected;calculate();dialog.close();document.getElementById('calculator').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});type.focus({preventScroll:true});});
+document.getElementById('scale-link').addEventListener('click',()=>{document.getElementById('billing-faq').open=true;});calculate();
+</script>
+</body>
+</html>

