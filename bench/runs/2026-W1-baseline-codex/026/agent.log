from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.cards=0; self.steps=0; self.images=0; self.external=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if tag=='article': self.cards+=1
        if tag=='li': self.steps+=1
        if tag=='svg' and a.get('role')=='img': self.images+=1
        if tag in ('script','link','img'): self.external.append((tag,a))
p=Path('index.html'); s=p.read_text(); c=Check(); c.feed(s)
assert c.cards==4 and c.steps==12 and c.images==4
assert not c.external
assert 'aspect-ratio:3/4' in s
print(f'验证通过：{p.name}，4 个做法、12 个步骤、4 幅内嵌插画、3:4 比例，无外部依赖。')
