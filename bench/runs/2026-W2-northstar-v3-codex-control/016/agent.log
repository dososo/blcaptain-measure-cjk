from html.parser import HTMLParser
from pathlib import Path
import shutil, subprocess
p=Path('index.html')
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.targets=[]; self.scripts=[]; self.in_script=False
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        for key in ('href','data-copy','aria-controls','aria-labelledby'):
            v=a.get(key,'')
            if key=='href' and v.startswith('#'): self.targets.append(v[1:])
            elif key"'!='"'href' and v: self.targets.extend(v.split())
        if tag=='script': self.in_script=True
    def handle_endtag(self, tag):
        if tag=='script': self.in_script=False
    def handle_data(self,data):
        if self.in_script: self.scripts.append(data)
c=Check(); c.feed(p.read_text())
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert all(x in c.ids for x in c.targets), 'Missing target'
print('HTML: all IDs unique; internal links and controls resolve.')
node=shutil.which('node')
if node:
    r=subprocess.run([node,'--check'],input='\\n'.join(c.scripts),text=True,capture_output=True)
    assert r.returncode==0,r.stderr
    print('JavaScript: syntax check passed.')
print(f'Created index.html ({p.stat().st_size:,} bytes), CSS and JavaScript included.')
