from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.plans=[]; self.ids=set(); self.links=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'data-plan' in a:self.plans.append(a['data-plan'])
        if 'id' in a:self.ids.add(a['id'])
        if tag=='a' and a.get('href','').startswith('#') and a['href']"'!='"'#':self.links.append(a['href'][1:])
p=Path('index.html'); text=p.read_text(); check=Check(); check.feed(text)
assert check.plans==['单次课','10 次卡','月卡','年卡']
assert all(target in check.ids for target in check.links)
assert '<meta name=\"viewport\"' in text and 'prefers-reduced-motion' in text
assert 'src=\"http' not in text and 'href=\"http' not in text
assert 128*10-980==300 and 680*12-5880==2280
print('检查通过：四种套餐、页内锚点、移动端配置、零外部资源、价格计算。')
print(f'已生成：{p.resolve()}（{p.stat().st_size} 字节）')
