+<body>
+  <div class="page" id="top">
+    <header class="masthead">
+      <div class="brand">书页之间 · 读书笔记</div>
+      <div class="issue">经济与社会 / 第 01 篇</div>
+    </header>
+    <main>
+      <section class="hero" aria-labelledby="book-heading">
