from pathlib import Path
import datetime
p=Path('index.html')
s=p.read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.inputs=[]; self.ids=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='input': self.inputs.append(a)
c=Check(); c.feed(s)
assert len(c.ids)==len(set(c.ids))
assert {'name','phone','city','session'} <= {a['name'] for a in c.inputs}
assert all('required' in a for a in c.inputs)
