+    const endpoints = [
+      {id:'list-users',method:'GET',path:'/users',title:'获取用户列表',desc:'分页获取工作空间中的用户，默认按创建时间倒序排列。',scope:'users:read',paramTitle:'查询参数',params:[['page','integer','可选','页码，从 1 开始；默认值为 1。'],['per_page','integer','可选','每页数量，取值 1–100；默认值为 20。']],requestPath:'/users?page=1&per_page=20',status:'200 OK',response:{data:[user],pagination:{page:1,per_page:20,total:1}},responseNote:'data 为用户对象数组；pagination 包含当前页码、每页数量与总记录数。',errors:'400、401、403、429、500'},
+      {id:'get-user',method:'GET',path:'/users/{user_id}',title:'获取用户详情',desc:'通过唯一用户 ID 获取用户的基本信息及创建、更新时间。',scope:'users:read',paramTitle:'路径参数',params:[['user_id','string','必填','用户的唯一标识，例如 usr_01J8QX。']],requestPath:'/users/usr_01J8QX',status:'200 OK',response:user,responseNote:'返回完整用户对象。未找到对应用户时返回 404。',errors:'401、403、404、429、500'},
+      {id:'create-user',method:'POST',path:'/users',title:'创建用户',desc:'在工作空间中创建一位新用户。邮箱地址须唯一，用户 ID 由系统生成。',scope:'users:write',paramTitle:'请求体 · application/json',params:[['name','string','必填','用户名称，去除首尾空白后为 1–50 个字符。'],['email','string','必填','有效的邮箱地址，最长 254 个字符。']],requestPath:'/users',body:{name:'林小满',email:'xiaoman@example.com'},status:'201 Created',response:user,responseNote:'返回新建的用户对象。邮箱已被使用时返回 409。',errors:'400、401、403、409、429、500'},
