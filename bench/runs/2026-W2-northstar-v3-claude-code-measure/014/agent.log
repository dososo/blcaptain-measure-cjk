plans {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n}\n.plan {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 24px 22px;\n  min-width: 0;\n}\n.plan.pick {\n  border: 2px solid var(--accent);\n  padding: 23px 21px;\n}\n.plan .badge {\n  position: absolute;\n  top: -12px;\n  left: 20px;\n  background: var(--accent);\n  color: var(--accent-fg);\n  font-size: 13px;\n  padding: 2px 10px;\n  border-radius: 4px;\n}\n.plan h3 {\n  font-size: 19px;\n  margin: 0 0 4px;\n}\n.plan .for {\n  color: var(--muted);\n  font-size: 15px;\n  margin: 0 0 18px;\n  line-height: 1.6;\n}\n.price {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n  margin: 0;\n}\n.price .num {\n  font-size: 36px;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n.price .cur { font-size: 18px; font-weight: 600; }\n.unit {\n  margin: 4px 0 20px;\n  font-size: 15px;\n  color: var(--muted);\n}\n.unit strong { color: var(--fg); font-weight: 600; }\n.plan ul {\n  list-style: none;\n  padding: 0;\n  margin: 0 0 24px;\n  flex: 1;\n}\n.plan li {\n  position: relative;\n  padding-left: 18px;\n  font-size: 15px;\n  line-height: 1.7;\n  margin-bottom: 6px;\n}\n.plan li::before {\n  content: \"\";\n  position: absolute;\n  left: 2px;\n  top: 0.72em;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--ink);\n}\n.btn {\n  display: block;\n  text-align: center;\n  text-decoration: none;\n  font-size: 16px;\n  font-weight: 600;\n  padding: 11px 16px;\n  border-radius: 6px;\n  border: 1px solid var(--fg);\n  color: var(--fg);\n}\n.btn:hover { background: var(--ink-soft); }\n.pick .btn, .btn.solid {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: var(--accent-fg);\n}\n.pick .btn:hover, .btn.solid:hover { filter: brightness(1.06); background: var(--accent); }\n\n.note {\n  margin: 18px 0 0;\n  font-size: 14px;\n  color: var(--muted);\n}\n\n/* 对比表 */\n.compare {\n  padding-block: 40px;\n  border-top: 1px solid var(--line);\n}\n.compare h2, .faq h2 {\n  font-size: 26px;\n  margin: 0 0 20px;\n}\n.table-scroll {\n  overflow-x: auto;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface);\n}\ntable {\n  width: 100%;\n  min-width: 560px;\n  border-collapse: collapse;\n  font-size: 15px;\n}\nth, td {\n  text-align: left;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n  vertical-align: top;\n}\ntr:last-child th, tr:last-child td { border-bottom: 0; }\nthead th {\n  font-size: 15px;\n  background: var(--ink-soft);\n}\ntbody th {\n  font-weight: 600;\n  color: var(--muted);\n  width: 22%;\n}\n\n/* 常见问题 */\n.faq {\n  padding-block: 40px;\n  border-top: 1px solid var(--line);\n}\n.faq details {\n  border-bottom: 1px solid var(--line);\n  padding-block: 14px;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 17px;\n  line-height: 1.6;\n}\n.faq details p {\n  margin: 10px 0 0;\n  color: var(--muted);\n}\n\n/* 底部试听 */\n.trial {\n  margin-block: 40px 56px;\n  padding: 32px;\n  border-radius: 10px;\n  background: var(--accent-soft);\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n.trial h2 {\n  font-size: 24px;\n  margin: 0 0 6px;\n}\n.trial p { margin: 0; color: var(--muted); }\n.trial > div { min-width: 0; }\n\nfooter {\n  border-top: 1px solid var(--line);\n  padding-block: 24px;\n  font-size: 14px;\n  color: var(--muted);\n}\n\n@media (max-width: 860px) {\n  .plans { grid-template-columns: minmax(0, 1fr); gap: 24px; }\n  .track-head { grid-template-columns: minmax(0, 1fr); }\n}\n@media (max-width: 560px) {\n  .topnav { display: none; }\n  .facts { grid-template-columns: minmax(0, 1fr); }\n  .facts li + li { border-left: 0; border-top: 1px solid var(--line); }\n  .trial { padding: 24px 20px; }\n  .switch { display: flex; }\n  .switch a { flex: 1; text-align: center; padding-inline: 8px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_019NT3qhKwApmUMYk8Pn5kFz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
