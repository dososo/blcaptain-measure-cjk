from pathlib import Path
p=Path('style.css')
s=p.read_text().replace('--mono:ui-monospace,monospace','--mono:ui-monospace,\"PingFang SC\",\"Microsoft YaHei\",monospace')
s+='''
/* Keep Chinese labels legible at every viewport and bound reading line length. */
.article-body{max-width:36em;margin-inline:auto;font-size:17px}
p{max-width:36em}
.sheet-grid{font-size:12px}
.python-art .code-gray{font-size:12px;font-family:var(--sans)}
.mini-label,.tools-note .mini-label,.breadcrumb,.eyebrow,.article-meta,.tags a,.tags>span,.art-footer>span:last-child,footer p span,.footer-brand span{font-size:12px}
.setup p,.sample .table-note,.tip .takeaway,.cheatsheet>p,.sidebar-note p,footer p{font-size:14px}
.sidebar-note p{max-width:14em}
@media(max-width:760px){
  .article-body{font-size:15px}
  .sheet-grid{font-size:12px}
  .python-art .code-gray{font-size:12px}
  .python-art{width:52%;right:10px}
  .sheet-art{width:52%;left:12px}
  .cheatsheet li{font-size:14px}
  .art-footer>span:last-child{font-size:12px}
  .reading-time{width:100%;margin-left:38px}
  footer>div{flex-direction:column;gap:18px}
}
'''
p.write_text(s)
