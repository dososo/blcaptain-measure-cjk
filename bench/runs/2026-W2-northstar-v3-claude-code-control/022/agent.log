   <p class=\"error\" id=\"typeError\" hidden>请选择一个问题类型</p>\n    </fieldset>\n\n    <!-- 描述 -->\n    <div class=\"field\">\n      <label for=\"desc\" class=\"label\">问题描述 <span class=\"req\">*</span></label>\n      <textarea id=\"desc\" name=\"desc\" rows=\"6\" maxlength=\"1000\"\n        placeholder=\"请尽量详细地描述：在什么页面、做了什么操作、期望的结果和实际的结果…\"></textarea>\n      <div class=\"meta\">\n        <p class=\"error\" id=\"descError\" hidden>描述至少需要 10 个字</p>\n        <span class=\"count\"><span id=\"descCount\">0</span>/1000</span>\n      </div>\n    </div>\n\n    <!-- 截图 -->\n    <div class=\"field\">\n      <span class=\"label\">截图 <span class=\"opt\">（选填，最多 5 张，单张不超过 5MB）</span></span>\n      <div class=\"uploader\">\n        <ul class=\"thumbs\" id=\"thumbs\"></ul>\n        <label class=\"drop\" id=\"drop\" tabindex=\"0\">\n          <input type=\"file\" id=\"file\" accept=\"image/png,image/jpeg,image/gif,image/webp\" multiple>\n          <svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z\"/></svg>\n          <span>点击或拖拽图片到这里</span>\n          <small>也可以直接粘贴截图（Ctrl/⌘ + V）</small>\n        </label>\n      </div>\n      <p class=\"error\" id=\"fileError\" hidden></p>\n    </div>\n\n    <!-- 联系方式 -->\n    <div class=\"field\">\n      <label for=\"contact\" class=\"label\">联系方式 <span class=\"opt\">（选填，便于我们回访）</span></label>\n      <input id=\"contact\" name=\"contact\" type=\"text\" placeholder=\"邮箱 / 手机号\">\n      <p class=\"error\" id=\"contactError\" hidden>请输入有效的邮箱或手机号</p>\n    </div>\n\n    <button type=\"submit\" class=\"submit\" id=\"submitBtn\">提交反馈</button>\n  </form>\n\n  <section class=\"card done\" id=\"done\" hidden>\n    <div class=\"check\">✓</div>\n    <h2>提交成功，感谢你的反馈！</h2>\n    <p>我们会在 1–3 个工作日内处理，如有需要会通过你留下的联系方式与你沟通。</p>\n    <button type=\"button\" class=\"ghost\" id=\"again\">再提交一条</button>\n  </section>\n</main>\n\n<script>\n(function () {\n  const MAX_FILES = 5, MAX_SI