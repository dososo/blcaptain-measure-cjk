+  <script>
+    document.getElementById('print-guide').addEventListener('click', function () { window.print(); });
+    const guideLinks = Array.from(document.querySelectorAll('.side-nav a'));
+    const guideSections = guideLinks.map(link => document.querySelector(link.getAttribute('href')));
+    let updatePending = false;
+    function updateActiveSection() {
+      let active = guideSections[0];
+      for (const section of guideSections) {
+        if (section.getBoundingClientRect().top <= 160) active = section;
+      }
+      guideLinks.forEach(link => {
+        const current = link.getAttribute('href') === '#' + active.id;
+        link.classList.toggle('active', current);
+        if (current) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+      updatePending = false;
+    }
+    window.addEventListener('scroll', function () {
+      if (!updatePending) { updatePending = true; requestAnimationFrame(updateActiveSection); }
+    }, { passive: true });
+    updateActiveSection();
+  </script>
