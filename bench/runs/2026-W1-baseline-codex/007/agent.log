+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="从读取、清洗、汇总到排版与批处理，用 5 个 Python 技巧，把重复的 Excel 报表工作交给代码。">
+  <title>用 Python 处理 Excel 报表的 5 个技巧 · 字节手记</title>
+  <style>
+    :root{--paper:#f8f9f5;--ink:#202e29;--muted:#768078;--green:#267258;--line:#e1e5dc;--light:#edf2e9;--code:#1f2b27;--mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace}
