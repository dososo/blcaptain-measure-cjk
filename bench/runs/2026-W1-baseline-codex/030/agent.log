from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.items = 0
        self.external = []
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'li' and attrs.get('class') == 'item':
            self.items += 1
        for key in ('src', 'href'):
            if key in attrs and not attrs[key].startswith('#'):
                self.external.append(attrs[key])
p = Path('index.html')
s = p.read_text()
c = Check()
