from html.parser import HTMLParser
from pathlib import Path
from collections import Counter
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.refs=[]; self.stack=[]; self.errors=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if a.get('href','').startswith('#'): self.refs.append(a['href'][1:])
        if tag not in {'meta','link','input','br','hr','img','use','path','rect','circle','ellipse'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in {'use','path','rect','circle','ellipse'}: return
        if not self.stack or self.stack[-1]"'!=tag: self.errors.append(tag)
        else: self.stack.pop()
