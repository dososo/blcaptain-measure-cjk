+@layer measure;
+@layer measure {
+  :where(:lang(zh)) { line-break: strict; font-synthesis-style: none; text-emphasis-position: under right; }
+  :where(:lang(zh)) :where(p, li) { line-height: 1.75; }
+  :where(:lang(zh)) :where(h1, h2, h3) { line-height: 1.3; }
+  .measure-prose { max-width: 36em; }
+  @supports (text-autospace: normal) { :where(:lang(zh)) { text-autospace: normal; } }
+}
+:root { color-scheme: light; --paper: #f7f5ee; --green: #263f32; --muted: #6c756b; --orange: #bc592f; --line: #dfdfd2; }
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 28px; }
+body { margin: 0; background: var(--paper); color: var(--green); font-family: system-ui, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 16px; }
+a { color: inherit; text-decoration: none; }
+button, a { -webkit-tap-highlight-color: transparent; }
+a:focus-visible { outline: 3px solid var(--orange); outline-offset: 5px; }
+svg { display: block; width: 100%; height: 100%; }
+.svg-library { position: absolute; width: 0; height: 0; overflow: hidden; }
+.wrap { max-width: 1200px; width: calc(100% - 96px); margin-inline: auto; }
+.skip-link { position: absolute; left: 20px; top: -80px; padding: 12px 20px; background: white; z-index: 10; }
+.skip-link:focus { top: 12px; }
+.site-header { height: 106px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); gap: 24px; }
+.brand { display: inline-flex; align-items: center; gap: 12px; font-size: 25px; font-weight: 750; white-space: nowrap; }
+.brand-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--green); color: #f7f5ee; }
+.brand-mark svg { width: 25px; height: 25px; transform: rotate(-13deg); }
+.brand-sub { display: block; font-size: 12px; font-weight: 500; margin-top: 2px; }
+nav { display: flex; gap: 38px; font-size: 14px; }
+nav a { padding: 12px 0; }
+nav a:hover, .text-link:hover { color: var(--orange); }
+.button { display: inline-flex; align-items: center; justify-content: center; gap: 14px; background: var(--orange); color: white; padding: 17px 24px; border-radius: 7px; font-size: 15px; font-weight: 600; transition: background .2s, transform .2s; }
+.button:hover { background: #a34724; transform: translateY(-2px); }
+.button.small { padding: 12px 20px; background: var(--green); font-size: 14px; }
+.icon { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; flex-shrink: 0; }
+.hero { min-height: 600px; display: grid; grid-template-columns: 1.04fr 1fr; align-items: center; gap: 20px; padding-top: 42px; padding-bottom: 35px; }
+.eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 500; }
+.status-dot { width: 7px; height: 7px; background: #66835a; border-radius: 50%; flex-shrink: 0; }
