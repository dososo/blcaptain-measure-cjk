+      year: {name:'年卡',price:'¥5,880 / 年',description:'首次使用起连续 365 天，常规团课不限次。请于购买后 30 天内首次使用。支持 1 次停卡，最长 30 天。'}
+    };
+    const dialog = document.getElementById('plan-dialog');
+    let selectedPlan;
+    document.querySelectorAll('[data-plan]').forEach(button => button.addEventListener('click', () => {
+      selectedPlan = plans[button.dataset.plan];
+      document.getElementById('dialog-title').textContent = selectedPlan.name + ' · 我的练习计划';
+      document.getElementById('dialog-price').textContent = selectedPlan.price;
+      document.getElementById('dialog-description').textContent = selectedPlan.description;
+      document.getElementById('save-plan').textContent = '保存我的方案 ↓';
+      dialog.showModal();
+    }));
+    dialog.querySelector('.close').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('click', event => {if(event.target === dialog){const bounds = dialog.getBoundingClientRect();if(event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();}});
+    document.getElementById('save-plan').addEventListener('click', () => {
+      if(!selectedPlan) return;
+      const content = '清屿瑜伽 · 我的练习计划\n\n' + selectedPlan.name + '\n' + selectedPlan.price + '\n' + selectedPlan.description + '\n\n所有方案均为本人使用，常规团课需提前预约。私教课、工作坊与特别活动另行收费。\n\n请到店向前台咨询课表及办理方式。此文件为方案记录，不是订单或预约凭证。';
