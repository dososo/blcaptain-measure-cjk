+    const transport = [...form.querySelectorAll('[name="transport"]')];
+    let answers = [];
+    function updateProgress() {
+      const data = new FormData(form);
+      const count = fields.filter(key => data.getAll(key).some(Boolean)).length;
+      document.querySelector('#progress').value = count;
+      document.querySelector('#progress-text').textContent = `已完成 ${count} / 6`;
