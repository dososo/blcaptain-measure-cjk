+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-image';
+        remove.setAttribute('aria-label', '删除截图：' + item.name);
+        remove.innerHTML = '<svg aria-hidden="true"><use href="#x"/></svg>';
+        remove.addEventListener('click', () => {
+          screenshots = screenshots.filter(file => file !== item);
+          renderPreviews();
+          uploadError.textContent = '';
+          upload.focus();
+        });
+        wrapper.append(img, remove);
+        previews.append(wrapper);
+      });
+    }
+    async function addFiles(files) {
+      const errors = [];
+      for (const file of files) {
+        if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) { errors.push('仅支持 JPG、PNG 和 WebP 图片。'); continue; }
+        if (file.size > 5 * 1024 * 1024) { errors.push('单张截图不能超过 5 MB。'); continue; }
+        if (screenshots.length + pending >= 3) { errors.push('最多可上传 3 张截图。'); continue; }
+        if (screenshots.some(item => item.name === file.name && item.size === file.size)) continue;
+        pending++;
+        submit.disabled = true;
+        try {
+          const data = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
