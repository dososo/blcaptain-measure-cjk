+  :where(:lang(zh)) { line-break: strict; font-synthesis-style: none; text-emphasis-position: under right; }
+  :where(:lang(zh)) :where(p, li) { line-height: 1.75; }
+  :where(:lang(zh)) :where(h1, h2, h3) { line-height: 1.3; }
+  .measure-prose { max-width: 36em; }
+  @supports (text-autospace: normal) { :where(:lang(zh)) { text-autospace: normal; } }
+}
+:root { color-scheme: light; --paper: #f7f5ee; --green: #263f32; --muted: #6c756b; --orange: #bc592f; --line: #dfdfd2; }
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 28px; }
+body { margin: 0; background: var(--paper); color: var(--green); font-family: system-ui, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 16px; }
+a { color: inherit; text-decoration: none; }
+button, a { -webkit-tap-highlight-color: transparent; }
+a:focus-visible { outline: 3px solid var(--orange); outline-offset: 5px; }
+svg { display: block; width: 100%; height: 100%; }
+.svg-library { position: absolute; width: 0; height: 0; overflow: hidden; }
+.wrap { max-width: 1200px; width: calc(100% - 96px); margin-inline: auto; }
+.skip-link { position: absolute; left: 20px; top: -80px; padding: 12px 20px; background: white; z-index: 10; }
+.skip-link:focus { top: 12px; }
+.site-header { height: 106px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); gap: 24px; }
+.brand { display: inline-flex; align-items: center; gap: 12px; font-size: 25px; font-weight: 750; white-space: nowrap; }
+.brand-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--green); color: #f7f5ee; }
+.brand-mark svg { width: 25px; height: 25px; transform: rotate(-13deg); }
+.brand-sub { display: block; font-size: 12px; font-weight: 500; margin-top: 2px; }
+nav { display: flex; gap: 38px; font-size: 14px; }
+nav a { padding: 12px 0; }
+nav a:hover, .text-link:hover { color: var(--orange); }
+.button { display: inline-flex; align-items: center; justify-content: center; gap: 14px; background: var(--orange); color: white; padding: 17px 24px; border-radius: 7px; font-size: 15px; font-weight: 600; transition: background .2s, transform .2s; }
+.button:hover { background: #a34724; transform: translateY(-2px); }
+.button.small { padding: 12px 20px; background: var(--green); font-size: 14px; }
+.icon { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; flex-shrink: 0; }
+.hero { min-height: 600px; display: grid; grid-template-columns: 1.04fr 1fr; align-items: center; gap: 20px; padding-top: 42px; padding-bottom: 35px; }
+.eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 500; }
+.status-dot { width: 7px; height: 7px; background: #66835a; border-radius: 50%; flex-shrink: 0; }
+h1 { font-size: clamp(36px, 4.3vw, 58px); line-height: 1.32; font-weight: 750; margin: 24px 0; }
+.orange { color: var(--orange); }
+.hero-description { color: var(--muted); font-size: 16px; margin: 0; line-height: 1.9; }
+.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 33px; }
+.text-link { font-size: 14px; display: inline-flex; gap: 14px; align-items: center; }
+.hero-note { margin-top: 36px; display: flex; gap: 9px; align-items: center; color: var(--muted); font-size: 13px; }
+.mini-paw { width: 23px; height: 23px; padding: 4px; color: #8a9b78; }
+.hero-art { position: relative; align-self: center; padding-top: 30px; }
+.pet-illustration { width: 100%; height: auto; }
+.art-caption { position: absolute; left: 12%; top: 25px; font-size: 12px; background: #fffcf5; border: 1px solid var(--line); border-radius: 40px; padding: 10px 15px; display: flex; gap: 8px; align-items: center; transform: rotate(-5deg); }
+.art-sticker { position: absolute; right: 0; bottom: 70px; display: flex; align-items: center; gap: 10px; background: #faf3dc; border: 1px solid #d7c9a8; padding: 15px 18px; font-size: 13px; line-height: 1.7; transform: rotate(7deg); border-radius: 8px; }
+.art-sticker svg { width: 28px; height: 28px; color: #ba7950; }
+.art-footnote { display: block; text-align: center; font-size: 10px; letter-spacing: 3px; color: #7a8a72; margin-top: -12px; }
+.care-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 25px 0; }
+.care-strip>div { display: flex; align-items: center; justify-content: center; gap: 18px; border-right: 1px solid var(--line); }
+.care-strip>div:last-child { border: 0; }
+.strip-symbol { color: #6e825e; font-size: 30px; font-weight: 400; }
+.care-strip strong { display: block; font-size: 15px; font-weight: 600; }
+.care-strip small { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
+.section { padding-top: 78px; padding-bottom: 78px; }
+.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
+.section-kicker { color: var(--orange); font-size: 11px; letter-spacing: 2px; }
+h2 { font-size: 30px; font-weight: 650; margin: 12px 0 0; }
+.section-heading>p { color: var(--muted); font-size: 14px; margin: 0 0 3px; }
+.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
+.service-card { position: relative; background: #fffdf7; border: 1px solid #e5e3d8; border-radius: 10px; padding: 27px 24px 24px; }
+.service-icon { width: 34px; height: 34px; fill: none; stroke: #627c58; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+.card-number { position: absolute; right: 23px; top: 30px; font-size: 12px; color: #9b9e8e; }
+h3 { font-size: 19px; font-weight: 650; margin: 23px 0 12px; }
+.service-card p { font-size: 14px; color: var(--muted); margin: 0; max-width: 36em; }
+.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
+.tags span { padding: 5px 8px; font-size: 12px; background: #f0f1e8; color: #65745b; border-radius: 4px; }
+.doctors-section { background: #eeefe5; }
+.doctor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
+.doctor-card { display: flex; align-items: center; gap: 16px; padding: 22px 0; border-top: 1px solid #d6dacb; }
+.portrait { flex-shrink: 0; width: 90px; height: 108px; overflow: hidden; background: #d4ddca; border-radius: 45px 45px 8px 8px; }
+.portrait svg { height: 112px; width: 112px; margin-left: -11px; }
+.portrait-two { background: #e4cfb6; }
+.portrait-three { background: #d6dcd8; }
+.doctor-card h3 { margin: 0 0 10px; font-size: 18px; }
+.doctor-card h3 span { display: inline-block; font-size: 12px; font-weight: 400; color: var(--muted); margin-left: 6px; }
+.doctor-card p { font-size: 13px; color: var(--muted); margin: 0; }
+blockquote { font-size: 12px; margin: 12px 0 0; color: #5d7059; line-height: 1.7; }
+.sample-note { color: #767e6c; font-size: 12px; margin: 12px 0 0; }
+.visit-card { display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; padding: 48px 56px; background: var(--green); color: #f6f3e8; border-radius: 12px; }
+.visit-card .eyebrow { color: #c2cdb5; font-size: 11px; letter-spacing: 2px; }
+.visit-card h2 { font-size: 31px; line-height: 1.5; margin-top: 18px; }
+.visit-copy>p { color: #c7d0c3; font-size: 14px; margin: 17px 0 22px; }
+.phone-number { font-size: clamp(25px, 3vw, 36px); font-weight: 600; display: inline-flex; gap: 25px; align-items: center; }
+.phone-number span { font-size: 25px; color: #e4b689; }
+.phone-note { display: block; color: #bac7b5; font-size: 12px; margin-top: 8px; }
+.visit-info { border-left: 1px solid #5b6c59; padding-left: 42px; display: flex; flex-direction: column; justify-content: center; gap: 25px; }
+.info-label { display: block; font-size: 12px; color: #b8c7ac; margin-bottom: 8px; }
+.visit-info strong { font-size: 16px; font-weight: 500; }
+.visit-info p { font-size: 12px; color: #c1cbb9; margin: 6px 0 0; }
+.visit-tip { display: flex; align-items: center; gap: 14px; padding-top: 18px; border-top: 1px solid #5b6c59; }
+.visit-tip .icon { color: #d7be91; stroke: none; width: 25px; height: 25px; }
+.visit-tip p { margin: 0; line-height: 1.8; }
+footer { display: flex; align-items: center; gap: 22px; padding: 0 0 32px; }
+.footer-brand { font-size: 15px; gap: 9px; }
+.footer-brand .brand-mark { width: 30px; height: 30px; }
+.footer-brand .brand-mark svg { width: 18px; height: 18px; }
+footer p, footer>span { color: var(--muted); font-size: 12px; }
+footer>span { margin-left: auto; }
+@media(min-width: 1450px) { .hero { min-height: 660px; } }
+@media(max-width: 1050px) { .wrap { width: calc(100% - 56px); } .hero { min-height: 540px; } .hero-actions { gap: 17px; } .service-grid { gap: 12px; } .service-card { padding: 22px 18px; } .doctor-card { flex-direction: column; align-items: flex-start; } .doctor-card h3 span { margin-left: 8px; } .visit-card { padding: 40px 34px; gap: 30px; } .visit-info { padding-left: 30px; } }
+@media(max-width: 760px) { .wrap { width: calc(100% - 40px); } .site-header { height: auto; min-height: 90px; flex-wrap: wrap; gap: 14px; padding: 18px 0; } .brand { font-size: 22px; } .brand-mark { width: 40px; height: 40px; } nav { order: 3; width: 100%; justify-content: center; gap: 44px; border-top: 1px solid var(--line); padding-top: 8px; } nav a { padding: 6px 0; } .hero { grid-template-columns: 1fr; padding-top: 40px; gap: 20px; } h1 { font-size: clamp(34px, 7.4vw, 52px); margin: 20px 0; } .hero-description { font-size: 15px; } .hero-note { margin-top: 24px; } .hero-art { max-width: 500px; width: 100%; margin-inline: auto; } .art-sticker { right: 5px; bottom: 56px; } .care-strip { gap: 16px; padding: 22px 0; } .care-strip>div { flex-direction: column; text-align: center; gap: 7px; padding-right: 10px; } .care-strip small { line-height: 1.6; } .strip-symbol { font-size: 25px; } .section { padding-top: 50px; padding-bottom: 50px; } .section-heading { display: block; margin-bottom: 24px; } h2 { font-size: 25px; } .section-heading>p { margin-top: 14px; font-size: 13px; } .service-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } .service-card { padding: 22px 20px; } .doctor-grid { grid-template-columns: 1fr; gap: 0; } .doctor-card { flex-direction: row; gap: 24px; align-items: center; padding: 23px 0; } .portrait { width: 90px; height: 100px; } .doctor-card h3 { font-size: 20px; } .doctor-card p { font-size: 14px; } blockquote { font-size: 13px; } .visit-card { grid-template-columns: 1fr; padding: 32px 27px; gap: 32px; } .visit-card h2 { font-size: 27px; } .phone-number { font-size: 29px; gap: 16px; } .visit-info { padding: 27px 0 0; border-left: 0; border-top: 1px solid #5b6c59; } footer { flex-wrap: wrap; gap: 10px 18px; padding-bottom: 24px; } footer p { margin: 0; } footer>span { margin: 0; width: 100%; } }
+@media(max-width: 380px) { .wrap { width: calc(100% - 32px); } .button { padding: 15px 18px; } .hero-actions { gap: 18px; } .text-link { font-size: 13px; } .service-grid { grid-template-columns: 1fr; } .care-strip small { font-size: 12px; } .care-strip { gap: 8px; } .visit-card { padding: 28px 20px; } .visit-card h2 { font-size: 24px; } .phone-number { font-size: 26px; } }
+@media(prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .button { transition: none; } .button:hover { transform: none; } }

