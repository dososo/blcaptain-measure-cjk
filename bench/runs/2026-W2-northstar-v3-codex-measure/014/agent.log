+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f8f7f3">
+  <meta name="description" content="开口英语在线口语课程：选择专注于你的外教一对一，或一起进步的 4 人小班。找到适合自己的开口节奏。">
+  <title>课程与价格 · 开口英语 Speakup</title>
+  <link rel="stylesheet" href="measure.css">
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <svg class="svg-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
+    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
+    <symbol id="check" viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"/></symbol>
+    <symbol id="person" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></symbol>
+    <symbol id="group" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 5v1"/></symbol>
+    <symbol id="clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
+    <symbol id="book" viewBox="0 0 24 24"><path d="M12 6v15M3 4c4-1 7 0 9 2 2-2 5-3 9-2v15c-4-1-7 0-9 2-2-2-5-3-9-2Z"/></symbol>
+    <symbol id="shield" viewBox="0 0 24 24"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-5"/></symbol>
+  </defs></svg>
+
+  <header class="site-header">
+    <a class="brand" href="#" aria-label="开口英语首页"><span class="brand-icon"><span></span><span></span><span></span></span><span class="brand-word" lang="en">speakup<span class="brand-dot">.</span></span><span class="brand-cn">开口英语</span></a>
+    <nav aria-label="主导航"><a href="#plans" class="active" aria-current="page">课程与价格</a><a href="#included">学习体验</a><a href="#faq">常见问题</a></nav>
+    <button class="button header-cta" data-plan="trial">体验一节课 <svg><use href="#arrow"/></svg></button>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="headline">
+      <div class="eyebrow"><span></span> 少一点犹豫，多一点开口</div>
+      <h1 id="headline">找到你的节奏，<span class="underlined">自信开口。</span></h1>
+      <p class="hero-description measure-prose">一个人专注突破，或和同伴一起进步。<br>让每一次对话，都成为真实生活里的底气。</p>
+      <svg class="hero-spark" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="m50 5 1 22M80 17 65 33M95 49 73 50M81 80 65 64M49 95 50 74M18 80 34 65M5 49 27 50M18 18 34 34" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><circle cx="50" cy="50" r="12" stroke="currentColor" stroke-width="3"/></svg>
+    </section>
+
+    <section id="plans" class="plans" aria-label="课程价格方案">
+      <div class="plan-controls"><div class="package-switch" role="group" aria-label="选择课包"><button class="selected" data-package="12" aria-pressed="true">12 节课包</button><button data-package="24" aria-pressed="false">24 节课包 <span>省 10%</span></button></div><p>按课包付费，无自动续费</p></div>
+      <div class="plan-grid">
+        <article class="plan-card personal">
+          <div class="card-top"><span class="course-icon"><svg><use href="#person"/></svg></span><span class="course-tag">专属你的学习时间</span></div>
