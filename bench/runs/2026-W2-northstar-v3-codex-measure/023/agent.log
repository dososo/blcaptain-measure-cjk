+.rating input{position:absolute;opacity:0;width:1px;height:1px}
+.rating:has(input:focus-visible){outline:3px solid #85b59c;outline-offset:3px}
+.rating-face{font-family:system-ui,sans-serif;font-size:27px;line-height:1;color:#8e9d80;font-weight:400}
+.rating:has(input:checked) .rating-face{color:var(--green)}
+.not-applicable{margin-top:9px;min-height:36px;padding:7px 11px}
+.last-question{margin-bottom:23px}
+.form-actions{display:flex;justify-content:space-between;align-items:center;gap:15px}
+.form-actions p{font-size:12px;color:#949c8d;margin:0}
+.primary{background:var(--green);border:1px solid var(--green);border-radius:6px;color:#fff;padding:11px 21px;font-weight:500;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:25px;transition:background .15s}
+.primary:hover{background:#275e44}
