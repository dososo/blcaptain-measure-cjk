+.text-link { font-size: 14px; display: inline-flex; gap: 14px; align-items: center; }
+.hero-note { margin-top: 36px; display: flex; gap: 9px; align-items: center; color: var(--muted); font-size: 13px; }
+.mini-paw { width: 23px; height: 23px; padding: 4px; color: #8a9b78; }
+.hero-art { position: relative; align-self: center; padding-top: 30px; }
+.pet-illustration { width: 100%; height: auto; }
