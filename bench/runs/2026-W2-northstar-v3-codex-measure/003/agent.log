+    const result = document.getElementById('signup-result');
+    const message = document.getElementById('signup-message');
+    const status = document.getElementById('copy-status');
+    document.querySelectorAll('[data-route]').forEach(link => link.addEventListener('click', () => {
+      document.getElementById('route').value = link.dataset.route;
+      result.hidden = true;
+    }));
+    form.addEventListener('input', event => { if (event.target !== message) result.hidden = true; });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const nickname = document.getElementById('nickname');
+      if (!nickname.value.trim()) { nickname.setCustomValidity('请填写你的骑行昵称'); nickname.reportValidity(); return; }
+      message.value = `你好，我想报名转个弯的骑行活动。\n昵称：${nickname.value.trim()}\n意向路线：${document.getElementById('route').value}\n骑行经验：${document.getElementById('experience').value}\n请告知最近场次、集合地点、名额及费用，谢谢！`;
+      status.textContent = '';
+      result.hidden = false;
+      message.focus();
+    });
+    document.getElementById('nickname').addEventListener('input', event => event.target.setCustomValidity(''));
+    document.getElementById('copy-button').addEventListener('click', async () => {
+      try { await navigator.clipboard.writeText(message.value); status.textContent = '已复制，请发送给活动组织者。'; }
+      catch { message.focus(); message.select(); status.textContent = '已选中报名信息，请长按或使用系统复制快捷键复制。'; }
+    });
+  </script>
+</body>
+</html>
