from html.parser import HTMLParser
from pathlib import Path
import shutil, subprocess
p=Path('index.html')
s=p.read_text()
class Checker(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.refs=[]; self.stack=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a:self.ids.append(a['id'])
        if a.get('href','').startswith('#') and len(a['href'])>1:self.refs.append(a['href'][1:])
        if tag not in {'meta','link','input','br','hr','img','path','circle','ellipse','rect','stop','use'}:self.stack.append(tag)
    def handle_endtag(self,tag):
        if tag in {'path','circle','ellipse','rect','stop','use'}:return
        assert self.stack and self.stack[-1]==tag, (tag,self.stack[-3:])
        self.stack.pop()
c=Checker();c.feed(s)
assert not c.stack, c.stack
assert len(c.ids)==len(set(c.ids)), 'Duplicate IDs'
assert set(c.refs)<=set(c.ids), 'Missing anchor targets'
assert '<html lang=\"zh-CN\">' in s
node=shutil.which('node')
if node:
    script=s.split('<script>')[1].split('</script>')[0]
    r=subprocess.run([node,'--check'],input=script,text=True,capture_output=True)
    assert r.returncode==0,r.stderr
    print('JavaScript syntax: OK')
print(f'HTML structure and anchors: OK; index.html: {p.stat().st_size:,} bytes')
