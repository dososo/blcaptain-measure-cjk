var(--sans);\n  font-size: .7rem;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  margin-left: .5em;\n  color: var(--caramel);\n}\n.nav { display: flex; gap: 28px; font-size: .95rem; }\n.nav a { color: var(--muted); transition: color .2s; }\n.nav a:hover { color: var(--espresso); }\n\n/* Hero */\n.hero {\n  padding: 120px 0 110px;\n  background:\n    radial-gradient(circle at 85% 20%, rgba(192, 131, 74, .22), transparent 45%),\n    radial-gradient(circle at 10% 90%, rgba(90, 58, 38, .12), transparent 40%),\n    var(--cream);\n}\n.hero h1 { font-size: clamp(2.2rem, 5.5vw, 3.8rem); max-width: 14em; }\n.lead { font-size: 1.1rem; color: var(--muted); max-width: 34em; margin: 0 0 2rem; }\n.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }\n\n.btn {\n  display: inline-block;\n  padding: 12px 26px;\n  border-radius: 999px;\n  font-weight: 600;\n  font-size: .95rem;\n  transition: transform .2s, background .2s, color .2s;\n}\n.btn:hover { transform: translateY(-2px); }\n.btn-primary { background: var(--espresso); color: var(--paper); }\n.btn-primary:hover { background: var(--roast); }\n.btn-ghost { border: 1.5px solid var(--espresso); }\n.btn-ghost:hover { background: var(--espresso); color: var(--paper); }\n\n/* Sections */\n.section { padding: 96px 0; }\n.section-head { max-width: 640px; margin-bottom: 48px; }\n.section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); }\n.section-head p:last-child { color: var(--muted); margin: 0; }\n\n/* Beans */\n.bean-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: 22px;\n}\n.bean-card {\n  background: var(--paper);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 26px 24px 22px;\n  display: flex;\n  flex-direction: column;\n  transition: transform .25s, box-shadow .25s;\n}\n.bean-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 16px 32px -18px rgba(43, 29, 20, .35);\n}\n.bean-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }\n.origin { font-size: .82rem; color: var(--muted); }\n.roast-tag {\n  font-size: .75rem;\n  padding: 3px 10px;\n  border-radius: 999px;\n  font-weight: 600;\n}\n.roast-tag.light { background: #f3e2c7; color: #8a5a22; }\n.roast-tag.medium { background: #e3c6a4; color: #5a3a26; }\n.roast-tag.dark { background: #5a3a26; color: #f6f0e6; }\n.bean-card h3 { font-size: 1.2rem; margin-bottom: .25em; }\n.process { font-size: .82rem; color: var(--caramel); margin: 0 0 .8em; }\n.notes { font-size: .93rem; color: var(--muted); margin: 0 0 1.4em; flex: 1; }\n.bean-foot {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-top: 1px dashed var(--line);\n  padding-top: 14px;\n}\n.price { font-weight: 700; font-size: 1.1rem; }\n.price small { font-weight: 400; color: var(--muted); font-size: .78rem; }\n.meter {\n  width: 64px;\n  height: 6px;\n  border-radius: 6px;\n  background: var(--line);\n  overflow: hidden;\n}\n.meter i {\n  display: block;\n  height: 100%;\n  width: var(--v);\n  background: linear-gradient(90deg, var(--caramel), #e2a94d);\n}\n.bean-hint { margin-top: 24px; font-size: .82rem; color: var(--muted); text-align: center; }\n\n/* Philosophy */\n.section-dark { background: var(--espresso); color: var(--cream); }\n.section-dark .section-head p:last-child { color: #c9b8a5; }\n.philo-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 40px 32px;\n}\n.philo-num {\n  font-family: var(--serif);\n  font-size: 2.2rem;\n  color: var(--caramel);\n  display: block;\n  margin-bottom: .3em;\n}\n.philo-item h3 { font-size: 1.2rem; }\n.philo-item p { color: #c9b8a5; margin: 0; font-size: .95rem; }\n.quote {\n  margin: 72px auto 0;\n  max-width: 640px;\n  text-align: center;\n  font-family: var(--serif);\n  font-size: clamp(1.25rem, 2.5vw, 1.6rem);\n  line-height: 1.6;\n}\n.quote cite {\n  display: block;\n  margin-top: 1em;\n  font-family: var(--sans);\n  font-size: .85rem;\n  font-style: normal;\n  color: var(--caramel);\n}\n\n/* Visit */\n.visit-inner {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 56px;\n  align-items: center;\n}\n.visit-info h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); }\n.visit-lead { color: var(--muted); margin: 0 0 2rem; }\n.info-list { margin: 0; display: grid; gap: 22px; }\n.info-list > div {\n  display: grid;\n  grid-template-columns: 88px 1fr;\n  gap: 12px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--line);\n}\n.info-list dt { font-weight: 600; color: var(--caramel); }\n.info-list dd { margin: 0; }\n.info-list small { color: var(--muted); }\n\n.visit-card {\n  background: var(--paper);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 18px;\n}\n.visit-card p { margin: 16px 6px 4px; font-size: .9rem; color: var(--muted); }\n.map-art {\n  position: relative;\n  height: 280px;\n  border-radius: 10px;\n  overflow: hidden;\n  background:\n    linear-gradient(90deg, transparent 47%, #fff 47%, #fff 53%, transparent 53%),\n    linear-gradient(0deg, transparent 58%, #fff 58%, #fff 64%, transparent 64%),\n    linear-gradient(25deg, transparent 30%, #fff 30%, #fff 34%, transparent 34%),\n    #e9dfcf;\n}\n.street {\n  position: absolute;\n  font-size: .72rem;\n  color: var(--muted);\n  letter-spacing: .1em;\n}\n.s1 { top: 33%; left: 8%; }\n.s2 { top: 8%; left: 55%; }\n.s3 { bottom: 14%; left: 14%; transform: rotate(-25deg); }\n.pin {\n  position: absolute;\n  top: 39%;\n  left: 50%;\n  transform: translate(-50%, -100%);\n  background: var(--espresso);\n  color: var(--paper);\n  font-family: var(--serif);\n  font-size: .85rem;\n  padding: 6px 14px;\n  border-radius: 999px;\n  box-shadow: 0 8px 18px -6px rgba(43, 29, 20, .5);\n}\n.pin::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: -6px;\n  transform: translateX(-50%);\n  border: 6px solid transparent;\n  border-bottom: 0;\n  border-top-color: var(--espresso);\n}\n\n/* Footer */\n.site-footer {\n  border-top: 1px solid var(--line);\n  padding: 28px 0;\n}\n.footer-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.footer-inner p { margin: 0; font-size: .85rem; color: var(--muted); }\n\n/* Responsive */\n@media (max-width: 820px) {\n  .visit-inner { grid-template-columns: 1fr; gap: 40px; }\n}\n@media (max-width: 600px) {\n  .nav { gap: 16px; font-size: .85rem; }\n  .logo span { display: none; }\n  .hero { padding: 80px 0 72px; }\n  .section { padding: 72px 0; }\n  .info-list > div { grid-template-columns: 1fr; gap: 4px; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01VioZKiu9zfL24CM11AAfcB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
