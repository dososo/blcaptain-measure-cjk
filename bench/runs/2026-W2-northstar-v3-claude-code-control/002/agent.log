 transparent);\n  backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--line);\n}\n.nav-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n  gap: 16px;\n}\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: 700;\n  font-size: 1.15rem;\n}\n.logo-mark {\n  display: grid;\n  place-items: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  background: var(--accent);\n  color: #fff;\n  font-size: 0.95rem;\n}\n.nav-links { display: flex; gap: 28px; color: var(--muted); }\n.nav-links a:hover { color: var(--fg); }\n\n/* 首屏 */\n.hero { padding-block: 80px 64px; }\n.hero-inner {\n  display: grid;\n  grid-template-columns: 1.05fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n.hero-text { min-width: 0; }\n.badge {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n.hero h1 {\n  font-size: clamp(2rem, 4.5vw, 3.1rem);\n  line-height: 1.2;\n  margin: 18px 0 16px;\n  letter-spacing: -0.01em;\n}\n.hero h1 em { font-style: normal; color: var(--accent); }\n.hero p.lead { color: var(--muted); font-size: 1.12rem; margin: 0 0 28px; }\n.hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }\n.hero-note { margin-top: 14px; color: var(--muted); font-size: 0.9rem; }\n\n/* 首屏模拟面板 */\n.mock {\n  min-width: 0;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  box-shadow: var(--shadow);\n  padding: 22px;\n}\n.mock-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n  font-weight: 600;\n}\n.mock-head span { color: var(--muted); font-weight: 400; font-size: 0.85rem; }\n.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }\n.stat {\n  background: var(--bg);\n  border-radius: 10px;\n  padding: 10px 12px;\n  min-width: 0;\n}\n.stat small { color: var(--muted); display: block; font-size: 0.78rem; }\n.stat b { font-size: 1.05rem; }\n.up { color: var(--green); }\n.down { color: var(--red); }\n.bars {\n  display: flex;\n  align-items: flex-end;\n  gap: 8px;\n  height: 110px;\n  padding: 0 4px 6px;\n  border-bottom: 1px solid var(--line);\n  margin-bottom: 14px;\n}\n.bars i {\n  flex: 1;\n  border-radius: 6px 6px 2px 2px;\n  background: var(--accent-soft);\n}\n.bars i.hi { background: var(--accent); }\n.tx { list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }\n.tx li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 0;\n  border-bottom: 1px dashed var(--line);\n}\n.tx li:last-child { border-bottom: 0; }\n.tx .who { color: var(--muted); font-size: 0.82rem; }\n\n/* 信任条 */\n.trust {\n  padding-block: 20px 8px;\n  text-align: center;\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n.trust-logos {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px 36px;\n  margin-top: 12px;\n  font-weight: 700;\n  font-size: 1.05rem;\n  opacity: 0.7;\n}\n\n/* 通用区块 */\nsection.block { padding-block: 80px; }\n.section-head { text-align: center; max-width: 640px; margin: 0 auto 48px; }\n.section-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0 0 10px; }\n.section-head p { color: var(--muted); margin: 0; }\n\n/* 功能 */\n.features {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n}\n.card {\n  min-width: 0;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 26px;\n  transition: box-shadow 0.2s, transform 0.2s;\n}\n.card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }\n.icon {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 1.3rem;\n  margin-bottom: 14px;\n}\n.card h3 { margin: 0 0 8px; font-size: 1.12rem; }\n.card p { margin: 0; color: var(--muted); font-size: 0.95rem; }\n\n/* 步骤 */\n.steps-wrap { background: var(--surface); border-block: 1px solid var(--line); }\n.steps {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 28px;\n  counter-reset: step;\n}\n.step { min-width: 0; }\n.step::before {\n  counter-increment: step;\n  content: counter(step);\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: var(--accent);\n  color: #fff;\n  font-weight: 700;\n  margin-bottom: 12px;\n}\n.step h3 { margin: 0 0 6px; font-size: 1.08rem; }\n.step p { margin: 0; color: var(--muted); font-size: 0.95rem; }\n\n/* 评价 */\n.reviews {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n}\n.review { display: flex; flex-direction: column; gap: 16px; }\n.stars { color: #f5a623; letter-spacing: 2px; }\n.review blockquote { margin: 0; flex: 1; }\n.author { display: flex; align-items: center; gap: 12px; }\n.avatar {\n  display: grid;\n  place-items: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-weight: 700;\n  flex-shrink: 0;\n}\n.author b { display: block; font-size: 0.95rem; }\n.author small { color: var(--muted); }\n\n/* 价格 */\n.pricing {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  align-items: stretch;\n}\n.plan { display: flex; flex-direction: column; }\n.plan.featured { border: 2px solid var(--accent); position: relative; }\n.plan .tag {\n  position: absolute;\n  top: -12px;\n  left: 50%;\n  transform: translateX(-50%);\n  background: var(--accent);\n  color: #fff;\n  font-size: 0.78rem;\n  padding: 2px 12px;\n  border-radius: 999px;\n  white-space: nowrap;\n}\n.price { font-size: 2rem; font-weight: 700; margin: 8px 0 2px; }\n.price small { font-size: 0.9rem; color: var(--muted); font-weight: 400; }\n.plan ul { list-style: none; padding: 0; margin: 16px 0 24px; flex: 1; }\n.plan li { padding: 5px 0; color: var(--muted); font-size: 0.95rem; }\n.plan li::before { content: \"✓ \"; color: var(--green); font-weight: 700; }\n.plan .btn { width: 100%; }\n\n/* 注册 */\n.signup {\n  background: linear-gradient(135deg, var(--accent), var(--accent-strong));\n  color: #fff;\n  border-radius: 22px;\n  padding: 56px 32px;\n  text-align: center;\n}\n.signup h2 { margin: 0 0 10px; font-size: clamp(1.6rem, 3vw, 2.2rem); }\n.signup p { margin: 0 0 28px; opacity: 0.9; }\n.signup-form {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px;\n  max-width: 560px;\n  margin: 0 auto;\n}\n.signup-form input {\n  flex: 1 1 260px;\n  min-width: 0;\n  padding: 0.85em 1em;\n  border-radius: 10px;\n  border: 0;\n  font: inherit;\n  color: #172033;\n  background: #fff;\n}\n.signup-form .btn {\n  background: #172033;\n  color: #fff;\n}\n.signup-form .btn:hover { background: #000; }\n.signup-msg { margin-top: 14px; min-height: 1.6em; font-weight: 600; }\n.signup small { display: block; margin-top: 6px; opacity: 0.8; }\n\n/* FAQ */\n.faq { max-width: 760px; margin: 0 auto; }\n.faq details {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 16px 20px;\n  margin-bottom: 12px;\n}\n.faq summary { cursor: pointer; font-weight: 600; }\n.faq details p { margin: 10px 0 0; color: var(--muted); }\n\n/* 页脚 */\nfooter {\n  border-top: 1px solid var(--line);\n  padding-block: 32px;\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n.footer-inner {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 12px;\n}\n.footer-inner nav { display: flex; gap: 20px; flex-wrap: wrap; }\n\n/* 响应式 */\n@media (max-width: 900px) {\n  .hero-inner { grid-template-columns: 1fr; }\n  .features, .reviews, .pricing { grid-template-columns: repeat(2, 1fr); }\n  .steps { grid-template-columns: 1fr; }\n}\n\n@media (max-width: 640px) {\n  .nav-links { display: none; }\n  .hero { padding-block: 48px 40px; }\n  section.block { padding-block: 56px; }\n  .features, .reviews, .pricing { grid-template-columns: 1fr; }\n  .stats { grid-template-columns: 1fr 1fr; }\n  .signup { padding: 40px 20px; }\n}\n"}}}
