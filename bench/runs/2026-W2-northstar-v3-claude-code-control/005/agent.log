ze: 1.2rem;\n}\n\n.nav {\n  display: flex;\n  gap: 24px;\n  font-size: 0.95rem;\n}\n\n.nav a {\n  text-decoration: none;\n  color: var(--muted);\n}\n\n.nav a:hover { color: var(--accent); }\n\n.header-call {\n  padding: 8px 16px;\n  border-radius: 999px;\n  background: var(--accent);\n  color: #fff;\n  text-decoration: none;\n  font-weight: 600;\n  font-size: 0.95rem;\n  white-space: nowrap;\n}\n\n/* 首屏 */\n.hero { padding-block: 72px 56px; }\n\n.hero .wrap {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n\n.eyebrow {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: var(--warm-soft);\n  color: var(--warm);\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n.hero h1 {\n  margin: 16px 0 12px;\n  font-size: clamp(2rem, 5vw, 3rem);\n  line-height: 1.25;\n}\n\n.hero h1 em {\n  font-style: normal;\n  color: var(--accent);\n}\n\n.hero p {\n  margin: 0 0 28px;\n  color: var(--muted);\n  font-size: 1.05rem;\n  max-width: 34em;\n}\n\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.btn {\n  display: inline-block;\n  padding: 12px 24px;\n  border-radius: 999px;\n  font-weight: 600;\n  text-decoration: none;\n}\n\n.btn-primary { background: var(--accent); color: #fff; }\n.btn-ghost { border: 1.5px solid var(--line); background: var(--surface); }\n\n.hero-card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 24px;\n  padding: 28px;\n  box-shadow: var(--shadow);\n}\n\n.hero-card h2 { margin: 0 0 16px; font-size: 1.1rem; }\n\n.hours { list-style: none; margin: 0; padding: 0; }\n\n.hours li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding-block: 10px;\n  border-bottom: 1px dashed var(--line);\n}\n\n.hours li:last-child { border-bottom: 0; }\n.hours span:last-child { font-weight: 600; }\n\n.badge-emergency {\n  margin-top: 16px;\n  padding: 12px 14px;\n  border-radius: 12px;\n  background: var(--warm-soft);\n  font-size: 0.92rem;\n}\n\n/* 通用区块 */\nsection { scroll-margin-top: 80px; }\n\n.section { padding-block: 64px; }\n.section.alt { background: var(--surface); border-block: 1px solid var(--line); }\n\n.section-head { margin-bottom: 32px; }\n.section-head h2 { margin: 0 0 6px; font-size: 1.8rem; }\n.section-head p { margin: 0; color: var(--muted); }\n\n.grid {\n  display: grid;\n  gap: 20px;\n}\n\n.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n\n/* 科室 */\n.dept {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 24px;\n  box-shadow: var(--shadow);\n}\n\n.section.alt .dept { background: var(--bg); }\n\n.dept-icon {\n  display: grid;\n  place-items: center;\n  width: 48px;\n  height: 48px;\n  border-radius: 14px;\n  background: var(--accent-soft);\n  font-size: 1.5rem;\n  margin-bottom: 14px;\n}\n\n.dept h3 { margin: 0 0 6px; font-size: 1.15rem; }\n.dept p { margin: 0 0 12px; color: var(--muted); font-size: 0.95rem; }\n\n.tags { display: flex; flex-wrap: wrap; gap: 6px; }\n\n.tags span {\n  padding: 2px 10px;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 0.8rem;\n}\n\n/* 医生 */\n.doctor {\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 24px 20px;\n  text-align: center;\n}\n\n.avatar {\n  display: grid;\n  place-items: center;\n  width: 84px;\n  height: 84px;\n  margin: 0 auto 14px;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.doctor:nth-child(even) .avatar { background: var(--warm-soft); color: var(--warm); }\n\n.doctor h3 { margin: 0; font-size: 1.1rem; }\n.doctor .role { margin: 2px 0 10px; color: var(--accent); font-size: 0.9rem; font-weight: 600; }\n.doctor .bio { margin: 0 0 12px; color: var(--muted); font-size: 0.9rem; }\n.doctor .time { font-size: 0.85rem; color: var(--muted); }\n\n/* 预约 */\n.booking {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 32px;\n  align-items: stretch;\n}\n\n.phone-card {\n  background: var(--accent);\n  color: #fff;\n  border-radius: 24px;\n  padding: 36px;\n}\n\n.phone-card h2 { margin: 0 0 8px; font-size: 1.6rem; }\n.phone-card p { margin: 0 0 24px; opacity: 0.9; }\n\n.phone-number {\n  display: block;\n  font-size: clamp(1.8rem, 6vw, 2.6rem);\n  font-weight: 800;\n  letter-spacing: 0.02em;\n  color: #fff;\n  text-decoration: none;\n  margin-bottom: 8px;\n}\n\n.phone-card .sub { font-size: 0.95rem; opacity: 0.9; margin: 0; }\n\n.copy-btn {\n  margin-top: 20px;\n  padding: 10px 20px;\n  border: 1.5px solid rgba(255, 255, 255, 0.7);\n  border-radius: 999px;\n  background: transparent;\n  color: #fff;\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.copy-btn:hover { background: rgba(255, 255, 255, 0.12); }\n\n.steps {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 24px;\n  padding: 32px;\n  box-shadow: var(--shadow);\n}\n\n.steps h3 { margin: 0 0 16px; }\n\n.steps ol { margin: 0; padding-left: 1.2em; }\n.steps li { margin-bottom: 10px; color: var(--muted); }\n.steps li strong { color: var(--fg); }\n\n.address {\n  margin-top: 20px;\n  padding-top: 16px;\n  border-top: 1px solid var(--line);\n  font-size: 0.95rem;\n}\n\n/* 页脚 */\n.site-footer {\n  padding-block: 28px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 0.88rem;\n}\n\n.site-footer .wrap {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n/* 移动端底部拨号条 */\n.mobile-call {\n  display: none;\n}\n\n@media (max-width: 960px) {\n  .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@media (max-width: 760px) {\n  .nav { display: none; }\n  .hero { padding-block: 40px 32px; }\n  .hero .wrap,\n  .booking