+.secondary{border:1px solid #d8e0d3;background:#fff;border-radius:6px;color:#5e7357;padding:10px 18px}
+@media(min-width:1400px){.layout{margin-top:75px;gap:90px;grid-template-columns:390px minmax(0,1fr)}}
