tice-body p,\n.notice-body li {\n  line-height: 1.8;\n}\n\nh2 {\n  margin: 48px 0 16px;\n  padding-top: 8px;\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\nh3 {\n  margin: 0 0 8px;\n  font-size: 17px;\n  font-weight: 600;\n  line-height: 1.5;\n}\n\n.lead { font-size: 17px; }\n\nstrong { font-weight: 600; }\n\n/* 时间安排 */\n.schedule {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: 12px;\n  margin: 24px 0;\n  padding: 0;\n  list-style: none;\n}\n\n.schedule li {\n  min-width: 0;\n  padding: 16px 18px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface);\n}\n\n.schedule .label {\n  display: block;\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.schedule .time {\n  display: block;\n  margin: 4px 0;\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 1.4;\n  font-variant-numeric: tabular-nums;\n}\n\n.schedule .note {\n  display: block;\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.schedule .core { border-color: var(--accent); }\n.schedule .core .time { color: var(--accent); }\n\n/* 示例表 */\n.table-wrap {\n  overflow-x: auto;\n  margin: 16px 0 8px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface);\n}\n\ntable {\n  width: 100%;\n  min-width: 30rem;\n  border-collapse: collapse;\n  font-size: 15px;\n}\n\nth, td {\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--line);\n  text-align: left;\n  line-height: 1.6;\n  font-variant-numeric: tabular-nums;\n}\n\nth {\n  color: var(--muted);\n  font-size: 14px;\n  font-weight: 600;\n}\n\ntr:last-child td { border-bottom: 0; }\n\n.caption {\n  margin: 0;\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.7;\n}\n\nol, ul { padding-left: 1.4em; }\n\n/* 常见问题 */\n.faq {\n  border-top: 1px solid var(--line);\n}\n\n.faq details {\n  border-bottom: 1px solid var(--line);\n}\n\n.faq summary {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding-block: 16px;\n  cursor: pointer;\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.6;\n  list-style: none;\n}\n\n.faq summary::-webkit-details-marker { display: none; }\n\n.faq summary::after {\n  content: \"+\";\n  flex: none;\n  color: var(--muted);\n  font-weight: 400;\n  font-size: 20px;\n  line-height: 1.3;\n}\n\n.faq details[open] summary::after { content: \"−\"; }\n\n.faq summary:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.faq .answer {\n  padding-bottom: 16px;\n  color: var(--fg);\n}\n\n.faq .answer p { margin: 0 0 8px; }\n.faq .answer p:last-child { margin-bottom: 0; }\n\n/* 联系方式 */\n.contact {\n  margin-top: 48px;\n  padding: 20px 22px;\n  border-left: 3px solid var(--accent);\n  border-radius: 0 8px 8px 0;\n  background: var(--surface);\n}\n\n.contact p { margin: 0 0 4px; }\n.contact p:last-child { margin-bottom: 0; }\n\n.sign {\n  margin-top: 40px;\n  text-align: right;\n  color: var(--muted);\n  font-size: 15px;\n}\n\n.sign p { margin: 0; line-height: 1.7; }\n"}}}
