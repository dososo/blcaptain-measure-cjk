from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.anchors=[]; self.images=0
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.add(a['id'])
        if a.get('href','').startswith('#'): self.anchors.append(a['href'][1:])
        if tag=='img':
            assert a.get('alt'), 'Missing image description'
            self.images+=1
p=Path('index.html'); html=p.read_text(); check=Check(); check.feed(html)
assert all(a in check.ids for a in check.anchors), 'Broken page anchor'
assert 'name=\"viewport\"' in html
assert 'tel:01000000000' in html
print(f'Checked {p}: {p.stat().st_size:,} bytes, {check.images} images, all internal links valid.')
