;gap:30px}.detail{display:flex;gap:13px;padding-left:10px}.detail>svg{width:20px;height:20px;color:#8e9a7d;margin-top:2px;flex-shrink:0}.detail h3{font-size:11px;font-weight:500;margin:0 0 7px;letter-spacing:1px}.detail p{font-size:10px;color:#919b84;margin:0;line-height:1.9}.detail+.detail{border-left:1px solid var(--line);padding-left:35px}footer{display:flex;justify-content:space-between;align-items:center;padding:25px 0;color:#a0a891;font-size:9px;letter-spacing:.7px}.footer-motto{font-family:var(--serif);letter-spacing:2px;font-size:11px}dialog{border:1px solid var(--line);border-radius:10px;padding:32px;max-width:420px;width:calc(100% - 40px);color:var(--ink);box-shadow:0 20px 100px #202b3040}dialog::backdrop{background:#28302970;backdrop-filter:blur(4px)}.success-icon{width:45px;height:45px;border-radius:50%;background:#eef2e7;color:var(--green);display:grid;place-items:center;margin-bottom:18px}dialog h2{font:500 24px var(--serif);margin:0 0 14px}dialog p{font-size:12px;color:#858e78;line-height:1.9}.confirmation-details{background:var(--paper);padding:17px;border-radius:5px;margin-top:18px;line-height:2;color:#59664f;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}.modal-close{width:100%;border:0;background:var(--green);color:white;padding:13px;margin-top:22px;border-radius:4px}
