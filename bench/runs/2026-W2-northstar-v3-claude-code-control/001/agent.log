s2 { top: 8%; left: 55%; }\n.s3 { bottom: 14%; left: 14%; transform: rotate(-25deg); }\n.pin {\n  position: absolute;\n  top: 39%;\n  left: 50%;\n  transform: translate(-50%, -100%);\n  background: var(--espresso);\n  color: var(--paper);\n  font-family: var(--serif);\n  font-size: .85rem;\n  padding: 6px 14px;\n  border-radius: 999px;\n  box-shadow: 0 8px 18px -6px rgba(43, 29, 20, .5);\n}\n.pin::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: -6px;\n  transform: translateX(-50%);\n  border: 6px solid transparent;\n  border-bottom: 0;\n  border-top-color: var(--espresso);\n}\n\n/* Footer */\n.site-footer {\n  border-top: 1px solid var(--line);\n  padding: 28px 0;\n}\n.footer-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.footer-inner p { margin: 0; font-size: .85rem; color: var(--muted); }\n\n/* Responsive */\n@media (max-width: 820px) {\n  .visit-inner { grid-template-columns: 1fr; gap: 40px; }\n}\n@media (max-width: 600px) {\n  .nav { gap: 16px; font-size: .85rem; }\n  .logo span { display: none; }\n  .hero { padding: 80px 0 72px; }\n  .section { padding: 72px 0; }\n  .info-list > div { grid-template-columns: 1fr; gap: 4px; }\n}\n"}}}
