solid var(--line);\n}\n.topbar .wrap {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding-block: 16px;\n}\n.brand {\n  font-weight: 700;\n  font-size: 18px;\n  text-decoration: none;\n}\n.brand span { color: var(--accent); }\n.topnav {\n  display: flex;\n  gap: 20px;\n  font-size: 15px;\n}\n.topnav a { text-decoration: none; color: var(--muted); }\n.topnav a:hover { color: var(--fg); }\n\n/* 首屏 */\n.intro {\n  padding-block: 56px 32px;\n}\n.intro h1 {\n  font-size: clamp(28px, 4.6vw, 42px);\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  margin: 0 0 16px;\n}\n.intro p {\n  color: var(--muted);\n  font-size: 17px;\n  margin: 0;\n}\n\n/* 切换 */\n.switch {\n  display: inline-flex;\n  margin-top: 28px;\n  padding: 4px;\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: var(--surface);\n}\n.switch a {\n  padding: 8px 18px;\n  border-radius: 7px;\n  text-decoration: none;\n  font-size: 15px;\n  color: var(--muted);\n}\n.switch a:hover { color: var(--fg); background: var(--ink-soft); }\n\n/* 课程区块 */\n.track {\n  padding-block: 40px;\n  border-top: 1px solid var(--line);\n  scroll-margin-top: 16px;\n}\n.track-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 24px 48px;\n  align-items: end;\n  margin-bottom: 28px;\n}\n.track-head h2 {\n  font-size: 28px;\n  margin: 0 0 8px;\n}\n.track-head .tag {\n  display: inline-block;\n  font-size: 14px;\n  color: var(--ink);\n  background: var(--ink-soft);\n  padding: 2px 10px;\n  border-radius: 4px;\n  margin-bottom: 12px;\n}\n.track-head p {\n  margin: 0;\n  color: var(--muted);\n}\n.facts {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface);\n}\n.facts li {\n  padding: 12px 14px;\n  line-height: 1.5;\n}\n.facts li + li { border-left: 1px solid var(--line); }\n.facts b {\n  display: block;\n  font-size: 18px;\n}\n.facts small {\n  color: var(--muted);\n  font-size: 14px;\n}\n\n/* 套餐 */\n.plans {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n}\n.plan {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 24px 22px;\n  min-width: 0;\n}\n.plan.pick {\n  border: 2px solid var(--accent);\n  padding: 23px 21px;\n}\n.plan .badge {\n  position: absolute;\n  top: -12px;\n  left: 20px;\n  background: var(--accent);\n  color: var(--accent-fg);\n  font-size: 13px;\n  padding: 2px 10px;\n  border-radius: 4px;\n}\n.plan h3 {\n  font-size: 19px;\n  margin: 0 0 4px;\n}\n.plan .for {\n  color: var(--muted);\n  font-size: 15px;\n  margin: 0 0 18px;\n  line-height: 1.6;\n}\n.price {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n  margin: 0;\n}\n.price .num {\n  font-size: 36px;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n.price .cur { font-size: 18px; font-weight: 600; }\n.unit {\n  margin: 4px 0 20px;\n  font-size: 15px;\n  color: var(--muted);\n}\n.unit strong { color: var(--fg); font-weight: 600; }\n.plan ul {\n  list-style: none;\n  padding: 0;\n  margin: 0 0 24px;\n  flex: 1;\n}\n.plan li {\n  position: relative;\n  padding-left: 18px;\n  font-size: 15px;\n  line-height: 1.7;\n  margin-bottom: 6px;\n}\n.plan li::before {\n  content: \"\";\n  position: absolute;\n  left: 2px;\n  top: 0.72em;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--ink);\n}\n.btn {\n  display: block;\n  text-align: center;\n  text-decoration: none;\n  font-size: 16px;\n  font-weight: 600;\n  padding: 11px 16px;\n  border-radius: 6px;\n  border: 1px solid var(--fg);\n  color: var(--fg);\n}\n.btn:hover { background: var(--ink-soft); }\n.pick .btn, .btn.solid {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: var(--accent-fg);\n}\n.pick .btn:hover, .btn.solid:hover { filter: brightness(1.06); background: var(--accent); }\n\n.note {\n  margin: 18px 0 0;\n  font-size: 14px;\n  color: var(--muted);\n}\n\n/* 对比表 */\n.compare {\n  padding-block: 40px;\n  border-top: 1px solid var(--line);\n}\n.compare h2, .faq h2 {\n  font-size: 26px;\n  margin: 0 0 20px;\n}\n.table-scroll {\n  overflow-x: auto;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface);\n}\ntable {\n  width: 100%;\n  min-width: 560px;\n  border-collapse: collapse;\n  font-size: 15px;\n}\nth, td {\n  text-align: left;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--line);\n  line-height: 1.6;\n  vertical-align: top;\n}\ntr:last-child th, tr:last-child td { border-bottom: 0; }\nthead th {\n  font-size: 15px;\n  background: var(--ink-soft);\n}\ntbody th {\n  font-weight: 600;\n  color: var(--muted);\n  width: 22%;\n}\n\n/* 常见问题 */\n.faq {\n  padding-block: 40px;\n  border-top: 1px solid var(--line);\n}\n.faq details {\n  border-bottom: 1px solid var(--line);\n  padding-block: 14px;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 17px;\n  line-height: 1.6;\n}\n.faq details p {\n  margin: 10px 0 0;\n  color: var(--muted);\n}\n\n/* 底部试听 */\n.trial {\n  margin-block: 40px 56px;\n  padding: 32px;\n  border-radius: 10px;\n  background: var(--accent-soft);\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n.trial h2 {\n  font-size: 24px;\n  margin: 0 0 6px;\n}\n.trial p { margin: 0; color: var(--muted); }\n.trial > div { min-width: 0; }\n\nfooter {\n  border-top: 1px solid var(--line);\n  padding-block: 24px;\n  font-size: 14px;\n  color: var(--muted);\n}\n\n@media (max-width: 860px) {\n  .plans { grid-template-columns: minmax(0, 1fr); gap: 24px; }\n  .track-head { grid-template-columns: minmax(0, 1fr); }\n}\n@media (max-width: 560px) {\n  .topnav { display: none; }\n  .facts { grid-template-columns: minmax(0, 1fr); }\n  .f