+  <script>
+    const form=document.querySelector('#application'), container=document.querySelector('#experiences'), status=document.querySelector('#status');
+    let nextId=0, application=null;
+    function renumber(){container.querySelectorAll('.experience-number').forEach((el,i)=>el.textContent='工作经历 '+String(i+1).padStart(2,'0'));}
+    function addExperience(data={}){const item=document.querySelector('#experience-template').content.firstElementChild.cloneNode(true);const id=++nextId;item.querySelectorAll('[data-key]').forEach(input=>{input.id='experience-'+id+'-'+input.dataset.key;input.previousElementSibling.htmlFor=input.id;input.value=data[input.dataset.key]||'';});item.querySelector('.remove').addEventListener('click',()=>{item.remove();renumber();});container.append(item);renumber();return item;}
+    addExperience();
+    document.querySelector('#add-experience').addEventListener('click',()=>addExperience().querySelector('input').focus());
+    function collect(){const data=Object.fromEntries(new FormData(form));data.experiences=[...container.children].map(item=>Object.fromEntries([...item.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.value])));return data;}
