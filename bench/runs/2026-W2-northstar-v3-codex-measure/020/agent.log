+@media (max-width: 680px) { .sidebar { width: 100%; height: auto; position: relative; padding: 16px 18px 10px; border-right: none; border-bottom: 1px solid var(--line); } .brand { font-size: 18px; } .brand-mark { height: 32px; width: 32px; font-size: 26px; } .brand small { display: none; } .nav-label, .sidebar-note, .sidebar-bottom, .nav-count { display: none; } nav { display: flex; gap: 4px; justify-content: space-between; margin-top: 15px; } nav a { font-size: 12px; padding: 7px 8px; gap: 0; } nav a > span:first-child { display: none; } .workspace { margin-left: 0; } .topbar { height: 48px; padding: 0 20px; } .top-tag { display: none; } main { padding: 20px 18px 0; } .hero { min-height: 315px; padding: 27px 23px; } .hero-art { display: none; } .hero-copy { max-width: 100%; } h1 { font-size: 29px; } .hero p { font-size: 14px; } .overview-strip { grid-template-columns: 1fr 1fr; gap: 15px; margin: 17px 0 28px; } .overview-strip > div + div { padding-left: 15px; } .overview-strip .progress-stat { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); padding: 13px 0 0; } h2 { font-size: 19px; } .section-heading > .pill { display: none; } .section-description { font-size: 14px; } .day-tabs { gap: 2px; } .day-tabs button { padding: 9px 1px; } .day-tabs button small { font-size: 12px; } .day-heading { padding: 17px; } .day-heading > div { gap: 10px; } .day-heading h3 { font-size: 14px; } .task { margin: 0 17px; } .task small { font-size: 14px; } .task-footer { padding: 10px 17px; } .right-column { grid-template-columns: 1fr; gap: 5px; } .tip-card { padding: 21px; } .tip-card p, .tip-card a, .packing li { font-size: 14px; } .packing { padding: 17px 6px; } .accounts-section { margin-top: 23px; } .accounts-grid { grid-template-columns: 1fr; } .account { padding: 19px; } .account-details { font-size: 14px; } .help-section { gap: 22px 15px; } .help-section > div:first-child { grid-column: 1 / -1; } .help-item:last-child { grid-column: 1 / -1; } footer { font