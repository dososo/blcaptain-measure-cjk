+    function highlightJSON(value){return escapeHtml(JSON.stringify(value,null,2)).replace(/(&quot;.*?&quot;)(\s*:)?|\b(\d+|true|false|null)\b/g,(match,str,key,num)=>str?`<span class="${key?'key':'string'}">${str}</span>${key||''}`:`<span class="number">${num}</span>`);}
