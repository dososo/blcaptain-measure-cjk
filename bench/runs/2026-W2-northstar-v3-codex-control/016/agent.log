+    document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const text=document.getElementById(button.dataset.copy).textContent;try{await navigator.clipboard.writeText(text);notify('命令已复制')}catch{const field=document.createElement('textarea');field.value=text;field.style.cssText='position:fixed;top:0;left:0;opacity:0';document.body.appendChild(field);field.select();let copied=false;try{copied=document.execCommand('copy')}catch{}field.remove();button.focus();notify(copied?'命令已复制':'无法自动复制，请选中命令手动复制')}}));
+    const dialog=document.getElementById('search-dialog'),input=document.getElementById('search-input'),results=document.getElementById('search-results');
+    const entries=[{id:'overview',title:'快速上手',keywords:'开始 入门 quickstart'},{id:'installation',title:'安装 Git',keywords:'macOS Linux Windows brew apt winget install'},{id:'configuration',title:'基础配置 · 名字与邮箱',keywords:'config name email 身份'},{id:'commands',title:'常用命令 · 克隆、状态与历史',keywords:'clone status log 仓库 提交'}];
+    function search(){const query=input.value.trim().toLowerCase();results.replaceChildren();const matches=entries.filter(e=>(e.title+' '+e.keywords).toLowerCase().includes(query));matches.forEach(entry=>{const link=document.createElement('a');link.href='#'+entry.id;link.textContent=entry.title;link.addEventListener('click',()=>dialog.close());results.appendChild(link)});if(!matches.length){const p=document.createElement('p');p.textContent='没有找到相关内容，试试“安装”或“命令”。';results.appendChild(p)}}
