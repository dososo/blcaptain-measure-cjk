from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()
        self.refs = []
        self.recipes = 0
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if 'id' in attrs:
            self.ids.add(attrs['id'])
        if tag == 'use':
            self.refs.append(attrs['href'][1:])
        if tag == 'section' and attrs.get('class') == 'recipe':
            self.recipes += 1
p = Path('index.html')
s = p.read_text()
c = Check()
c.feed(s)
assert c.recipes == 4
assert all(ref in c.ids for ref in c.refs)
assert 'aspect-ratio: 3 / 4' in s
assert not any(x in s for x in ['<script', 'src=\"http', 'href=\"http'])
print('已检查：index.html，4 个食谱，3:4 比例，插画引用完整，无外部依赖。')
