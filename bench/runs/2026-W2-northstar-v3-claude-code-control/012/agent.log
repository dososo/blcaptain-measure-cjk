res li.off::before { background: var(--line); box-shadow: none; }\n\n.btn {\n  display: block;\n  text-align: center;\n  padding: 0.8rem 1rem;\n  border-radius: 0.75rem;\n  font-weight: 600;\n  text-decoration: none;\n  border: 1.5px solid var(--accent);\n  color: var(--accent-strong);\n  background: transparent;\n  cursor: pointer;\n  font: inherit;\n  width: 100%;\n  transition: background 0.2s ease, color 0.2s ease;\n}\n.btn:hover { background: var(--accent-soft); }\n.btn.primary { background: var(--accent); color: var(--on-accent); }\n.btn.primary:hover { background: var(--accent-strong); }\n\n/* Section titles */\n.section { padding-block: 3rem; border-top: 1px solid var(--line); }\n.section h2.title { text-align: center; font-size: 1.6rem; margin: 0 0 0.5rem; }\n.section .sub { text-align: center; color: var(--muted); margin: 0 0 2rem; }\n\n/* Comparison table */\n.table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); }\ntable { width: 100%; border-collapse: collapse; min-width: 40rem; }\nth, td { padding: 0.9rem 1rem; text-align: center; border-bottom: 1px solid var(--line); font-size: 0.95rem; }\nth:first-child, td:first-child { text-align: left; color: var(--muted); }\nthead th { background: var(--accent-soft); color: var(--fg); font-weight: 600; }\ntbody tr:last-child td { border-bottom: none; }\ntd.yes { color: var(--accent-strong); font-weight: 600; }\ntd.no { color: var(--muted); }\n.col-featured { background: color-mix(in srgb, var(--accent-soft) 45%, transparent); }\n\n/* Notes */\n.notes {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));\n  gap: 1rem;\n}\n.note {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 1rem;\n  padding: 1.25rem;\n  min-width: 0;\n}\n.note .icon { font-size: 1.5rem; }\n.note h3 { margin: 0.5rem 0 0.25rem; font-size: 1.05rem; }\n.note p { margin: 0; color: var(--muted); font-size: 0.9rem; }\n\n/* FAQ */\n.faq { max-width: 48rem; margin: 0 auto; }\n.faq details {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 0.85rem;\n  padding: 1rem 1.25rem;\n  margin-bottom: 0.75rem;\n}\n.faq summary {\n  cursor: pointer;\n  font-weight: 600;\n  list-style: none;\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n}\n.faq summary::-webkit-details-marker { display: none; }\n.faq summary::after { content: \"+\"; color: var(--accent-strong); font-size: 1.25rem; line-height: 1; }\n.faq details[open] summary::after { content: \"−\"; }\n.faq details p { margin: 0.75rem 0 0; color: var(--muted); }\n\n/* CTA + footer */\n.cta {\n  text-align: center;\n  background: var(--accent-soft);\n  border-radius: 1.5rem;\n  padding: 2.5rem 1.5rem;\n  margin-block: 1rem 3rem;\n}\n.cta h2 { margin: 0 0 0.5rem; }\n.cta p { color: var(--muted); margin: 0 0 1.25rem; }\n.cta .btn { display: inline-block; width: auto; padding-inline: 2rem; }\n\n.site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }\n.site-footer .wrap {\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  flex-wrap: wrap;\n  padding-block: 1.5rem;\n}\n\n/* Toast */\n.toast {\n  position: fixed;\n  left: 50%;\n  bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));\n  transform: translateX(-50%);\n  background: var(--fg);\n  color: var(--bg);\n  padding: 0.75rem 1.25rem;\n  border-radius: 0.75rem;\n  font-size: 0.9rem;\n  max-width: calc(100% - 2rem);\n  box-shadow: var(--shadow);\n}\n\n@media (max-width: 600px) {\n  .hero { padding-block: 2.5rem 1.5rem; }\n  .site-header nav { gap: 0.9rem; }\n  .plan .desc { min-height: 0; }\n}\n"}}}
