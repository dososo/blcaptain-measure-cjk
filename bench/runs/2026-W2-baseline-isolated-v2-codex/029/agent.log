from html.parser import HTMLParser
from pathlib import Path
class CardParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.books = 0
        self.titles = 0
        self.external_assets = []
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        self.books += tag == 'li' and a.get('class') == 'book'
        self.titles += tag == 'h2'
        if tag in ('script', 'img', 'link'):
            self.external_assets.append(a)
p = Path('index.html')
s = p.read_text()
c = CardParser()
c.feed(s)
assert c.books == c.titles == 5
assert 'aspect-ratio: 3 / 4' in s
assert not c.external_assets
assert s.strip().endswith('</html>')
print(f'Checked {p}: 5 books, 3:4 ratio, inline styles and illustrations, no external assets. ({p.stat().st_size} bytes)')
