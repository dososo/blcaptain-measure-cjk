\n  max-width: 1120px;\n  margin: 0 auto;\n  padding-inline: 20px;\n}\n\n/* 按钮 */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0.7em 1.4em;\n  border-radius: 10px;\n  border: 1px solid transparent;\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.2s, border-color 0.2s;\n}\n.btn:hover { transform: translateY(-1px); }\n.btn-primary { background: var(--accent); color: #fff; }\n.btn-primary:hover { background: var(--accent-strong); }\n.btn-ghost { border-color: var(--line); background: var(--surface); }\n.btn-ghost:hover { border-color: var(--accent); }\n.btn-sm { padding: 0.45em 1em; font-size: 0.9rem; }\n.btn-lg { padding: 0.85em 1.8em; font-size: 1.05rem; }\n\n/* 导航 */\n.nav {\n  position: sticky;\n  top: env(safe-area-inset-top, 0px);\n  z-index: 10;\n  background: color-mix(in srgb, var(--bg) 88%, transparent);\n  backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--line);\n}\n.nav-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n  gap: 16px;\n}\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: 700;\n  font-size: 1.15rem;\n}\n.logo-mark {\n  display: grid;\n  place-items: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  background: var(--accent);\n  color: #fff;\n  font-size: 0.95rem;\n}\n.nav-links { display: flex; gap: 28px; color: var(--muted); }\n.nav-links a:hover { color: var(--fg); }\n\n/* 首屏 */\n.hero { padding-block: 80px 64px; }\n.hero-inner {\n  display: grid;\n  grid-template-columns: 1.05fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n.hero-text { min-width: 0; }\n.badge {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n.hero h1 {\n  font-size: clamp(2rem, 4.5vw, 3.1rem);\n  line-height: 1.2;\