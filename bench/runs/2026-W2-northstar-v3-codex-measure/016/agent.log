from pathlib import Path
import re, subprocess
text = Path('index.html').read_text()
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.refs=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if a.get('href','').startswith('#') and a['href']"'!='"'#': self.refs.append(a['href'][1:])
p=Check(); p.feed(text)
assert len(set(p.ids))==len(p.ids), 'Duplicate ids'
assert all(ref in p.ids for ref in p.refs), 'Missing anchor target'
script=re.search(r'<script>(.*?)</script>',text,re.S).group(1)
result=subprocess.run(['node','--check'], input=script, text=True, capture_output=True)
assert result.returncode==0, result.stderr
assert all(Path(name).is_file() for name in ['index.html','style.css','measure.css'])
print('PASS: HTML anchor targets, unique IDs, JavaScript syntax, and local stylesheet files.')
