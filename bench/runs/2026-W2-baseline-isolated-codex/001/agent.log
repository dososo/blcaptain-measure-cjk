from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.links=[]; self.stack=[]; self.errors=[]; self.images=0
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a:
            if a['id'] in self.ids: self.errors.append('Duplicate id: '+a['id'])
            self.ids.add(a['id'])
        if tag=='a': self.links.append(a.get('href',''))
        if tag=='img':
            self.images+=1
            if not a.get('alt'): self.errors.append('Image missing alt')
        if tag not in {'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        if not self.stack or self.stack[-1]"'!=tag: self.errors.append('"'Mismatched tag: '+tag)
        else: self.stack.pop()
    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if self.stack and self.stack[-1]==tag: self.stack.pop()
p=Path('index.html'); c=Check(); c.feed(p.read_text())
c.errors += ['Missing anchor: '+a for a in c.links if a.startswith('#') and a[1:] not in c.ids]
assert not c.errors and not c.stack, (c.errors,c.stack)
print(f'Checked {p}: {p.stat().st_size:,} bytes; valid tag nesting; all {len(c.links)} anchor links resolve; {c.images} images have alt text.')
print('Files:', ', '.join(x.name for x in Path('.').iterdir() if x.is_file()))
