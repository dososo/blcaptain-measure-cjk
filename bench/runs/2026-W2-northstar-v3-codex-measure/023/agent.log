+@layer measure;
+:root{color-scheme:light;--ink:#243b30;--muted:#7d867c;--green:#347858;--line:#e6e9e1;--paper:#fff;--wash:#f6f7f2}
+*{box-sizing:border-box}
+body{margin:0;background:var(--wash);color:var(--ink);font-family:system-ui,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.7}
+button,input,select{font:inherit}
+button,a,input,select{-webkit-tap-highlight-color:transparent}
+button{cursor:pointer}
+a{color:inherit;text-decoration:none}
+button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #85b59c;outline-offset:4px}
+[hidden]{display:none!important}
+.site-header{max-width:1280px;margin:auto;padding:27px 48px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}
+.brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:700;letter-spacing:1px}
+.brand-icon{display:grid;place-items:center;width:33px;height:33px;background:var(--green);border-radius:9px;color:#fff;font-size:26px;font-weight:400;line-height:1}
+.brand-en{font-size:10px;letter-spacing:1.8px;margin-left:9px;font-weight:500;color:var(--muted)}
+.header-note{font-size:12px;color:#6a776b;display:flex;align-items:center;gap:8px}
+.status-dot{width:6px;height:6px;background:#7a9971;border-radius:50%}
+.layout{max-width:1184px;margin:60px auto 70px;display:grid;grid-template-columns:380px minmax(0,1fr);gap:72px;padding:0 24px;align-items:start}
+.intro{padding-top:13px;position:sticky;top:32px}
+.eyebrow{display:flex;align-items:center;gap:9px;color:#647e63;font-size:12px;letter-spacing:1px;margin-bottom:23px}
+.eyebrow>span{height:1px;width:23px;background:#6f8e69}
+h1{font-size:38px;font-weight:600;margin:0 0 23px;letter-spacing:1px;line-height:1.5!important}
+.green{color:var(--green)}
+.intro-copy{color:#768174;font-size:14px;line-height:1.95;margin-bottom:22px}
+.facts{display:flex;align-items:center;gap:17px;font-size:12px;color:#7b8577;margin-bottom:40px}
+.facts>span+span{border-left:1px solid #d7ddcf;padding-left:17px}
+.facts b{font-weight:600;color:#3d5542;font-size:14px}
+.journey-art{background:#eaf0e2;border-radius:5px;padding:20px 21px 16px;overflow:hidden;transform:rotate(-1.5deg)}
+.art-top,.art-bottom{display:flex;justify-content:space-between;color:#68815d;font-size:12px}
+.art-top{font-size:11px;letter-spacing:2px}
+.journey-art svg{width:100%;display:block;margin:10px 0 4px}
+.art-bottom{padding:0 14px}
+.aside-note{color:#87917e;font-size:12px;margin:20px 0 0;text-align:center}
+.aside-note span{padding-right:5px;color:#668258}
+.privacy{display:flex;gap:13px;align-items:center;margin:40px 0 0;color:#8a9385;border-top:1px solid #e0e5d9;padding-top:23px}
+.privacy p{margin:0;font-size:12px;line-height:1.8}
+.privacy svg{flex-shrink:0}
+.survey{background:var(--paper);border:1px solid #e3e7df;border-radius:12px;padding:30px 34px 25px;box-shadow:0 7px 30px #263c2a03}
+.survey-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:12px}
+.section-label{font-size:10px;letter-spacing:1.6px;color:#8a9586}
+h2{font-size:22px;margin:7px 0 0;font-weight:600;letter-spacing:.5px}
+.survey-badge{background:#f1f5ec;color:#6c8260;border:1px solid #e2e9dc;border-radius:5px;padding:3px 9px;font-size:12px;white-space:nowrap}
+.progress-info{display:flex;justify-content:space-between;font-size:12px;color:#8a9385;margin-bottom:7px}
+#progress-text{color:#66815d;font-variant-numeric:tabular-nums}
+progress{display:block;width:100%;height:4px;border:0;border-radius:8px;background:#eef1e9;overflow:hidden;accent-color:var(--green)}
+progress::-webkit-progress-bar{background:#eef1e9}
+progress::-webkit-progress-value{background:#6d9570;border-radius:8px;transition:width .25s}
+progress::-moz-progress-bar{background:#6d9570}
+.form-note{font-size:12px;color:#8b9486;margin:17px 0 27px}
+fieldset{border:0;min-width:0;margin:0 0 25px;padding:0 0 24px;border-bottom:1px solid #edf0e9}
+legend{padding:0;margin-bottom:13px;font-size:14px;font-weight:600;width:100%;line-height:1.7}
+.question-number{color:#7d9871;font-size:12px;font-weight:500;display:inline-block;margin-right:11px;font-variant-numeric:tabular-nums}
+.question-type{font-size:11px;color:#97a08f;font-weight:400;margin-left:9px;white-space:nowrap}
+.question-help{font-size:12px;color:#929b8b;margin:-6px 0 13px 26px;line-height:1.7}
+.options{display:grid;gap:9px}
+.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
+.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
+.option{display:flex;align-items:center;gap:8px;border:1px solid #e1e6dc;border-radius:6px;padding:10px 11px;cursor:pointer;transition:background .15s,border-color .15s;color:#66735f;font-size:12px;min-height:43px}
+.option:hover,.rating:hover{background:#f7f9f3;border-color:#a8bda0}
+.option:has(input:checked),.rating:has(input:checked){border-color:#68916b;background:#f0f6eb;color:#365b39}
+.option input{margin:0;width:14px;height:14px;accent-color:#527e52;flex-shrink:0;cursor:pointer}
+.full{grid-column:1/-1}
+select{width:100%;appearance:none;padding:11px 38px 11px 14px;color:#64725e;background:transparent;border:1px solid #e1e6dc;border-radius:6px;font-size:13px;cursor:pointer;min-height:44px}
+select:has(option:checked[value=""]){color:#9aa28f}
+.select-wrap{position:relative}
+.select-wrap:after{content:"⌄";position:absolute;right:15px;top:6px;color:#85937b;pointer-events:none;font-size:20px}
+.rating-options{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
+.rating{position:relative;display:flex;align-items:center;flex-direction:column;gap:7px;border:1px solid #e3e7dd;border-radius:6px;padding:12px 2px 10px;cursor:pointer;font-size:12px;color:#78866c}
+.rating input{position:absolute;opacity:0;width:1px;height:1px}
+.rating:has(input:focus-visible){outline:3px solid #85b59c;outline-offset:3px}
+.rating-face{font-family:system-ui,sans-serif;font-size:27px;line-height:1;color:#8e9d80;font-weight:400}
+.rating:has(input:checked) .rating-face{color:var(--green)}
+.not-applicable{margin-top:9px;min-height:36px;padding:7px 11px}
+.last-question{margin-bottom:23px}
+.form-actions{display:flex;justify-content:space-between;align-items:center;gap:15px}
+.form-actions p{font-size:12px;color:#949c8d;margin:0}
+.primary{background:var(--green);border:1px solid var(--green);border-radius:6px;color:#fff;padding:11px 21px;font-weight:500;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:25px;transition:background .15s}
+.primary:hover{background:#275e44}
+.primary span{font-size:19px;line-height:1}
+.local-note{font-size:11px;color:#9aa291;text-align:right;margin:13px 0 0}
+footer{max-width:1184px;padding:22px 24px 30px;margin:auto;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:#969f8d;font-size:11px}
+footer [lang="en"]{font-size:10px;letter-spacing:1.6px}
+.footer-dot{padding:0 9px}
+.success-icon{display:grid;place-items:center;width:54px;height:54px;background:#eaf2e5;border-radius:50%;color:var(--green);font-size:27px;margin:35px 0 22px}
+.result-intro{color:var(--muted);font-size:14px;max-width:36em}
+#result-list{margin:27px 0}
+#result-list>div{padding:15px 0;border-bottom:1px solid var(--line)}
+dt{font-size:12px;color:var(--muted)}
+dd{margin:5px 0 0;font-size:15px}
+.result-actions{display:flex;justify-content:space-between;gap:12px;margin-top:25px}
+.secondary{border:1px solid #d8e0d3;background:#fff;border-radius:6px;color:#5e7357;padding:10px 18px}
+@media(min-width:1400px){.layout{margin-top:75px;gap:90px;grid-template-columns:390px minmax(0,1fr)}}
+@media(max-width:1050px){.layout{gap:35px;grid-template-columns:300px minmax(0,1fr));}.layout{grid-template-columns:300px minmax(0,1fr)}h1{font-size:31px}.survey{padding:25px}.brand-en{display:none}.option{padding:10px 8px;gap:6px}.facts{gap:10px}.facts>span+span{padding-left:10px}.cols-3{grid-template-columns:repeat(2,minmax(0,1fr))}.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:760px){.site-header{padding:20px 24px}.layout{grid-template-columns:minmax(0,1fr);max-width:640px;margin:32px auto 38px;gap:30px;padding:0 20px}.intro{position:static;padding-top:0}.eyebrow{margin-bottom:14px}h1{font-size:34px;line-height:1.5!important;margin-bottom:15px}.intro-copy{margin-top:0;margin-bottom:15px}.facts{margin-bottom:0;gap:18px}.facts>span+span{padding-left:18px}.journey-art,.aside-note,.privacy{display:none}.survey{padding:25px 22px}.header-note{font-size:11px}.brand{font-size:17px}.brand-icon{width:30px;height:30px}.survey-top{margin-bottom:22px}footer{margin:0 20px;padding:20px 0;flex-direction:column;gap:6px}.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}.form-actions p{font-size:11px}}
+@media(max-width:440px){.survey{padding:22px 17px}.cols-3,.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}.question-type{font-size:12px;margin-left:6px}.question-number{margin-right:8px}legend{font-size:14px}.rating-options{gap:5px}.rating{font-size:12px;padding:12px 0 10px}.form-actions{align-items:stretch;flex-direction:column;gap:13px}.form-actions p,.local-note{text-align:center}.header-note{font-size:12px}.site-header{padding:19px 20px}.brand{gap:7px}.eyebrow{font-size:12px}.result-actions .primary{gap:10px;padding:11px 14px}}
+@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

diff --git a/index.html b/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..89a3d70cb74133c903d1173e52e086edeff5f667
--- /dev/null
+++ b/index.html
@@ -0,0 +1,135 @@
+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f7f2">
+  <title>通勤之间 · 日常通勤小调查</title>
+  <link rel="stylesheet" href="measure.css">
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <header class="site-header">
+    <a class="brand" href="./index.html" aria-label="通勤之间首页"><span class="brand-icon" aria-hidden="true">↗</span>通勤之间<span class="brand-en" lang="en">ON THE WAY</span></a>
+    <span class="header-note"><span class="status-dot"></span>城市生活观察计划</span>
+  </header>
+
+  <main class="layout">
+    <aside class="intro">
+      <div class="eyebrow"><span></span>每一段日常，都值得被看见</div>
+      <h1>从家到目的地，<br>你花了多久<span class="green">？</span></h1>
+      <p class="intro-copy measure-prose">挤过的地铁、等过的红灯、走过的街角。<br>用 6 个小问题，记录你的日常通勤。</p>
+      <div class="facts"><span><b>6</b> 道问题</span><span><b>约 1</b> 分钟</span><span>无需个人信息</span></div>
+
+      <div class="journey-art" aria-hidden="true">
+        <div class="art-top"><span>日常路线</span><span lang="en">A → B</span></div>
+        <svg viewBox="0 0 380 260" fill="none" xmlns="http://www.w3.org/2000/svg">
+          <path d="M0 217H380M0 175H380M0 133H380M0 91H380M42 55V255M104 55V255M166 55V255M228 55V255M290 55V255M352 55V255" stroke="#dbe6d8" stroke-width="1"/>
+          <path d="M50 200H112Q132 200 132 180V154Q132 135 153 135H227Q250 135 250 113V90Q250 70 274 70H326" stroke="#fafbf7" stroke-width="19" stroke-linecap="round"/>
+          <path d="M50 200H112Q132 200 132 180V154Q132 135 153 135H227Q250 135 250 113V90Q250 70 274 70H326" stroke="#39815e" stroke-width="3" stroke-dasharray="5 7" stroke-linecap="round"/>
+          <circle cx="50" cy="200" r="8" fill="#f9fbf7" stroke="#39815e" stroke-width="3"/><circle cx="326" cy="70" r="8" fill="#39815e"/>
+          <path d="M29 162V133L50 116L71 133V162H29Z" fill="#f9fbf7" stroke="#355e46" stroke-width="2"/><path d="M22 137L50 114L78 137M44 162V145H57V162" stroke="#355e46" stroke-width="2"/>
+          <rect x="302" y="12" width="46" height="38" rx="2" fill="#f9fbf7" stroke="#355e46" stroke-width="2"/><path d="M312 22H319M330 22H337M312 32H319M330 32H337M323 50V41H330V50" stroke="#355e46" stroke-width="2"/>
+          <g transform="translate(173 106) rotate(-8)"><rect width="49" height="51" rx="11" fill="#367856"/><rect x="7" y="8" width="35" height="21" rx="4" fill="#e5edce"/><path d="M24 8V29" stroke="#367856" stroke-width="2"/><circle cx="12" cy="39" r="3" fill="#eff2c9"/><circle cx="37" cy="39" r="3" fill="#eff2c9"/><path d="M10 51L6 57M39 51L43 57" stroke="#367856" stroke-width="3" stroke-linecap="round"/></g>
+          <circle cx="302" cy="186" r="18" fill="#b9ccaa"/><circle cx="320" cy="199" r="13" fill="#ccdabd"/><path d="M302 186V223M320 198V224" stroke="#6d8a60" stroke-width="2"/>
+        </svg>
+        <div class="art-bottom"><span>家的方向</span><span>生活的另一站</span></div>
+      </div>
+      <p class="aside-note"><span aria-hidden="true">↳</span> 无论远近，每一种出行都有自己的节奏。</p>
+      <div class="privacy"><svg width="19" height="22" viewBox="0 0 20 24" fill="none" aria-hidden="true"><path d="M10 2L18 5V12C18 17 14 20 10 22C6 20 2 17 2 12V5L10 2Z" stroke="currentColor" stroke-width="1.5"/><path d="M6 11L9 14L14 9" stroke="currentColor" stroke-width="1.5"/></svg><p>你的回答只在当前页面处理。<br>无需登录，不收集姓名与联系方式。</p></div>
+    </aside>
+
+    <section class="survey" aria-labelledby="survey-title">
+      <div class="survey-top"><div><span class="section-label" lang="en">DAILY COMMUTE SURVEY</span><h2 id="survey-title">聊聊你的通勤日常</h2></div><span class="survey-badge">共 6 题</span></div>
+      <div class="progress-info"><span>填写进度</span><span id="progress-text" aria-live="polite">已完成 0 / 6</span></div>
+      <progress id="progress" max="6" value="0" aria-label="问卷填写进度"></progress>
+      <form id="commute-form">
+        <p class="form-note">请按最近一个月的通常情况填写，所有问题均为必答。</p>
+        <fieldset><legend><span class="question-number">01</span>你每周通常有几天需要通勤？<span class="question-type">单选</span></legend>
+          <div class="options cols-4"><label class="option"><input type="radio" name="frequency" value="1—2 天" required><span>1—2 天</span></label><label class="option"><input type="radio" name="frequency" value="3—4 天"><span>3—4 天</span></label><label class="option"><input type="radio" name="frequency" value="5 天"><span>5 天</span></label><label class="option"><input type="radio" name="frequency" value="6—7 天"><span>6—7 天</span></label><label class="option full"><input type="radio" name="frequency" value="无需通勤"><span>无需通勤／居家办公</span></label></div>
+        </fieldset>
+        <fieldset><legend><span class="question-number">02</span>你平均每天单程通勤需要多久？<span class="question-type">单选</span></legend><p class="question-help">包括步行、等车和换乘时间；无需通勤可选最后一项。</p>
+          <div class="options cols-3"><label class="option"><input type="radio" name="duration" value="少于 15 分钟" required><span>少于 15 分钟</span></label><label class="option"><input type="radio" name="duration" value="15—30 分钟"><span>15—30 分钟</span></label><label class="option"><input type="radio" name="duration" value="31—60 分钟"><span>31—60 分钟</span></label><label class="option"><input type="radio" name="duration" value="超过 60 分钟"><span>超过 60 分钟</span></label><label class="option"><input type="radio" name="duration" value="不适用"><span>不适用</span></label></div>
+        </fieldset>
+        <fieldset><legend><span class="question-number">03</span>你通常使用哪些交通方式？<span class="question-type">可多选</span></legend><p class="question-help" id="transport-hint">如需换乘，可选择多种方式。</p>
+          <div class="options cols-3" id="transport-options"><label class="option"><input type="checkbox" name="transport" value="地铁／轻轨" aria-describedby="transport-hint"><span>地铁／轻轨</span></label><label class="option"><input type="checkbox" name="transport" value="公交车"><span>公交车</span></label><label class="option"><input type="checkbox" name="transport" value="自驾"><span>自驾</span></label><label class="option"><input type="checkbox" name="transport" value="步行"><span>步行</span></label><label class="option"><input type="checkbox" name="transport" value="自行车"><span>自行车</span></label><label class="option"><input type="checkbox" name="transport" value="电动车／摩托车"><span>电动车／摩托车</span></label><label class="option"><input type="checkbox" name="transport" value="出租车／网约车"><span>出租车／网约车</span></label><label class="option"><input type="checkbox" name="transport" value="其他"><span>其他</span></label><label class="option"><input type="checkbox" name="transport" value="不适用"><span>不适用</span></label></div>
+        </fieldset>
+        <fieldset><legend><span class="question-number">04</span>你的单程通勤距离大约是多少？<span class="question-type">单选</span></legend>
+          <div class="select-wrap"><select name="distance" required aria-label="单程通勤距离"><option value="" disabled selected>请选择大致距离</option><option>少于 3 公里</option><option>3—5 公里</option><option>超过 5 公里，至 10 公里</option><option>超过 10 公里，至 20 公里</option><option>超过 20 公里</option><option>不确定</option><option>不适用</option></select></div>
+        </fieldset>
+        <fieldset><legend><span class="question-number">05</span>你通常在什么时间出发？<span class="question-type">单选</span></legend>
+          <div class="select-wrap"><select name="departure" required aria-label="通常出发时间"><option value="" disabled selected>请选择通常离家的时间</option><option>早上 7 点前</option><option>早上 7 点至 8 点前</option><option>早上 8 点至 9 点前</option><option>早上 9 点至 10 点前</option><option>上午 10 点及以后</option><option>时间不固定</option><option>不适用</option></select></div>
+        </fieldset>
+        <fieldset class="last-question"><legend><span class="question-number">06</span>你对目前的通勤体验满意吗？<span class="question-type">单选</span></legend>
+          <div class="rating-options"><label class="rating"><input type="radio" name="satisfaction" value="很不满意" required><span class="rating-face" aria-hidden="true">☹</span><span>很不满意</span></label><label class="rating"><input type="radio" name="satisfaction" value="不太满意"><span class="rating-face" aria-hidden="true">◔</span><span>不太满意</span></label><label class="rating"><input type="radio" name="satisfaction" value="一般"><span class="rating-face" aria-hidden="true">⊙</span><span>一般</span></label><label class="rating"><input type="radio" name="satisfaction" value="比较满意"><span class="rating-face" aria-hidden="true">☺</span><span>比较满意</span></label><label class="rating"><input type="radio" name="satisfaction" value="非常满意"><span class="rating-face" aria-hidden="true">☻</span><span>非常满意</span></label></div>
+          <label class="option not-applicable"><input type="radio" name="satisfaction" value="不适用"><span>不适用</span></label>
+        </fieldset>
+        <div class="form-actions"><p>每一个回答，都是一幅生活切片。</p><button class="primary" type="submit">完成问卷<span aria-hidden="true">↗</span></button></div>
+        <p class="local-note">完成后可查看并下载回答，数据不会上传。</p>
+      </form>
+      <section id="result" hidden aria-labelledby="result-title"><div class="success-icon" aria-hidden="true">✓</div><h2 id="result-title" tabindex="-1">你的通勤记录，完成了。</h2><p class="result-intro">感谢你分享日常。以下是本次填写的回答，可下载留存。</p><dl id="result-list"></dl><div class="result-actions"><button type="button" id="edit" class="secondary">返回修改</button><button type="button" id="download" class="primary">下载我的回答 <span aria-hidden="true">↓</span></button></div><p class="local-note">回答仅保留在当前页面，刷新或关闭后将清除。</p></section>
+    </section>
+  </main>
+  <footer><span>通勤之间<span class="footer-dot">·</span>记录城市里的每一次出发</span><span lang="en">A LITTLE TIME, A LITTLE INSIGHT.</span></footer>
+  <script>
+    const form = document.querySelector('#commute-form');
+    const fields = ['frequency', 'duration', 'transport', 'distance', 'departure', 'satisfaction'];
+    const titles = ['每周通勤频率', '单程通勤时间', '交通方式', '单程通勤距离', '通常出发时间', '通勤满意度'];
+    const transport = [...form.querySelectorAll('[name="transport"]')];
+    let answers = [];
+    function updateProgress() {
+      const data = new FormData(form);
+      const count = fields.filter(key => data.getAll(key).some(Boolean)).length;
+      document.querySelector('#progress').value = count;
+      document.querySelector('#progress-text').textContent = `已完成 ${count} / 6`;
+      transport[0].setCustomValidity(data.getAll('transport').length ? '' : '请至少选择一种交通方式，或选择“不适用”。');
+    }
+    form.addEventListener('change', event => {
+      if (event.target.name === 'transport' && event.target.checked) {
+        transport.forEach(input => {
+          if (input !== event.target && (event.target.value === '不适用' || input.value === '不适用')) input.checked = false;
+        });
+      }
+      updateProgress();
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      updateProgress();
+      if (!form.reportValidity()) return;
+      const data = new FormData(form);
+      answers = fields.map((key, index) => ({question: titles[index], answer: data.getAll(key).join('、')}));
+      const list = document.querySelector('#result-list');
+      list.replaceChildren();
+      answers.forEach(({question, answer}) => {
+        const row = document.createElement('div');
+        const label = document.createElement('dt');
+        const value = document.createElement('dd');
+        label.textContent = question;
+        value.textContent = answer;
+        row.append(label, value);
+        list.append(row);
+      });
+      form.hidden = true;
+      document.querySelector('#result').hidden = false;
+      document.querySelector('#result-title').focus();
+    });
+    document.querySelector('#edit').addEventListener('click', () => {
+      document.querySelector('#result').hidden = true;
+      form.hidden = false;
+      form.querySelector('input').focus();
+    });
+    document.querySelector('#download').addEventListener('click', () => {
+      const text = '通勤之间 · 我的通勤记录\n\n' + answers.map(({question, answer}, index) => `${index + 1}. ${question}\n${answer}`).join('\n\n');
+      const url = URL.createObjectURL(new Blob(['\ufeff' + text], {type: 'text/plain;charset=utf-8'}));
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = '我的通勤记录.txt';
+      document.body.append(link);
+      link.click();
+      link.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+    });
+    updateProgress();
+  </script>
+</body>
+</html>
diff --git a/style.css b/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..4dc146e3341f64f6f9155f8346ddd222f04dfeab
--- /dev/null
+++ b/style.css
@@ -0,0 +1,95 @@
+@layer measure;
+:root{color-scheme:light;--ink:#243b30;--muted:#7d867c;--green:#347858;--line:#e6e9e1;--paper:#fff;--wash:#f6f7f2}
+*{box-sizing:border-box}
+body{margin:0;background:var(--wash);color:var(--ink);font-family:system-ui,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.7}
+button,input,select{font:inherit}
+button,a,input,select{-webkit-tap-highlight-color:transparent}
+button{cursor:pointer}
+a{color:inherit;text-decoration:none}
+button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #85b59c;outline-offset:4px}
+[hidden]{display:none!important}
+.site-header{max-width:1280px;margin:auto;padding:27px 48px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}
+.brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:700;letter-spacing:1px}
+.brand-icon{display:grid;place-items:center;width:33px;height:33px;background:var(--green);border-radius:9px;color:#fff;font-size:26px;font-weight:400;line-height:1}
+.brand-en{font-size:10px;letter-spacing:1.8px;margin-left:9px;font-weight:500;color:var(--muted)}
+.header-note{font-size:12px;color:#6a776b;display:flex;align-items:center;gap:8px}
+.status-dot{width:6px;height:6px;background:#7a9971;border-radius:50%}
+.layout{max-width:1184px;margin:60px auto 70px;display:grid;grid-template-columns:380px minmax(0,1fr);gap:72px;padding:0 24px;align-items:start}
+.intro{padding-top:13px;position:sticky;top:32px}
+.eyebrow{display:flex;align-items:center;gap:9px;color:#647e63;font-size:12px;letter-spacing:1px;margin-bottom:23px}
+.eyebrow>span{height:1px;width:23px;background:#6f8e69}
+h1{font-size:38px;font-weight:600;margin:0 0 23px;letter-spacing:1px;line-height:1.5!important}
+.green{color:var(--green)}
+.intro-copy{color:#768174;font-size:14px;line-height:1.95;margin-bottom:22px}
+.facts{display:flex;align-items:center;gap:17px;font-size:12px;color:#7b8577;margin-bottom:40px}
+.facts>span+span{border-left:1px solid #d7ddcf;padding-left:17px}
+.facts b{font-weight:600;color:#3d5542;font-size:14px}
+.journey-art{background:#eaf0e2;border-radius:5px;padding:20px 21px 16px;overflow:hidden;transform:rotate(-1.5deg)}
+.art-top,.art-bottom{display:flex;justify-content:space-between;color:#68815d;font-size:12px}
+.art-top{font-size:11px;letter-spacing:2px}
+.journey-art svg{width:100%;display:block;margin:10px 0 4px}
+.art-bottom{padding:0 14px}
+.aside-note{color:#87917e;font-size:12px;margin:20px 0 0;text-align:center}
+.aside-note span{padding-right:5px;color:#668258}
+.privacy{display:flex;gap:13px;align-items:center;margin:40px 0 0;color:#8a9385;border-top:1px solid #e0e5d9;padding-top:23px}
+.privacy p{margin:0;font-size:12px;line-height:1.8}
+.privacy svg{flex-shrink:0}
+.survey{background:var(--paper);border:1px solid #e3e7df;border-radius:12px;padding:30px 34px 25px;box-shadow:0 7px 30px #263c2a03}
+.survey-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:12px}
+.section-label{font-size:10px;letter-spacing:1.6px;color:#8a9586}
+h2{font-size:22px;margin:7px 0 0;font-weight:600;letter-spacing:.5px}
+.survey-badge{background:#f1f5ec;color:#6c8260;border:1px solid #e2e9dc;border-radius:5px;padding:3px 9px;font-size:12px;white-space:nowrap}
+.progress-info{display:flex;justify-content:space-between;font-size:12px;color:#8a9385;margin-bottom:7px}
+#progress-text{color:#66815d;font-variant-numeric:tabular-nums}
+progress{display:block;width:100%;height:4px;border:0;border-radius:8px;background:#eef1e9;overflow:hidden;accent-color:var(--green)}
+progress::-webkit-progress-bar{background:#eef1e9}
+progress::-webkit-progress-value{background:#6d9570;border-radius:8px;transition:width .25s}
+progress::-moz-progress-bar{background:#6d9570}
+.form-note{font-size:12px;color:#8b9486;margin:17px 0 27px}
+fieldset{border:0;min-width:0;margin:0 0 25px;padding:0 0 24px;border-bottom:1px solid #edf0e9}
+legend{padding:0;margin-bottom:13px;font-size:14px;font-weight:600;width:100%;line-height:1.7}
+.question-number{color:#7d9871;font-size:12px;font-weight:500;display:inline-block;margin-right:11px;font-variant-numeric:tabular-nums}
+.question-type{font-size:11px;color:#97a08f;font-weight:400;margin-left:9px;white-space:nowrap}
+.question-help{font-size:12px;color:#929b8b;margin:-6px 0 13px 26px;line-height:1.7}
+.options{display:grid;gap:9px}
+.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
+.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
+.option{display:flex;align-items:center;gap:8px;border:1px solid #e1e6dc;border-radius:6px;padding:10px 11px;cursor:pointer;transition:background .15s,border-color .15s;color:#66735f;font-size:12px;min-height:43px}
+.option:hover,.rating:hover{background:#f7f9f3;border-color:#a8bda0}
+.option:has(input:checked),.rating:has(input:checked){border-color:#68916b;background:#f0f6eb;color:#365b39}
+.option input{margin:0;width:14px;height:14px;accent-color:#527e52;flex-shrink:0;cursor:pointer}
+.full{grid-column:1/-1}
+select{width:100%;appearance:none;padding:11px 38px 11px 14px;color:#64725e;background:transparent;border:1px solid #e1e6dc;border-radius:6px;font-size:13px;cursor:pointer;min-height:44px}
+select:has(option:checked[value=""]){color:#9aa28f}
+.select-wrap{position:relative}
+.select-wrap:after{content:"⌄";position:absolute;right:15px;top:6px;color:#85937b;pointer-events:none;font-size:20px}
+.rating-options{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
+.rating{position:relative;display:flex;align-items:center;flex-direction:column;gap:7px;border:1px solid #e3e7dd;border-radius:6px;padding:12px 2px 10px;cursor:pointer;font-size:12px;color:#78866c}
+.rating input{position:absolute;opacity:0;width:1px;height:1px}
+.rating:has(input:focus-visible){outline:3px solid #85b59c;outline-offset:3px}
+.rating-face{font-family:system-ui,sans-serif;font-size:27px;line-height:1;color:#8e9d80;font-weight:400}
+.rating:has(input:checked) .rating-face{color:var(--green)}
+.not-applicable{margin-top:9px;min-height:36px;padding:7px 11px}
+.last-question{margin-bottom:23px}
+.form-actions{display:flex;justify-content:space-between;align-items:center;gap:15px}
+.form-actions p{font-size:12px;color:#949c8d;margin:0}
+.primary{background:var(--green);border:1px solid var(--green);border-radius:6px;color:#fff;padding:11px 21px;font-weight:500;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:25px;transition:background .15s}
+.primary:hover{background:#275e44}
+.primary span{font-size:19px;line-height:1}
+.local-note{font-size:11px;color:#9aa291;text-align:right;margin:13px 0 0}
+footer{max-width:1184px;padding:22px 24px 30px;margin:auto;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:#969f8d;font-size:11px}
+footer [lang="en"]{font-size:10px;letter-spacing:1.6px}
+.footer-dot{padding:0 9px}
+.success-icon{display:grid;place-items:center;width:54px;height:54px;background:#eaf2e5;border-radius:50%;color:var(--green);font-size:27px;margin:35px 0 22px}
+.result-intro{color:var(--muted);font-size:14px;max-width:36em}
+#result-list{margin:27px 0}
+#result-list>div{padding:15px 0;border-bottom:1px solid var(--line)}
+dt{font-size:12px;color:var(--muted)}
+dd{margin:5px 0 0;font-size:15px}
+.result-actions{display:flex;justify-content:space-between;gap:12px;margin-top:25px}
+.secondary{border:1px solid #d8e0d3;background:#fff;border-radius:6px;color:#5e7357;padding:10px 18px}
+@media(min-width:1400px){.layout{margin-top:75px;gap:90px;grid-template-columns:390px minmax(0,1fr)}}
+@media(max-width:1050px){.layout{gap:35px;grid-template-columns:300px minmax(0,1fr));}.layout{grid-template-columns:300px minmax(0,1fr)}h1{font-size:31px}.survey{padding:25px}.brand-en{display:none}.option{padding:10px 8px;gap:6px}.facts{gap:10px}.facts>span+span{padding-left:10px}.cols-3{grid-template-columns:repeat(2,minmax(0,1fr))}.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:760px){.site-header{padding:20px 24px}.layout{grid-template-columns:minmax(0,1fr);max-width:640px;margin:32px auto 38px;gap:30px;padding:0 20px}.intro{position:static;padding-top:0}.eyebrow{margin-bottom:14px}h1{font-size:34px;line-height:1.5!important;margin-bottom:15px}.intro-copy{margin-top:0;margin-bottom:15px}.facts{margin-bottom:0;gap:18px}.facts>span+span{padding-left:18px}.journey-art,.aside-note,.privacy{display:none}.survey{padding:25px 22px}.header-note{font-size:11px}.brand{font-size:17px}.brand-icon{width:30px;height:30px}.survey-top{margin-bottom:22px}footer{margin:0 20px;padding:20px 0;flex-direction:column;gap:6px}.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}.form-actions p{font-size:11px}}
+@media(max-width:440px){.survey{padding:22px 17px}.cols-3,.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}.question-type{font-size:12px;margin-left:6px}.question-number{margin-right:8px}legend{font-size:14px}.rating-options{gap:5px}.rating{font-size:12px;padding:12px 0 10px}.form-actions{align-items:stretch;flex-direction:column;gap:13px}.form-actions p,.local-note{text-align:center}.header-note{font-size:12px}.site-header{padding:19px 20px}.brand{gap:7px}.eyebrow{font-size:12px}.result-actions .primary{gap:10px;padding:11px 14px}}
