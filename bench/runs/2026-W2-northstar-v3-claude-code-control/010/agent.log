l-label { font-size: 0.85rem; color: var(--muted); }\n.hl-value { font-size: 1.6rem; font-weight: 700; color: var(--accent); line-height: 1.4; }\n.hl-note { font-size: 0.8rem; color: var(--muted); }\n\n.rules, .notes { margin: 0; padding-left: 1.4rem; }\n.rules li, .notes li { margin-bottom: 0.6rem; }\n.rules li:last-child, .notes li:last-child { margin-bottom: 0; }\n\ndetails {\n  border-top: 1px solid var(--line);\n}\ndetails:last-of-type { border-bottom: 1px solid var(--line); }\nsummary {\n  cursor: pointer;\n  list-style: none;\n  padding: 0.9rem 2rem 0.9rem 0;\n  font-weight: 600;\n  position: relative;\n}\nsummary::-webkit-details-marker { display: none; }\nsummary::after {\n  content: \"+\";\n  position: absolute;\n  right: 0.25rem;\n  top: 50%;\n  transform: translateY(-50%);\n  font-size: 1.3rem;\n  font-weight: 400;\n  color: var(--accent);\n}\ndetails[open] summary::after { content: \"−\"; }\nsummary:hover { color: var(--accent); }\ndetails p {\n  margin: 0 0 1rem;\n  color: var(--muted);\n}\n\n.contact .sign {\n  text-align: right;\n  margin-top: 1.25rem;\n}\n\nfooter {\n  text-align: center;\n  color: var(--muted);\n  font-size: 0.8rem;\n  margin-top: 2rem;\n}\n\n@media (max-width: 480px) {\n  .card { padding: 1.25rem 1.1rem; }\n}\n"}}}
