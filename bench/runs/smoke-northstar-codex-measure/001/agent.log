+  </main>
+  <footer class="footer"><div class="wrap footer-main"><a class="footer-brand" href="#">山间 <span lang="en">SHAN JIAN</span></a><span>来自山野，融入日常。</span><a href="#main">回到顶部 ↑</a></div><div class="wrap footer-note"><span lang="en">© 2026 SHAN JIAN COFFEE ROASTERS</span><span>独立咖啡烘焙工作室 · 示例品牌页面</span></div></footer>
+  <dialog id="bean-dialog" aria-labelledby="dialog-title"><button class="dialog-close" aria-label="关闭详情">×</button><span class="eyebrow" lang="en">GET TO KNOW YOUR COFFEE</span><h2 id="dialog-title"></h2><p id="dialog-description"></p><div class="brew-tip"><strong>冲煮起点</strong><p id="dialog-tip"></p></div><p class="dialog-note">风味描述和冲煮参数供参考，可根据设备与口味调整。此处为示例产品信息。</p><form method="dialog"><button class="button">继续逛豆单 <span aria-hidden="true">↗</span></button></form></dialog>
+  <script>
+    const coffees = {
+      flower: { title: '花间 · 耶加雪菲', description: '水洗处理带来清晰、轻盈的口感。茉莉花般的香气之后，是柠檬的明亮与蜂蜜般的柔和甜感，适合喜欢清爽手冲的你。', tip: '手冲可从 15 克咖啡粉、240 克水、92℃ 水温开始，使用中细研磨。' },
+      fruit: { title: '山果 · 慧兰', description: '红苹果的果香与焦糖甜感相遇，尾韵带着温和的坚果香。口感圆润，适合做一杯午后的手冲，也适合用法压壶慢慢分享。', tip: '手冲可从 15 克咖啡粉、225 克水、90℃ 水温开始，使用中等研磨。' },
+      daily: { title: '日常 · 招牌拼配', description: '以黑巧克力和榛果为主调，带着绵密的奶油口感。做浓缩醇厚扎实，加入牛奶后，甜感也依然清晰。', tip: '意式浓缩可从 18 克咖啡粉、36 克咖啡液开始，萃取时间参考 25 至 30 秒，再按口味调整研磨。' }
+    };
