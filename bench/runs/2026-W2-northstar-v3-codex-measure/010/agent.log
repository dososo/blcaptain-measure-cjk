+      expandedBeforePrint = [...document.querySelectorAll('details')].map(item => [item, item.open]);
+      expandedBeforePrint.forEach(([item]) => { item.open = true; });
+    });
+    window.addEventListener('afterprint', () => {
+      expandedBeforePrint.forEach(([item, wasOpen]) => { item.open = wasOpen; });
+    });
+  </script>
+</body>'''.replace('\\n+', '\\n'))
p.write_text(s)
PY
