+  <div class="shell">
+    <header class="topbar"><div class="breadcrumb"><span>工程手册</span><span>/</span><span>团队协作</span><span>/</span><strong>Git 使用规范</strong></div><div class="top-tag"><span class="status-dot"></span>团队标准</div></header>
+    <main class="page">
+      <section class="hero" id="overview">
