<script>
const form=document.getElementById('"'survey');
const questions=[...form.querySelectorAll('fieldset')];
const error=document.getElementById('error');
let submitted=null;
function updateProgress(){
 const completed=questions.filter(q=>q.querySelector('input:checked')).length;
 document.getElementById('count').textContent=completed;
 document.getElementById('progress').style.width=(completed/6*100)+'%';
 document.querySelector('[role=\"progressbar\"]').setAttribute('aria-valuenow',completed);
 questions.forEach(q=>{if(q.querySelector('input:checked')){q.classList.remove('invalid');q.removeAttribute('aria-describedby');}});
 if(completed===6)error.hidden=true;
}
form.addEventListener('change',updateProgress);
form.addEventListener('submit',event=>{
 event.preventDefault();
 const missing=questions.filter(q=>"'!q.querySelector('"'input:checked'));
 if(missing.length){
  error.textContent='还有 '+missing.length+' 道题未填写，请完成后再提交。';error.hidden=false;
  missing.forEach(q=>{q.classList.add('invalid');q.setAttribute('aria-describedby','error');});
  missing[0].querySelector('input').focus();return;
 }
 submitted={};
 questions.forEach(q=>{const title=[...q.querySelector('legend').childNodes].filter(n=>n.nodeType===3).map(n=>n.textContent).join('').trim();submitted[title]=q.querySelector('input:checked').value;});
 let saved=false;
 try{localStorage.setItem('city-commute-response',JSON.stringify(submitted));saved=true;}catch(e){}
 document.getElementById('save-status').textContent=saved?'6 道题已完成，答案已保存在当前浏览器中，未发送至服务器。你也可以下载一份自己的通勤记录。':'6 道题已完成。当前浏览器无法保存答案，请下载留存；关闭页面后答案将丢失。答案未发送至服务器。';
 document.getElementById('survey-content').hidden=true;
 document.getElementById('success').hidden=false;
 document.getElementById('success-title').focus();
});
document.getElementById('download').addEventListener('click',()=>{
 if("'!submitted)return;
 const content='"'城市之间 · 每日通勤调查\\n\\n'+Object.entries(submitted).map(([q,a],i)=>(i+1)+'. '+q+'\\n'+a).join('\\n\\n');
 const url=URL.createObjectURL(new Blob(['\\ufeff'+content],{type:'text/plain;charset=utf-8'}));
 const link=document.createElement('a');link.href=url;link.download='我的通勤回答.txt';document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
});
document.getElementById('edit').addEventListener('click',()=>{
 document.getElementById('success').hidden=true;document.getElementById('survey-content').hidden=false;
 form.querySelector('input:checked').focus();
});
</script>
</body>
</html>
