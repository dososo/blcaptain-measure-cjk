from html.parser import HTMLParser
from pathlib import Path
class Audit(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.targets=[]; self.plans=[]; self.external=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if 'id' in a:self.ids.append(a['id'])
        if a.get('href','').startswith('#') and len(a['href'])>1:self.targets.append(a['href'][1:])
        if 'data-plan' in a:self.plans.append(a['data-plan'])
        if a.get('src','').startswith('http'):self.external.append(a['src'])
p=Audit();p.feed(Path('index.html').read_text())
assert len(p.ids)==len(set(p.ids)), '重复标识'
assert not set(p.targets)-set(p.ids), '锚点不存在'
assert p.plans==['free','pro','team'], '套餐缺失'
assert not p.external, '存在外部依赖'
print('结构检查通过：三档套餐齐全，锚点有效，标识唯一，无外部资源依赖。')
