+    const endpoints = [
+      {id:'list-users',method:'GET',path:'/users',title:'获取用户列表',desc:'分页获取工作空间中的用户，默认按创建时间倒序排列。',scope:'users:read',paramTitle:'查询参数',params:[['page','integer','可选','页码，从 1 开始；默认值为 1。'],['per_page','integer','可选','每页数量，取值 1–100；默认值为 20。']],requestPath:'/users?page=1&per_page=20',status:'200 OK',response:{data:[user],pagination:{page:1,per_page:20,total:1}},responseNote:'data 为用户对象数组；pagination 包含当前页码、每页数量与总记录数。',errors:'400、401、403、429、500'},
