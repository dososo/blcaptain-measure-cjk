from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=set(); self.refs=[]; self.copies=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a:
            assert a['id'] not in self.ids, f\"Duplicate ID: {a['id']}\"
            self.ids.add(a['id'])
        if a.get('href','').startswith('#') and len(a['href'])>1: self.refs.append(a['href'][1:])
        if 'data-copy' in a: self.copies.append(a['data-copy'])
p=Path('index.html'); h=Check(); h.feed(p.read_text())
assert all(x in h.ids for x in h.refs+h.copies), 'Missing target'
assert len(h.copies)==6
print(f'HTML checked: {p.stat().st_size:,} bytes; all anchor and copy targets valid; 6 copy controls.')
