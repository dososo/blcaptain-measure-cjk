/bin/zsh -lc "node <<'JS'
const fs = require('fs');
const vm = require('vm');
const assert = require('assert');
const html = fs.readFileSync('index.html','utf8');
const script = html.match(/<script>([\\s\\S]*?)<\\/script>/)[1];
function el(dataset={}) {return {dataset,textContent:'',events:{},classList:{toggle(){}},setAttribute(k,v){this[k]=v},addEventListener(k,fn){this.events[k]=fn}}}
const cycles = ['monthly','yearly'].map(cycle=>el({cycle}));
