+.facts{display:flex;align-items:center;gap:17px;font-size:12px;color:#7b8577;margin-bottom:40px}
+.facts>span+span{border-left:1px solid #d7ddcf;padding-left:17px}
+.facts b{font-weight:600;color:#3d5542;font-size:14px}
+.journey-art{background:#eaf0e2;border-radius:5px;padding:20px 21px 16px;overflow:hidden;transform:rotate(-1.5deg)}
+.art-top,.art-bottom{display:flex;justify-content:space-between;color:#68815d;font-size:12px}
+.art-top{font-size:11px;letter-spacing:2px}
+.journey-art svg{width:100%;display:block;margin:10px 0 4px}
+.art-bottom{padding:0 14px}
+.aside-note{color:#87917e;font-size:12px;margin:20px 0 0;text-align:center}
+.aside-note span{padding-right:5px;color:#668258}
+.privacy{display:flex;gap:13px;align-items:center;margin:40px 0 0;color:#8a9385;border-top:1px solid #e0e5d9;padding-top:23px}
+.privacy p{margin:0;font-size:12px;line-height:1.8}
+.privacy svg{flex-shrink:0}
+.survey{background:var(--paper);border:1px solid #e3e7df;border-radius:12px;padding:30px 34px 25px;box-shadow:0 7px 30px #263c2a03}
