from html.parser import HTMLParser
from pathlib import Path
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.ids=[]; self.links=[]; self.stack=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if 'id' in a: self.ids.append(a['id'])
        if tag=='a' and a.get('href','').startswith('#'): self.links.append(a['href'][1:])
        if tag not in {'meta','link','br','hr','img','input','area','base','col','embed','param','source','track','wbr'}: self.stack.append(tag)
    def handle_endtag(self, tag):
        assert self.stack and self.stack[-1]==tag, (tag,self.stack[-3:])
        self.stack.pop()
p=Path('index.html'); parser=Check(); parser.feed(p.read_text())
assert not parser.stack, parser.stack
assert len(parser.ids)==len(set(parser.ids)), 'duplicate IDs'
assert set(parser.links)<=set(parser.ids), 'broken anchor'
assert '<html lang=\"zh-CN\">' in p.read_text()
print('PASS: HTML structure, unique IDs, navigation anchors and Chinese language declaration.')
print(f'index.html: {p.stat().st_size:,} bytes; styles and scripts embedded; no external assets.')
