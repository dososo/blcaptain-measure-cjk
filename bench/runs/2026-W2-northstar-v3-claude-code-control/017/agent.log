rder); padding-bottom: 1.5rem; }\nheader.hero h1 { margin: 0 0 .4rem; font-size: 1.9rem; line-height: 1.3; }\nheader.hero p { margin: 0; color: var(--muted); }\n.meta { margin-top: .75rem; font-size: .85rem; color: var(--muted); }\n\nnav.toc { position: sticky; top: 1.5rem; align-self: start; font-size: .9rem; }\nnav.toc strong { display: block; margin-bottom: .5rem; color: var(--muted); font-size: .8rem; letter-spacing: .05em; }\nnav.toc ol { list-style: none; margin: 0; padding: 0; }\nnav.toc li { margin: .15rem 0; }\nnav.toc a { color: var(--fg); text-decoration: none; display: block; padding: .2rem .6rem; border-left: 2px solid var(--border); }\nnav.toc a:hover { color: var(--accent); border-left-color: var(--accent); }\nnav.toc ol ol a { padding-left: 1.4rem; color: var(--muted); font-size: .85rem; }\n\nmain { min-width: 0; }\nsection { margin-bottom: 3rem; scroll-margin-top: 1rem; }\nh2 { font-size: 1.45rem; margin: 0 0 1rem; padding-bottom: .4rem; border-bottom: 1px solid var(--border); }\nh3 { font-size: 1.1rem; margin: 1.75rem 0 .6rem; scroll-margin-top: 1rem; }\np, li { max-width: 46rem; }\na { color: var(--accent); }\n\ncode {\n  font-family: \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  font-size: .88em;\n  background: var(--code-bg);\n  padding: .1em .35em;\n  border-radius: 4px;\n}\npre {\n  background: var(--code-bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 1rem 1.1rem;\n  overflow-x: auto;\n  line-height: 1.6;\n}\npre code { background: none; padding: 0; font-size: .85rem; }\n\n.table-wrap { overflow-x: auto; margin: 1rem 0; }\ntable { border-collapse: collapse; width: 100%; min-width: 32rem; background: var(--surface); font-size: .9rem; }\nth, td { border: 1px solid var(--border); padding: .55rem .8rem; text-align: left; vertical-align: top; }\nth { background: var(--accent-soft); font-weight: 600; }\n\n.callout {\n  border-left: 4px solid var(--accent);\n  background: var(--accent-soft);\n  padding: .75rem 1rem;\n  border-radius: 0 8px 8px 0;\n  margin: 1rem 0;\n}\n.callout p { margin: 0; }\n\n.compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0; }\n.compare > div { border-radius: 8px; padding: .8rem 1rem; min-width: 0; }\n.compare .good { background: var(--ok-soft); border: 1px solid var(--ok); }\n.compare .bad { background: var(--bad-soft); border: 1px solid var(--bad); }\n.compare h4 { margin: 0 0 .4rem; font-size: .9rem; }\n.compare .good h4 { color: var(--ok); }\n.compare .bad h4 { color: var(--bad); }\n.compare ul { margin: 0; padding-left: 1.1rem; }\n.compare code { background: transparent; padding: 0; word-break: break-all; }\n\n.steps { counter-reset: step; list-style: none; padding: 0; }\n.steps > li {\n  counter-increment: step;\n  position: relative;\n  padding: .2rem 0 1rem 2.6rem;\n  border-left: 2px solid var(--border);\n  margin-left: .9rem;\n}\n.steps > li:last-child { border-left-color: transparent; }\n.steps > li::before {\n  content: counter(step);\n  position: absolute; left: -0.95rem; top: 0;\n  width: 1.8rem; height: 1.8rem; border-radius: 50%;\n  background: var(--accent); color: var(--surface);\n  display: grid; place-items: center; font-size: .85rem; font-weight: 600;\n}\n.steps strong { display: block; }\n\n.checklist { list-style: none; padding: 0; }\n.checklist li { padding-left: 1.6rem; position: relative; margin: .3rem 0; }\n.checklist li::before { content: \"☐\"; position: absolute; left: 0; color: var(--accent); }\n\nfooter { grid-column: 1 / -1; border-top: 1px solid var(--border); padding-top: 1rem; color: var(--muted); font-size: .85rem; }\n\n@media (max-width: 52rem) {\n  .layout { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-block: 1.5rem 3rem; }\n  nav.toc { position: static; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: .8rem 1rem; }\n  .compare { grid-template-columns: minmax(0, 1fr); }\n  header.hero h1 { font-size: 1.5rem; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01HVHwu4NTMD7goFk6W7imiA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
