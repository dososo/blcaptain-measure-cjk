+      {name:'回顾与出发',title:'整理这一周，为下一步留好方向',desc:'今天的目标：回顾收获，解决疑问，带着清晰的计划继续。',tasks:[['回顾第一周的进展','整理已完成事项、学习收获与仍需协助的问题。','回顾'],['与负责人或伙伴做一次沟通','分享感受与困难，确认支持资源及后续反馈节奏。','团队'],['制定下一周计划','确定重点任务与学习目标，补齐尚未完成的入职事项。','计划']]}
+    ];
