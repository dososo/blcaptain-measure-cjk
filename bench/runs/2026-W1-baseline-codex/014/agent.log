<script>
(()=>{
let selectedPlan=4;
const plans={4:{group:80,private:200,days:30},12:{group:68,private:170,days:90}};
const money=n=>n.toLocaleString('"'zh-CN');
document.querySelectorAll('[data-plan]').forEach(button=>button.addEventListener('click',()=>{
selectedPlan=Number(button.dataset.plan);
document.querySelectorAll('[data-plan]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
const plan=plans[selectedPlan];
['group','private'].forEach(type=>{
document.getElementById(type+'-price').textContent=plan[type];
document.getElementById(type+'-old').hidden=selectedPlan===4;
document.getElementById(type+'-billing').innerHTML="'`${selectedPlan} 节课包，共 <strong>¥${money(plan[type]*selectedPlan)}</strong> · 有效期 ${plan.days} 天`;
});
}));
const dialog=document.getElementById('"'course-dialog');
document.querySelectorAll('[data-course]').forEach(button=>button.addEventListener('click',()=>{
const course=button.dataset.course;
document.getElementById('dialog-title').textContent=course==='体验课'?'先体验，再选课':course;
const rate=course==='小班口语课'?plans[selectedPlan].group:plans[selectedPlan].private;
document.getElementById('dialog-detail').textContent=course==='体验课'?'免费体验 · 25 分钟 · 口语水平评估与学习建议':"'`${selectedPlan} 节 × 50 分钟 · ¥${rate}/节 · 总计 ¥${money(rate*selectedPlan)} · 有效期 ${plans[selectedPlan].days} 天`;
dialog.showModal();
}));
document.querySelectorAll('"'.dialog-close,.dialog-done').forEach(button=>button.addEventListener('click',()=>dialog.close()));
dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
})();
</script>
</body>
</html>
